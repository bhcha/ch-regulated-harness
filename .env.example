# .env.example — 하네스 런타임 설정 템플릿.
#   값을 채워 repo-root 의 .env 로 복사하세요(cp .env.example .env).
#   ⚠ 실제 .env 는 절대 커밋하지 마세요(.gitignore 로 차단). 이 예시 파일(.env.example)만 추적됩니다.
#   로드: scripts/lib/common.sh 가 repo-root/.env 를 자동 로드합니다(이미 설정된 환경변수는 보존 — 호출자 환경 우선).

# ── 이미지 실생성 (Nano Banana / Gemini) ──
NANOBANANA_API_KEY=            # Google(Gemini/Vertex) API 키. 키비주얼·블록 이미지 실생성에 필요.
HARNESS_IMAGE_CLI=nanobanana   # nanobanana=실생성(온라인+키 없으면 fail-closed 중단). stub 은 오프라인(HARNESS_OFFLINE=1) 전용.

# ── 원격 심의 (ADK Cloud Run critic) — 도메인별 엔드포인트 ──
#   운영 심의 = 원격 ADK(adk-http) 단일. 엔드포인트는 도메인이 가리킨다:
#   packs/<도메인>/domain.json 의 adk_critic 블록(url_env/host_env)이 아래 env 이름을 정한다.
#   ⚠ 단일 ADK_CRITIC_URL / ADK_CRITIC_ALLOWED_HOST / ADK_CRITIC_APP 은 폐기됐다(도메인별로 대체).
ADK_COSMETICS_CRITIC_URL=          # 화장품 심의 엔드포인트(https, 공인 host). 설정하면 화장품 심의가 adk-http 로 자동 채택+필수화.
ADK_COSMETICS_CRITIC_ALLOWED_HOST= # 위 URL 의 host 와 '정확히' 일치해야 함(블록 있는 도메인인데 미설정이면 fail-closed 중단).
#   미구현 도메인(adk_critic 블록 없음, 예: 건강기능식품·의약외품 현재)은 ADK 를 생략하고 룰엔진-단독으로 진행하며
#     "사람 확인 권장"을 화면에 가시화한다(조용한 강등 아님). 추후 엔드포인트를 받으면:
#     packs/<도메인>/domain.json 에 adk_critic 블록 추가 + 이 파일에 ADK_<도메인>_CRITIC_URL/_ALLOWED_HOST 추가만(core 무수정).
#   (참고) KCIA_CRITIC_ENGINE 은 비우거나 adk-http 만 유효. 로컬 헤드리스 크리틱(claude-subagent/KCIA_CRITIC_CMD)은 폐기.

# ── (선택) 생성 엔진 / 동작 토글 ──
# HARNESS_CLI=claude                   # claude | stub. 오프라인(HARNESS_OFFLINE=1)이면 기본 stub, 온라인이면 기본 claude.
#                                      #   온라인에서 stub 명시는 거부(CI 전용). 세션 밖 실엔진 헤드리스 생성은 폐기 → 세션 안(insession) 또는 CI-stub.
# HARNESS_NANOBANANA_MODEL=gemini-2.5-flash-image  # 코드 기본 flash. Pro opt-in=gemini-3-pro-image(핸드오프 품질↑·쿼터↓).
#   ⚠ O-4 운영 정책: Pro(bake-all 10~14장)는 쿼터가 계정 공유라 **동시 2런 금지·순차 실행**(동시면 429 압박 2배).
#   429/400 부분실패는 P-1 백오프→강등으로 완주(아래 다이얼). 상세 = docs/deployment.md 2-1.
# HARNESS_NANOBANANA_RETRY_429=3       # 429(쿼터) 재시도 횟수(기본 3).
# HARNESS_NANOBANANA_BACKOFF=15,30,60  # 429 지수 백오프 간격(초).
# HARNESS_NANOBANANA_FALLBACK_MODEL=gemini-2.5-flash-image  # 429/400 시 그 블록부터 자동 강등 모델(빈 값=강등 끄기).
# HARNESS_IMAGE_TIMEOUT=120            # 이미지 호출 상한(초)
# KCIA_CRITIC_TIMEOUT=600              # 원격 ADK 심의 1회 하드 상한(초)
# ADK_CRITIC_RETRY=8                    # 빈응답/첫 턴 flaky 흡수 재시도 횟수(기본 8). 성공 시 조기 종료라 정상 경로 비용 0.
#                                      #   우선순위: 이 env > 팩 packs/<도메인>/domain.json 의 adk_critic.retry > 코드 기본 8.
#                                      #   (팩이 자기 엔드포인트 flakiness 를 선언하려면 domain.json 의 adk_critic 블록에 "retry": N 추가.)

# ── (선택) 테스트 입력 번들 ──
# 크롤 번들(naver_*/)은 git 추적 제외라 클론본엔 없습니다. 골든/풀파이프라인 테스트를 돌리려면
# 본인 번들 디렉터리를 지정하세요(없으면 stub 단계 테스트만 동작):
# TEST_BUNDLE=/abs/path/to/your-bundle-dir
