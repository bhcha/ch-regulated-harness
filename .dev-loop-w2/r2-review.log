+// ── reaper(고아 클레임 회수) ───────────────────────────────────────────────────
+
+export interface ReapDeps extends DoubleCheckDeps {
+  dirs: JobDirs;
+  /**
+   * 그 소비자가 아직 살아 있는가(하트비트 등) — **필수**. 기본값을 두지 않는 이유: '살아 있음' 판정은 소비자 구현의
+   *   지식이고(데몬=하트비트 파일 · 사람=알 수 없음), 여기서 아무 기본값이나 쓰면 **일하는 중인 소비자의 잡을
