   356	 * 클레임 해제 = pending 복귀(reaper 가 고아 클레임을 되돌릴 때). **no-clobber**: 같은 이름의 새 잡이 이미
   357	 *   대기 중이면 그 새 잡(마감이 더 넉넉하다)을 옛 고아로 덮지 않고, 고아 쪽을 버린다(중복 잡 제거).
   358	 *   link+unlink 를 쓰는 이유 = rename 은 무조건 덮어써서 '있는지 보고 옮기기'의 경합 창이 생기기 때문.
   359	 * @returns 실제로 복귀시켰으면 true, 새 잡이 있어 버렸으면 false.
   360	 */
   361	export async function releaseJob(dirs: JobDirs, claimedPath: string): Promise<boolean> {
   362	  const name = basename(claimedPath);
   363	  await mkdir(dirs.pending, { recursive: true });
   364	  const dest = join(dirs.pending, name);
   365	  try {
   366	    await link(claimedPath, dest);
   367	  } catch (e) {
   368	    if (!isEexist(e)) throw e;
   369	    await completeJob(claimedPath); // 새 잡이 이미 대기 중 — 고아는 중복이라 버린다.
   370	    return false;
   371	  }
   372	  await completeJob(claimedPath); // 하드링크 성공 → 원본 링크 제거(= 이동 완료).
   373	  return true;
   374	}
   375	
   376	/**
   377	 * 봇 타임아웃 회수 — **자기 잡일 때만** pending 에서 거둬들인다(job_id 대조). 소비자가 이미 클레임했으면(파일 없음)
   378	 *   no-op 이고, 같은 단계로 **새 잡이 다시 적재**됐으면(job_id 다름) 건드리지 않는다 — 남의 요청을 지우면 그 요청이 증발한다.
   379	 *
   380	 * **이 회수는 2차 방어다(1차는 마감 그 자체).** 봇이 타임아웃하는 순간은 정의상 `now ≥ expires_at` 이라, 남아 있는
   381	 *   잡은 이미 만료다 — 어떤 소비자가 집으려 해도 2중 검사 ㉠에 걸려 failed/ 로 간다. 회수는 그 뻔한 결말을 앞당기는
   382	 *   **정리**일 뿐이라 실패해도 안전하다(그래서 읽기 오류도 '회수 못 함'으로 환원한다).
   383	 * ⚠ 읽기-후-삭제라 원자적이지 않다. 창이 좁게 유지되는 근거는 **적재자가 하나**라는 배치 전제다: pending/ 을 쓰는 것은
   384	 *   봇뿐이고(Socket Mode 봇은 워크스페이스당 1 프로세스), 그 잡큐는 run 별 FIFO 라 같은 run 의 다음 생성 잡은 이
   385	 *   execute 가 끝난 **뒤에** 적재된다. job_id 대조는 그 위의 2차 방어다. 봇을 다중화하려면(같은 jobs/ 를 공유하는
   386	 *   2 프로세스) 이 회수도 클레임처럼 rename 기반으로 바꿔야 한다 — 다만 그 배치는 카드·잡 중복부터 깨진다.
   387	 * @returns 실제로 회수했으면 true.
   388	 */
   389	export async function recallPendingJob(pendingDir: string, job: GenerateJobFile): Promise<boolean> {
   390	  const path = join(pendingDir, jobFileName(job.run_id, job.stage));
   391	  // 읽기 실패(권한·IO)는 '회수 못 함'으로 환원한다 — 봇의 타임아웃 보고를 fs 예외로 바꾸지 않는다(사람 문구가 사라진다).
   392	  const cur = await readJobFile(path).catch(() => null);
   393	  // job_id 는 v2 잡에만 있다 — 둘 다 '비지 않은 문자열'이고 같을 때만 자기 잡으로 인정(옛/변조 잡 오삭제 차단).
   394	  if (!cur || !job.job_id || cur.job_id !== job.job_id) return false;
   395	  try {
   396	    await unlink(path);
   397	    return true;
   398	  } catch (e) {
   399	    if (isEnoent(e)) return false; // 그 사이 누가 집었다 — 정상.
   400	    throw e;
   401	  }
   402	}
   403	
   404	// ── 소비자 진입점(집기) ────────────────────────────────────────────────────────
   405	
   406	/** 잡 1건을 집으려는 시도의 결과. */
   407	export type TakeAction =
   408	  | "claimed" /** 2중 검사 통과 + rename 승리 → 이 소비자가 일한다(path 는 claimed 경로) */
   409	  | "lost" /** 경합 패배·이미 사라짐 — 다른 소비자 몫(조용히 넘어간다) */
   410	  | "failed" /** 만료·형식 오류 → failed/ 격리(+ .reason) */
   411	  | "dropped" /** 전이 완료 → 잡 삭제(할 일이 이미 끝났다) */
   412	  | "skipped"; /** 레거시(미클레임) · 판단 불가(복귀) — 일감으로 삼지 않는다 */
   413	
   414	export interface TakeResult {
   415	  action: TakeAction;
   416	  reason: JobCheckReason;
   417	  /** action="claimed" 일 때의 claimed 경로. */
   418	  path?: string;
   419	  detail?: string;
   420	}
   421	
   422	export interface TakeDeps extends DoubleCheckDeps {
   423	  dirs: JobDirs;
   424	  /** 이 소비자의 id(= `claimed/<consumerId>/` 디렉터리명 · 안전 토큰). */
   425	  consumerId: string;
   426	}
   427	
   428	/**
   429	 * **소비자 1급 경로** — pending 잡 1건을 집어 2중 검사를 걸고 그 결과대로 처분한다(사람 소비자도 같은 규약을 손으로 따른다):
   430	 *   통과 → 그대로 보유(작업) · 만료 → failed/ · 전이완료 → 삭제 · 레거시/판단불가 → 대기줄 복귀.
   431	 *   검사 실패 잡을 그냥 두지 않고 **처분까지** 하는 이유: 남겨두면 다음 회차마다 같은 검사·spawn 을 되풀이하고
   432	 *   사람 눈에도 '대기 중'으로 보인다(큐가 거짓말을 한다).
   433	 *
   434	 * ★ 순서가 핵심 — **먼저 집고(claim), 집은 것을 검사한다.** 반대로 하면(검사 후 집기) 검사한 잡과 집은 잡이 다를 수
   435	 *   있다: rename 은 잡이 아니라 **경로**를 집는데, 그 사이 같은 이름으로 새 잡이 들어올 수 있기 때문이다. 그러면
   436	 *   ㉠ 검사 안 한 잡을 들고 일하거나 ㉡ 멀쩡한 새 잡을 남의 판정으로 failed/ 에 처박는다. 소유한 뒤 검사하면 검사
   437	 *   대상과 처분 대상이 같음이 보장되고(경합 패배자는 아무것도 만지지 않는다), 느린 next-action 조회 동안 예산이
   438	 *   닳는 문제도 같이 사라진다(검사 시각이 소유 이후다).
   439	 *   예외 하나 — **v1 레거시는 집지도 않는다**: 마감이 없다는 건 파일만 보고 알 수 있고(셸 0), 집었다 되돌리면 사람이
   440	 *   손으로 소비 중인 파일을 매 회차 흔들게 된다(contract: 레거시는 사람 몫).
   441	 */
   442	export async function takePendingJob(job: GenerateJobFile, deps: TakeDeps): Promise<TakeResult> {
   443	  assertJobArgs(job.run_id, job.stage);
   444	  // 0) 순수 사전 필터(파일만 보고 판단 · fs 접촉 0): 레거시 잡은 애초에 집지 않는다.
   445	  if (parseDeadline(job) === null) {
   446	    return { action: "skipped", reason: "no_deadline", detail: "expires_at 미기재(v1 레거시 잡) — 사람 소비자 몫" };
   447	  }
   448	  // 1) 집는다(경합의 승자는 OS 가 정한다).
   449	  const path = await claimJob(deps.dirs, job, deps.consumerId);
   450	  if (path === null) return { action: "lost", reason: "ok" };
   451	  try {
   452	    // 2) 집은 **실물**을 읽는다 — 검사도 처분도 이 실물에 대해서만 한다(목록의 잡은 '뭔가 있다'는 힌트일 뿐).
   453	    const mine = await readJobFile(path);
   454	    if (!mine) {
   455	      await failJob(deps.dirs, path, "잡 파일을 읽을 수 없음(형식 오류)");
   456	      return { action: "failed", reason: "unreadable", detail: "잡 파일 형식 오류" };
   457	    }
   458	    // 3) 2중 검사 → 처분. 판정 불가·레거시면 되돌린다(버리지 않는다 — 다음 회차·사람이 다시 본다).
   459	    const check = await doubleCheckJob(mine, deps);
   460	    const detail = check.detail ? { detail: check.detail } : {};
   461	    if (check.ok) return { action: "claimed", reason: "ok", path };
   462	    if (check.reason === "expired") {
   463	      await failJob(deps.dirs, path, check.detail ?? "만료(expires_at 초과)");
   464	      return { action: "failed", reason: check.reason, ...detail };
   465	    }
   466	    if (check.reason === "transitioned") {
   467	      await completeJob(path); // 이미 됐다 → 재실행 금지.
   468	      return { action: "dropped", reason: check.reason, ...detail };
   469	    }
   470	    await releaseJob(deps.dirs, path); // no_deadline(사전 필터 뒤 바뀐 경우) · unreadable
   471	    return { action: "skipped", reason: check.reason, ...detail };
   472	  } catch (e) {
   473	    // 소유한 채 판단·처분에 실패하면(IO 오류 등) 대기줄로 되돌리고 예외를 올린다. 안 그러면 그 잡은 살아 있는
   474	    //   소비자의 claimed/ 에 갇힌다 — reaper 는 산 소비자의 클레임을 건드리지 않으므로 재기동 전까지 아무도 못 집는다
   475	    //   (고아가 아니라 '실종'이라 더 나쁘다). 되돌리기 실패는 삼킨다 — 원래 원인을 가리면 안 된다.
   476	    await releaseJob(deps.dirs, path).catch(() => {});
   477	    throw e;
   478	  }
   479	}
   480	
   481	// ── reaper(고아 클레임 회수) ───────────────────────────────────────────────────
   482	
   483	export interface ReapDeps extends DoubleCheckDeps {
   484	  dirs: JobDirs;
   485	  /**
   486	   * 그 소비자가 아직 살아 있는가(하트비트 등) — **필수**. 기본값을 두지 않는 이유: '살아 있음' 판정은 소비자 구현의
   487	   *   지식이고(데몬=하트비트 파일 · 사람=알 수 없음), 여기서 아무 기본값이나 쓰면 **일하는 중인 소비자의 잡을
   488	   *   빼앗는다**. 판단은 호출부가 명시한다.
   489	   */
   490	  isConsumerAlive: (consumerId: string) => boolean | Promise<boolean>;
   491	}
   492	
   493	export interface ReapResult {
   494	  path: string;
   495	  consumer: string;
   496	  /** alive=살아 있어 건너뜀 · released=pending 복귀 · dropped=중복이라 버림 · failed=만료 격리 · completed=전이완료 삭제 · skipped=판단 불가 */
   497	  action: "alive" | "released" | "dropped" | "failed" | "completed" | "skipped";
   498	  reason: JobCheckReason | "alive";
   499	  detail?: string;
   500	}
   501	
   502	/**
   503	 * 기동 reaper — `claimed/<consumer>/` 의 **고아**(살아 있지 않은 소비자의 클레임)를 회수한다. 고아를 무조건
   504	 *   재큐하지 않고 **같은 2중 검사**를 다시 건다: 만료됐거나 이미 전이됐으면 복귀시키지 않는다(stale 재실행 차단).
   505	 *   살아 있는 소비자의 클레임과 판단 불가(next-action 조회 실패)는 손대지 않는다(fail-closed).
   506	 *
   507	 * ⚠ 호출 순서 규약: 소비자는 **기동 시 이 reaper 를 먼저 돌린 뒤 폴링을 시작한다**. 지난 생의 고아
   508	 *   (`claimed/<자기 id>/`)를 남겨 둔 채 새로 집으면 같은 이름의 클레임을 자기가 덮어써 그 기록을 잃는다.
   509	 */
   510	export async function reapClaimedJobs(deps: ReapDeps): Promise<ReapResult[]> {
   511	  let consumers: string[];
   512	  try {
   513	    consumers = (await readdir(deps.dirs.claimed, { withFileTypes: true }))
   514	      .filter((d) => d.isDirectory())
   515	      .map((d) => d.name)
   516	      .sort();
   517	  } catch (e) {
   518	    if (isEnoent(e)) return []; // claimed/ 없음 = 고아 없음.
   519	    throw e; // 권한·IO 오류를 '고아 없음'으로 위장하지 않는다.
   520	  }
   521	  const out: ReapResult[] = [];
   522	  for (const consumer of consumers) {
   523	    const dir = join(deps.dirs.claimed, consumer);
   524	    // ENOENT = 그 사이 비워짐(정상). 그 외 오류는 '잡 없음'으로 위장하지 않고 올린다.
   525	    const names = (
   526	      await readdir(dir).catch((e: unknown) => {
   527	        if (isEnoent(e)) return [] as string[];
   528	        throw e;
   529	      })
   530	    ).sort();
   531	    // 생사 판정은 소비자당 **한 번**만 — 한 pass 안에서 같은 소비자의 잡들이 서로 다른 판정을 받으면
   532	    //   (스캔 도중 죽었을 때) 일부만 빼앗기는 어중간한 상태가 된다. 판정이 바뀌면 다음 pass 가 처리한다.
   533	    const alive = await deps.isConsumerAlive(consumer);
   534	    for (const name of names) {
   535	      if (name.startsWith(".") || !name.endsWith(".json")) continue;
   536	      const path = join(dir, name);
   537	      if (alive) {
   538	        out.push({ path, consumer, action: "alive", reason: "alive" });
   539	        continue;
   540	      }
   541	      const job = await readJobFile(path);
   542	      if (!job) {
   543	        // 깨진 잡 파일 = 판단 불가 → 사람이 보게 failed/ 로(큐에 남겨 되풀이 읽지 않는다).
   544	        await failJob(deps.dirs, path, "잡 파일을 읽을 수 없음(형식 오류)");
   545	        out.push({ path, consumer, action: "failed", reason: "unreadable", detail: "잡 파일 형식 오류" });
   546	        continue;
   547	      }
   548	      const check = await doubleCheckJob(job, deps);
   549	      const detail = check.detail ? { detail: check.detail } : {};
   550	      if (check.ok || check.reason === "no_deadline") {
   551	        // ok = 아직 시간이 있다 → 대기줄 복귀. no_deadline = 레거시라 데몬이 못 집는다 → 사람이 찾을 대기줄로 되돌린다.
   552	        const released = await releaseJob(deps.dirs, path);
   553	        out.push({ path, consumer, action: released ? "released" : "dropped", reason: check.reason, ...detail });
   554	        continue;
   555	      }
   556	      if (check.reason === "expired") {
   557	        await failJob(deps.dirs, path, check.detail ?? "만료(expires_at 초과)");
   558	        out.push({ path, consumer, action: "failed", reason: check.reason, ...detail });
   559	        continue;
   560	      }
   561	      if (check.reason === "transitioned") {
   562	        await completeJob(path); // 이미 됐다 → 재큐 금지(늦은 중복 생성 차단).
   563	        out.push({ path, consumer, action: "completed", reason: check.reason, ...detail });
   564	        continue;
   565	      }
   566	      // unreadable — 조회 실패로 잡을 버리거나 되살리지 않는다(다음 회차 재시도).
   567	      out.push({ path, consumer, action: "skipped", reason: check.reason, ...detail });
   568	    }
   569	  }
   570	  return out;
   571	}

