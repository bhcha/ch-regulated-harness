+        continue;
+      }
+      const job = await readJobFile(path);
+      if (!job) {
+        // 깨진 잡 파일 = 판단 불가 → 사람이 보게 failed/ 로(큐에 남겨 되풀이 읽지 않는다).
+        await failJob(deps.dirs, path, "잡 파일을 읽을 수 없음(형식 오류)");
+        out.push({ path, consumer, action: "failed", reason: "unreadable", detail: "잡 파일 형식 오류" });
+        continue;
+      }
+      const check = await doubleCheckJob(job, deps);
+      const detail = check.detail ? { detail: check.detail } : {};
+      if (check.ok || check.reason === "no_deadline") {
+        // ok = 아직 시간이 있다 → 대기줄 복귀. no_deadline = 레거시라 데몬이 못 집는다 → 사람이 찾을 대기줄로 되돌린다.
+        const released = await releaseJob(deps.dirs, path);
+        out.push({ path, consumer, action: released ? "released" : "dropped", reason: check.reason, ...detail });
+        continue;
+      }
+      if (check.reason === "expired") {
+        await failJob(deps.dirs, path, check.detail ?? "만료(expires_at 초과)");
+        out.push({ path, consumer, action: "failed", reason: check.reason, ...detail });
