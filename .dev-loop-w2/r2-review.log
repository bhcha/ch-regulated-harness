+ *   무한/즉시 타임아웃을 만들지 않게), 유효값이라도 **하한 1000ms**로 clamp 한다 — 서브초(예 0.0001초→0ms)로
+ *   반올림되면 상한이 사실상 0/즉시가 돼 '언제나 kill 할 수 있어야 한다'·'적재된 잡을 누군가는 집을 수 있어야 한다'는
+ *   전제가 깨진다.
+ */
+function timeoutEnvMs(name: string, defaultMs: number): number {
+  const raw = readEnv(name);
+  if (raw === undefined) return defaultMs;
+  const sec = Number(raw);
+  if (!Number.isFinite(sec) || sec <= 0) return defaultMs;
+  return Math.max(1000, Math.round(sec * 1000));
