+// ── 잡 조립·마감 ──────────────────────────────────────────────────────────────
+describe("expires_at — 절대 마감(적재시각 + 대기 상한)", () => {
+  it("computeExpiresAt: ISO-8601 UTC 절대시각(duration 아님)", () => {
+    expect(computeExpiresAt(T0, BRIDGE_TIMEOUT)).toBe(new Date(T0 + BRIDGE_TIMEOUT).toISOString());
