+  } as NextAction;
+}
+
+let root: string;
+let dirs: JobDirs;
+
+beforeEach(async () => {
+  root = await mkdtemp(join(tmpdir(), "chat-jobproto-"));
+  dirs = jobDirsOf({
+    jobsPending: join(root, "pending"),
+    jobsClaimed: join(root, "claimed"),
+    jobsFailed: join(root, "failed"),
