    21	/** 다음 매크로태스크까지 양보 — 동기 블로킹 워커 시작 전에 submit()·ack 가 현재 틱에서 먼저 끝나게 한다. */
    22	const nextMacrotask = (): Promise<void> => new Promise((r) => setImmediate(r));
