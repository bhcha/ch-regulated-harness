   101	  private async deliver(outcome: WorkerOutcome, job: Job): Promise<void> {
   102	    if (this.onOutcome) await this.onOutcome(outcome, job);
   103	  }
   104	
   105	  private async deliverError(err: unknown, job: Job): Promise<void> {
   106	    if (this.onError) await this.onError(err, job);
   107	  }
   108	}
