    42	/**
    43	 * JobQueue — run별 FIFO 잡큐(JobSubmitter 구현).
    44	 * submit 은 체인 적재만 하고 즉시 resolve 한다(처리를 기다리지 않음). 처리는 주입된 worker 에 위임한다.
    45	 */
    46	export class JobQueue implements JobSubmitter {
    47	  private readonly worker: WorkerLike;
    48	  private readonly onOutcome?: OutcomeSink;
    49	  private readonly onError?: ErrorSink;
    50	  /** run_id → 그 run 의 '마지막 잡까지 이어진' 체인 프로미스(정착 시 스스로 제거). */
