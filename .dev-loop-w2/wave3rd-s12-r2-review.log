    30	} from "../../src/worker/ownership.js";
    31	
    32	// ── 고정 상수(머신 무관 · 결정론) ────────────────────────────────────────────────
    33	const HB = "/abs/worker/ledger.json";
    34	const SUP: SupervisorMeta = { pid: 4242, startedAtMs: 1_000_000, rid: "run-abc-0718", stage: "brief" };
    35	const KILL_AT = 1_480_000;
    36	
    37	// ── 가짜 io(in-memory · ops 로그로 tmp→rename 순서 관측) ──────────────────────────
    38	function makeFakeIo() {
    39	  const files: Record<string, string> = {};
    40	  const ops: string[] = [];
    41	  const io: LedgerIo = {
    42	    writeFileSync: (p, d) => {
    43	      files[p] = d;
    44	      ops.push(`write:${p}`);
    45	    },
    46	    renameSync: (from, to) => {
    47	      files[to] = files[from];
    48	      delete files[from];
    49	      ops.push(`rename:${from}->${to}`);
    50	    },
    51	  };
    52	  return {
    53	    io,
    54	    ops,
    55	    /** path 로 내구화된 원장(파싱). 없으면 undefined. */
    56	    read: (p = HB): Ledger | undefined => (files[p] !== undefined ? parse(files[p]) : undefined),
    57	    /** path 로 **직접** 쓴 적(원자 스왑 우회 = 찢김 가능)의 목록 — 원자성 위반 관측용. */
    58	    directWrites: (p = HB): string[] => ops.filter((o) => o === `write:${p}`),
    59	  };
    60	}
    61	
    62	/** 고정 nonce 시퀀스를 내는 생성기(테스트 결정성). 소진되면 던진다(예상보다 많은 intent 감지). */
    63	function makeNonceGen(seq: string[]): NonceGen {
    64	  let i = 0;
    65	  return () => {
    66	    const n = seq[i++];
    67	    if (n === undefined) throw new Error(`makeNonceGen: nonce 시퀀스 소진(요청 ${i})`);
    68	    return n;
    69	  };
    70	}
    71	
    72	/** 고정 시계(intentAtMs·spawnedAtMs 를 결정론적으로). */
    73	function makeClock(t = 500_000) {
    74	  let cur = t;
    75	  return { now: (): number => cur, set: (v: number): void => void (cur = v) };
    76	}
    77	
    78	// ── 세션 상태 기계: intent → register → settle ────────────────────────────────────
    79	describe("createLedger — 상태 기계(intent→register→settle)", () => {
    80	  test("happy path: intent(spawning) → register(live) → settle(reaped) 가 디스크에 순차 내구화", () => {
    81	    const fake = makeFakeIo();
    82	    const clock = makeClock(500_000);
    83	    const led = createLedger(HB, SUP, fake.io, { now: clock.now, nonceGen: makeNonceGen(["N1"]) });
    84	
    85	    // intent — spawning(pgid 없음), nonce 반환.
    86	    const nonce = led.intent("main", KILL_AT);
    87	    expect(nonce).toBe("N1");
    88	    expect(fake.read()).toEqual({
    89	      v: LEDGER_VERSION,
    90	      supervisor: SUP,
    91	      sessions: [{ nonce: "N1", role: "main", state: "spawning", intentAtMs: 500_000, killAtMs: KILL_AT }],
    92	    });
    93	
    94	    // register — live(pgid 부여 · spawnedAtMs 기록).
    95	    clock.set(500_100);
    96	    led.register("N1", 5555);
    97	    expect(fake.read()?.sessions[0]).toEqual({
    98	      nonce: "N1",
    99	      role: "main",
   100	      state: "live",
   101	      pgid: 5555,
   102	      intentAtMs: 500_000,
   103	      spawnedAtMs: 500_100,
   104	      killAtMs: KILL_AT,
   105	    });
   106	
   107	    // settle reaped — 소멸 확인 · pgid **버림**(스키마: reaped 엔 pgid 부재).
   108	    led.settle("N1", "reaped");
   109	    const e = fake.read()?.sessions[0];
   110	    expect(e?.state).toBe("reaped");
   111	    expect(e && "pgid" in e).toBe(false); // pgid 키가 실제로 제거됨.
   112	  });
   113	
   114	  test("모든 변이는 tmp 에 쓴 뒤 rename(원자 스왑) — 목적지 직접 쓰기 0(찢김 불가)", () => {
   115	    const fake = makeFakeIo();
   116	    const led = createLedger(HB, SUP, fake.io, { now: makeClock().now, nonceGen: makeNonceGen(["N1"]) });
   117	    led.intent("main", KILL_AT);
   118	    // 정확히: write(/…​.tmp) → rename(/…​.tmp → /…). 목적지로의 직접 write 는 없다.
   119	    expect(fake.ops).toEqual([`write:${HB}.tmp`, `rename:${HB}.tmp->${HB}`]);
   120	    led.register("N1", 5555);
   121	    led.settle("N1", "reaped");
   122	    // 세 번의 변이 각각이 tmp→rename 한 쌍 = 총 3 write(tmp) + 3 rename, 목적지 직접 쓰기 0.
   123	    expect(fake.directWrites()).toEqual([]);
   124	    expect(fake.ops.filter((o) => o.startsWith(`rename:`)).length).toBe(3);
   125	    expect(fake.ops).toEqual([
   126	      `write:${HB}.tmp`,
   127	      `rename:${HB}.tmp->${HB}`,
   128	      `write:${HB}.tmp`,
   129	      `rename:${HB}.tmp->${HB}`,
   130	      `write:${HB}.tmp`,
   131	      `rename:${HB}.tmp->${HB}`,
   132	    ]);
   133	  });
   134	
   135	  test("leaked 엔트리는 **삭제되지 않고 존치**하며 pgid 를 **유지**한다(데몬이 계속 겨냥)", () => {
   136	    const fake = makeFakeIo();
