   532	  const snapshot = (): number[] => [...live].sort((a, b) => a - b);
   533	  const emit = (kind: HeartbeatPublishKind): void => publish?.(snapshot(), kind);
   534	  return {
   535	    register: (pgid: number): void => {
   536	      if (Number.isInteger(pgid) && pgid > 1) {
   537	        live.add(pgid);
   538	        emit("register");
   539	      }
   540	    },
   541	    release: (pgid: number): void => {
   542	      if (live.delete(pgid)) emit("release");
   543	    },
   544	    live: snapshot,
   545	  };
   546	}
