   701	  await gw.pending.set(threadId, { kind: "wb", rid });
   702	  const vm = toViewModel(await gw.readNext(rid).catch(() => stubNext(rid)));
   703	  await gw.chat.render(threadId, ingestP(vm));
   704	}
