    29	/** 잡 완료 회신 싱크(F2 어댑터의 카드 edit). 잡별로 완료 순서대로 호출된다. */
    30	export type OutcomeSink = (outcome: WorkerOutcome, job: Job) => void | Promise<void>;
    31	
    32	/** 예기치 못한 처리 예외 싱크(진단/알림). Worker.process 는 보통 예외를 흡수하지만 방어적으로 노출. */
