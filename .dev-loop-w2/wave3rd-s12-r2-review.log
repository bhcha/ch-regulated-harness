   294	      { nonce: "N2", role: "recovery", state: "spawning", intentAtMs: 3, killAtMs: 9 },
   295	      { nonce: "N3", role: "main", state: "leaked", pgid: 200, intentAtMs: 4, spawnedAtMs: 5, killAtMs: 9 },
   296	      { nonce: "N4", role: "main", state: "reaped", intentAtMs: 6, killAtMs: 9 },
   297	    ],
   298	  };
   299	
   300	  test("round-trip: parse(serialize(x)) === x", () => {
   301	    expect(parse(serialize(ledger))).toEqual(ledger);
   302	  });
   303	
   304	  test("serialize 는 트레일링 개행을 붙이고 parse 는 그걸 허용한다", () => {
