   310	  test("알 수 없는 v 는 거부(전방 비호환 fail-closed)", () => {
   311	    const future = serialize(ledger).replace('"v":1', '"v":2');
   312	    expect(() => parse(future)).toThrow(LedgerParseError);
   313	    expect(() => parse(future)).toThrow(/알 수 없는 원장 버전/);
   314	    // v 누락도 거부.
   315	    expect(() => parse('{"supervisor":{},"sessions":[]}')).toThrow(/알 수 없는 원장 버전/);
   316	  });
   317	
   318	  test("torn/invalid JSON 은 거부", () => {
   319	    const good = serialize(ledger);
   320	    const torn = good.slice(0, good.length - 5); // 끝을 잘라 파싱 불가하게.
   321	    expect(() => parse(torn)).toThrow(LedgerParseError);
