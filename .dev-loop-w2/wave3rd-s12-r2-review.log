    52	
    53	  constructor(deps: JobQueueDeps) {
    54	    this.worker = deps.worker;
    55	    this.onOutcome = deps.onOutcome;
    56	    this.onError = deps.onError;
    57	  }
    58	
    59	  /**
    60	   * 잡을 run별 FIFO 체인 끝에 적재하고 즉시 resolve(ack-후-비동기 · 셸 실행 안 함).
    61	   * 같은 run 은 이전 잡 완료 뒤 순차 처리, 다른 run 은 독립 체인이라 병렬 처리된다.
    62	   */
    63	  async submit(job: Job): Promise<void> {
    64	    // 이전 체인은 항상 '정상 정착'(아래 catch 로 rejection 미전파)이라 then 이 반드시 다음 잡을 실행한다.
    65	    const prev = this.chains.get(job.run_id) ?? Promise.resolve();
    66	    // 자기참조(정착 시 자기 항목만 정리)를 위해 먼저 선언 후 할당.
    67	    let done: Promise<void>;
    68	    done = prev
    69	      // ★ 매크로태스크 경계: worker.process 는 첫 await 전에 spawnSync(동기 셸)를 돌 수 있다. 빈 큐면 prev 가
    70	      //   이미 resolved 라 then 콜백이 같은 틱 마이크로태스크로 실행돼 submit()·ack 가 끝나기 전 이벤트루프를
    71	      //   블로킹한다 → Slack 3초 ack 창을 놓친다. setImmediate 로 한 틱 미뤄 submit·ack 를 먼저 끝낸다(FIFO 불변).
    72	      .then(nextMacrotask)
    73	      .then(() => this.worker.process(job))
    74	      .then(
    75	        (outcome) => this.deliver(outcome, job),
    76	        (err) => this.deliverError(err, job),
    77	      )
    78	      .catch(() => {
    79	        // 회신 싱크(onOutcome/onError) 자체가 던져도 체인을 오염시키지 않는다(다음 잡 실행 보장).
    80	      })
    81	      .finally(() => {
    82	        // 이 잡이 이 run 의 마지막이면 맵에서 제거(무한 성장 방지). 뒤에 새 잡이 붙었으면 그대로 둔다.
    83	        if (this.chains.get(job.run_id) === done) this.chains.delete(job.run_id);
    84	      });
    85	    this.chains.set(job.run_id, done);
    86	    // 여기서 즉시 반환 — worker.process 는 위 체인(마이크로태스크)에서 비동기로 시작된다.
    87	  }
    88	
    89	  /** 진행 중(대기 포함)인 run 수 — 진단/테스트용. */
    90	  get activeRuns(): number {
    91	    return this.chains.size;
    92	  }
    93	
    94	  /** 현재 적재된 모든 잡이 처리·회신 완료될 때까지 대기(그레이스풀 셧다운·테스트용). */
    95	  async drain(): Promise<void> {
    96	    while (this.chains.size > 0) {
    97	      await Promise.allSettled([...this.chains.values()]);
    98	    }
    99	  }
