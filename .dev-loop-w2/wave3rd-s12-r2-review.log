   118	  /** register(자식 확정) 시각 ms — live 승격 시 기록(감사용). spawning 엔 부재. */
   119	  spawnedAtMs?: number;
   120	  /** 이 세션의 마감 절대 시각 ms(supervisor 가 intent 시 박는다). spawning GC 판정의 기준. */
   121	  killAtMs: number;
   122	}
   123	
   124	/** 원장 전체. v 는 스키마 버전(데몬이 미지 버전을 거부하는 근거). */
   125	export interface Ledger {
   126	  v: typeof LEDGER_VERSION;
   127	  supervisor: SupervisorMeta;
   128	  sessions: SessionEntry[];
   129	}
   130	
   131	// ── 타입드 에러(호출부가 surface 할 수 있게) ──────────────────────────────────────
   132	
   133	/**
   134	 * parse 실패 에러 — **throw 로** 신호한다(타입드 에러라 호출부가 `instanceof LedgerParseError` 로 구분·surface 가능).
   135	 *   던지는 경우: ① torn/invalid JSON, ② 알 수 없는 `v`, ③ 구조 위반(필드 누락·타입 불일치·pgid 불변식 위반).
   136	 */
   137	export class LedgerParseError extends Error {
   138	  constructor(message: string) {
   139	    super(message);
   140	    this.name = "LedgerParseError";
   141	  }
   142	}
   143	
   144	/** 불법 상태전이 에러 — register/settle 이 계약 밖 전이를 만나면 던진다(호출부가 명확히 실패 처리). */
   145	export class LedgerTransitionError extends Error {
   146	  constructor(message: string) {
   147	    super(message);
   148	    this.name = "LedgerTransitionError";
   149	  }
   150	}
   151	
   152	/**
   153	 * 내구 기록 실패 에러 — io(writeFileSync/renameSync)가 던지면 **삼키지 않고** 이걸로 감싸 surface 한다. supervisor 가
   154	 *   intent/register 에서 이걸 받아 fail-closed 할지(치명 여부)는 supervisor 가 정한다 — 이 모듈은 보고만 한다.
   155	 */
   156	export class LedgerWriteError extends Error {
   157	  constructor(message: string) {
   158	    super(message);
   159	    this.name = "LedgerWriteError";
   160	  }
   161	}
   162	
   163	// ── serialize / parse ────────────────────────────────────────────────────────────
   164	
   165	/**
   166	 * 원장을 내구 문자열로 직렬화. supervisor.ts 하트비트와 같은 관례로 끝에 `\n` 을 붙인다(POSIX 텍스트 파일). parse 는
   167	 *   JSON.parse 가 트레일링 공백을 무시하므로 round-trip 한다.
   168	 */
   169	export function serialize(ledger: Ledger): string {
   170	  return `${JSON.stringify(ledger)}\n`;
   171	}
   172	
   173	function asFiniteNumber(label: string, v: unknown): number {
   174	  if (typeof v !== "number" || !Number.isFinite(v)) {
   175	    throw new LedgerParseError(`원장 필드 '${label}' 가 유한한 숫자가 아닙니다: ${JSON.stringify(v)}`);
   176	  }
   177	  return v;
   178	}
   179	
   180	function asString(label: string, v: unknown): string {
   181	  if (typeof v !== "string") throw new LedgerParseError(`원장 필드 '${label}' 가 문자열이 아닙니다: ${JSON.stringify(v)}`);
   182	  return v;
   183	}
   184	
   185	/**
   186	 * pgid 불변식 검증 — **register 와 동일한 조건**(1 초과 정수). parse 가 "유한 숫자"만 봐 넘기면 `pgid:1`·`-1`·`1.5`
   187	 *   같은 값이 live/leaked 엔트리로 파싱돼 '구조적으로 유효한 v1 원장'이라는 스키마 계약이 깨진다(evaluateReap 이
   188	 *   나중에 refuse 하더라도 계약 자체는 이미 거짓). init/launchd·광역 신호로 번질 값을 스키마 층에서부터 막는다.
   189	 */
   190	function asPgid(label: string, v: unknown): number {
   191	  if (typeof v !== "number" || !Number.isInteger(v) || v <= 1) {
   192	    throw new LedgerParseError(`원장 필드 '${label}' 가 유효한 pgid 가 아닙니다(1 초과 정수여야 함): ${JSON.stringify(v)}`);
   193	  }
   194	  return v;
   195	}
   196	
   197	function parseRole(v: unknown): SessionRole {
   198	  if (v === "main" || v === "recovery") return v;
   199	  throw new LedgerParseError(`알 수 없는 role: ${JSON.stringify(v)}`);
   200	}
   201	
   202	function parseState(v: unknown): SessionState {
   203	  if (v === "spawning" || v === "live" || v === "reaped" || v === "leaked") return v;
   204	  throw new LedgerParseError(`알 수 없는 state: ${JSON.stringify(v)}`);
   205	}
   206	
   207	/** live/leaked 만 pgid 를 갖는다(스키마 불변식). */
   208	function stateHasPgid(state: SessionState): boolean {
   209	  return state === "live" || state === "leaked";
   210	}
   211	
   212	function parseEntry(raw: unknown, i: number): SessionEntry {
   213	  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
   214	    throw new LedgerParseError(`sessions[${i}] 가 객체가 아닙니다`);
   215	  }
   216	  const o = raw as Record<string, unknown>;
   217	  const state = parseState(o.state);
   218	  const entry: SessionEntry = {
   219	    nonce: asString(`sessions[${i}].nonce`, o.nonce),
   220	    role: parseRole(o.role),
   221	    state,
   222	    intentAtMs: asFiniteNumber(`sessions[${i}].intentAtMs`, o.intentAtMs),
   223	    killAtMs: asFiniteNumber(`sessions[${i}].killAtMs`, o.killAtMs),
   224	  };
   225	  // pgid 불변식: live/leaked 는 반드시 있어야 하고(그리고 register 와 같은 '1 초과 정수'여야 한다 — asPgid), spawning/
   226	  //   reaped 는 있으면 안 된다(맨몸 신호 금지의 스키마 층).
   227	  const hasPgid = o.pgid !== undefined;
   228	  if (stateHasPgid(state)) {
   229	    if (!hasPgid) throw new LedgerParseError(`sessions[${i}] state=${state} 인데 pgid 가 없습니다(불변식 위반)`);
   230	    entry.pgid = asPgid(`sessions[${i}].pgid`, o.pgid);
   231	  } else if (hasPgid) {
   232	    throw new LedgerParseError(`sessions[${i}] state=${state} 인데 pgid 가 있습니다(불변식 위반)`);
   233	  }
   234	  if (o.spawnedAtMs !== undefined) entry.spawnedAtMs = asFiniteNumber(`sessions[${i}].spawnedAtMs`, o.spawnedAtMs);
   235	  return entry;
   236	}
   237	
   238	/**
   239	 * 내구 문자열을 원장으로 파싱(round-trip). **거부하는 것**(전부 LedgerParseError throw): torn/invalid JSON · 알 수
   240	 *   없는 `v`(전방 비호환) · 구조 위반. 반환은 **정규화된** 원장(알 수 없는 잉여 필드는 버린다 — round-trip 결정론).
   241	 */
   242	export function parse(text: string): Ledger {
   243	  let raw: unknown;
   244	  try {
   245	    raw = JSON.parse(text);
   246	  } catch (e) {
   247	    const msg = e instanceof Error ? e.message : String(e);
   248	    throw new LedgerParseError(`원장 JSON 파싱 실패(torn/invalid): ${msg}`);
   249	  }
   250	  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
   251	    throw new LedgerParseError("원장 최상위가 객체가 아닙니다");
   252	  }
   253	  const o = raw as Record<string, unknown>;
   254	  // 알 수 없는 v 거부 — 데몬이 미지 포맷을 잘못 해석하지 않게(전방 비호환 fail-closed).
   255	  if (o.v !== LEDGER_VERSION) {
   256	    throw new LedgerParseError(`알 수 없는 원장 버전 v=${JSON.stringify(o.v)}(지원 v=${LEDGER_VERSION})`);
   257	  }
   258	  const sup = o.supervisor;
   259	  if (typeof sup !== "object" || sup === null || Array.isArray(sup)) {
   260	    throw new LedgerParseError("supervisor 블록이 객체가 아닙니다");
   261	  }
   262	  const s = sup as Record<string, unknown>;
   263	  const supervisor: SupervisorMeta = {
   264	    pid: asFiniteNumber("supervisor.pid", s.pid),
   265	    startedAtMs: asFiniteNumber("supervisor.startedAtMs", s.startedAtMs),
   266	    rid: asString("supervisor.rid", s.rid),
   267	    stage: asString("supervisor.stage", s.stage),
   268	  };
   269	  if (!Array.isArray(o.sessions)) throw new LedgerParseError("sessions 가 배열이 아닙니다");
   270	  const sessions = o.sessions.map((e, i) => parseEntry(e, i));
   271	  return { v: LEDGER_VERSION, supervisor, sessions };
   272	}
   273	
   274	// ── nonce 생성 seam ───────────────────────────────────────────────────────────────
   275	
   276	/** nonce 생성기 — 주입 seam(테스트 결정성). 기본은 crypto.randomUUID(재사용 불가·정상 앱 코드라 허용). */
   277	export type NonceGen = () => string;
   278	
   279	/** 프로덕션 기본 nonce 생성기. */
   280	export const defaultNonceGen: NonceGen = () => randomUUID();
   281	
   282	// ── 내구 기록기(createLedger) ─────────────────────────────────────────────────────
   283	
   284	/**
   285	 * io seam — supervisor.ts 의 `HeartbeatIo` 와 **같은 모양**(동기 + tmp→rename 원자 스왑)을 재사용한다. 동기라
   286	 *   호출 반환 시점엔 이미 디스크에 있어(대기 중 비동기 쓰기 없음) `process.exit()` 이 앞질러도 마지막 상태가 유실되지
   287	 *   않고, tmp→rename 이라 데몬이 반쯤 쓰인 파일을 절대 읽지 않는다(찢김 없음).
   288	 */
   289	export interface LedgerIo {
   290	  writeFileSync: (path: string, data: string) => void;
   291	  renameSync: (from: string, to: string) => void;
   292	}
   293	
   294	/** createLedger 의 추가 주입 seam(시계·nonce). io 는 필수 위치인자, 이건 선택(기본=실시계/실 nonce). */
   295	export interface LedgerSeams {
   296	  /** 현재 절대 시각 ms(intentAtMs·spawnedAtMs 기록용). 기본 Date.now — 테스트는 가짜 시계를 넣는다. */
   297	  now?: () => number;
   298	  nonceGen?: NonceGen;
   299	}
   300	
   301	/** createLedger 가 돌려주는 핸들. supervisor 가 이걸로 원장을 몬다. */
   302	export interface LedgerHandle {
   303	  /** nonce 생성 + `spawning` 엔트리 내구 기록 후 nonce 반환. **자식 spawn 직전**에 호출(register-lag 해소). */
   304	  intent: (role: SessionRole, killAtMs: number) => string;
   305	  /** 자식 확정 시 그 엔트리를 `live` + pgid 로 승격(내구 기록). */
   306	  register: (nonce: string, pgid: number) => void;
   307	  /** 회수 확인 시 처분 기록: reaped(소멸·pgid 버림) 또는 leaked(생존·pgid 유지·엔트리 존치). */
   308	  settle: (nonce: string, disposition: "reaped" | "leaked") => void;
   309	  /** 현재 원장 스냅샷(읽기 전용 복사 — 종료 전파가 live pgid 를 읽거나 테스트가 관측). */
   310	  snapshot: () => Ledger;
   311	}
   312	
   313	/**
   314	 * 내구 원장 기록기를 만든다. **모든 변이는 tmp→rename 원자 스왑으로 내구 기록되고, io 가 던지면 삼키지 않고
   315	 *   LedgerWriteError 로 surface** 한다(변이는 내구 성공 후에만 in-memory 에 커밋 → io 실패 시 in-memory 는
   316	 *   디스크와 어긋나지 않는다). 불법 전이는 LedgerTransitionError 로 거부한다.
   317	 *
   318	 * @param path 원장 파일 경로.
   319	 * @param supervisorMeta 이 supervisor 의 신원(데몬의 start-time 대조용).
   320	 * @param io 동기 원자 쓰기 seam(HeartbeatIo 와 동형).
   321	 * @param seams 선택 주입(now·nonceGen · 기본=실시계/실 nonce).
   322	 */
   323	export function createLedger(
   324	  path: string,
   325	  supervisorMeta: SupervisorMeta,
   326	  io: LedgerIo,
   327	  seams: LedgerSeams = {},
   328	): LedgerHandle {
   329	  const now = seams.now ?? (() => Date.now());
   330	  const nonceGen = seams.nonceGen ?? defaultNonceGen;
   331	  const tmp = `${path}.tmp`;
   332	  // in-memory 는 **내구화된 디스크 상태의 거울**이다. 변이는 persist 성공 후에만 여기에 반영한다.
   333	  let sessions: SessionEntry[] = [];
   334	
   335	  /**
   336	   * 다음 세션 배열을 내구 기록한다 — **성공한 뒤에만** in-memory 에 커밋한다. io 가 던지면 커밋 없이 LedgerWriteError
   337	   *   를 던진다 → in-memory(sessions)는 이전 내구 상태 그대로라, 실패한 변이가 핸들에 새지 않는다(롤백 불필요·자동).
   338	   */
   339	  const persist = (next: SessionEntry[]): void => {
   340	    const data = serialize({ v: LEDGER_VERSION, supervisor: supervisorMeta, sessions: next });
   341	    try {
   342	      io.writeFileSync(tmp, data);
   343	      io.renameSync(tmp, path); // 원자 교체 — 소비자(데몬)는 완결본만 본다.
   344	    } catch (e) {
   345	      const msg = e instanceof Error ? e.message : String(e);
   346	      throw new LedgerWriteError(`원장 내구 기록 실패(path=${path}): ${msg}`);
   347	    }
   348	    sessions = next; // 내구 성공 후에만 커밋.
   349	  };
   350	
   351	  const findIndex = (nonce: string): number => sessions.findIndex((e) => e.nonce === nonce);
   352	
   353	  return {
   354	    intent: (role: SessionRole, killAtMs: number): string => {
   355	      // role·killAt 정합성 fail-closed(잘못된 잡 스펙이 원장에 새지 않게).
   356	      if (role !== "main" && role !== "recovery") {
   357	        throw new LedgerTransitionError(`intent: 알 수 없는 role: ${JSON.stringify(role)}`);
   358	      }
   359	      if (!Number.isFinite(killAtMs)) {
   360	        throw new LedgerTransitionError(`intent: killAtMs 가 유한하지 않습니다: ${killAtMs}`);
   361	      }
   362	      const nonce = nonceGen();
   363	      // nonce 충돌 방어 — 실 crypto nonce 는 충돌하지 않지만, 주입 테스트 seam 이 같은 값을 두 번 낼 수 있다. 같은
   364	      //   nonce 두 엔트리는 register/settle 을 모호하게 만들므로 fail-closed(소유 토큰의 유일성이 계약의 근간).
   365	      if (findIndex(nonce) >= 0) {
   366	        throw new LedgerTransitionError(`intent: nonce 충돌(${nonce}) — 소유 토큰 유일성 위반`);
   367	      }
   368	      const entry: SessionEntry = { nonce, role, state: "spawning", intentAtMs: now(), killAtMs };
   369	      persist([...sessions, entry]);
   370	      return nonce;
   371	    },
   372	
   373	    register: (nonce: string, pgid: number): void => {
   374	      const idx = findIndex(nonce);
   375	      if (idx < 0) throw new LedgerTransitionError(`register: intent 되지 않은 nonce(${nonce}) — 소유권 없음`);
   376	      const cur = sessions[idx];
   377	      if (cur.state !== "spawning") {
   378	        throw new LedgerTransitionError(`register: state=${cur.state} 는 spawning 이 아닙니다(재register·settle 후 register 금지)`);
   379	      }
   380	      // pgid 정합성 — supervisor 의 pgid ≤ 1 가드와 같은 이유(방어심층). pgid ≤ 1 이 원장에 들어가면 데몬의 회수가
   381	      //   kill(1)=init/launchd·kill(-1)=광역·kill(0)=호출자그룹 으로 번질 위험이 있다. 유효 그룹만 live 로 승격한다.
   382	      if (!Number.isInteger(pgid) || pgid <= 1) {
   383	        throw new LedgerTransitionError(`register: 유효하지 않은 pgid(${pgid}) — init/launchd·광역 오신호 방지(1 초과 정수만)`);
   384	      }
   385	      const next = sessions.slice();
   386	      next[idx] = { ...cur, state: "live", pgid, spawnedAtMs: now() };
   387	      persist(next);
   388	    },
   389	
   390	    settle: (nonce: string, disposition: "reaped" | "leaked"): void => {
   391	      const idx = findIndex(nonce);
   392	      if (idx < 0) throw new LedgerTransitionError(`settle: 알 수 없는 nonce(${nonce})`);
   393	      const cur = sessions[idx];
   394	      if (cur.state === "reaped" || cur.state === "leaked") {
   395	        throw new LedgerTransitionError(`settle: 이미 settle 됨(state=${cur.state}) — double-settle 금지`);
   396	      }
   397	      const next = sessions.slice();
   398	      if (disposition === "reaped") {
   399	        // reaped = 그룹 소멸 확인. pgid 는 이제 무의미하고 재사용 위험이라 **버린다**(스키마: reaped 엔 pgid 부재).
   400	        //   live(있던 pgid) 든 spawning(원래 없음)이든 결과적으로 pgid 없는 reaped. spawn 실패로 register 못 한
   401	        //   spawning 을 '아무것도 안 남고 확인됨'으로 정리하는 경로이기도 하다.
   402	        const { pgid: _dropped, ...rest } = cur;
   403	        void _dropped;
   404	        next[idx] = { ...rest, state: "reaped" };
   405	      } else {
   406	        // leaked = 회수 실패, 그룹 생존. 데몬이 계속 겨냥해야 하므로 pgid 를 **유지**하고 엔트리를 **삭제하지 않는다**.
   407	        //   pgid 없는 spawning 은 leaked 로 갈 수 없다(유지할 pgid 가 없다 — settle 시그니처가 pgid 를 안 받는다).
   408	        if (cur.state !== "live") {
   409	          throw new LedgerTransitionError(`settle leaked: state=${cur.state} 에는 유지할 pgid 가 없습니다(live 만 leaked 가능)`);
   410	        }
   411	        next[idx] = { ...cur, state: "leaked" };
   412	      }
   413	      persist(next);
   414	    },
   415	
   416	    snapshot: (): Ledger => ({
   417	      v: LEDGER_VERSION,
   418	      supervisor: { ...supervisorMeta },
   419	      sessions: sessions.map((e) => ({ ...e })),
   420	    }),
   421	  };
   422	}
   423	
   424	// ── 순수 회수판정 함수(evaluateReap) — 계약의 심장 ────────────────────────────────
   425	
   426	/**
   427	 * 데몬이 프로세스 세계를 관측하는 seam(주입). **evaluateReap 은 이 안에서 실 ps/pgrep 를 부르지 않는다** — W3
   428	 *   테스트는 가짜, W4 가 실 `ps -E`/`pgrep` 를 배선한다.
   429	 */
   430	export interface ProcView {
   431	  /** pgid 그룹의 구성원 pid 목록. 그룹이 없으면(ESRCH) 빈 배열. */
   432	  groupMembers: (pgid: number) => number[];
   433	  /** pid 의 exec-env 에 name=value 가 있는가(예: `ps -E` 로 그 프로세스의 환경변수 조회). */
   434	  execEnvHas: (pid: number, name: string, value: string) => boolean;
   435	  /** exec-env 에 name=value 를 지닌 프로세스들의 pgid 목록(예: `pgrep`+env 필터). register-lag 창에서 pgid 발견용. */
   436	  scanByEnv: (name: string, value: string) => number[];
   437	}
   438	
   439	/** 데몬이 판정 시점에 보는 세계 상태(owner supervisor 신원 + 관측 + 현재 시각). */
   440	export interface SupervisorState {
   441	  /** 원장이 기록한 owner supervisor 신원(우리가 이 잡을 띄웠다고 주장하는 그 프로세스). */
   442	  ledger: { pid: number; startedAtMs: number };
   443	  /** 데몬이 지금 그 pid 를 관측한 결과 — alive(kill(pid,0)) + 실제 startedAtMs(없으면 null). */
   444	  observed: { alive: boolean; startedAtMs: number | null };
   445	  /** 데몬의 현재 절대 시각 ms(spawning GC 의 killAt+여유 판정용). */
   446	  nowMs: number;
   447	}
   448	
   449	/**
   450	 * 회수 판정(부작용 없음 — **결정만** 한다, 실행은 데몬 몫):
   451	 *   · kill          — pgid 그룹이 신호 후보다(판정 시점 nonce 검증 통과). **nonce 를 동봉**하니, 데몬은 kill(-pgid) 를
   452	 *                     쏘기 **직전에** 그 nonce 로 재검증한 뒤 실행한다(decision ≠ signal · verify→signal 창 최소화).
   453	 *   · scan-then-kill — spawning(pgid 미확정)인데 nonce 스캔이 그룹(들)을 **발견(discovery)**했다. 스캔은 발견일 뿐이라
   454	 *                     데몬은 동봉된 nonce 로 **각 pgid 를 신호 직전 재검증**한 뒤 회수한다(스캔이 nonce-free kill 을 허락 안 함).
   455	 *   · refuse        — 신호 거부. reason 이 근거(대표=nonce 불일치=PID 재사용 → 무관 그룹 오kill 방지 · 안전의 핵심).
   456	 *   · gc            — 회수할 그룹이 없다(이미 소멸·미발생·reaped). 원장 엔트리만 정리(신호 없음).
   457	 *   · wait          — 지금 손대지 않는다(owner 가 살아있어 자기 세션 관리 중 · 또는 register-lag 창 안).
   458	 */
   459	export type ReapDecision =
   460	  | { action: "kill"; pgid: number; nonce: string; reason: string }
   461	  | { action: "scan-then-kill"; nonce: string; pgids: number[]; reason: string }
   462	  | { action: "refuse"; reason: string }
   463	  | { action: "gc"; reason: string }
   464	  | { action: "wait"; reason: string };
   465	
   466	/**
   467	 * 세션 엔트리 1건에 대한 회수 판정. 순수 — procView/supervisorState 만 보고 ReapDecision 을 돌린다.
   468	 *
   469	 * **판정 순서**:
   470	 *   1. owner 신원 게이트 — **세 갈래**로 가른다(2갈래로 뭉치면 '살아있으나 기동시각 못 읽음'이 오회수로 샌다):
   471	 *      ⓐ alive && 기동시각 == ledger → 우리 owner, 아직 관리 중 → **wait**(비켜섬). `kill(pid,0)` 만으론 부족,
   472	 *         **기동시각 일치**까지 봐야 PID 재사용된 supervisor 를 원 supervisor 로 오인하지 않는다.
   473	 *      ⓑ alive && 기동시각을 **읽었고 진짜로 다름** → PID 재사용(무관 프로세스) → not-our-supervisor(고아 회수 진행).
   474	 *      ⓒ alive && 기동시각 == **null(못 읽음: 권한/파싱 실패)** → **다르다고 단정 금지** → **wait**(안전 방향: 살아있는
   475	 *         owner 가 사라졌음을 증명 못 하니 그 세션을 뺏지 않는다). '못 읽음'을 '불일치'로 흘리면 살아있는 supervisor 의
   476	 *         제 세션을 죽인다 — reap-progress 는 **DIFFERENT 임을 적극 확인**했을 때만 정당하다.
   477	 *      ⓓ !alive → owner 사망 → 고아 회수 진행.
   478	 *   2. terminal 정리 — reaped 는 이미 끝났으니 gc(엔트리 정리).
   479	 *   3. live/leaked(pgid 있음) — 그룹이 없으면 gc(이미 소멸). 있으면 **nonce 일치할 때만 kill**, 불일치면 refuse
   480	 *      (PID 재사용 안전 케이스).
   481	 *   4. spawning(pgid 미확정) — nonce 로 스캔해 그룹을 찾으면 scan-then-kill, 못 찾고 killAt+여유를 넘겼으면 gc,
   482	 *      아직 창 안이면 wait.
   483	 */
   484	export function evaluateReap(
   485	  entry: SessionEntry,
   486	  supervisorState: SupervisorState,
   487	  procView: ProcView,
   488	): ReapDecision {
   489	  // 1. owner 신원 게이트 — 세 갈래(ⓐ 우리 owner 살아있음 · ⓑ PID 재사용 · ⓒ 기동시각 못 읽음 · ⓓ 사망). reap-progress
   490	  //   는 owner 가 **DIFFERENT 프로세스임을 적극 확인**했을 때만 정당하다 — '살아있으나 신원 확인 불가'는 회수 금지.
   491	  const obs = supervisorState.observed;
   492	  if (obs.alive === true) {
   493	    if (obs.startedAtMs === supervisorState.ledger.startedAtMs) {
   494	      // ⓐ 살아있고 기동시각 일치 = 진짜 우리 owner, 아직 관리 중. 데몬은 밑에서 뺏지 않는다(owner 가 자기 마감을 강제
   495	      //   하고, 데몬은 owner 사망 시의 백스톱). W4/W5 카베아트: 'owner 살아있으나 마감+유예 초과' 에스컬레이션은 계약 밖.
   496	      return { action: "wait", reason: "owner supervisor 살아있고 신원 일치 — 자기 세션 관리 중이니 회수 보류(defer)" };
   497	    }
   498	    if (obs.startedAtMs === null) {
   499	      // ⓒ 살아있으나 기동시각을 **못 읽음**(권한/파싱) → '다른 프로세스'라고 단정할 수 없다. 여기서 회수로 내려가면
   500	      //   살아있는 supervisor 의 제 세션을 죽인다 — 그래서 **wait**(safe direction: 못 읽음 ≠ 불일치). PID 재사용 판정은
   501	      //   기동시각이 **읽혔고 실제로 달랐을 때만** 성립한다(아래 ⓑ). 이게 HIGH 결함의 처방(옛 2갈래는 이 경우를 흘렸다).
   502	      return {
   503	        action: "wait",
   504	        reason: "owner pid 살아있으나 기동시각 못 읽음(권한/파싱) — 신원 확인 불가라 회수 보류(safe direction: 살아있는 owner 세션을 뺏지 않는다)",
   505	      };
   506	    }
   507	    // ⓑ 기동시각이 읽혔고 진짜로 다르다 = PID 재사용(무관 프로세스). 아래 고아 회수로 내려간다.
   508	  }
   509	  // not-our-supervisor(ⓑ PID 재사용 또는 ⓓ 관측 dead): 원 supervisor 는 사라졌고 세션은 고아 → nonce 검증하 회수로
   510	  //   진행한다. ⓑ 의 살아있는 그 pid 는 무관한 프로세스라 절대 신호하지 않는다(evaluateReap 은 세션 pgid 만 다룬다 —
   511	  //   supervisor pid 신호는 데몬의 별개 경로). 여기 도달 = alive===false 이거나 (alive && 기동시각 읽힘 && 불일치).
   512	  const ownerNote = obs.alive === false
   513	    ? "owner dead"
   514	    : "owner PID 재사용(기동시각 불일치) — not-our-supervisor";
   515	
   516	  // 2. terminal 정리.
   517	  if (entry.state === "reaped") {
   518	    return { action: "gc", reason: `이미 reaped — 엔트리 정리(${ownerNote})` };
   519	  }
   520	
   521	  // 3. live/leaked — pgid 알려짐.
   522	  if (entry.state === "live" || entry.state === "leaked") {
   523	    const pgid = entry.pgid;
   524	    if (pgid === undefined || !Number.isInteger(pgid) || pgid <= 1) {
   525	      // 스키마상 도달 불가(parse/register 가 막는다)지만, 손상 원장 방어 — 유효 pgid 없이는 신호하지 않는다.
   526	      return { action: "refuse", reason: `state=${entry.state} 인데 유효 pgid 부재(손상 엔트리) — 신호 거부(${ownerNote})` };
   527	    }
   528	    const members = procView.groupMembers(pgid);
   529	    if (members.length === 0) {
   530	      // ESRCH — 그룹이 이미 소멸했다. 회수할 게 없으니 정리(gc). (pgid 재사용 위험은 여기 없다 — 없는 그룹이다.)
   531	      return { action: "gc", reason: `pgid=${pgid} 그룹 부재(ESRCH·이미 소멸) — 정리(${ownerNote})` };
   532	    }
   533	    // nonce 검증 — 구성원 중 하나라도 exec-env 에 우리 nonce 를 지녔거나, scanByEnv 가 이 pgid 를 돌려주면 우리 그룹.
   534	    const verified =
   535	      members.some((pid) => procView.execEnvHas(pid, SESSION_NONCE_ENV, entry.nonce)) ||
   536	      procView.scanByEnv(SESSION_NONCE_ENV, entry.nonce).includes(pgid);
   537	    if (verified) {
   538	      // nonce 를 **동봉**한다 — 데몬이 kill(-pgid) 직전에 이 값으로 재검증해 판정→신호 사이 PID 재사용 창을 좁힌다
   539	      //   (여기 verified 는 '판정 시점' 검증일 뿐, '신호해도 됨'의 최종 보증이 아니다 · 헤더 daemon-MUST 참조).
   540	      return { action: "kill", pgid, nonce: entry.nonce, reason: `nonce 일치 확인 — 그룹(${pgid}) 회수(${ownerNote})` };
   541	    }
   542	    // ★ PID 재사용 안전 케이스 ★ — pgid 는 살아있으나 그 그룹의 exec-env 에 우리 nonce 가 **없다**. 커널이 이 pgid
   543	    //   숫자를 무관한 다른 그룹에 재배정했다는 뜻이다. 맨몸 pgid 를 믿고 신호하면 **엉뚱한 프로세스를 죽인다** —
   544	    //   그래서 **거부**한다. 이 한 줄이 옛 raw-PID 하트비트가 못 막던 재앙을 닫는다.
   545	    return {
   546	      action: "refuse",
   547	      reason: `nonce 불일치 — pgid=${pgid} 는 재사용된 무관 그룹(exec-env 에 우리 nonce 없음) → 신호 거부(무관 프로세스 오kill 방지)`,
   548	    };
   549	  }
   550	
   551	  // 4. spawning — pgid 미확정(register-lag 창). nonce 로 스캔해 그룹을 찾는다.
   552	  const found = procView.scanByEnv(SESSION_NONCE_ENV, entry.nonce);
   553	  if (found.length > 0) {
   554	    // 스캔은 **발견(discovery) 전용**이다 — 우리 nonce 를 지닌 그룹을 '찾았다'는 사실이 nonce-free kill 을 허락하지
   555	    //   않는다. 데몬은 동봉된 nonce 로 **발견된 각 pgid 를 신호 직전 재검증**한 뒤에만 회수한다(판정≠신호 · 재사용 창
   556	    //   최소화 · 헤더 daemon-MUST 참조). 스캔 결과를 '검증 완료'로 오독하지 말 것.
   557	    return {
   558	      action: "scan-then-kill",
   559	      nonce: entry.nonce,
   560	      pgids: found,
   561	      reason: `spawning: nonce 스캔이 그룹(${found.join(",")}) 발견(discovery) — 신호 직전 pgid별 nonce 재검증 후 회수(${ownerNote})`,
   562	    };
   563	  }
   564	  // 못 찾음 — killAt+여유를 넘겼으면 그 의도는 결국 아무 그룹도 안 낳았다고 보고 정리(gc). 아직 창 안이면 대기(wait).
   565	  if (supervisorState.nowMs >= entry.killAtMs + REGISTER_LAG_MARGIN_MS) {
   566	    return {
   567	      action: "gc",
   568	      reason: `spawning: nonce 스캔 무발견 + killAt+${REGISTER_LAG_MARGIN_MS}ms 초과 — 미발생 의도 정리(${ownerNote})`,
   569	    };
   570	  }
   571	  return {
   572	    action: "wait",
   573	    reason: `spawning: nonce 스캔 무발견이나 아직 register-lag 창 안(killAt+여유 이전) — 대기(${ownerNote})`,
   574	  };
   575	}

