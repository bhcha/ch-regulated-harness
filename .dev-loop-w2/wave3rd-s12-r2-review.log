   161	  test("snapshot 은 내구 상태의 읽기전용 복사(원장 내부를 노출하지 않는다)", () => {
   162	    const fake = makeFakeIo();
   163	    const led = createLedger(HB, SUP, fake.io, { now: makeClock().now, nonceGen: makeNonceGen(["N1"]) });
   164	    led.intent("main", KILL_AT);
