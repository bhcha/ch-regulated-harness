   124	/**
   125	 * BridgeGenExecutor — 셸을 직접 띄우지 않고 pending 잡 파일을 적재한 뒤, 소비자(운영자 Claude Code 세션 ·
   126	 *   후속의 무인 데몬)가 세션 내(insession) 생성으로 전이시키기를 next-action 폴링으로 기다린다(전이 감지 시 resolve).
   127	 *   무한 대기 금지 — timeoutMs 초과 시 명확한 Error. 파일 기록만(state 직접쓰기 0).
   128	 *
   129	 * 프로토콜 v2 에서 봇 몫(chat-dual-surface-plan 3절 — 큐·커널 로직은 그대로, 봇 변경은 additive):
   130	 *   · 적재하는 잡에 `expires_at`(= 적재시각 + timeoutMs) 을 싣는다 — 봇의 폴링 마감과 **같은 값**이다(이중 시계 금지).
   131	 *   · 대기 상한 초과 시 아직 pending 인 **자기 잡을 회수**한다(나중 소비자가 봇 몰래 되살리는 창을 닫는다).
   132	 *   · 회수 실패(이미 클레임됨) = 늦은 성공이 가능하다는 뜻 → 그 화해는 실패 카드의 [상태 다시 확인] 버튼이 한다
   133	 *     (보증 3분법의 봇 몫 — 봇은 소비자를 죽일 수 없으므로 UX 로 닫는다).
   134	 *   · 회수 성공 = 요청이 사라졌다는 뜻(core 는 그대로 생성 차례) → [상태 다시 확인]이 그 사실을 확인하고 [다시 만들기]
   135	 *     카드를 낸다(flow.presentationForStatusCheck). 그 클릭은 옛 잡 부활이 아니라 이 실행기를 다시 타는 **새 요청**이다.
   136	 *   · **회수 실패 = 적재 금지**: 그 '새 요청'이 무조건 적재되면, 옛 잡을 집은 소비자와 새 잡을 집을 소비자가 같은
   137	 *     런을 동시에 쓴다(이중 소비 · 이중 과금). 그 차단은 **적재 그 자체**가 한다 — `enqueueJob`(원자 대체)이
   138	 *     '옛 잡 내리기(unlink) → 산 클레임 조회 → 배타 생성'을 한 걸음처럼 수행하고, 막을 사정이면 아무것도 쓰지 않고
   139	 *     ok=false 를 낸다. 이 실행기는 그 결과를 사람의 문구로 옮길 뿐 스스로 검사·보상하지 않는다(판정 SSoT 는 하나다).
   140	 *
   141	 * ⚠ 옛 설계(check → write → re-check → 보상)는 폐기됐다: 검사와 적재가 두 걸음이라 그 사이에 옛 잡이 집히는 창이
   142	 *   남았고, 보상(우리 잡 회수)은 제 자신도 실패할 수 있었다. 지금은 그 창의 **전제**(집을 수 있는 옛 잡)가 적재
   143	 *   1단계에서 사라진다 — 근거는 job-protocol.enqueueJob 주석이 SSoT.
   144	 */
   145	export class BridgeGenExecutor implements GenExecutor {
   146	  private readonly readNext: (rid: string) => Promise<NextAction>;
   147	  private readonly jobsPendingDir: string;
   148	  private readonly jobsClaimedDir: string;
   149	  private readonly pollIntervalMs: number;
   150	  private readonly timeoutMs: number;
   151	  private readonly sleep: (ms: number) => Promise<void>;
   152	  private readonly now: () => number;
   153	  constructor(deps: BridgeDeps = {}) {
   154	    this.readNext = deps.readNext ?? defaultReadNextAction;
   155	    this.jobsPendingDir = deps.jobsPendingDir ?? storagePaths().jobsPending;
   156	    this.jobsClaimedDir = deps.jobsClaimedDir ?? storagePaths().jobsClaimed;
   157	    this.pollIntervalMs = deps.pollIntervalMs ?? 3000;
   158	    this.timeoutMs = deps.timeoutMs ?? bridgeTimeout();
   159	    this.sleep = deps.sleep ?? defaultSleep;
   160	    // 주입 없으면 Date.now — 애플리케이션 런타임 코드라 사용 가능(Workflow 스크립트 아님).
   161	    this.now = deps.now ?? (() => Date.now());
   162	  }
   163	
   164	  async execute(run_id: string, stage: string): Promise<void> {
   165	    assertGenArgs(run_id, stage);
   166	    // ★ check-first: 요청한 stage 가 더 이상 현재 생성 대상이 아니면(중복 클릭·이미 다음 단계로 진행) pending
   167	    //   파일을 쓰지 않고 즉시 반환. 안 그러면 아무도 소비 안 하는 stale 잡 파일이 남아 엉뚱한 게이트에 처리될 수 있다.
   168	    if (this.transitioned(await this.readNext(run_id), stage)) return;
   169	    // ★ 이중 소비 차단 = 적재 그 자체(원자 대체). 검사와 적재가 갈라져 있지 않으므로 '그 사이'가 없다 —
   170	    //   막을 사정이면 아무것도 쓰이지 않은 채 ok=false 로 돌아온다(보상할 것도 없다).
   171	    const res = await enqueueJob(
   172	      { pending: this.jobsPendingDir, claimed: this.jobsClaimedDir },
   173	      { run_id, stage, timeoutMs: this.timeoutMs },
   174	      { now: this.now },
   175	    );
   176	    if (!res.ok) {
   177	      // 두 사정을 뭉개지 않는다: 산 클레임을 **본** 것과, 못 봤을 뿐 **없다고 말할 수 없는** 것은 다르다.
   178	      //   후자에 "만들고 있어요"라고 답하면 모르는 것을 아는 척하는 것이다(둘 다 fail-closed 인 건 같다).
   179	      throw new GenerationInProgressError(res.reason === "in_progress" ? MSG_ALREADY_IN_PROGRESS : MSG_CANNOT_TELL);
   180	    }
   181	    const job = res.job;
   182	    // 종단 마감 단일 원천(프로토콜 v2): 봇의 폴링 마감을 **잡 파일에 실린 그 값**에서 읽는다 — 따로 재면 봇이
   183	    //   포기한 뒤에도 소비자가 '아직 안 늦었다'고 보는 어긋남이 생긴다.
   184	    const deadline = parseDeadline(job);
   185	    if (deadline === null) {
   186	      // buildGenerateJob 이 만든 잡이라 도달 불가. 조용히 지어낸 마감으로 폴링하느니 드러낸다(마감은 보증의 뿌리다).
   187	      throw new Error(`적재한 잡에 마감이 없습니다(run=${run_id}, stage=${stage}) — 프로토콜 위반.`);
   188	    }
   189	    for (;;) {
   190	      const na = await this.readNext(run_id);
   191	      // ⚠ 순서 주의(의도): 마감 검사보다 **전이 검사가 먼저**다. 마감이 지난 뒤에 본 전이라도 그건 '실제로 된 것'이라
   192	      //   성공으로 보고한다 — 우리 타이머가 지났다는 이유로 끝난 일을 실패로 알리면 카드가 사실과 어긋난다.
   193	      //   (봇이 이미 포기해 실패 카드를 띄운 뒤의 늦은 전이는 이 루프 밖의 일이라 [상태 다시 확인]이 맡는다.)
   194	      if (this.transitioned(na, stage)) {
   195	        await this.cleanupPendingJob(run_id, stage); // 전이 완료 → 남은 pending 파일 정리(stale 방지)
   196	        return; // 생성 완료 → 게이트 도달
   197	      }
   198	      if (this.now() >= deadline) {
   199	        // 봇 타임아웃 = 회수: 아직 pending 인 **자기 잡**만 거둬들인다(job_id 대조 — 같은 단계로 새로 적재된
   200	        //   잡이 있으면 그건 남의 요청이라 손대지 않는다). 이미 클레임됐으면 회수 실패 → 늦은 성공이 가능하다.
   201	        const recalled = await recallPendingJob(this.jobsPendingDir, job);
