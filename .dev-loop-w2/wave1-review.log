   623	      if (!isEnoent(e)) return { ok: false, reason: "unknown" };
   624	    }
   625	    // 2) 산 클레임 조회 — 여기서 보이는 것은 '1) 전에 이미 성립한 클레임' 전부다(위 ㉮).
   626	    let blocking: ClaimedJobRef | null;
   627	    try {
   628	      blocking = await findBlockingClaimedJob(dirs.claimed, input.run_id, input.stage, deps.now());
   629	    } catch {
   630	      return { ok: false, reason: "unknown" }; // 조회 실패 = 판정 불가 → fail-closed.
   631	    }
   632	    if (blocking) return { ok: false, reason: "in_progress" };
   633	    // 3) 배타 생성 — 이겼으면 대기줄의 그 이름은 우리 잡 하나뿐이다.
   634	    if (await create(dirs.pending, dest, job)) return { ok: true, job, path: dest };
   635	  }
   636	  // 2회째 EEXIST — 단일 적재자 전제가 깨졌다(누가 계속 같은 이름을 만든다). 배제하지 못했으니 막는다.
   637	  return { ok: false, reason: "unknown" };
   638	}
   639	
   640	// ── 소비자 진입점(집기) ────────────────────────────────────────────────────────
   641	
   642	/** 잡 1건을 집으려는 시도의 결과. */
   643	export type TakeAction =
   644	  | "claimed" /** 2중 검사 통과 + rename 승리 → 이 소비자가 일한다(path 는 claimed 경로) */
   645	  | "lost" /** 경합 패배·이미 사라짐 — 다른 소비자 몫(조용히 넘어간다) */
   646	  | "failed" /** 만료·형식 오류 → failed/ 격리(+ .reason) */
   647	  | "dropped" /** 전이 완료 → 잡 삭제(할 일이 이미 끝났다) */
   648	  | "skipped"; /** 레거시(미클레임) · 판단 불가(복귀) — 일감으로 삼지 않는다 */
   649	
   650	export interface TakeResult {
   651	  action: TakeAction;
   652	  reason: JobCheckReason;
   653	  /** action="claimed" 일 때의 claimed 경로. */
   654	  path?: string;
   655	  detail?: string;
   656	}
   657	
   658	export interface TakeDeps extends DoubleCheckDeps {
   659	  dirs: JobDirs;
   660	  /** 이 소비자의 id(= `claimed/<consumerId>/` 디렉터리명 · 안전 토큰). */
   661	  consumerId: string;
   662	}
   663	
   664	/**
   665	 * **소비자 1급 경로** — pending 잡 1건을 집어 2중 검사를 걸고 그 결과대로 처분한다(사람 소비자도 같은 규약을 손으로 따른다):
   666	 *   통과 → 그대로 보유(작업) · 만료 → failed/ · 전이완료 → 삭제 · 레거시/판단불가 → 대기줄 복귀.
   667	 *   검사 실패 잡을 그냥 두지 않고 **처분까지** 하는 이유: 남겨두면 다음 회차마다 같은 검사·spawn 을 되풀이하고
   668	 *   사람 눈에도 '대기 중'으로 보인다(큐가 거짓말을 한다).
   669	 *
   670	 * ★ 순서가 핵심 — **먼저 집고(claim), 집은 것을 검사한다.** 반대로 하면(검사 후 집기) 검사한 잡과 집은 잡이 다를 수
   671	 *   있다: rename 은 잡이 아니라 **경로**를 집는데, 그 사이 같은 이름으로 새 잡이 들어올 수 있기 때문이다. 그러면
   672	 *   ㉠ 검사 안 한 잡을 들고 일하거나 ㉡ 멀쩡한 새 잡을 남의 판정으로 failed/ 에 처박는다. 소유한 뒤 검사하면 검사
   673	 *   대상과 처분 대상이 같음이 보장되고(경합 패배자는 아무것도 만지지 않는다), 느린 next-action 조회 동안 예산이
   674	 *   닳는 문제도 같이 사라진다(검사 시각이 소유 이후다).
   675	 *   예외 하나 — **v1 레거시는 집지도 않는다**: 마감이 없다는 건 파일만 보고 알 수 있고(셸 0), 집었다 되돌리면 사람이
   676	 *   손으로 소비 중인 파일을 매 회차 흔들게 된다(contract: 레거시는 사람 몫).
   677	 */
   678	export async function takePendingJob(job: GenerateJobFile, deps: TakeDeps): Promise<TakeResult> {
   679	  assertJobArgs(job.run_id, job.stage);
   680	  // 0) 순수 사전 필터(파일만 보고 판단 · fs 접촉 0): 레거시 잡은 애초에 집지 않는다.
   681	  if (parseDeadline(job) === null) {
   682	    return { action: "skipped", reason: "no_deadline", detail: "expires_at 미기재(v1 레거시 잡) — 사람 소비자 몫" };
   683	  }
   684	  // 1) 집는다(경합의 승자는 OS 가 정한다).
   685	  const path = await claimJob(deps.dirs, job, deps.consumerId);
   686	  if (path === null) return { action: "lost", reason: "ok" };
   687	  try {
   688	    // 2) 집은 **실물**을 읽는다 — 검사도 처분도 이 실물에 대해서만 한다(목록의 잡은 '뭔가 있다'는 힌트일 뿐).
   689	    const mine = await readJobFile(path);
   690	    if (!mine) {
   691	      await failJob(deps.dirs, path, "잡 파일을 읽을 수 없음(형식 오류)");
   692	      return { action: "failed", reason: "unreadable", detail: "잡 파일 형식 오류" };
   693	    }
   694	    // 3) 2중 검사 → 처분. 판정 불가·레거시면 되돌린다(버리지 않는다 — 다음 회차·사람이 다시 본다).
   695	    const check = await doubleCheckJob(mine, deps);
   696	    const detail = check.detail ? { detail: check.detail } : {};
   697	    if (check.ok) return { action: "claimed", reason: "ok", path };
   698	    if (check.reason === "expired") {
   699	      await failJob(deps.dirs, path, check.detail ?? "만료(expires_at 초과)");
   700	      return { action: "failed", reason: check.reason, ...detail };
   701	    }
   702	    if (check.reason === "transitioned") {
   703	      await completeJob(path); // 이미 됐다 → 재실행 금지.
   704	      return { action: "dropped", reason: check.reason, ...detail };
   705	    }
   706	    // no_deadline(사전 필터 뒤 바뀐 경우) · unreadable — **아직 일을 시작하기 전**이라 되돌려도 아무도 두 번 일하지
   707	    //   않는다(releaseJob 의 W4 계약이 허용하는 유일한 자리). 세션이 뜬 뒤라면 여기서도 complete/fail 만 했어야 한다.
   708	    await releaseJob(deps.dirs, path);
   709	    return { action: "skipped", reason: check.reason, ...detail };
   710	  } catch (e) {
   711	    // 소유한 채 판단·처분에 실패하면(IO 오류 등) 대기줄로 되돌리고 예외를 올린다. 안 그러면 그 잡은 살아 있는
   712	    //   소비자의 claimed/ 에 갇힌다 — reaper 는 산 소비자의 클레임을 건드리지 않으므로 재기동 전까지 아무도 못 집는다
   713	    //   (고아가 아니라 '실종'이라 더 나쁘다). 되돌리기 실패는 삼킨다 — 원래 원인을 가리면 안 된다.
   714	    await releaseJob(deps.dirs, path).catch(() => {});
   715	    throw e;
   716	  }
   717	}
   718	
   719	// ── reaper(마감 지난 클레임 뒷정리) ────────────────────────────────────────────
   720	
   721	export interface ReapDeps {
   722	  dirs: JobDirs;
   723	  /** 현재시각(ms) — 주입(테스트 결정성). */
   724	  now: () => number;
   725	  /** next-action 조회(읽기 전용) — **마감이 지난** 클레임의 처분(뒷정리냐 만료 격리냐)만 가른다. */
   726	  readNext: (rid: string) => Promise<NextAction>;
   727	}
   728	
   729	export interface ReapResult {
   730	  path: string;
   731	  consumer: string;
   732	  /**
   733	   * leased    = 마감이 남았다 → **불가침**(손대지 않는다)
   734	   * completed = 마감 지남 + 이미 전이됨 → 잡 삭제(뒷정리)
   735	   * failed    = 마감 지남 + 아직 그 단계 생성 차례 → failed/ 격리(+.reason) · 깨진 잡 파일도 여기
   736	   * skipped   = v1(마감 미기재) · 판단 불가(next-action 조회 실패) → 손대지 않는다
   737	   */
   738	  action: "leased" | "completed" | "failed" | "skipped";
   739	  reason: JobCheckReason | "leased";
   740	  detail?: string;
   741	}
   742	
   743	/**
   744	 * 기동 reaper — `claimed/<소비자>/` 를 훑어 **마감이 지난** 클레임만 뒷정리한다. 처분은 마감(리스)이 정한다:
   745	 *
   746	 *   | 클레임 상태              | 처분                                                |
   747	 *   |--------------------------|-----------------------------------------------------|
   748	 *   | 마감이 남음              | **불가침**(leased) — 하트비트를 묻지도 않는다        |
   749	 *   | 마감 지남 + 전이 완료    | 삭제(completed) — 이미 끝난 일의 흔적만 치운다       |
   750	 *   | 마감 지남 + 아직 그 차례 | failed/ 격리(failed) — **재큐하지 않는다**           |
   751	 *   | 마감 미기재(v1)          | 보고만(skipped) — 생사를 알 수 없는 것에 손대지 않는다 |
   752	 *
   753	 * ★ **생사 추정은 펜스가 아니다**(이 재작성의 이유). 옛 구현은 `isConsumerAlive()===false` 를 '죽음'으로 믿고 잡을
   754	 *   재큐했는데, **하트비트 정지 ≠ 죽음**이다(멈췄다 재개하는 소비자 · 느린 소비자 · 하트비트만 끊긴 소비자). 그
   755	 *   추정이 한 번 틀리면 원 소비자와 재큐된 잡을 집은 새 소비자가 **같은 런을 동시에 쓴다** — 이중 소비를 막아야 할
   756	 *   reaper 가 그 원천이 된다. 그래서 판정 근거를 '누가 살아 있나'(추정)에서 **'마감이 남았나'(파일에 박힌 사실)** 로
   757	 *   바꿨다. 적재 차단(findBlockingClaimedJob)이 쓰는 규칙과 **같은 규칙**이다 — 한 잡의 생사를 두 곳이 다르게
   758	 *   판정하면 한쪽이 반드시 틀린다. (하트비트는 폐기가 아니라 **강등**이다: W4 의 관측성·로그 몫이지 처분 근거가 아니다.)
   759	 *
   760	 * ★ **재큐를 버린 이유**: 되돌린 잡에는 새 마감이 필요한데 마감을 발행하는 자는 봇뿐이다(마감 단일 원천). reaper 가
   761	 *   마감을 지어내면 그 잡의 마감과 봇의 대기 마감이 갈라진다. 게다가 정규 복구 경로가 **이미 있다** — 만료된 클레임은
   762	 *   적재를 막지 않으므로(위와 같은 규칙) 봇의 자동 이어가기·[다시 만들기] 가 **새 마감을 단 새 잡**을 적재한다.
   763	 *   reaper 가 할 일은 큐가 거짓말하지 않게 흔적을 치우는 것뿐이다.
   764	 *
   765	 * ⚠ 예산(budgetMs·startupMarginMs)을 받지 않는다: 예산은 '지금 시작해서 끝낼 수 있나'를 묻는 값인데 reaper 는
   766	 *   **아무에게도 일을 주지 않는다**(재큐 없음). 물을 것이 없으므로 요구하지 않는다.
   767	 * ⚠ 호출 순서 규약: 소비자는 **기동 시 이 reaper 를 먼저 돌린 뒤 폴링을 시작한다**. 지난 생의 고아
   768	 *   (`claimed/<자기 id>/`)를 남겨 둔 채 새로 집으면 같은 이름의 클레임을 자기가 덮어써 그 기록을 잃는다.
   769	 */
   770	export async function reapClaimedJobs(deps: ReapDeps): Promise<ReapResult[]> {
   771	  // 시각은 pass 당 **한 번**만 읽는다: 스캔 도중 시계가 흐르면 같은 리스가 파일마다 다르게 판정된다(어중간한 상태).
   772	  //   스냅샷이 낡아 봐야 방금 만료된 리스를 'leased'(불가침)로 볼 뿐이라 늘 안전한 쪽으로 틀린다 — 다음 pass 가 치운다.
   773	  const nowMs = deps.now();
   774	  let consumers: string[];
   775	  try {
   776	    consumers = (await readdir(deps.dirs.claimed, { withFileTypes: true }))
   777	      .filter((d) => d.isDirectory())
   778	      .map((d) => d.name)
   779	      .sort();
   780	  } catch (e) {
   781	    if (isEnoent(e)) return []; // claimed/ 없음 = 고아 없음.
   782	    throw e; // 권한·IO 오류를 '고아 없음'으로 위장하지 않는다.
   783	  }
   784	  const out: ReapResult[] = [];
   785	  for (const consumer of consumers) {
   786	    const dir = join(deps.dirs.claimed, consumer);
   787	    // ENOENT = 그 사이 비워짐(정상). 그 외 오류는 '잡 없음'으로 위장하지 않고 올린다.
   788	    const names = (
   789	      await readdir(dir).catch((e: unknown) => {
   790	        if (isEnoent(e)) return [] as string[];
   791	        throw e;
   792	      })
   793	    ).sort();
   794	    for (const name of names) {
   795	      if (name.startsWith(".") || !name.endsWith(".json")) continue;
   796	      const path = join(dir, name);
   797	      const job = await readJobFile(path);
   798	      if (!job) {
   799	        // 깨진 잡 파일 = 마감을 읽을 수 없다 = 리스를 존중할 근거도 없다 → 사람이 보게 failed/ 로(큐에 남겨
   800	        //   되풀이 읽지 않는다). 리스 존중의 예외지만 안전하다: 읽을 수 없는 파일은 소비자도 일감으로 삼지 못한다.
   801	        await failJob(deps.dirs, path, "잡 파일을 읽을 수 없음(형식 오류)");
   802	        out.push({ path, consumer, action: "failed", reason: "unreadable", detail: "잡 파일 형식 오류" });
   803	        continue;
   804	      }
   805	      const deadlineMs = parseDeadline(job);
   806	      if (deadlineMs === null) {
   807	        // v1 레거시 — 마감이 없으니 리스가 살았는지 죽었는지 **알 수 없다**. 모르는 것에 손대지 않는다(사람 몫).
   808	        //   옛 구현은 이걸 대기줄로 되돌렸는데, 사람이 손으로 소비 중인 파일을 매 pass 마다 흔드는 짓이었다.
   809	        out.push({
   810	          path,
   811	          consumer,
   812	          action: "skipped",
   813	          reason: "no_deadline",
   814	          detail: "expires_at 미기재(v1 레거시 잡) — 생사 판정 불가 · 사람 소비자 몫",
   815	        });
   816	        continue;
   817	      }
   818	      if (deadlineMs > nowMs) {
   819	        // 리스가 살아 있다 → **불가침**. 하트비트가 끊겼든 말든 그 소비자는 마감까지 일할 권리가 있다
   820	        //   (적재 차단과 같은 규칙 — findBlockingClaimedJob).
   821	        out.push({ path, consumer, action: "leased", reason: "leased" });
   822	        continue;
   823	      }
   824	      // 마감 지남 — 규약상 아무도 마감 뒤엔 일하지 않는다(2중 검사 ㉠). 남은 물음은 '뒷정리냐 만료 격리냐' 하나뿐이라
   825	      //   여기서만 next-action 을 부른다(산 리스에는 셸 비용을 쓰지 않는다).
   826	      let na: NextAction;
   827	      try {
   828	        na = await deps.readNext(job.run_id);
   829	      } catch (e) {
   830	        const msg = e instanceof Error ? e.message : String(e);
   831	        // 조회 실패 = 판단 불가 → 손대지 않는다(다음 pass 재시도). 조회 실패로 잡을 처분하지 않는다.
   832	        out.push({ path, consumer, action: "skipped", reason: "unreadable", detail: `next-action 조회 실패: ${msg}` });
   833	        continue;
   834	      }
   835	      if (!isGenerateTurn(na, job.stage)) {
   836	        await completeJob(path); // 늦게라도 전이됐다 → 다 끝난 일의 흔적만 치운다.
   837	        out.push({
   838	          path,
   839	          consumer,
   840	          action: "completed",
   841	          reason: "transitioned",
   842	          detail: `그 단계 생성 차례가 아님(현재 step=${String(na.step)} stage=${na.stage ?? "-"})`,
   843	        });
   844	        continue;
   845	      }
   846	      // 마감이 지났는데 전이도 안 됐다 = 그 소비자는 못 끝냈다. **재큐하지 않는다** — 되돌린 잡엔 새 마감이 필요한데
   847	      //   마감은 봇만 발행한다. 복구는 새 요청(새 마감)의 몫이고, 만료된 이 클레임은 그 적재를 막지 않는다.
   848	      await failJob(
   849	        deps.dirs,
   850	        path,
   851	        `만료(마감 ${String(job.expires_at)} · 지금 ${new Date(nowMs).toISOString()}) — 마감까지 전이되지 않음`,
   852	      );
   853	      out.push({
   854	        path,
   855	        consumer,
   856	        action: "failed",
   857	        reason: "expired",
   858	        detail: "마감이 지난 채 전이되지 않음 — 재큐하지 않는다(새 요청이 새 마감을 받는다)",
   859	      });
   860	    }
