   457	describe("findBlockingClaimedJob — 산 클레임이 있으면 새 잡을 적재하지 못하게 한다", () => {
   458	  /** 잡 1건을 c1 이 집은 상태로 만든다(= claimed/c1/<rid>-<stage>.json). */
   459	  async function claimed(job: GenerateJobFile = newJob(), consumer = "c1"): Promise<string> {
   460	    await writePendingJob(dirs.pending, job);
   461	    return (await claimJob(dirs, job, consumer))!;
   462	  }
   463	  const find = (nowMs = T0, run_id = "run-1", stage = "brief"): Promise<unknown> =>
   464	    findBlockingClaimedJob(dirs.claimed, run_id, stage, nowMs);
   465	
   466	  it("★ 마감이 남은 클레임 → 막는다(누가 집었는지·언제까지인지와 함께)", async () => {
