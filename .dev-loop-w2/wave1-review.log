   731	    const p = await claimedBy(); // 마감 T0+900초 · 지금 T0
   732	    const r = await reapClaimedJobs(reapDeps());
   733	    expect(r).toEqual([{ path: p, consumer: "c1", action: "leased", reason: "leased" }]);
   734	    expect(await exists(p)).toBe(true); // 그 소비자는 마감까지 일할 권리가 있다
   735	    expect(await ls(dirs.pending)).toEqual([]); // ★ 재큐 없음(옛 동작: '죽었으니 released' → 이중 소비의 원천)
