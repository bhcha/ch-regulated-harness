   553	  function okOf(r: EnqueueResult): Extract<EnqueueResult, { ok: true }> {
   554	    if (!r.ok) throw new Error(`적재가 성공했어야 한다(reason=${r.reason})`);
   555	    return r;
   556	  }
   557	  /** 그 잡을 소비자가 집은 상태로 만든다(= claimed/<consumer>/…). */
   558	  async function claimedBy(j: GenerateJobFile, consumer = "c1"): Promise<void> {
   559	    await writePendingJob(dirs.pending, j);
   560	    await claimJob(dirs, j, consumer);
