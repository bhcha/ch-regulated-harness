   347	/**
   348	 * 무인 워커 시간 설정의 정합 검사 — `sdkGenTimeout() + 기동 여유 ≤ bridgeTimeout()` (계획 5절 기동 검증).
   349	 *   어기면 세션이 예산을 다 쓰기 전에 잡이 먼저 만료된다 = 완주한 산출물이 버려지고 운영자는 이유를 모른다.
   350	 *
   351	 * **던지지 않고 결과를 돌려준다**(순수 검사기) — 기동 배선은 W4(소비자 데몬)의 몫이고, 여기서 throw 하면
   352	 *   이 값을 안 쓰는 다른 경로(봇 등)까지 config 를 읽다 죽는다. 부르는 쪽이 언제 멈출지 정한다.
   353	 */
   354	export interface WorkerTimeoutCheck {
   355	  ok: boolean;
   356	  /** ok=false 일 때만. 운영자가 무엇을 어떻게 고쳐야 하는지 알려주는 평이한 한국어 사유. */
   357	  reason?: string;
   358	}
   359	export function validateWorkerTimeouts(): WorkerTimeoutCheck {
   360	  const gen = sdkGenTimeout();
   361	  const bridge = bridgeTimeout();
   362	  const needed = gen + WORKER_STARTUP_MARGIN_MS;
   363	  if (needed <= bridge) return { ok: true };
   364	  const sec = (ms: number) => Math.round(ms / 1000);
   365	  return {
   366	    ok: false,
   367	    reason:
   368	      `무인 생성 시간(CHAT_SDK_GEN_TIMEOUT=${sec(gen)}초)에 기동 여유 ${sec(WORKER_STARTUP_MARGIN_MS)}초를 더하면 ` +
   369	      `${sec(needed)}초라, 봇의 대기 상한(CHAT_BRIDGE_TIMEOUT=${sec(bridge)}초)을 넘습니다 — 세션이 다 끝내기 전에 ` +
   370	      `요청이 먼저 만료돼 결과가 버려집니다. CHAT_SDK_GEN_TIMEOUT 을 ${sec(bridge - WORKER_STARTUP_MARGIN_MS)}초 이하로 줄이거나 ` +
   371	      `CHAT_BRIDGE_TIMEOUT 을 ${sec(needed)}초 이상으로 올리세요.`,
   372	  };
   373	}
