   310	    await claim(); // C1 이 집어 작업 중(마감 T0+900초 · 지금 T0)
   311	    const { gen, enqueued } = watchingBridge();
   312	    const err = await gen.execute("run-1", "brief").catch((e: unknown) => e);
   313	    expect(err).toBeInstanceOf(GenerationInProgressError);
   314	    expect((err as Error).message).toBe("이미 만들고 있어요 — 잠시 후 다시 확인해 주세요.");
   315	    // ★ 핵심 단정: 새 잡이 **한 번도** 있은 적 없어야 C2 가 집을 것이 없다(이중 소비의 원천 차단).
   316	    expect(enqueued()).toBeNull();
   317	    expect(await readdir(pendingDir)).toEqual([]);
