   302	        seen = await readJobFile(join(pendingDir, "run-1-brief.json")); // 적재됐나(= C2 가 집을 것이 있나)
   303	        return na("human"); // 전이 → execute 종료
   304	      },
   305	    });
   306	    return { gen, enqueued: () => seen };
   307	  }
