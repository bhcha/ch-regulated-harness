   242	/**
   243	 * 이중 소비 구멍의 회귀 가드 — 시나리오: 소비자 C1 이 잡을 집고 느리게 일하는 동안 봇이 대기 상한에 포기한다.
   244	 *   회수는 `pending/` 만 보므로 실패하고(잡은 claimed/ 에 있다), core 는 그대로 생성 차례라 사람에게 [다시 만들기]가
   245	 *   뜬다. 그 클릭이 **새 잡**을 적재하면 C2 가 집어 C1 과 같은 런을 동시에 쓴다(이중 소비 · 이중 과금).
   246	 *   막는 자리는 **적재 그 자체**다(enqueueJob 의 원자 대체) — 아래는 그 차단이 실행기까지 이어져 있음을 못 박는다.
   247	 *   판정 규칙(마감 남음/지남/미기재·조회 실패)의 근거는 job-protocol 주석이 SSoT 이고, 여기서는 그 결과가 사람에게
   248	 *   가는 문구·적재 여부로 옳게 번역되는지만 본다.
   249	 */
   250	describe("BridgeGenExecutor — 이중 소비 차단(적재가 곧 검사)", () => {
   251	  const T0 = 1_700_000_000_000;
   252	  const TIMEOUT = 900_000;
   253	  let root: string;
   254	  let pendingDir: string;
   255	  let claimedDir: string;
   256	
   257	  beforeEach(async () => {
   258	    root = await mkdtemp(join(tmpdir(), "chat-bridge-dup-"));
   259	    pendingDir = join(root, "pending");
   260	    claimedDir = join(root, "claimed");
   261	    await mkdir(pendingDir, { recursive: true });
   262	  });
   263	  afterEach(async () => {
   264	    await rm(root, { recursive: true, force: true });
   265	  });
   266	
   267	  /** v2 잡 1건(적재 T0 · 마감 T0+900초). over 로 마감·rid·stage 를 갈아끼운다. */
   268	  function job(over: Partial<GenerateJobFile> = {}): GenerateJobFile {
   269	    return {
   270	      ...buildGenerateJob({ run_id: "run-1", stage: "brief", enqueuedAtMs: T0, timeoutMs: TIMEOUT }),
   271	      ...over,
   272	    };
   273	  }
   274	  /** 그 잡을 소비자가 집은 상태로 만든다(= claimed/<consumer>/<rid>-<stage>.json). */
   275	  async function claim(j: GenerateJobFile = job(), consumer = "c1"): Promise<void> {
   276	    await writePendingJob(pendingDir, j);
   277	    await claimJob({ pending: pendingDir, claimed: claimedDir, failed: join(root, "failed") }, j, consumer);
   278	    await rm(join(pendingDir, "run-1-brief.json"), { force: true }); // 집혔으니 대기줄엔 없다(잔재 정리)
   279	  }
