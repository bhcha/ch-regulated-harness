   711	// ── reaper(마감 리스 · 펜스 2) ────────────────────────────────────────────────
   712	/**
   713	 * reaper 의 판정 근거는 **마감(리스)뿐**이다 — 소비자의 생사를 묻지 않는다(하트비트 개념 자체가 없다).
   714	 *   옛 구현은 `isConsumerAlive()===false` 를 죽음으로 믿고 재큐했는데, 하트비트 정지 ≠ 죽음이라 그 추정이 틀리는
   715	 *   순간 원 소비자와 재큐된 잡의 새 소비자가 같은 런을 동시에 썼다. 아래 '재큐 없음' 단정들이 그 회귀 가드다.
   710	
   711	// ── reaper(마감 리스 · 펜스 2) ────────────────────────────────────────────────
   712	/**
   713	 * reaper 의 판정 근거는 **마감(리스)뿐**이다 — 소비자의 생사를 묻지 않는다(하트비트 개념 자체가 없다).
   714	 *   옛 구현은 `isConsumerAlive()===false` 를 죽음으로 믿고 재큐했는데, 하트비트 정지 ≠ 죽음이라 그 추정이 틀리는
   715	 *   순간 원 소비자와 재큐된 잡의 새 소비자가 같은 런을 동시에 썼다. 아래 '재큐 없음' 단정들이 그 회귀 가드다.
   716	 */
   717	describe("reapClaimedJobs — 마감 리스(생사 추정 없음)", () => {
   718	  /** 클레임 1건을 만든다(소비자 c1 이 집은 상태 — 살았는지 죽었는지는 **묻지 않는다**). */
   719	  async function claimedBy(job: GenerateJobFile = newJob()): Promise<string> {
   720	    await writePendingJob(dirs.pending, job);
   721	    return (await claimJob(dirs, job, "c1"))!;
   722	  }
   723	  const reapDeps = (over: Partial<ReapDeps> = {}): ReapDeps => ({
   724	    dirs,
   725	    now: () => T0,
   726	    readNext: async () => na("generate", "brief"),
