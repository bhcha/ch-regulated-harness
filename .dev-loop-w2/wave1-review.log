   331	  const raw = readEnv("CHAT_SDK_STAGES");
   332	  if (!raw) return [];
   333	  const stages = raw
   334	    .split(",")
   335	    .map((s) => s.trim())
   336	    .filter((s) => s.length > 0);
   337	  for (const s of stages) {
   338	    if (!SAFE_STAGE_SEGMENT.test(s)) {
   339	      throw new Error(
   340	        `CHAT_SDK_STAGES 에 안전하지 않은 단계명이 있습니다: "${s}" — 단계명은 영소문자·숫자·하이픈만 쓸 수 있습니다(예: 00a-intake,01-brief).`,
   341	      );
   342	    }
   343	  }
   344	  return stages;
   345	}
