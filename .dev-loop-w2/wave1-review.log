   170	  // tmp 는 '.' 로 시작 — listPendingJobs 가 건너뛴다(반쯤 쓰인 파일이 잡으로 보이지 않게).
   171	  const tmp = join(pendingDir, `.${name}.tmp-${randomUUID()}`);
   172	  await writeFile(tmp, `${JSON.stringify(job, null, 2)}\n`, "utf8");
   173	  await rename(tmp, dest);
   174	  return dest;
   175	}
   176	
   177	/**
   178	 * 잡 파일 읽기 + 최소 형태 검증. **없음(ENOENT)·깨짐·형태 불일치 = null**(모르는 파일은 일감이 아니다).
   179	 *   ⚠ 그 외 fs 오류(EACCES·EIO·EMFILE…)는 **삼키지 않고 던진다**: '일시적으로 못 읽음'과 '내용이 깨졌음'은 다르다.
   180	 *     둘을 뭉뚱그리면 reaper 가 멀쩡한 잡을 디스크 딸꾹질 한 번에 failed/ 로 강등한다(호출부는 재시도해야 한다).
   181	 */
   182	export async function readJobFile(path: string): Promise<GenerateJobFile | null> {
   183	  let text: string;
   184	  try {
   185	    text = await readFile(path, "utf8");
   186	  } catch (e) {
   187	    if (isEnoent(e)) return null; // 없음 = 잡 아님(경합 패배·이미 처분됨).
   188	    throw e; // 읽기 실패 ≠ 깨진 잡 — 호출부가 재시도하게 올린다.
   189	  }
   190	  let parsed: unknown;
   191	  try {
   192	    parsed = JSON.parse(text);
   193	  } catch {
   194	    return null;
   195	  }
   196	  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) return null;
   197	  const j = parsed as Record<string, unknown>;
   198	  if (j.kind !== "generate") return null;
   199	  if (typeof j.run_id !== "string" || !isSafeRunId(j.run_id)) return null;
   200	  if (typeof j.stage !== "string" || !isSafeStage(j.stage)) return null;
   201	  // 미지 필드는 그대로 보존(forward-compat) — 재구성하지 않고 캐스팅만.
   202	  return parsed as GenerateJobFile;
   203	}
   204	
   205	/**
   206	 * pending/ 의 잡 목록(파일명 오름차순 = 결정적 순서). 숨김(tmp)·비-json·형태 불일치는 건너뛴다.
   207	 *   **파일명 규약(`<rid>-<stage>.json`)을 지키는 것만** 잡으로 본다: 하류(takePendingJob·claimJob)가 잡 내용에서
   208	 *   canonical 이름을 다시 만들어 쓰므로, 이름이 어긋난 파일을 잡으로 넘기면 매 회차 '찾을 수 없음'만 되풀이한다.
   209	 */
   210	export async function listPendingJobs(
   211	  pendingDir: string,
   212	): Promise<Array<{ path: string; job: GenerateJobFile }>> {
   213	  let names: string[];
   214	  try {
   215	    names = await readdir(pendingDir);
   216	  } catch (e) {
   217	    if (isEnoent(e)) return []; // 폴더가 아직 없음 = 잡 없음.
   218	    throw e; // 권한·IO 오류를 '빈 큐'로 위장하지 않는다(있는 일감이 조용히 사라진다).
   219	  }
   220	  const out: Array<{ path: string; job: GenerateJobFile }> = [];
   221	  for (const name of names.sort()) {
   222	    if (name.startsWith(".") || !name.endsWith(".json")) continue;
   223	    const path = join(pendingDir, name);
   224	    const job = await readJobFile(path);
   225	    if (!job || jobFileName(job.run_id, job.stage) !== name) continue;
   226	    out.push({ path, job });
   227	  }
   228	  return out;
   229	}
   230	
   231	// ── 2중 검사 ──────────────────────────────────────────────────────────────────
   232	
   233	/**
   234	 * 2중 검사 판정 사유. 소비자(데몬·사람)는 이 값으로 클레임/포기를 가른다:
   235	 *   ok           → 클레임하고 일한다
   236	 *   expired      → 마감까지 남은 시간이 잡 예산+기동 여유에 못 미친다 → failed/ 격리(늦은 성공 창 자체를 없앤다)
   237	 *   transitioned → 그 단계 생성 차례가 아니다(이미 됐거나 다음으로 감) → 잡 삭제(stale 재실행 차단)
   238	 *   no_deadline  → expires_at 미기재(v1 레거시 잡) → 자동 소비 대상 아님(마감을 못 걸어 구조적 보증이 성립 안 함) · 사람 소비자 몫
   239	 *   unreadable   → next-action 조회 실패 → 판단 불가라 손대지 않는다(다음 회차 재시도 — 조회 실패로 잡을 버리지 않는다)
   240	 */
   241	export type JobCheckReason = "ok" | "expired" | "transitioned" | "no_deadline" | "unreadable";
   242	
   243	export interface JobCheck {
   244	  ok: boolean;
   245	  reason: JobCheckReason;
   246	  /** 진단용 상세(로그·failed/ 사유 파일). 사람 카드 문구가 아니다. */
   247	  detail?: string;
   248	}
   249	
   250	/**
   251	 * 검사 ㉠(시간) — 순수. `지금 + 잡 예산 + 기동 여유 ≤ expires_at` 이어야 집는다.
   252	 *   '마감이 아직 안 지났나'가 아니라 '**끝낼 수 있나**'를 본다 — 마감 3초 전에 8분짜리 잡을 시작하면 실패 카드 뒤
   253	 *   늦은 성공이 되기 때문이다(그 창을 시작 전에 없앤다).
   254	 */
   255	export function checkBudget(
   256	  job: GenerateJobFile,
   257	  nowMs: number,
   258	  budgetMs: number,
   259	  startupMarginMs: number,
   260	): JobCheck {
   261	  const deadline = parseDeadline(job);
   262	  if (deadline === null) {
   263	    return { ok: false, reason: "no_deadline", detail: "expires_at 미기재(v1 레거시 잡) — 자동 소비 대상 아님" };
   264	  }
   265	  const need = budgetMs + startupMarginMs;
   266	  const remain = deadline - nowMs;
   267	  if (remain < need) {
   268	    return { ok: false, reason: "expired", detail: `남은 시간 ${remain}ms < 필요 ${need}ms(예산 ${budgetMs} + 기동여유 ${startupMarginMs})` };
   269	  }
   270	  return { ok: true, reason: "ok" };
   271	}
   272	
   273	/**
   274	 * 검사 ㉡(차례) — 지금 이 단계의 생성 차례인가. 봇(브리지)의 전이 감지와 **같은 판정**을 쓴다(이중 진실 금지).
   275	 *   step 은 페이즈 횡단 전역이라 `step==generate` 만 보면 stale 한 brief 잡을 다음 단계(concept)의 차례와 혼동한다
   276	 *   → stage 까지 같아야 '아직 그 잡의 차례'다.
   277	 */
   278	export function isGenerateTurn(na: NextAction, stage: string): boolean {
   279	  return na.step === "generate" && na.stage === stage;
   280	}
   281	
   282	export interface DoubleCheckDeps {
   283	  /** 현재시각(ms) — 주입(테스트 결정성). */
   284	  now: () => number;
   285	  /** 잡 wall-clock 예산(ms) — 소비자가 자기 값을 준다(데몬 = CHAT_SDK_GEN_TIMEOUT · 후속 단계 소유). */
   286	  budgetMs: number;
   287	  /** 기동 여유(ms) — 검사·클레임·세션 spawn 오버헤드 몫. */
   288	  startupMarginMs: number;
   289	  /** next-action 조회(읽기 전용). */
   290	  readNext: (rid: string) => Promise<NextAction>;
   291	}
   292	
   293	/**
   294	 * 2중 검사 — 시간(㉠) 먼저, 차례(㉡) 나중. 순서 주의: ㉠ 이 셸 없이 즉답이라 마감 지난 잡에 next-action spawn 비용을
   295	 *   쓰지 않는다. 둘 다 통과해야만 ok(하나라도 어긋나면 일하지 않는다 — fail-closed).
   296	 *
   297	 * ⚠ ㉠은 ㉡ **뒤에 한 번 더** 본다: ㉡의 next-action 조회는 셸 spawn 이라 수백 ms가 걸릴 수 있고, 그동안 기동 여유가
   298	 *   닳는다. 조회 전 시각으로만 판정하면 '검증할 땐 있던 예산'이 일을 시작할 땐 없다. 재검사는 순수 계산이라 공짜다.
   299	 */
   300	export async function doubleCheckJob(job: GenerateJobFile, deps: DoubleCheckDeps): Promise<JobCheck> {
   301	  const budget = checkBudget(job, deps.now(), deps.budgetMs, deps.startupMarginMs);
   302	  if (!budget.ok) return budget;
   303	  let na: NextAction;
   304	  try {
   305	    na = await deps.readNext(job.run_id);
   306	  } catch (e) {
   307	    const msg = e instanceof Error ? e.message : String(e);
   308	    return { ok: false, reason: "unreadable", detail: `next-action 조회 실패: ${msg}` };
   309	  }
   310	  if (!isGenerateTurn(na, job.stage)) {
   311	    return {
   312	      ok: false,
   313	      reason: "transitioned",
   314	      detail: `그 단계 생성 차례가 아님(현재 step=${String(na.step)} stage=${na.stage ?? "-"})`,
   315	    };
   316	  }
   317	  return checkBudget(job, deps.now(), deps.budgetMs, deps.startupMarginMs); // 조회에 걸린 시간만큼 예산 재확인
   318	}
   319	
   320	// ── 클레임·정리(rename 기반) ───────────────────────────────────────────────────
   321	
   322	/**
   323	 * 클레임 = `rename(pending/X → claimed/<consumer>/X)`. **경합의 승자는 OS 가 정한다**: 동시에 집으면 rename 이
   324	 *   하나만 성공하고 나머지는 원본이 사라져 ENOENT → null(깨끗한 패배). 승자만 그 잡을 만진다.
   325	 * @returns 승자면 claimed 경로, 패자·이미 없어짐이면 null.
   326	 */
   327	export async function claimJob(
   328	  dirs: JobDirs,
   329	  job: GenerateJobFile,
   330	  consumerId: string,
   331	): Promise<string | null> {
   332	  assertConsumerId(consumerId);
   333	  const name = jobFileName(job.run_id, job.stage);
   334	  const destDir = join(dirs.claimed, consumerId);
   335	  await mkdir(destDir, { recursive: true });
   336	  const to = join(destDir, name);
   337	  try {
   338	    await rename(join(dirs.pending, name), to);
   339	    return to;
   340	  } catch (e) {
   341	    if (isEnoent(e)) return null; // 누가 먼저 집었거나 봇이 회수함 — 정상 패배.
   342	    throw e;
   343	  }
   344	}
   345	
   346	/** 성공 = 잡 파일 삭제(수명주기 종료). 이미 없으면 no-op(멱등). */
   347	export async function completeJob(claimedPath: string): Promise<void> {
   348	  try {
   349	    await unlink(claimedPath);
   350	  } catch (e) {
   351	    if (!isEnoent(e)) throw e;
   352	  }
   353	}
   354	
   355	/**
   356	 * 실패 = `failed/X` + 사유 파일(`X.reason`). 부분 성공은 없다 — 실패한 잡은 큐에서 빠지고 사람이 본다.
   357	 *
   358	 * 순서: **잡을 먼저 옮기고 사유를 쓴다.** 반대로 하면(사유 먼저) 사유 파일 경로가 잡보다 먼저 존재해, 같은 잡을
   359	 *   처분하려던 다른 호출이 자기 실패를 정리하며 **승자의 사유 파일을 지운다**(사유 없는 실패 잡). 이 순서면 진 쪽은
   360	 *   아무것도 쓰지 않는다. 남는 위험은 '옮긴 직후 죽어 사유가 안 써지는' 창(µs)뿐이고, 그건 사유 없는 실패 잡 하나로
   361	 *   그친다(파일은 남아 사람이 본다).
   362	 *   ⚠ 검토 이력(㉢): 이 순서는 리뷰에서 **의도적으로 유지**하기로 했다 — 뒤집는 대안이 더 나쁘고(위), 나머지 대안은
   363	 *     값이 더 비싸다(사람 규약 복잡화). 재검토 불필요.
   364	 *   ⚠ 호출 전제: **그 잡을 소유한 상태**(클레임 승자)여야 한다 — takePendingJob 은 클레임 뒤에만 부른다.
   365	 *   ⚠ 알려진 한계: failed 경로도 `<rid>-<stage>` 라, 같은 단계의 잡 둘이 **동시에 살아 있다가 둘 다 실패**하면
   366	 *     나중 것이 앞의 기록을 덮는다(사유가 다른 실패를 가리킬 수 있다). 그 상황 자체가 이미 비정상이고(같은 단계를
   367	 *     두 소비자가 동시에 생성 — core 락·멱등 게이트가 상태는 지킨다), 실패 기록 한 줄의 정확도 문제라 파일명에
   368	 *     job_id 를 붙여 사람 규약(jobs/README 의 `mv … failed/`)을 복잡하게 만드는 대신 이 한계를 남긴다.
   369	 * @returns failed 경로.
   370	 */
   371	export async function failJob(dirs: JobDirs, fromPath: string, reason: string): Promise<string> {
   372	  const name = basename(fromPath);
   373	  await mkdir(dirs.failed, { recursive: true });
   374	  const dest = join(dirs.failed, name);
   375	  await rename(fromPath, dest);
   376	  await writeFile(`${dest}${REASON_SUFFIX}`, `${reason}\n`, "utf8");
   377	  return dest;
   378	}
   379	
   380	/**
   381	 * 클레임 해제 = pending 복귀. **쓰이는 자리는 하나뿐이다 — `takePendingJob` 이 일을 시작하기도 전에 물러설 때**
   382	 *   (레거시·판단 불가·처분 중 IO 오류). 그 시점엔 세션이 없으므로 되돌려도 아무도 두 번 일하지 않는다.
   383	 *
   384	 * ★ **W4 계약(못 박는다): 세션이 뜬 뒤엔 절대 해제하지 않는다 — 그 뒤의 결말은 complete(성공)·fail(실패) 둘뿐이다.**
   385	 *   일하는 중인 세션의 잡을 대기줄에 되돌리면 그 세션과 그 잡을 새로 집는 소비자가 **같은 런을 동시에 쓴다**
   386	 *   (reaper 가 재큐를 버린 이유와 같다 — 되살릴 근거는 늘 '저쪽은 죽었을 것'이라는 추정이고, 추정은 펜스가 아니다).
   387	 * ⚠ reaper 는 이 함수를 쓰지 않는다(마감 리스 — 재큐 개념 자체가 없다).
   388	 *
   389	 * **no-clobber**: 같은 이름의 새 잡이 이미 대기 중이면 그 새 잡(마감이 더 넉넉하다)을 옛 클레임으로 덮지 않고,
   390	 *   이쪽을 버린다(중복 잡 제거). link+unlink 를 쓰는 이유 = rename 은 무조건 덮어써서 '있는지 보고 옮기기'의
   391	 *   경합 창이 생기기 때문(`enqueueJob` 의 배타 생성도 같은 패턴이다).
   392	 * @returns 실제로 복귀시켰으면 true, 새 잡이 있어 버렸으면 false.
   393	 */
   394	export async function releaseJob(dirs: JobDirs, claimedPath: string): Promise<boolean> {
   395	  const name = basename(claimedPath);
   396	  await mkdir(dirs.pending, { recursive: true });
   397	  const dest = join(dirs.pending, name);
   398	  try {
   399	    await link(claimedPath, dest);
   400	  } catch (e) {
   401	    if (!isEexist(e)) throw e;
   402	    await completeJob(claimedPath); // 새 잡이 이미 대기 중 — 고아는 중복이라 버린다.
   403	    return false;
   404	  }
   405	  await completeJob(claimedPath); // 하드링크 성공 → 원본 링크 제거(= 이동 완료).
   406	  return true;
   407	}
   408	
   409	/**
   410	 * 봇 타임아웃 회수 — **자기 잡일 때만** pending 에서 거둬들인다(job_id 대조). 소비자가 이미 클레임했으면(파일 없음)
   411	 *   no-op 이고, 같은 단계로 **새 잡이 다시 적재**됐으면(job_id 다름) 건드리지 않는다 — 남의 요청을 지우면 그 요청이 증발한다.
   412	 *
   413	 * **이 회수는 2차 방어다(1차는 마감 그 자체).** 봇이 타임아웃하는 순간은 정의상 `now ≥ expires_at` 이라, 남아 있는
   414	 *   잡은 이미 만료다 — 어떤 소비자가 집으려 해도 2중 검사 ㉠에 걸려 failed/ 로 간다. 회수는 그 뻔한 결말을 앞당기는
   415	 *   **정리**일 뿐이라 실패해도 안전하다(그래서 읽기 오류도 '회수 못 함'으로 환원한다).
   416	 * ⚠ 읽기-후-삭제라 원자적이지 않다. 창이 좁게 유지되는 근거는 **적재자가 하나**라는 배치 전제다: pending/ 을 쓰는 것은
   417	 *   봇뿐이고(Socket Mode 봇은 워크스페이스당 1 프로세스), 그 잡큐는 run 별 FIFO 라 같은 run 의 다음 생성 잡은 이
   418	 *   execute 가 끝난 **뒤에** 적재된다. job_id 대조는 그 위의 2차 방어다. 봇을 다중화하려면(같은 jobs/ 를 공유하는
   419	 *   2 프로세스) 이 회수도 클레임처럼 rename 기반으로 바꿔야 한다 — 다만 그 배치는 카드·잡 중복부터 깨진다.
   420	 * @returns 실제로 회수했으면 true.
   421	 */
   422	export async function recallPendingJob(pendingDir: string, job: GenerateJobFile): Promise<boolean> {
   423	  const path = join(pendingDir, jobFileName(job.run_id, job.stage));
