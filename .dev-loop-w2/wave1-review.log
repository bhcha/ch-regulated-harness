   230	/**
   231	 * SKILL.md 를 결정론적으로 치환하고 그 산물에서 allow 규칙을 도출한다.
   232	 *
   233	 * @throws 미지원 단계 · 안전하지 않은 rid · 비-절대 coreRoot · 전이 명령이 정확히 1개가 아닌 경우.
   234	 */
   235	export function rewriteSkill(input: RewriteSkillInput): RewrittenSkill {
   236	  const { skillMd, stage, rid, coreRoot } = input;
   237	
   238	  assertSupportedStage(stage);
   239	  if (!isSafeRunId(rid)) {
   240	    throw new Error(
   241	      `run_id 가 안전한 토큰이 아닙니다: '${rid}'. 영숫자·'.'·'_'·'-' 만 허용합니다 ` +
   242	        "(이 값은 allow 규칙 문자열에 그대로 박히므로 공백·셸 메타문자는 경계를 훼손합니다).",
   243	    );
   244	  }
   245	  if (typeof skillMd !== "string" || skillMd.trim() === "") {
   246	    throw new Error(`SKILL.md 원문이 비어있습니다(stage=${stage}) — 읽기는 호출부의 일입니다.`);
   247	  }
   248	  const absRunStage = resolveRunStagePath(coreRoot);
   249	
   250	  // ① 상대 호출 → 절대경로(부록A-10) ② <RUN> → 실제 rid. split/join = 리터럴 전역 치환(정규식 이스케이프 불필요).
   251	  //   치환은 **문서 전체**에 적용한다(산문의 안내 명령도 절대경로가 돼야 거짓말이 되지 않는다).
   252	  //   선별은 아래 '규칙 도출' 단계의 일이지 치환의 일이 아니다 — 두 관심사를 섞지 않는다.
   253	  const prompt = skillMd
   254	    .split(RUN_STAGE_INVOCATION)
   255	    .join(`bash ${absRunStage}`)
   256	    .split(RUN_PLACEHOLDER)
   257	    .join(rid);
   258	
   259	  const derived: string[] = [];
   260	  const unexpectedFencedCommands: string[] = [];
   261	  const transitions: string[] = [];
   262	
   263	  for (const cmd of collectFencedBashCommands(prompt)) {
   264	    if (!isDerivableRunStageCommand(cmd, absRunStage, stage, rid)) {
   265	      unexpectedFencedCommands.push(cmd.command);
   266	      continue;
   267	    }
   268	    derived.push(cmd.command);
   269	    // 전이 = 상태를 쓰는 호출. `--emit-context` 는 읽기전용 입력 로드라 전이가 아니다.
   270	    if (!cmd.command.split(/\s+/).includes(EMIT_CONTEXT_FLAG)) transitions.push(cmd.command);
   271	  }
   272	
   273	  if (transitions.length !== 1) {
   274	    throw new Error(
   275	      `SKILL.md(stage=${stage})에서 전이 명령을 정확히 1개 찾지 못했습니다(찾은 개수: ${transitions.length}). ` +
   276	        "무인 세션은 산출물을 쓴 뒤 이 한 줄로 검증·전이해야 하고, 복구 세션도 정확히 같은 문자열을 씁니다 — " +
   277	        "0개면 세션이 산출물만 쓰고 게이트가 정체하고, 2개 이상이면 어느 것이 그 한 줄인지 확정할 수 없습니다. " +
   278	        "SKILL.md 의 전이 단계가 바뀌었는지 확인하세요(스킬-게이트 드리프트).",
   279	    );
   280	  }
   281	
   282	  // 도출 규칙(문서 순서) + 실측 보조 도구. 중복은 제거하되 첫 등장 순서를 보존한다(결정론).
   283	  const allowRules = [...new Set([...derived.map((c) => `Bash(${c})`), ...AUX_ALLOW_RULES[stage]])];
   284	
   285	  return { prompt, allowRules, transitionCommand: transitions[0], unexpectedFencedCommands };
   286	}
