   268	 *   내 것만 allow' 는 만들 수도 없다. `ask` 는 Bash 읽기에 적용되지 않아 수단이 아니다.
   269	 *
   270	 * 결정론: 규칙 순서는 선언 순서 고정(같은 입력 → 바이트 동일 산출). 설정 파일이 실행마다 달라지면 그 경계는 무효다.
   271	 */
   272	export function buildWorkerSettings(input: { runDir: string; addDirs: string[] }): WorkerSettings {
   273	  const runDir = assertRulePath("runDir", input.runDir);
   274	  if (!Array.isArray(input.addDirs) || input.addDirs.length === 0) {
   275	    throw new Error("addDirs 가 비어 있습니다 — buildAddDirs() 의 산물을 그대로 넘기세요(입력 경로 쓰기 금지 대상).");
   276	  }
   277	
   278	  const deny: string[] = [];
   279	  // ① 런 안에서 스크립트만 만질 수 있어야 하는 것들.
   280	  for (const rel of ["state.json", "run.md", ".lock", join(".lock", "**")]) {
   281	    const target = absGlob(join(runDir, rel));
   282	    deny.push(`Write(${target})`, `Edit(${target})`);
   283	  }
   284	  // ② 입력 경로(add-dir 루트)는 읽기 전용이다.
   285	  for (const dir of input.addDirs) {
   286	    const target = absGlob(join(assertRulePath("addDirs 항목", dir), "**"));
   287	    deny.push(`Write(${target})`, `Edit(${target})`);
   288	  }
   289	  return { permissions: { deny } };
   290	}
