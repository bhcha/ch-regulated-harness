   355	/**
   356	 * argv 조립(순수).
   357	 *
   358	 * **cwd 는 여기 없다** — CLI 에 cwd 플래그가 없기 때문이다(cwd 는 spawn 속성이라 러너가 넘긴다).
   359	 *   그래도 cwd 는 이 모듈이 정한다(buildRunCwd·buildSessionPlan): 경계를 정하는 자리는 한 곳이어야 한다.
   360	 *
   361	 * 순서 규약(두 가지 실측이 강제한다 — 로컬 파서 수준 프로브 · claude 2.1.212 · **API 콜 없음**):
   362	 *   ① **프롬프트는 `--` 뒤 피연산자**로 넘긴다. cli-parser 의 `-p <prompt>` 관례에서 벗어나는 유일한 지점이고,
   363	 *      이유가 있다: `-p` 는 값을 받지 않는 불리언이라 프롬프트는 위치인자인데, 우리 프롬프트는 SKILL.md 전문이라
   364	 *      **YAML frontmatter(`---`)로 시작**한다 → 대시로 시작하는 토큰이라 인자 파서가 **옵션으로 읽는다**.
   365	 *        `claude -p "---\nname: brief" --zzz-unknown --output-format json` → `error: unknown option '---\nname: brief…'`
   366	 *        `claude -p --zzz-unknown --output-format json -- "---\nname: brief"` → `error: unknown option '--zzz-unknown'`
   367	 *      (뒤쪽 = 프롬프트가 피연산자로 정상 수용됐다는 증거. 미지 옵션 오류는 옵션 파싱이 **끝난 뒤** 나므로 이 대조가
   368	 *       결정적이다 — 대조군 없이 앞쪽만 보면 오독을 놓친다.) `--` 없이 조립하면 **모든 SKILL.md 프롬프트가 첫 줄에서
   369	 *      죽는다**. 부록A 는 프롬프트 전달 형태를 기록하지 않아 이 지점은 A 가 답을 주지 않는 자리였다.
   370	 *   ② **variadic 플래그를 뒤에 모은다**. `--add-dir`·`--tools`·`--allowedTools`·`--disallowedTools` 는 전부
   371	 *      `<x...>` 수집기라 뒤 토큰을 삼킨다. 실측상 수집은 다음 `-` 접두 토큰(그리고 `--`)에서 멈추므로,
   372	 *      '값 있는 플래그들 → variadic 들 → `--` → 프롬프트' 순서면 서로를 먹지 않는다(cli-parser 가 `--tools ""` 를
   373	 *      맨 끝에 둔 것과 같은 조심의 일반화).
   374	 *
   375	 * @throws 프롬프트가 비었거나 · maxTurns 가 1 이상의 정수가 아니거나 · addDirs/allowRules 가 비었거나 ·
   376	 *         규칙/경로 토큰이 `-` 로 시작할 때.
   377	 */
   378	export function buildSessionArgs(input: SessionArgsInput): string[] {
   379	  const { prompt, allowRules, disallowRules, maxTurns, addDirs } = input;
   380	
   381	  if (typeof prompt !== "string" || prompt.trim() === "") {
   382	    throw new Error("프롬프트가 비어 있습니다 — skill-rewrite 의 치환 산물(SKILL.md 전문)을 넘기세요.");
   383	  }
   384	  // config.sdkMaxTurns 와 같은 규칙(지어내지 않는다): 읽을 수 없으면 clamp·반올림이 아니라 멈춘다.
   385	  if (!Number.isSafeInteger(maxTurns) || maxTurns < 1) {
