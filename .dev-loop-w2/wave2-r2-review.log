    16	 */
    17	import { chatSecretEnvNames } from "./config.js";
    18	
    19	/** 화이트리스트: base 에서 이 이름들만(존재하는 것만) 통과시킨다. 나머지는 전부 버린다. */
    20	export const SPAWN_ENV_ALLOWLIST = [
    21	  "PATH",
    22	  "HOME",
    23	  "LANG",
    24	  "LC_ALL",
    25	  "LC_CTYPE",
    26	  "TMPDIR",
    27	  "TERM",
    28	] as const;
    29	
    30	/** 스크럽(정확일치): 과금/인증/클라우드모드/마커 env — base 에 있어도 절대 싣지 않는다. */
    31	export const SPAWN_ENV_SCRUB_EXACT = [
    32	  "ANTHROPIC_API_KEY",
    33	  "ANTHROPIC_AUTH_TOKEN",
    34	  "CLAUDE_CODE_USE_BEDROCK",
    35	  "CLAUDE_CODE_USE_VERTEX",
    36	  "CLAUDECODE",
    37	  "CLAUDE_CODE_ENTRYPOINT",
    38	] as const;
    39	
    40	/** 스크럽(접두어): 이 접두어로 시작하는 이름은 전부 제거(Codex 마커·Bedrock/Vertex 자격증명 계열). */
    41	export const SPAWN_ENV_SCRUB_PREFIXES = ["CODEX_", "ANTHROPIC_BEDROCK_", "ANTHROPIC_VERTEX_"] as const;
    42	
    43	/**
    44	 * 이름이 스크럽 대상인가 — 정확일치 목록 + 접두어 목록 + Slack/플랫폼 비밀(chatSecretEnvNames).
    45	 * Slack 비밀 이름은 config(플랫폼 인지 계층)에서만 조회해 이 파일에 하드코딩하지 않는다.
    46	 */
    47	function isScrubbed(name: string): boolean {
    48	  if ((SPAWN_ENV_SCRUB_EXACT as readonly string[]).includes(name)) return true;
    49	  if (chatSecretEnvNames().includes(name)) return true;
    50	  return SPAWN_ENV_SCRUB_PREFIXES.some((prefix) => name.startsWith(prefix));
    51	}
    52	
    53	/**
    54	 * 무인 spawn 에 넘길 위생 env 를 조립한다(순수).
    55	 *
    56	 * @param base   상속 후보 env(보통 process.env). 통째로 복사하지 않고 화이트리스트로만 재구성한다.
    57	 * @param opts.configDir  주면 CLAUDE_CONFIG_DIR 로 고정 — 사용자 훅/플러그인/MCP/apiKeyHelper 미로드 격리.
    58	 *   미지정이면 설정하지 않는다(호출부는 보통 전용 격리 디렉터리를 넘겨야 한다 — 계획 5-1 도구0 경계).
    59	 * @param opts.inject     화이트리스트 재구성 뒤 되싣는 명시 env. 단 (a) 스크럽 대상 이름은 거부(무시),
    60	 *   (b) HARNESS_ACK_GAPS 는 아래 "0" 핀이 항상 이긴다.
    61	 */
    62	export function hygienicSpawnEnv(
    63	  base: NodeJS.ProcessEnv,
    64	  opts?: { configDir?: string; inject?: Record<string, string> },
    65	): Record<string, string> {
    66	  const out: Record<string, string> = {};
    67	
    68	  // 1) 화이트리스트 재구성 — base 에서 허용 이름만(존재+비스크럽). 나머지는 전부 드롭.
    69	  for (const name of SPAWN_ENV_ALLOWLIST) {
    70	    const value = base[name];
    71	    if (value !== undefined && !isScrubbed(name)) out[name] = value;
    72	  }
    73	
    74	  // 5) inject — 명시 env 되싣기. 스크럽 대상 이름은 거부(방어심층 2차).
    75	  if (opts?.inject) {
    76	    for (const [name, value] of Object.entries(opts.inject)) {
    77	      if (isScrubbed(name)) continue;
    78	      out[name] = value;
    79	    }
    80	  }
    81	
    82	  // 4) 전용 CLAUDE_CONFIG_DIR — 주어졌을 때만 설정(사용자 설정 격리).
    83	  if (opts?.configDir !== undefined) out.CLAUDE_CONFIG_DIR = opts.configDir;
    84	
    85	  // 3) HARNESS_ACK_GAPS "0" 핀 고정 — inject·base 무관하게 항상 마지막에 덮어 이긴다.
    86	  out.HARNESS_ACK_GAPS = "0";
    87	
    88	  return out;
    89	}

