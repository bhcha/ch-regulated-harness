   347	  /** `--disallowedTools` 규칙(buildDisallowedTools 산물). */
   348	  disallowRules: string[];
   349	  /** `--max-turns`(config 의 sdkMaxTurns). 이 모듈은 env 를 읽지 않는다 — 순수 유지. */
   350	  maxTurns: number;
   351	  /** `--add-dir`(buildAddDirs 산물 · 절대경로). */
   352	  addDirs: string[];
   353	}
