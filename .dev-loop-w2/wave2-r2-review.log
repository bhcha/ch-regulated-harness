   484	
   485	export interface SessionPlanInput {
   486	  /** core(하네스) 체크아웃 절대경로(config.harnessRoot()). */
   487	  coreRoot: string;
   488	  /** 이 잡의 run_id. */
   489	  rid: string;
   490	  /** state.json 에 사람이 선언한 규제도메인(팩 선택 키) — 이 세션이 볼 수 있는 팩은 이것 하나뿐이다. */
   491	  domain: string;
   492	  /** skill-rewrite 의 치환 산물. */
   493	  prompt: string;
   494	  /** skill-rewrite 의 도출 규칙. */
   495	  allowRules: string[];
   496	  /** config.sdkMaxTurns(). */
   497	  maxTurns: number;
   498	  /** 워커가 이 잡용으로 만든 전용 빈 디렉터리(절대경로). 생성·정리는 러너의 몫. */
   499	  configDir: string;
   500	  /** 구독 인증 토큰(chat/.env 의 CLAUDE_CODE_OAUTH_TOKEN). 없으면 세션은 인증 실패로 죽는다(A-8). */
   501	  oauthToken?: string;
   502	  /** 위생 재구성의 base(보통 process.env). 이 모듈은 process.env 를 직접 읽지 않는다 — 순수 유지. */
   503	  baseEnv: NodeJS.ProcessEnv;
   504	}
   505	
   506	/**
   507	 * 세션 1건 조립의 단일 진입점 — 부록A-9 의 축을 **한 번에** 묶는다.
   508	 *
   509	 * 왜 조립기를 따로 두나: 축이 하나라도 빠지면 경계가 조용히 약해진다(add-dir 를 빠뜨리면 세션이 못 읽어 시끄럽게
   510	 *   실패하지만, **settings 를 빠뜨리면 state 쓰기 금지가 사라지고 아무 소리도 안 난다**). 러너가 축을 손으로
   511	 *   재조립하지 않도록 여기서 한 덩이로 돌려준다 — '경계를 정하는 자리는 한 곳'이라는 이 모듈의 존재 이유 그대로다.
   512	 */
   513	export function buildSessionPlan(input: SessionPlanInput): SessionPlan {
   514	  const cwd = buildRunCwd({ coreRoot: input.coreRoot, rid: input.rid });
   515	  const addDirs = buildAddDirs({ coreRoot: input.coreRoot, domain: input.domain });
   516	  const settings = buildWorkerSettings({ runDir: cwd, addDirs });
   517	  const argv = buildSessionArgs({
   518	    prompt: input.prompt,
   519	    allowRules: input.allowRules,
   520	    disallowRules: buildDisallowedTools(input.coreRoot),
   521	    maxTurns: input.maxTurns,
   522	    addDirs,
   523	  });
   524	  const env = buildSessionEnv(input.baseEnv, {
   525	    configDir: input.configDir,
   526	    ...(input.oauthToken !== undefined ? { oauthToken: input.oauthToken } : {}),
   527	  });
   528	  return {
   529	    argv,
   530	    cwd,
   531	    env,
   532	    settings,
   533	    settingsJson: serializeWorkerSettings(settings),
   534	    settingsPath: join(input.configDir, WORKER_SETTINGS_FILENAME),
   535	    addDirs,
   536	  };
   537	}

