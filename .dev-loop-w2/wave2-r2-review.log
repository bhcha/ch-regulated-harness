   387	  }
   388	  if (!Array.isArray(addDirs) || addDirs.length === 0) {
   389	    throw new Error("addDirs 가 비어 있습니다 — buildAddDirs() 의 산물을 넘기세요(읽기 경계에 추가할 경로).");
   390	  }
   391	  if (!Array.isArray(allowRules) || allowRules.length === 0) {
   392	    // 규칙 0개면 세션은 산출물만 쓰고 전이하지 못한다 — 부록A-9 1차 시도의 실패 양상(산출물은 썼는데
   393	    //   전이 3회 거부 → next-action 정체) 그대로다. 조용히 그 상태를 만드는 대신 조립에서 끊는다.
   394	    throw new Error(
   395	      "allowRules 가 비어 있습니다 — 무인 세션은 전이 명령 한 줄을 통과시킬 규칙이 없으면 산출물만 쓰고 게이트에서 정체합니다. " +
   396	        "skill-rewrite 의 도출 산물을 넘기세요.",
   397	    );
   398	  }
   399	
   400	  // variadic 자리에 들어가는 caller 문자열은 **`-` 로 시작하면 안 된다**: 파서가 그 토큰을 옵션으로 읽어
   401	  //   ① 수집을 조기 종료(= 뒤 규칙들이 조용히 누락 = 경계가 의도와 달라짐) ② 최악의 경우 그 토큰 자체가
   402	  //   플래그로 해석된다(`--dangerously-skip-permissions` 를 규칙인 척 흘려보내는 길). 조립에서 끊는다.
   403	  for (const [label, values] of [
   404	    ["--add-dir", addDirs],
   405	    ["--allowedTools", allowRules],
   406	    ["--disallowedTools", disallowRules],
   407	  ] as const) {
   408	    for (const v of values) {
   409	      if (typeof v !== "string" || v === "") {
   410	        throw new Error(`${label} 항목이 비어 있습니다 — 빈 토큰은 인자 위치를 밀어 조립을 어긋나게 합니다.`);
   411	      }
   412	      if (v.startsWith("-")) {
   413	        throw new Error(
   414	          `${label} 항목은 '-' 로 시작할 수 없습니다: '${v}' — 인자 파서가 이 토큰을 옵션으로 읽어 뒤 항목을 누락시키거나 ` +
   415	            "플래그로 실행합니다(경계가 조용히 달라집니다).",
   416	        );
   417	      }
   418	    }
   419	  }
   420	
   421	  return [
   422	    "-p",
   423	    // 봉투(JSON)로 받아야 러너가 결과·비용·permission_denials 를 읽는다(도구 흔적 = 경계가 하중을 받은 증거).
   424	    "--output-format",
   425	    "json",
   426	    "--permission-mode",
   427	    SESSION_PERMISSION_MODE,
   428	    "--max-turns",
   429	    String(maxTurns),
   430	    /**
   431	     * 설정 소스 = `user` 하나(모듈 상단 '설정 소스' 절). 격리 CONFIG_DIR 는 **user 설정만** 옮기므로 이 핀이 없으면
   432	     *   레포의 `.claude/settings.local.json`(= 사람이 '허용'을 누를 때마다 자라는 파일)이 무인 세션 권한에 병합된다.
   433	     *   `<sources>` 는 variadic 이 아니라 **단일 콤마목록 값**이라 variadic 구간 앞에 두어도 뒤 토큰을 삼키지 않는다.
   434	     */
   435	    "--setting-sources",
   436	    SESSION_SETTING_SOURCES,
   437	    /**
   438	     * MCP 서버 0개 — `--mcp-config` 를 **주지 않은 채** 이 플래그를 켜면 '설정에서 온 MCP 전부 무시'가 된다.
   439	     *   `--tools` 는 빌트인만 제한하므로 이게 없으면 `core/.mcp.json` 이 도구 표면에 붙을 수 있다(불리언 = 값 없음).
   440	     */
   441	    "--strict-mcp-config",
   442	    // 여기부터 variadic — 각각 다음 `-` 접두 토큰에서 멈춘다(위 순서 규약 ②).
   443	    "--add-dir",
   444	    ...addDirs,
   445	    "--tools",
   446	    SESSION_TOOLS,
   447	    /**
   448	     * 규칙 **1건 = argv 토큰 1개**로 넘긴다.
   449	     *
   450	     * ⚠ **미실측 — W5 카나리 확인 필요**: 부록A 는 `--allowedTools` 에 **여러 규칙을 어떤 형태로 넘겼는지
   451	     *   기록하지 않았다**(한 토큰에 공백으로 이어붙였는지 · 규칙마다 토큰을 나눴는지 · 플래그를 반복했는지).
   452	     *   A-9 가 확인해 준 건 '두 규칙이 실제로 매칭됐다'는 결과뿐이다. 그러니 이 선택은 실측이 아니라 **판단**이다:
   453	     *     · 우리 규칙은 **내부에 공백이 있다**(`Bash(bash /abs/scripts/run-stage.sh brief rid)`). 한 토큰에
   454	     *       이어붙이면 규칙 내부 공백과 구분자 공백을 CLI 가 무엇으로 가르는지에 경계를 맡기게 된다.
   455	     *     · A-9 는 공백 포함 규칙 하나가 **온전히 매칭**됐음을 보였다(전이 성공) = 토큰 내부 공백으로 규칙을
   456	     *       쪼개지는 않는다. 그렇다면 토큰을 나누는 쪽이 '구분자 해석'을 CLI 에 넘기지 않는 유일한 형태다.
   457	     *   다만 **여러 토큰을 각각 독립 규칙으로 읽는지**는 라이브에서만 확인된다. 틀리면 전이가 거부되고
   458	     *   next-action 이 정체해 드러난다(= 조용한 통과가 아니라 fail-closed) — W5 무인 완주가 그 카나리다.
   459	     */
   460	    "--allowedTools",
   461	    ...allowRules,
   462	    ...(disallowRules.length > 0 ? ["--disallowedTools", ...disallowRules] : []),
   463	    // `--` 가 옵션 파싱을 끝낸다 → 뒤의 프롬프트는 frontmatter 로 시작해도 피연산자로 안전하게 수용된다(위 ①).
   464	    "--",
   465	    prompt,
   466	  ];
   467	}
   468	
   469	/** 세션 1건을 띄우는 데 필요한 전부(러너가 이걸 그대로 소비한다 — 축을 빠뜨릴 여지를 없앤다). */
   470	export interface SessionPlan {
   471	  /** `claude` 에 넘길 argv. */
   472	  argv: string[];
   473	  /** spawn cwd = 읽기 경계(`<coreRoot>/runs/<rid>`). */
   474	  cwd: string;
   475	  /** spawn env(위생 재구성 + 격리 CONFIG_DIR + OAuth). */
