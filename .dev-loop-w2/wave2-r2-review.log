   342	export interface SessionArgsInput {
   343	  /** 세션에 넘길 프롬프트 = skill-rewrite 의 치환 산물(SKILL.md 전문). 프리앰블을 덧붙이지 않는다(부록A-10). */
   344	  prompt: string;
   345	  /** `--allowedTools` 규칙 — **skill-rewrite 도출 산물**(손으로 짜지 않는다 · 부록A-9 교훈). */
