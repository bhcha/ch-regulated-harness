   297	/**
   298	 * 무인 세션 env — 위생 재구성(hygienicSpawnEnv) + 격리 CONFIG_DIR + OAuth 주입.
   299	 *
   300	 * hygienicSpawnEnv 가 이미 하는 일은 **다시 하지 않는다**: 화이트리스트 재구성(base 통째 복사 아님) ·
   301	 *   `ANTHROPIC_API_KEY`/`ANTHROPIC_AUTH_TOKEN`·`CODEX_*`·Bedrock/Vertex·마커·플랫폼 비밀 스크럽 ·
   302	 *   `HARNESS_ACK_GAPS="0"` 핀(core 의 .env 로더가 set-if-unset 이라 생략만으론 되채워진다).
   303	 *
   304	 * 여기서 더하는 두 가지:
   305	 *   · **격리 CONFIG_DIR 필수** — 사용자 훅/플러그인/MCP/`apiKeyHelper` 를 애초에 없애는 층이라(과금·행동 우회 차단)
   306	 *     선택지가 아니다. 절대경로만 받는다: 상대경로면 CLI 가 **cwd(=런 디렉터리) 기준**으로 풀어 워커 설정이
   307	 *     남의 산출물 폴더 안에 생긴다(= 격리 실패 + 런 오염).
   308	 *   · **OAuth 토큰 주입** — 격리 CONFIG_DIR 는 로컬 로그인 자격증명까지 가려서 그대로 두면 `Not logged in` 이다
   309	 *     (부록A-1 부수 관측). 토큰 주입으로 인증·격리·경계가 한 구성에서 성립함이 A-8 에서 실측됐다.
   310	 *     ⚠ 토큰은 **API 키가 아니라 구독 토큰**이라 과금이 구독으로 잡힌다(잠긴 결정 6). 빈 문자열은 '미설정'으로
   311	 *     취급한다(config 의 readEnv 관례) — 빈 값을 실어보내면 인증이 '설정됐는데 실패'로 흐려진다.
   312	 *   · **claude.ai 커넥터 끄기**(`ENABLE_CLAUDEAI_MCP_SERVERS=false`) — 커넥터는 **OAuth 계정**을 타고 도구를 노출하므로
   313	 *     바로 위 토큰 주입이 여는 경로다(= 격리 CONFIG_DIR 도 `--strict-mcp-config` 도 못 닫는다). 인증을 주는 대가로
   314	 *     열리는 표면이니 인증과 **같은 자리에서** 닫는다. 도구 표면 결정성 계약이지 승인 게이트 대체물이 아니다.
   315	 *
   316	 * ⚠ 여기 핀은 `hygienicSpawnEnv` 의 `inject` 를 탄다 — 그쪽이 스크럽 대상 이름을 거부하고(방어심층) `HARNESS_ACK_GAPS`
   317	 *   "0" 핀은 inject 보다 **뒤에 덮어써서 항상 이긴다**. 그 순서에 기대므로 위생 모듈을 고칠 땐 이 결합을 함께 볼 것.
   318	 */
   319	export function buildSessionEnv(
   320	  baseEnv: NodeJS.ProcessEnv,
   321	  opts: { configDir: string; oauthToken?: string },
   322	): Record<string, string> {
   323	  const configDir = opts.configDir;
   324	  if (typeof configDir !== "string" || configDir.trim() === "" || !isAbsolute(configDir)) {
   325	    throw new Error(
   326	      `격리 CLAUDE_CONFIG_DIR 는 절대경로여야 합니다(받은 값: '${configDir}') — 워커가 잡마다 만드는 전용 디렉터리를 넘기세요. ` +
   327	        "상대경로는 세션 cwd(런 디렉터리) 기준으로 풀려 워커 설정이 런 산출물 안에 생깁니다.",
   328	    );
   329	  }
   330	  const token = opts.oauthToken;
   331	  return hygienicSpawnEnv(baseEnv, {
   332	    configDir,
   333	    inject: {
   334	      // 커넥터 차단은 **토큰 유무와 무관하게** 항상 실린다 — 토큰이 없는 실행(인증 실패로 죽는 경로)에서도
   335	      //   도구 표면 계약이 구성상 같아야 한다. 조건부로 달면 '토큰 없을 때만 표면이 다른' 세션이 생긴다.
   336	      [SESSION_CLAUDEAI_MCP_ENV]: SESSION_CLAUDEAI_MCP_VALUE,
   337	      ...(typeof token === "string" && token !== "" ? { CLAUDE_CODE_OAUTH_TOKEN: token } : {}),
   338	    },
   339	  });
   340	}
