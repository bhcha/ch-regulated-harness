   104	  runner: NextActionRunner = defaultRunner,
   105	): Promise<NextAction> {
   106	  if (!rid || rid.trim() === "") {
   107	    throw new Error("readNextAction: run_id 가 비었습니다.");
   108	  }
   109	  // 읽기 경로도 write 래퍼와 동일하게 경로-안전 rid 만 허용 — next-action.sh 가 $HARNESS_ROOT/runs/$rid 로
   110	  //   경로를 만들므로 `../runs/other` 같은 값이 다른 run 을 들여다보지 않도록 fail-closed.
   111	  if (!isSafeRunId(rid)) {
   112	    throw new Error(`readNextAction: run_id 형식이 안전하지 않습니다: ${rid}`);
   113	  }
   114	  const { code, stdout, stderr } = await runner(rid);
   115	  const errTail = stderr.trim() || "(stderr 없음)";
   116	  if (code !== 0) {
   117	    throw new Error(`next-action.sh 비정상 종료(rid=${rid}, code=${code}): ${errTail}`);
   118	  }
   119	  const text = stdout.trim();
   120	  if (text === "") {
   121	    throw new Error(`next-action.sh 빈 출력(rid=${rid}, code=${code}): ${errTail}`);
   122	  }
   123	  let parsed: unknown;
   124	  try {
   125	    parsed = JSON.parse(text);
   126	  } catch (e) {
   127	    const msg = e instanceof Error ? e.message : String(e);
   128	    throw new Error(
   129	      `next-action.sh JSON 파싱 실패(rid=${rid}): ${msg} — 원문(앞 200자): ${text.slice(0, 200)}`,
   130	    );
   131	  }
   132	  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
   133	    throw new Error(`next-action.sh JSON 이 객체가 아닙니다(rid=${rid}): ${text.slice(0, 200)}`);
   134	  }
   135	  // 필수 계약 필드 검증(next-action.sh out 딕셔너리 SSoT: rid·step·stage·action 은 항상 실린다).
   136	  //   '객체다'만으로는 부족하다 — 소비자(cli-session-runner)는 isGenerateTurn(na) 이 false 면 '전이 완료'로 보고
   137	  //   성공 처분한다. 그래서 필드가 빠진 퇴화 응답({} 등)은 'generate 아님 = 전이 완료'로 오독돼 **미전이 잡을
   138	  //   성공으로 삭제**한다. 안전하게 해석할 수 없는 next-action 은 여기서 fail-closed 한다(모든 호출부가 throw 를
   139	  //   실패/폴백으로 흡수 — runner=next_action_unreadable · worker/flow=.catch()). 미지 필드는 아래처럼 건드리지 않아
   140	  //   forward-compat(index signature 보존)은 그대로다 — 필수 필드의 존재·타입만 본다.
   141	  const p = parsed as Record<string, unknown>;
   142	  const snip = text.slice(0, 200);
   143	  // rid: 요청한 rid 를 그대로 되돌려줘야 한다(불일치·부재 = 다른 run 을 읽었거나 봉투가 깨짐 → 신뢰 불가).
   144	  if (p.rid !== rid) {
   145	    throw new Error(`next-action.sh rid 불일치(요청 rid=${rid}, 응답 rid=${String(p.rid)}): ${snip}`);
   146	  }
   147	  // step·action: 계약상 enum(contract.ts Step·Action) 멤버여야 한다. '비어있지 않은 문자열'만으론 부족 —
   148	  //   `step:"unknown"` 같은 오탈자·미지 값이 통과하면 소비자(isGenerateTurn: step==="generate" && stage 일치)가
   149	  //   'generate 아님'으로 읽어 **전이 완료로 오독** → 미전이 잡을 성공 삭제한다(HIGH #1). enum 밖 값은 안전
   150	  //   해석 불가 → fail-closed. (빈 문자열도 enum 에 없으므로 자연히 걸린다.)
   151	  if (typeof p.step !== "string" || !STEP_VALUES.has(p.step)) {
   152	    throw new Error(`next-action.sh step 값이 유효하지 않습니다(rid=${rid}): ${snip}`);
   153	  }
   154	  if (typeof p.action !== "string" || !ACTION_VALUES.has(p.action)) {
   155	    throw new Error(`next-action.sh action 값이 유효하지 않습니다(rid=${rid}): ${snip}`);
   156	  }
   157	  // stage: 계약상 nullable(contract.ts `stage: string | null`) — 문자열 또는 null 만 허용, 그 외 타입은 거부
   158	  //   (정당한 null 은 통과시키고 숫자 등 오염만 막는다 — over-tighten 금지).
   159	  if (p.stage !== null && typeof p.stage !== "string") {
   160	    throw new Error(`next-action.sh stage 가 문자열/null 이 아닙니다(rid=${rid}): ${snip}`);
   161	  }
   162	  // 교차규칙(contract.ts: action=generate ⟹ stage 는 non-empty 문자열 · contract.test.ts 165행에 고정):
   163	  //   action 이 generate 인데 stage 가 null/빈 문자열이면 어느 단계를 만들지 없는 **퇴화 봉투**다. 이걸 통과시키면
   164	  //   isGenerateTurn 이 stage 불일치로 false → '전이 완료'로 오독된다(HIGH #1 의 핵심 구멍 — 부분/오류 객체가
   165	  //   성공으로 읽힘). generate 아닌 action 의 stage:null 은 정당하므로 건드리지 않는다(over-tighten 금지).
   166	  if (p.action === "generate" && (typeof p.stage !== "string" || p.stage === "")) {
   167	    throw new Error(`next-action.sh action=generate 인데 stage 가 비어있습니다(rid=${rid}): ${snip}`);
   168	  }
   169	  // 미지 필드 무시=그대로 보존: 재구성 없이 캐스팅만(index signature 가 미지 키를 담는다).
   170	  return parsed as NextAction;
   171	}

