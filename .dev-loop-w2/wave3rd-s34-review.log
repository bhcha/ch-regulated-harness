   518	          //   이미 참). 그룹이 이제 소멸했어도 이건 **깨끗한 마감 강제가 아니라 폭주 출력 회수(실패)**다 → killed 가
   519	          //   아니라 output_cap 으로 settle(전이가 관측돼도 러너가 실패로 처분하게). ref 를 보므로 close 지연에도 샌다.
   520	          settle({ outcome: "output_cap", exitCode: null, detail: "출력 상한(32MiB) 초과 → 그룹 cap-kill 후 회수 확인(실패 · killed 아님)" });
   521	        } else {
   522	          settle({ outcome: "killed", exitCode: null, detail: "마감 강제(회수 확인됨)" });
   523	        }
   524	        return;
   525	      }
   526	      if (now >= schedule.killSigAtMs) {
   527	        if (!termSent) {
   528	          deps.signalGroup(pgid, "SIGTERM");
   529	          termSent = true;
   530	        }
   531	        if (!killSent) {
   532	          deps.signalGroup(pgid, "SIGKILL");
   533	          killSent = true;
   534	        }
   535	        armNext(); // 아직 kill_at 전 — reap 확인 알람을 잇는다.
   536	        return;
   537	      }
   538	      if (now >= schedule.termAtMs) {
   539	        if (!termSent) {
   540	          deps.signalGroup(pgid, "SIGTERM");
   541	          termSent = true;
   542	        }
   543	        armNext(); // KILL·reap 알람을 잇는다.
   544	        return;
   545	      }
   546	      // 조기 발화(now < termAt) — 스펜트 원샷으로 버리지 않고 다음 임계로 재무장한다(Finding 3).
   547	      armNext();
   548	    };
   549	
   550	    // 첫 무장(다음 임계로). 조기 발화·클램프·밀린 타이머는 armNext 재무장 + enforce 절대시계 재판정이 흡수한다.
   551	    armNext();
   552	  });
   553	}
