   482	     */
   483	    const armNext = (): void => {
   484	      if (settled) return;
   485	      const now = deps.now();
   486	      const nextTarget =
   487	        now < schedule.termAtMs
   488	          ? schedule.termAtMs
   489	          : now < schedule.killSigAtMs
   490	            ? schedule.killSigAtMs
   491	            : schedule.killAtMs;
