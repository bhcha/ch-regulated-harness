   508	        }
   509	        if (!killSent) {
   510	          deps.signalGroup(pgid, "SIGKILL");
   511	          killSent = true;
   512	        }
   513	        // kill_at 시점 판정: **지금 소멸했는가**(결국이 아니라). 살아 있으면 회수 실패.
   514	        if (deps.groupAlive(pgid)) {
