   473	      (e) => onSelfExit(e.code, e.outputCapExceeded === true),
   474	      () => onSelfExit(null, false), // 종료 관측 자체가 실패해도 감독은 계속(회수 알람이 백스톱).
   475	    );
   476	
   477	    /**
