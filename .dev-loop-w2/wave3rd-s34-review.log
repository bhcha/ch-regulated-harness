   496	    /**
   497	     * 마감 강제 한 스텝 — **어느 알람이 깨우든 `now()` 로 due 페이즈를 재계산**해 밀린 단계를 즉시 따라잡고, 아직
   498	     *   kill_at 전이면 `armNext()` 로 다음 임계 알람을 잇는다(조기 발화·클램프에도 회수가 새지 않는다).
   499	     */
   500	    const enforce = (): void => {
   501	      if (settled) return;
   502	      const now = deps.now();
   503	      if (now >= schedule.killAtMs) {
   504	        // 밀린 경우를 대비해 아직 안 보낸 신호를 지금 마저 보낸다(그 뒤 곧바로 소멸 확인).
