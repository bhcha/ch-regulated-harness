+export interface SuperviseResult {
+  outcome: SessionOutcome;
+  /** 세션이 스스로 종료했을 때의 종료코드(신호 종료·미종료·refused 면 null). */
+  exitCode: number | null;
+  /** 진단 한 줄(로그·failed 사유). 사람 카드 문구가 아니다. */
+  detail: string;
+}
