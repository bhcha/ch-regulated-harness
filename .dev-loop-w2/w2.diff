+  try {
+    names = await readdir(pendingDir);
+  } catch (e) {
+    if (isEnoent(e)) return []; // 폴더가 아직 없음 = 잡 없음.
+    throw e; // 권한·IO 오류를 '빈 큐'로 위장하지 않는다(있는 일감이 조용히 사라진다).
