+      }
+      if (now >= schedule.killSigAtMs) {
+        if (!termSent) {
+          deps.signalGroup(pgid, "SIGTERM");
+          termSent = true;
+        }
+        if (!killSent) {
+          deps.signalGroup(pgid, "SIGKILL");
+          killSent = true;
+        }
