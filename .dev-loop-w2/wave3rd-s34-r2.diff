+      if (settled) return;
+      const now = deps.now();
+      const nextTarget =
+        now < schedule.termAtMs
+          ? schedule.termAtMs
+          : now < schedule.killSigAtMs
+            ? schedule.killSigAtMs
+            : schedule.killAtMs;
