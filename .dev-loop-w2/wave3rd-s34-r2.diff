+          ledger.settle(nonce, "reaped");
+        } catch (e) {
+          process.stderr.write(
+            `supervisor: 원장 settle(reaped) 실패 — 그룹은 소멸 확인됨, 데몬이 원장 상태로 정리(pgid=${pgid}): ${e instanceof Error ? e.message : String(e)}\n`,
