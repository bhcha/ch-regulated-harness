   376	// ── 5. 적대 우회 표(조립 수준) ───────────────────────────────────────────────
   377	
   378	/**
   379	 * 조립된 allow 집합이 이 명령을 **통과시킬 여지가 있는가**.
   380	 *   정확일치(`Bash(cmd)`)와 접두(`Bash(cmd:*)`) **두 의미론을 모두 가정**하고 본다 — 어느 쪽이 참이든
   381	 *   '우리 규칙 중 이 명령에 걸릴 수 있는 게 하나도 없다'를 말하려면 둘 다 봐야 한다.
   382	 */
   383	function allowSetWouldMatch(allowRules: string[], command: string): boolean {
   384	  return allowRules.some((rule) => {
   385	    const m = /^Bash\((.*)\)$/.exec(rule);
   386	    if (!m) return false;
   387	    const body = m[1];
   388	    return body.endsWith(":*") ? command.startsWith(body.slice(0, -2)) : command === body;
   389	  });
   390	}
