   205	/**
   206	 * 격리 `CLAUDE_CONFIG_DIR/settings.json` 내용 — **경계 안쪽에서 파내는 예외**만 담는다(부록A-7 2번).
   207	 *
   208	 * 담는 것:
   209	 *   ① 런의 `state.json`·`run.md`·`.lock` 쓰기 금지 — **상태는 오직 `run-stage.sh` 가 쓴다**(AGENTS 1번 절).
   210	 *      세션이 state 를 직접 쓸 수 있으면 게이트를 건너뛴 '전이'가 가능해져 승인·심의 전제가 통째로 무너진다.
   211	 *      `.lock` 은 파일이 아니라 **디렉터리**(core 의 mkdir 원자성 락)라 실질 표적은 `.lock/pid`(보유 PID 위조)다 →
   212	 *      루트와 하위를 함께 막는다.
   213	 *   ② `--add-dir` 루트 4종 쓰기 금지 — 그것들은 **입력이지 산출물이 아니다**. `acceptEdits` 아래선 파일 작성이
   214	 *      자동승인이므로, 막지 않으면 세션이 `scripts/run-stage.sh` 를 고쳐놓고 **허용된 그 한 줄로 실행**할 수 있다
   215	 *      (= allow 규칙 정밀도를 우회하는 지름길). `packs/<도메인>/ruleset.json` 쓰기 금지는 같은 이유의 심의판
   216	 *      — 자기 심의 기준을 고쳐 쓰는 세션은 self-grading 이다(AGENTS 1번 절 4).
   217	 *
   218	 * 담지 않는 것: **읽기 허용목록도, 읽기 deny 열거도 없다.** cwd 가 이미 기본-거부 읽기 경계라 `.env`·타 런·
   219	 *   `chat/jobs`·`~/.claude` 는 전부 구조적으로 밖이고(A-4), A-3 상 `deny` 가 `allow` 를 이기므로 '전부 deny +
   220	 *   내 것만 allow' 는 만들 수도 없다. `ask` 는 Bash 읽기에 적용되지 않아 수단이 아니다.
   221	 *
   222	 * 결정론: 규칙 순서는 선언 순서 고정(같은 입력 → 바이트 동일 산출). 설정 파일이 실행마다 달라지면 그 경계는 무효다.
   223	 */
   224	export function buildWorkerSettings(input: { runDir: string; addDirs: string[] }): WorkerSettings {
   225	  const runDir = assertRulePath("runDir", input.runDir);
   226	  if (!Array.isArray(input.addDirs) || input.addDirs.length === 0) {
   227	    throw new Error("addDirs 가 비어 있습니다 — buildAddDirs() 의 산물을 그대로 넘기세요(입력 경로 쓰기 금지 대상).");
   228	  }
   229	
   230	  const deny: string[] = [];
   231	  // ① 런 안에서 스크립트만 만질 수 있어야 하는 것들.
   232	  for (const rel of ["state.json", "run.md", ".lock", join(".lock", "**")]) {
   233	    const target = absGlob(join(runDir, rel));
   234	    deny.push(`Write(${target})`, `Edit(${target})`);
   235	  }
   236	  // ② 입력 경로(add-dir 루트)는 읽기 전용이다.
   237	  for (const dir of input.addDirs) {
   238	    const target = absGlob(join(assertRulePath("addDirs 항목", dir), "**"));
   239	    deny.push(`Write(${target})`, `Edit(${target})`);
   240	  }
   241	  return { permissions: { deny } };
   242	}
   243	
   244	/** settings 직렬화(결정적) — 2칸 들여쓰기 + 끝 개행. 러너가 이 문자열을 그대로 쓴다. */
   245	export function serializeWorkerSettings(settings: WorkerSettings): string {
   246	  return `${JSON.stringify(settings, null, 2)}\n`;
   247	}
   248	
   249	/**
   250	 * 무인 세션 env — 위생 재구성(hygienicSpawnEnv) + 격리 CONFIG_DIR + OAuth 주입.
   251	 *
   252	 * hygienicSpawnEnv 가 이미 하는 일은 **다시 하지 않는다**: 화이트리스트 재구성(base 통째 복사 아님) ·
   253	 *   `ANTHROPIC_API_KEY`/`ANTHROPIC_AUTH_TOKEN`·`CODEX_*`·Bedrock/Vertex·마커·플랫폼 비밀 스크럽 ·
   254	 *   `HARNESS_ACK_GAPS="0"` 핀(core 의 .env 로더가 set-if-unset 이라 생략만으론 되채워진다).
   255	 *
   256	 * 여기서 더하는 두 가지:
   257	 *   · **격리 CONFIG_DIR 필수** — 사용자 훅/플러그인/MCP/`apiKeyHelper` 를 애초에 없애는 층이라(과금·행동 우회 차단)
   258	 *     선택지가 아니다. 절대경로만 받는다: 상대경로면 CLI 가 **cwd(=런 디렉터리) 기준**으로 풀어 워커 설정이
   259	 *     남의 산출물 폴더 안에 생긴다(= 격리 실패 + 런 오염).
   260	 *   · **OAuth 토큰 주입** — 격리 CONFIG_DIR 는 로컬 로그인 자격증명까지 가려서 그대로 두면 `Not logged in` 이다
   261	 *     (부록A-1 부수 관측). 토큰 주입으로 인증·격리·경계가 한 구성에서 성립함이 A-8 에서 실측됐다.
   262	 *     ⚠ 토큰은 **API 키가 아니라 구독 토큰**이라 과금이 구독으로 잡힌다(잠긴 결정 6). 빈 문자열은 '미설정'으로
   263	 *     취급한다(config 의 readEnv 관례) — 빈 값을 실어보내면 인증이 '설정됐는데 실패'로 흐려진다.
   264	 */
   265	export function buildSessionEnv(
   266	  baseEnv: NodeJS.ProcessEnv,
   267	  opts: { configDir: string; oauthToken?: string },
   268	): Record<string, string> {
   269	  const configDir = opts.configDir;
   270	  if (typeof configDir !== "string" || configDir.trim() === "" || !isAbsolute(configDir)) {
   271	    throw new Error(
   272	      `격리 CLAUDE_CONFIG_DIR 는 절대경로여야 합니다(받은 값: '${configDir}') — 워커가 잡마다 만드는 전용 디렉터리를 넘기세요. ` +
   273	        "상대경로는 세션 cwd(런 디렉터리) 기준으로 풀려 워커 설정이 런 산출물 안에 생깁니다.",
   274	    );
   275	  }
   276	  const token = opts.oauthToken;
   277	  return hygienicSpawnEnv(baseEnv, {
   278	    configDir,
   279	    ...(typeof token === "string" && token !== "" ? { inject: { CLAUDE_CODE_OAUTH_TOKEN: token } } : {}),
   280	  });
   281	}
   282	
   283	export interface SessionArgsInput {
   284	  /** 세션에 넘길 프롬프트 = skill-rewrite 의 치환 산물(SKILL.md 전문). 프리앰블을 덧붙이지 않는다(부록A-10). */
   285	  prompt: string;
   286	  /** `--allowedTools` 규칙 — **skill-rewrite 도출 산물**(손으로 짜지 않는다 · 부록A-9 교훈). */
   287	  allowRules: string[];
   288	  /** `--disallowedTools` 규칙(buildDisallowedTools 산물). */
   289	  disallowRules: string[];
   290	  /** `--max-turns`(config 의 sdkMaxTurns). 이 모듈은 env 를 읽지 않는다 — 순수 유지. */
   291	  maxTurns: number;
   292	  /** `--add-dir`(buildAddDirs 산물 · 절대경로). */
   293	  addDirs: string[];
   294	}
   295	
   296	/**
   297	 * argv 조립(순수).
   298	 *
   299	 * **cwd 는 여기 없다** — CLI 에 cwd 플래그가 없기 때문이다(cwd 는 spawn 속성이라 러너가 넘긴다).
   300	 *   그래도 cwd 는 이 모듈이 정한다(buildRunCwd·buildSessionPlan): 경계를 정하는 자리는 한 곳이어야 한다.
   301	 *
   302	 * 순서 규약(두 가지 실측이 강제한다 — 로컬 파서 수준 프로브 · claude 2.1.212 · **API 콜 없음**):
   303	 *   ① **프롬프트는 `--` 뒤 피연산자**로 넘긴다. cli-parser 의 `-p <prompt>` 관례에서 벗어나는 유일한 지점이고,
   304	 *      이유가 있다: `-p` 는 값을 받지 않는 불리언이라 프롬프트는 위치인자인데, 우리 프롬프트는 SKILL.md 전문이라
   305	 *      **YAML frontmatter(`---`)로 시작**한다 → 대시로 시작하는 토큰이라 인자 파서가 **옵션으로 읽는다**.
   306	 *        `claude -p "---\nname: brief" --zzz-unknown --output-format json` → `error: unknown option '---\nname: brief…'`
   307	 *        `claude -p --zzz-unknown --output-format json -- "---\nname: brief"` → `error: unknown option '--zzz-unknown'`
   308	 *      (뒤쪽 = 프롬프트가 피연산자로 정상 수용됐다는 증거. 미지 옵션 오류는 옵션 파싱이 **끝난 뒤** 나므로 이 대조가
   309	 *       결정적이다 — 대조군 없이 앞쪽만 보면 오독을 놓친다.) `--` 없이 조립하면 **모든 SKILL.md 프롬프트가 첫 줄에서
   310	 *      죽는다**. 부록A 는 프롬프트 전달 형태를 기록하지 않아 이 지점은 A 가 답을 주지 않는 자리였다.
   311	 *   ② **variadic 플래그를 뒤에 모은다**. `--add-dir`·`--tools`·`--allowedTools`·`--disallowedTools` 는 전부
   312	 *      `<x...>` 수집기라 뒤 토큰을 삼킨다. 실측상 수집은 다음 `-` 접두 토큰(그리고 `--`)에서 멈추므로,
   313	 *      '값 있는 플래그들 → variadic 들 → `--` → 프롬프트' 순서면 서로를 먹지 않는다(cli-parser 가 `--tools ""` 를
   314	 *      맨 끝에 둔 것과 같은 조심의 일반화).
   315	 *
   316	 * @throws 프롬프트가 비었거나 · maxTurns 가 1 이상의 정수가 아니거나 · addDirs/allowRules 가 비었거나 ·
   317	 *         규칙/경로 토큰이 `-` 로 시작할 때.
   318	 */
   319	export function buildSessionArgs(input: SessionArgsInput): string[] {
   320	  const { prompt, allowRules, disallowRules, maxTurns, addDirs } = input;
   321	
   322	  if (typeof prompt !== "string" || prompt.trim() === "") {
   323	    throw new Error("프롬프트가 비어 있습니다 — skill-rewrite 의 치환 산물(SKILL.md 전문)을 넘기세요.");
   324	  }
   325	  // config.sdkMaxTurns 와 같은 규칙(지어내지 않는다): 읽을 수 없으면 clamp·반올림이 아니라 멈춘다.
   326	  if (!Number.isSafeInteger(maxTurns) || maxTurns < 1) {
   327	    throw new Error(`--max-turns 값이 올바르지 않습니다: '${maxTurns}' — 1 이상의 정수여야 합니다(예: 50).`);
   328	  }
   329	  if (!Array.isArray(addDirs) || addDirs.length === 0) {
   330	    throw new Error("addDirs 가 비어 있습니다 — buildAddDirs() 의 산물을 넘기세요(읽기 경계에 추가할 경로).");
   331	  }
   332	  if (!Array.isArray(allowRules) || allowRules.length === 0) {
   333	    // 규칙 0개면 세션은 산출물만 쓰고 전이하지 못한다 — 부록A-9 1차 시도의 실패 양상(산출물은 썼는데
   334	    //   전이 3회 거부 → next-action 정체) 그대로다. 조용히 그 상태를 만드는 대신 조립에서 끊는다.
   335	    throw new Error(
   336	      "allowRules 가 비어 있습니다 — 무인 세션은 전이 명령 한 줄을 통과시킬 규칙이 없으면 산출물만 쓰고 게이트에서 정체합니다. " +
   337	        "skill-rewrite 의 도출 산물을 넘기세요.",
   338	    );
   339	  }
   340	
   341	  // variadic 자리에 들어가는 caller 문자열은 **`-` 로 시작하면 안 된다**: 파서가 그 토큰을 옵션으로 읽어
   342	  //   ① 수집을 조기 종료(= 뒤 규칙들이 조용히 누락 = 경계가 의도와 달라짐) ② 최악의 경우 그 토큰 자체가
   343	  //   플래그로 해석된다(`--dangerously-skip-permissions` 를 규칙인 척 흘려보내는 길). 조립에서 끊는다.
   344	  for (const [label, values] of [
   345	    ["--add-dir", addDirs],
   346	    ["--allowedTools", allowRules],
   347	    ["--disallowedTools", disallowRules],
   348	  ] as const) {
   349	    for (const v of values) {
   350	      if (typeof v !== "string" || v === "") {
   351	        throw new Error(`${label} 항목이 비어 있습니다 — 빈 토큰은 인자 위치를 밀어 조립을 어긋나게 합니다.`);
   352	      }
   353	      if (v.startsWith("-")) {
   354	        throw new Error(
   355	          `${label} 항목은 '-' 로 시작할 수 없습니다: '${v}' — 인자 파서가 이 토큰을 옵션으로 읽어 뒤 항목을 누락시키거나 ` +
   356	            "플래그로 실행합니다(경계가 조용히 달라집니다).",
   357	        );
   358	      }
   359	    }
   360	  }
   361	
   362	  return [
   363	    "-p",
   364	    // 봉투(JSON)로 받아야 러너가 결과·비용·permission_denials 를 읽는다(도구 흔적 = 경계가 하중을 받은 증거).
   365	    "--output-format",
   366	    "json",
   367	    "--permission-mode",
   368	    SESSION_PERMISSION_MODE,
   369	    "--max-turns",
   370	    String(maxTurns),
   371	    // 여기부터 variadic — 각각 다음 `-` 접두 토큰에서 멈춘다(위 순서 규약 ②).
   372	    "--add-dir",
   373	    ...addDirs,
   374	    "--tools",
   375	    SESSION_TOOLS,
   376	    /**
   377	     * 규칙 **1건 = argv 토큰 1개**로 넘긴다.
   378	     *
   379	     * ⚠ **미실측 — W5 카나리 확인 필요**: 부록A 는 `--allowedTools` 에 **여러 규칙을 어떤 형태로 넘겼는지
   380	     *   기록하지 않았다**(한 토큰에 공백으로 이어붙였는지 · 규칙마다 토큰을 나눴는지 · 플래그를 반복했는지).
   381	     *   A-9 가 확인해 준 건 '두 규칙이 실제로 매칭됐다'는 결과뿐이다. 그러니 이 선택은 실측이 아니라 **판단**이다:
   382	     *     · 우리 규칙은 **내부에 공백이 있다**(`Bash(bash /abs/scripts/run-stage.sh brief rid)`). 한 토큰에
   383	     *       이어붙이면 규칙 내부 공백과 구분자 공백을 CLI 가 무엇으로 가르는지에 경계를 맡기게 된다.
   384	     *     · A-9 는 공백 포함 규칙 하나가 **온전히 매칭**됐음을 보였다(전이 성공) = 토큰 내부 공백으로 규칙을
   385	     *       쪼개지는 않는다. 그렇다면 토큰을 나누는 쪽이 '구분자 해석'을 CLI 에 넘기지 않는 유일한 형태다.
   386	     *   다만 **여러 토큰을 각각 독립 규칙으로 읽는지**는 라이브에서만 확인된다. 틀리면 전이가 거부되고
   387	     *   next-action 이 정체해 드러난다(= 조용한 통과가 아니라 fail-closed) — W5 무인 완주가 그 카나리다.
   388	     */
   389	    "--allowedTools",
   390	    ...allowRules,
   391	    ...(disallowRules.length > 0 ? ["--disallowedTools", ...disallowRules] : []),
   392	    // `--` 가 옵션 파싱을 끝낸다 → 뒤의 프롬프트는 frontmatter 로 시작해도 피연산자로 안전하게 수용된다(위 ①).
   393	    "--",
   394	    prompt,
   395	  ];
   396	}
   397	
   398	/** 세션 1건을 띄우는 데 필요한 전부(러너가 이걸 그대로 소비한다 — 축을 빠뜨릴 여지를 없앤다). */
   399	export interface SessionPlan {
   400	  /** `claude` 에 넘길 argv. */
   401	  argv: string[];
   402	  /** spawn cwd = 읽기 경계(`<coreRoot>/runs/<rid>`). */
   403	  cwd: string;
   404	  /** spawn env(위생 재구성 + 격리 CONFIG_DIR + OAuth). */
   405	  env: Record<string, string>;
   406	  /** 격리 CONFIG_DIR 에 쓸 settings 내용·경로(쓰기는 러너의 몫 — 이 모듈은 순수). */
   407	  settings: WorkerSettings;
   408	  settingsJson: string;
   409	  settingsPath: string;
   410	  /** 조립에 쓰인 add-dir(관측·로그용). */
   411	  addDirs: string[];
   412	}
   413	
   414	export interface SessionPlanInput {
   415	  /** core(하네스) 체크아웃 절대경로(config.harnessRoot()). */
   416	  coreRoot: string;
   417	  /** 이 잡의 run_id. */
   418	  rid: string;
   419	  /** state.json 에 사람이 선언한 규제도메인(팩 선택 키) — 이 세션이 볼 수 있는 팩은 이것 하나뿐이다. */
   420	  domain: string;
   421	  /** skill-rewrite 의 치환 산물. */
   422	  prompt: string;
   423	  /** skill-rewrite 의 도출 규칙. */
   424	  allowRules: string[];
   425	  /** config.sdkMaxTurns(). */
   426	  maxTurns: number;
   427	  /** 워커가 이 잡용으로 만든 전용 빈 디렉터리(절대경로). 생성·정리는 러너의 몫. */
   428	  configDir: string;
