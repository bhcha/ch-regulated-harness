    57	export const AUX_ALLOW_RULES: Record<SupportedStage, readonly string[]> = {
    58	  intake: ["Bash(shasum:*)"],
    59	  brief: [],
    60	};
    61	
    62	/** SKILL.md 원문의 상대 호출 형태(치환 대상) — core/skills 관례상 항상 `bash scripts/run-stage.sh`. */
    63	const RUN_STAGE_INVOCATION = "bash scripts/run-stage.sh";
    64	/** run-stage 스크립트의 core 상대 경로(절대경로 조립용). */
    65	const RUN_STAGE_RELPATH = ["scripts", "run-stage.sh"] as const;
    66	/** SKILL.md 의 run_id 자리표시자. */
    67	const RUN_PLACEHOLDER = "<RUN>";
    68	/** 읽기전용 입력 로드 호출을 가르는 플래그(전이 명령 판별에 사용). */
    69	const EMIT_CONTEXT_FLAG = "--emit-context";
    70	
    71	/**
    72	 * 셸 조합 문자 — 하나라도 있으면 그 명령은 규칙이 될 수 없다.
    73	 *   allow 규칙은 '한 줄 정확 문자열' 매칭이라 파이프·연쇄·치환이 섞이면 결박 자체가 성립하지 않고,
    74	 *   `(`·`)` 는 `Bash(...)` 규칙 문법을 깨뜨린다. 실측에서도 모델의 파이프 시도(`… | head -5`)는 거부됐다(부록A-10).
    75	 *   치환되지 않은 자리표시자(`<FOO>`)도 여기 걸려 fail-closed 된다 — 자리표시자 드리프트의 안전망.
    76	 */
    77	const SHELL_METACHARS = /[|&;<>()`$\\'"]/;
    78	
    79	/**
    80	 * 허용되는 env 접두 — **이름 패턴이 아니라 `NAME=VALUE` 리터럴의 정확 목록**이자 그 **정본 순서**다.
    81	 *
    82	 * 부록A-9 가 "접두를 원문 그대로 보존하라"고 요구한 건 실측된 **이 두 쌍**이지 '임의의 env' 가 아니다.
    83	 *   접두를 이름 패턴(`^[A-Za-z_]\w*=`)으로 열어두면 아래가 '정상 전이'로 분류돼 규칙이 된다:
    84	 *
    85	 *     BASH_ENV=<run 디렉터리>/.boot bash <절대>/scripts/run-stage.sh brief r1
    86	 *
    87	 *   bash 는 run-stage 를 실행하기 **전에** `BASH_ENV` 가 가리키는 파일을 source 한다. 거기에
    88	 *   `trap 'bash …/approve.sh r1 --ra-ok' EXIT` 한 줄이면 사람의 승인 게이트와 RA 확인이 함께 자동 통과되는데,
    89	 *   밖에서 보이는 도구 호출은 **허용된 run-stage 한 줄뿐**이다 — 즉 펜스 안 `approve.sh` 를 거부하는 필터를
    90	 *   **간접 등가물로 우회**한다. 결정은 사람의 몫이고(AGENTS 5번 절) 그 경계는 코드가 보장해야 한다.
    91	 *   같은 부류: `ENV`·`LD_PRELOAD`·`PATH`·`SHELLOPTS`·`IFS`·`BASH_FUNC_*=`.
    92	 *   → 목록 밖 접두가 붙으면 규칙이 아니라 '예상 밖'으로 보고한다(fail-closed).
    93	 *
    94	 * **값까지** 고정하는 이유: 이름만 맞으면 통과시키면 `HARNESS_CLI=stub`(CI 전용 — AGENTS 2번 절)이나
    95	 *   `HARNESS_GEN_MODE=subprocess`(폐기된 세션 밖 헤드리스 생성)가 무인 세션에 새어든다.
    96	 *   실제로 skills 코퍼스에는 `HARNESS_GEN_MODE=subprocess`·`HARNESS_IMAGE_CLI=nanobanana`·`HARNESS_OFFLINE=1` 이
    97	 *   존재하지만, **지원 단계(intake·brief)의 도출 대상 명령이 쓰는 건 아래 둘뿐이다**(원문 실측).
    98	 *   코퍼스에 있다는 이유로 통째 허용하지 않는다 — 허용은 실측이 요구한 만큼만.
    99	 *
   100	 * **순서·중복**까지 고정하는 이유: 리터럴이 고정이라 순서를 바꿔도 결과 env 는 같아 그 자체가 위험하진 않다.
   101	 *   다만 지원 단계의 원문은 정확히 이 순서이고, 일탈은 **SKILL.md 가 변했다는 신호**다 —
   102	 *   조용히 흡수하면 경계가 파싱 결과를 따라 저절로 넓어진다. 새 형태의 채택 여부는 실측할 사람의 몫이다(부록A-11 3번).
   103	 */
   104	const ENV_PREFIX_SEQUENCE = ["HARNESS_CLI=claude", "HARNESS_GEN_MODE=insession"] as const;
   105	
   106	/**
   107	 * 명령 앞의 env 접두를 소비하고 **다음 토큰의 인덱스**를 돌려준다.
   108	 *   허용 = ENV_PREFIX_SEQUENCE 의 순서를 지키는 **부분 수열**(중복 없음). 접두가 아예 없어도 된다(`--emit-context` 줄).
   109	 *   목록 밖·순서 역전·중복을 만나면 **거기서 멈춘다** — 그러면 호출부의 `tokens[i] !== "bash"` 검사에 걸려
   110	 *   그 명령은 규칙 자격을 잃는다(별도 예외를 던지지 않아도 fail-closed 로 수렴한다).
   111	 */
   112	function consumeEnvPrefix(tokens: string[]): number {
   113	  let i = 0;
   114	  let nextAllowed = 0; // 다음에 올 수 있는 정본 위치 — 순서 강제 + 같은 쌍의 재등장(중복) 차단.
   115	  while (i < tokens.length) {
   116	    const at = (ENV_PREFIX_SEQUENCE as readonly string[]).indexOf(tokens[i]);
   117	    if (at < 0 || at < nextAllowed) break;
   118	    nextAllowed = at + 1;
   119	    i++;
   120	  }
   121	  return i;
   122	}
   123	
   124	/** 마크다운 펜스 오프너/클로저(리스트 항목 안이라 들여쓰기가 있을 수 있어 trim 후 판정). */
   125	const FENCE_OPEN = /^```(\S*)\s*$/;
   126	const FENCE_CLOSE = /^```\s*$/;
   127	
   128	export interface RewriteSkillInput {
   129	  /** `skills/<stage>/SKILL.md` 원문(읽기는 호출부의 일 — 이 모듈은 순수). */
   130	  skillMd: string;
   131	  /** 단계명(SUPPORTED_STAGES 중 하나). */
   132	  stage: string;
   133	  /** 실제 run_id — `<RUN>` 자리에 박힌다. */
   134	  rid: string;
   135	  /** core 체크아웃 **절대경로**. 상대경로는 cwd 의존이라 거부(결정론 위반). */
   136	  coreRoot: string;
   137	}
   138	
   139	export interface RewrittenSkill {
   140	  /** 무인 세션에 그대로 넘길 프롬프트 = 치환된 SKILL.md 전문(프리앰블을 덧붙이지 않는다 — 부록A-10). */
   141	  prompt: string;
   142	  /** `--allowedTools` 에 넘길 규칙 = 도출 규칙(문서 순서) + 실측 보조 도구 규칙. */
   143	  allowRules: string[];
   144	  /** 치환된 전이 명령 한 줄(복구 세션이 정확히 이 문자열을 필요로 한다). */
   145	  transitionCommand: string;
   146	  /** 펜스 안인데 run-stage 호출이 아닌 명령들 — **보고 전용**. 비어있지 않으면 호출부가 거부해야 한다. */
   147	  unexpectedFencedCommands: string[];
   148	}
   149	
   150	/** 단계 지원 판정 — keyvisual 은 별도 메시지로 먼저 가른다(원인이 다르다: 미측정이 아니라 구조적 부재). */
   151	function assertSupportedStage(stage: string): asserts stage is SupportedStage {
   152	  if (stage === "keyvisual") {
   153	    throw new Error(
   154	      "keyvisual 은 무인 세션으로 돌릴 수 없습니다(계획 W0 미해결 3번) — 이 단계가 쓰는 도구들의 " +
   155	        "타입드 도구 대응물이 존재하지 않아, 재설계 없이는 무인 편입이 불가능합니다. 사람 소비자로 남깁니다.",
   156	    );
   157	  }
   158	  if (!(SUPPORTED_STAGES as readonly string[]).includes(stage)) {
   159	    throw new Error(
   160	      `무인 지원 단계가 아닙니다: '${stage}'. 지원 = ${SUPPORTED_STAGES.join(" · ")} ` +
   161	        "(부록A-11 — 무인 완주 실측이 있는 단계만 편입합니다. 새 단계는 dry-run 1회로 먼저 측정하세요).",
   162	    );
   163	  }
   164	}
   165	
   166	/** core 절대경로 검증 + run-stage 절대경로 조립. */
   167	function resolveRunStagePath(coreRoot: string): string {
   168	  if (typeof coreRoot !== "string" || coreRoot.trim() === "") {
   169	    throw new Error("coreRoot 가 필요합니다 — core(하네스) 체크아웃 절대경로를 넘기세요.");
   170	  }
   171	  if (!isAbsolute(coreRoot)) {
   172	    throw new Error(
   173	      `coreRoot 는 절대경로여야 합니다(받은 값: '${coreRoot}'). 상대경로는 cwd 에 따라 결과가 달라져 ` +
   174	        "치환 결정론이 깨지고, 부록A-10 실측상 모델이 상대경로 깊이를 오산해 명령이 거부됩니다.",
   175	    );
   176	  }
   177	  if (/\s/.test(coreRoot) || SHELL_METACHARS.test(coreRoot)) {
   178	    throw new Error(`coreRoot 에 공백·셸 메타문자를 쓸 수 없습니다(allow 규칙 문자열이 깨집니다): '${coreRoot}'`);
   179	  }
   180	  return join(coreRoot, ...RUN_STAGE_RELPATH);
   181	}
   182	
   183	/** 펜스 안에서 뽑아낸 논리 명령 한 건. */
   184	interface FencedCommand {
   185	  /** 치환 후 논리 명령(백슬래시 연속행은 한 줄로 결합). */
   186	  command: string;
   187	  /** 이 논리 명령이 몇 개의 물리 줄로 쓰였나 — 2 이상이면 규칙 결박이 불가능하다(아래 참조). */
   188	  physicalLines: number;
   189	}
   190	
   191	/**
   192	 * ```bash 펜스 안의 명령만 순서대로 수집한다(치환된 텍스트 기준).
   193	 *   · 인용문 안 펜스(`> ```)는 trim 후에도 `>` 로 시작해 오프너에 걸리지 않는다 — 자연히 제외된다.
   194	 *   · 백슬래시 연속행은 한 논리 명령으로 결합하되 physicalLines 로 흔적을 남긴다(분류에서 fail-closed).
   195	 */
   196	function collectFencedBashCommands(text: string): FencedCommand[] {
   197	  const out: FencedCommand[] = [];
   198	  let inFence = false;
   199	  let isBashFence = false;
   200	  let pending: string[] = [];
   201	
   202	  const flushPending = (): void => {
   203	    if (pending.length === 0) return;
   204	    out.push({ command: pending.join(" "), physicalLines: pending.length });
   205	    pending = [];
   206	  };
   207	
   208	  for (const raw of text.split("\n")) {
   209	    const line = raw.trim();
   210	
   211	    if (!inFence) {
   212	      const open = FENCE_OPEN.exec(line);
   213	      if (open) {
   214	        inFence = true;
   215	        isBashFence = open[1] === "bash";
   216	      }
   217	      continue;
   218	    }
   219	
   220	    if (FENCE_CLOSE.test(line)) {
   221	      // 닫히지 않은 연속행(끝이 `\`)이 남아있으면 그대로 흘려보낸다 → 분류에서 '예상 밖'이 된다.
   222	      flushPending();
   223	      inFence = false;
   224	      isBashFence = false;
   225	      continue;
   226	    }
   227	    if (!isBashFence) continue;
   228	
   229	    // 빈 줄·주석은 명령이 아니다(다만 연속행 중간이라면 그 연속은 끊긴 것으로 본다).
   230	    if (line === "" || line.startsWith("#")) {
   231	      flushPending();
   232	      continue;
   233	    }
   234	    if (line.endsWith("\\")) {
   235	      pending.push(line.slice(0, -1).trim());
   236	      continue;
   237	    }
   238	    pending.push(line);
   239	    flushPending();
   240	  }
   241	  flushPending(); // 펜스가 안 닫힌 문서도 조용히 삼키지 않는다.
   242	  return out;
   243	}
   244	
   245	/**
   246	 * 이 논리 명령이 '이 단계의 run-stage 호출'로서 규칙이 될 자격이 있는가.
   247	 *
   248	 * 통과 조건(전부 만족해야 한다 — 하나라도 어긋나면 규칙이 아니라 '예상 밖'으로 보고):
   249	 *   ① 물리 줄 1개  — allow 규칙은 한 줄 정확 문자열이라 여러 줄 명령은 결박 불가.
   250	 *   ② 셸 메타문자 없음 — 파이프·연쇄가 섞이면 경계가 무의미해진다.
   251	 *   ③ `bash <절대 run-stage 경로>` 로 시작(env 접두는 **허용 목록 안일 때만** 허용·보존) — 치환을 비껴간 **상대경로 호출은 거부**한다.
   252	 *      (치환 패턴은 `bash scripts/run-stage.sh` 리터럴이라, 원문이 `sh …`·`./scripts/…` 로 드리프트하면
   253	 *       상대경로가 남는데 그걸 규칙으로 승격하면 부록A-10 이 금지한 바로 그 형태가 된다.)
   254	 *   ④ 스크립트 다음 토큰 = 이 단계명, 그 다음 토큰 = 이 rid — 남의 단계·남의 런을 건드리는 형태는 규칙이 아니다.
   255	 *   ⑤ 나머지 토큰은 `--flag` 형태만.
   256	 */
   257	function isDerivableRunStageCommand(cmd: FencedCommand, absRunStage: string, stage: string, rid: string): boolean {
   258	  if (cmd.physicalLines !== 1) return false;
   259	  if (SHELL_METACHARS.test(cmd.command)) return false;
   260	
   261	  const tokens = cmd.command.split(/\s+/);
   262	  // env 접두는 **허용 목록에 있는 리터럴만** 소비·보존한다(부록A-9 는 이 두 쌍을 요구했지 임의 env 를 허용한 게 아니다).
   263	  //   목록 밖 접두(BASH_ENV·LD_PRELOAD·PATH…)는 소비되지 않고 남아 바로 아래 `bash` 검사에서 걸린다.
   264	  let i = consumeEnvPrefix(tokens);
   265	  if (tokens[i] !== "bash") return false;
   266	  i++;
   267	  if (tokens[i] !== absRunStage) return false;
   268	  i++;
   269	  if (tokens[i] !== stage) return false;
   270	  i++;
   271	  if (tokens[i] !== rid) return false;
   272	  i++;
   273	  return tokens.slice(i).every((t) => t.startsWith("--"));
   274	}
   275	
   276	/**
   277	 * SKILL.md 를 결정론적으로 치환하고 그 산물에서 allow 규칙을 도출한다.
   278	 *
   279	 * @throws 미지원 단계 · 안전하지 않은 rid · 비-절대 coreRoot · 전이 명령이 정확히 1개가 아닌 경우.
   280	 */
   281	export function rewriteSkill(input: RewriteSkillInput): RewrittenSkill {
   282	  const { skillMd, stage, rid, coreRoot } = input;
   283	
   284	  assertSupportedStage(stage);
   285	  if (!isSafeRunId(rid)) {
   286	    throw new Error(
   287	      `run_id 가 안전한 토큰이 아닙니다: '${rid}'. 영숫자·'.'·'_'·'-' 만 허용합니다 ` +
   288	        "(이 값은 allow 규칙 문자열에 그대로 박히므로 공백·셸 메타문자는 경계를 훼손합니다).",
   289	    );
   290	  }
   291	  if (typeof skillMd !== "string" || skillMd.trim() === "") {
   292	    throw new Error(`SKILL.md 원문이 비어있습니다(stage=${stage}) — 읽기는 호출부의 일입니다.`);
   293	  }
   294	  const absRunStage = resolveRunStagePath(coreRoot);
   295	
   296	  // ① 상대 호출 → 절대경로(부록A-10) ② <RUN> → 실제 rid. split/join = 리터럴 전역 치환(정규식 이스케이프 불필요).
   297	  //   치환은 **문서 전체**에 적용한다(산문의 안내 명령도 절대경로가 돼야 거짓말이 되지 않는다).
   298	  //   선별은 아래 '규칙 도출' 단계의 일이지 치환의 일이 아니다 — 두 관심사를 섞지 않는다.
   299	  const prompt = skillMd
   300	    .split(RUN_STAGE_INVOCATION)
   301	    .join(`bash ${absRunStage}`)
   302	    .split(RUN_PLACEHOLDER)
   303	    .join(rid);
   304	
   305	  const derived: string[] = [];
   306	  const unexpectedFencedCommands: string[] = [];
   307	  const transitions: string[] = [];
   308	
   309	  for (const cmd of collectFencedBashCommands(prompt)) {
   310	    if (!isDerivableRunStageCommand(cmd, absRunStage, stage, rid)) {
   311	      unexpectedFencedCommands.push(cmd.command);
   312	      continue;
   313	    }
   314	    derived.push(cmd.command);
   315	    // 전이 = 상태를 쓰는 호출. `--emit-context` 는 읽기전용 입력 로드라 전이가 아니다.
   316	    if (!cmd.command.split(/\s+/).includes(EMIT_CONTEXT_FLAG)) transitions.push(cmd.command);
   317	  }
   318	
