   435	/**
   436	 * 세션 1건 조립의 단일 진입점 — 부록A-9 의 축을 **한 번에** 묶는다.
   437	 *
   438	 * 왜 조립기를 따로 두나: 축이 하나라도 빠지면 경계가 조용히 약해진다(add-dir 를 빠뜨리면 세션이 못 읽어 시끄럽게
   439	 *   실패하지만, **settings 를 빠뜨리면 state 쓰기 금지가 사라지고 아무 소리도 안 난다**). 러너가 축을 손으로
   440	 *   재조립하지 않도록 여기서 한 덩이로 돌려준다 — '경계를 정하는 자리는 한 곳'이라는 이 모듈의 존재 이유 그대로다.
   441	 */
   442	export function buildSessionPlan(input: SessionPlanInput): SessionPlan {
   443	  const cwd = buildRunCwd({ coreRoot: input.coreRoot, rid: input.rid });
   444	  const addDirs = buildAddDirs({ coreRoot: input.coreRoot, domain: input.domain });
   445	  const settings = buildWorkerSettings({ runDir: cwd, addDirs });
   446	  const argv = buildSessionArgs({
   447	    prompt: input.prompt,
   448	    allowRules: input.allowRules,
   449	    disallowRules: buildDisallowedTools(input.coreRoot),
   450	    maxTurns: input.maxTurns,
   451	    addDirs,
   452	  });
   453	  const env = buildSessionEnv(input.baseEnv, {
   454	    configDir: input.configDir,
   455	    ...(input.oauthToken !== undefined ? { oauthToken: input.oauthToken } : {}),
   456	  });
   457	  return {
   458	    argv,
   459	    cwd,
   460	    env,
   461	    settings,
   462	    settingsJson: serializeWorkerSettings(settings),
   463	    settingsPath: join(input.configDir, WORKER_SETTINGS_FILENAME),
   464	    addDirs,
   465	  };
   466	}
