   });
+
+  it("무인 워커 파일도 스캔 대상에 실제로 잡힌다(가드가 src/worker/ 를 비껴가지 않는다)", () => {
+    // supervisor·cli-session-runner·run-domain 등이 반드시 스캔된다 — 폴더 오타로 조용히 0개 스캔되는 것을 막는다.
+    expect(tsFiles(WORKER_DIR).length).toBeGreaterThan(2);
