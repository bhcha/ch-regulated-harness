   278	  input: RunJobSessionInput,
   279	  deps: RunJobSessionDeps,
   280	): Promise<RunJobResult> {
   281	  const now = deps.now ?? Date.now;
   282	  const readDomain = deps.readDomain ?? readDeclaredDomain;
