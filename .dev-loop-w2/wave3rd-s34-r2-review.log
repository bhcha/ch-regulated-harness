   231	/**
   232	 * 복구 세션 프롬프트(전이 전용) — **고정 최소 템플릿 + 전이 명령 verbatim**. 프리앰블로 생성 명령 형태를
   233	 *   교정하려는 게 아니다(부록A-10 이 금지한 것): 여기선 '정확히 이 한 줄만 쳐라'라고 말하고, 그 한 줄이 곧 **유일한
   234	 *   allow 규칙**이라 모델이 다른 걸 치면 fail-closed 된다. 프롬프트의 변수는 transitionCommand 하나뿐(결정론).
   235	 */
   236	function recoveryPrompt(transitionCommand: string): string {
   237	  return [
   238	    "# 복구 세션(전이 전용)",
   239	    "",
   240	    "이 단계의 산출물은 이미 작성됐고, 상태 전이 호출만 실패했습니다.",
   241	    "아래 명령을 **정확히 그대로** 한 번만 실행하세요. 경로·인자·환경변수 접두를 바꾸거나 다른 명령을 덧붙이지 마세요:",
   242	    "",
   243	    "```bash",
   244	    transitionCommand,
   245	    "```",
   246	    "",
   247	    "이 명령 외에는 파일을 읽거나 쓰지 말고, 아무 것도 하지 마세요. 전이가 끝나면 종료하세요.",
   248	  ].join("\n");
   249	}
