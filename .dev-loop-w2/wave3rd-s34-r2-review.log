   311	    const skillMd = await readSkillMd(input.coreRoot, input.stage);
   312	    const rewritten = rewriteSkill({ skillMd, stage: input.stage, rid: input.rid, coreRoot: input.coreRoot }); // ②
   313	    // 펜스에 예상 밖 명령이 있으면 **호출부가 거부한다**(부록A-11 3번 · 조용히 규칙으로 승격하지 않는다).
   314	    if (rewritten.unexpectedFencedCommands.length > 0) {
   315	      return {
   316	        ok: false,
   317	        reason: "unexpected_commands",
   318	        detail: `SKILL.md(stage=${input.stage}) 펜스에 예상 밖 명령: ${rewritten.unexpectedFencedCommands.join(" · ")}`,
   319	      };
   320	    }
   321	    transitionCommand = rewritten.transitionCommand;
