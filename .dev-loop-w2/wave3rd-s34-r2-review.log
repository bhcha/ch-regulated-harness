   });
 
   const writeScript = (body: string): void =>
     writeFileSync(join(fakeRoot, "scripts", "next-action.sh"), `#!/usr/bin/env bash\n${body}\n`);
 
   test("bash <root>/scripts/next-action.sh <rid> → stdout JSON 파싱(+인자 전달)", async () => {
