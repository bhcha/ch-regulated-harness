     expect(na.stage).toBe("brief");
   });
 
   test("비-0 종료 스크립트 → throw(code+stderr)", async () => {
     writeScript(`echo "boom-from-script" >&2\nexit 7`);
     process.env.HARNESS_ROOT = fakeRoot;
