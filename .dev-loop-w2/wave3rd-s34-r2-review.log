   284	  const writeSettings = deps.writeSettings ?? defaultWriteSettings;
   285	  const supervise = deps.supervise; // 필수 seam(기본값 없음 — 원장 배선은 호출자 몫 · 위 supervise 주석).
   286	  const readNext = deps.readNext ?? readNextAction;
   287	  const artifactPresent = deps.artifactPresent ?? defaultArtifactPresent;
   288	
   289	  // MEDIUM#2 — config 게터(sdkGenTimeout·sdkMaxTurns)는 **명시 오설정에 던진다**(예: CHAT_SDK_MAX_TURNS=0 ·
   290	  //   CHAT_SDK_GEN_TIMEOUT=30m). 이 읽기가 아래 첫 try 밖에 있으면 그 throw 가 runJobSession 을 **reject** 시키고,
   291	  //   supervisor 의 `void main()` 이 결과 없이 죽어 데몬이 실패를 분류 못 한다. '늘 구조적 RunJobResult 를 보고한다'는
   292	  //   계약을 지키려면 던질 수 있는 이 읽기도 가드 안으로 들여, config_error(실패)로 환원한다. input 으로 값이 오면
