   186	 *      출력 회수)·reap_failed(마감 기계 실패)·spawn_failed(그룹 미기동)·ledger_unwritable(2급 백스톱 미확립)·
   187	 *      refused(스폰 여유 부족)는 전이가 우연히 보여도 성공이 아니다(MEDIUM#4·HIGH#1).
   188	 *
   189	 * ⚠ **성공 오판 방지가 이 매핑의 핵심**: 어떤 outcome 도 매핑 없이 아래 전이 확인으로 흘러 ok:true 가 되면 안 된다.
   190	 *   switch 끝의 `never` 가드가 SessionOutcome 이 늘 때 **컴파일을 깨** 새 outcome 을 명시 매핑하게 강제한다
   191	 *   (unmapped-fallthrough-to-success = 이 재정렬이 막으려는 바로 그 버그류).
   192	 *
   193	 * `reap_failed` 만 phase 로 갈린다 — 주 세션은 `reap_failed`, 복구 세션은 `recovery_reap_failed`(진단 분리). 나머지
   194	 *   실패 사유는 phase 무관(같은 의미). detail 은 호출부가 supervise 결과의 detail 을 그대로 싣는다.
   195	 */
   196	type OutcomeDisposition =
   197	  | { kind: "check-transition" }
   198	  | { kind: "fail"; reason: RunJobFailReason };
   199	
   200	function classifyOutcome(outcome: SessionOutcome, phase: SessionRole): OutcomeDisposition {
   201	  switch (outcome) {
   202	    case "exited":
   203	    case "killed":
   204	      // 그룹 소멸 확인된 정상 종료 — 성공은 전이됐을 때만(러너가 next-action 으로 판정).
   205	      return { kind: "check-transition" };
   206	    case "reap_failed":
   207	      // 마감 기계 자체가 실패(그룹 생존). '결국 종료'가 아니라 지금 실패다 — 복구도 시도하지 않는다.
   208	      return { kind: "fail", reason: phase === "recovery" ? "recovery_reap_failed" : "reap_failed" };
   209	    case "refused":
   210	      // 스폰 여유 부족으로 애초에 안 띄웠다(러너 사전검사 뒤 시계가 흘러 supervisor 가 다시 거부한 경우 포함).
   211	      return { kind: "fail", reason: "refused_insufficient_time" };
   212	    case "spawn_failed":
   213	      // 세션이 pid 를 못 냄(claude 부재·EACCES) — 실행된 그룹 없음(HIGH#1). 전이·산출물 확인 무의미.
   214	      return { kind: "fail", reason: "spawn_failed" };
   215	    case "ledger_unwritable":
   216	      // 소유권 원장(2급 백스톱)이 안 서서 supervisor 가 그룹을 회수했다 — 백스톱 없이 돌지 않았다(HIGH).
   217	      return { kind: "fail", reason: "ledger_unwritable" };
   218	    case "output_cap":
   219	      // 출력 상한(32MiB) 초과 cap-kill = 실패. **전이 관측 전에** 끊는다(우연한 전이를 성공으로 오판 금지 · MEDIUM#4).
   220	      return { kind: "fail", reason: "output_cap" };
   221	    default: {
   222	      // 도달 불가 — 위 케이스가 SessionOutcome 을 소진한다(never 가 컴파일 타임 보증). 방어적으로 실패 처분한다
   223	      //   (미처리 outcome 이 절대 성공 경로로 새지 않게 · runJobSession 은 여기서도 던지지 않는다).
   224	      const _exhaustive: never = outcome;
   225	      void _exhaustive;
   226	      return { kind: "fail", reason: "config_error" };
   227	    }
   228	  }
   229	}
