 /** 필수 문자열 payload 추출 — 없으면 노출안전한 BadJobError. */
 function requireStr(v: unknown, label: string): string {
   if (typeof v === "string" && v.trim() !== "") return v;
   throw new BadJobError(`${label} 정보가 없어 처리할 수 없습니다.`);
 }
 
 /** 선택 문자열 payload 추출(빈 문자열/비문자열 = 미지정). */
