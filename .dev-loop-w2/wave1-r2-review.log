   341	// ── 클레임·정리(rename 기반) ───────────────────────────────────────────────────
   342	
   343	/**
   344	 * 클레임 = `rename(pending/X → claimed/<consumer>/X)`. **경합의 승자는 OS 가 정한다**: 동시에 집으면 rename 이
   345	 *   하나만 성공하고 나머지는 원본이 사라져 ENOENT → null(깨끗한 패배). 승자만 그 잡을 만진다.
   346	 * @returns 승자면 claimed 경로, 패자·이미 없어짐이면 null.
   347	 */
   348	export async function claimJob(
   349	  dirs: JobDirs,
   350	  job: GenerateJobFile,
   351	  consumerId: string,
   352	): Promise<string | null> {
   353	  assertConsumerId(consumerId);
   354	  const name = jobFileName(job.run_id, job.stage);
   355	  const destDir = join(dirs.claimed, consumerId);
   356	  await mkdir(destDir, { recursive: true });
   357	  const to = join(destDir, name);
   358	  try {
   359	    await rename(join(dirs.pending, name), to);
   360	    return to;
   361	  } catch (e) {
   362	    if (isEnoent(e)) return null; // 누가 먼저 집었거나 봇이 회수함 — 정상 패배.
   363	    throw e;
   364	  }
   365	}
   366	
   367	/** 성공 = 잡 파일 삭제(수명주기 종료). 이미 없으면 no-op(멱등). */
   368	export async function completeJob(claimedPath: string): Promise<void> {
   369	  try {
   370	    await unlink(claimedPath);
   371	  } catch (e) {
   372	    if (!isEnoent(e)) throw e;
   373	  }
   374	}
   375	
   376	/**
   377	 * 실패 = `failed/X` + 사유 파일(`X.reason`). 부분 성공은 없다 — 실패한 잡은 큐에서 빠지고 사람이 본다.
   378	 *
   379	 * 순서: **잡을 먼저 옮기고 사유를 쓴다.** 반대로 하면(사유 먼저) 사유 파일 경로가 잡보다 먼저 존재해, 같은 잡을
   380	 *   처분하려던 다른 호출이 자기 실패를 정리하며 **승자의 사유 파일을 지운다**(사유 없는 실패 잡). 이 순서면 진 쪽은
   381	 *   아무것도 쓰지 않는다. 남는 위험은 '옮긴 직후 죽어 사유가 안 써지는' 창(µs)뿐이고, 그건 사유 없는 실패 잡 하나로
   382	 *   그친다(파일은 남아 사람이 본다).
   383	 *   ⚠ 검토 이력(㉢): 이 순서는 리뷰에서 **의도적으로 유지**하기로 했다 — 뒤집는 대안이 더 나쁘고(위), 나머지 대안은
   384	 *     값이 더 비싸다(사람 규약 복잡화). 재검토 불필요.
   385	 *   ⚠ 호출 전제: **그 잡을 소유한 상태**(클레임 승자)여야 한다 — takePendingJob 은 클레임 뒤에만 부른다.
   386	 *   ⚠ 알려진 한계: failed 경로도 `<rid>-<stage>` 라, 같은 단계의 잡 둘이 **동시에 살아 있다가 둘 다 실패**하면
   387	 *     나중 것이 앞의 기록을 덮는다(사유가 다른 실패를 가리킬 수 있다). 그 상황 자체가 이미 비정상이고(같은 단계를
   388	 *     두 소비자가 동시에 생성 — core 락·멱등 게이트가 상태는 지킨다), 실패 기록 한 줄의 정확도 문제라 파일명에
   389	 *     job_id 를 붙여 사람 규약(jobs/README 의 `mv … failed/`)을 복잡하게 만드는 대신 이 한계를 남긴다.
   390	 * @returns failed 경로.
   391	 */
   392	export async function failJob(dirs: JobDirs, fromPath: string, reason: string): Promise<string> {
   393	  const name = basename(fromPath);
   394	  await mkdir(dirs.failed, { recursive: true });
   395	  const dest = join(dirs.failed, name);
   396	  await rename(fromPath, dest);
   397	  await writeFile(`${dest}${REASON_SUFFIX}`, `${reason}\n`, "utf8");
   398	  return dest;
   399	}
   400	
   401	/**
   402	 * 클레임 해제 = pending 복귀. **쓰이는 자리는 하나뿐이다 — `takePendingJob` 이 일을 시작하기도 전에 물러설 때**
   403	 *   (레거시·판단 불가·처분 중 IO 오류). 그 시점엔 세션이 없으므로 되돌려도 아무도 두 번 일하지 않는다.
   404	 *
   405	 * ★ **W4 계약(못 박는다): 세션이 뜬 뒤엔 절대 해제하지 않는다 — 그 뒤의 결말은 complete(성공)·fail(실패) 둘뿐이다.**
   406	 *   일하는 중인 세션의 잡을 대기줄에 되돌리면 그 세션과 그 잡을 새로 집는 소비자가 **같은 런을 동시에 쓴다**
   407	 *   (reaper 가 재큐를 버린 이유와 같다 — 되살릴 근거는 늘 '저쪽은 죽었을 것'이라는 추정이고, 추정은 펜스가 아니다).
   408	 * ⚠ reaper 는 이 함수를 쓰지 않는다(마감 리스 — 재큐 개념 자체가 없다).
   409	 *
   410	 * **no-clobber**: 같은 이름의 새 잡이 이미 대기 중이면 그 새 잡(마감이 더 넉넉하다)을 옛 클레임으로 덮지 않고,
   411	 *   이쪽을 버린다(중복 잡 제거). link+unlink 를 쓰는 이유 = rename 은 무조건 덮어써서 '있는지 보고 옮기기'의
   412	 *   경합 창이 생기기 때문(`enqueueJob` 의 배타 생성도 같은 패턴이다).
   413	 * @returns 실제로 복귀시켰으면 true, 새 잡이 있어 버렸으면 false.
   414	 */
   415	export async function releaseJob(dirs: JobDirs, claimedPath: string): Promise<boolean> {
   416	  const name = basename(claimedPath);
   417	  await mkdir(dirs.pending, { recursive: true });
   418	  const dest = join(dirs.pending, name);
   419	  try {
   420	    await link(claimedPath, dest);
   421	  } catch (e) {
   422	    if (!isEexist(e)) throw e;
   423	    await completeJob(claimedPath); // 새 잡이 이미 대기 중 — 고아는 중복이라 버린다.
   424	    return false;
   425	  }
   426	  await completeJob(claimedPath); // 하드링크 성공 → 원본 링크 제거(= 이동 완료).
   427	  return true;
   428	}
