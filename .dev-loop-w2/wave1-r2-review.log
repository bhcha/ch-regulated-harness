   197	      }
   198	      if (this.now() >= deadline) {
   199	        // 봇 타임아웃 = 회수: 아직 pending 인 **자기 잡**만 거둬들인다(job_id 대조 — 같은 단계로 새로 적재된
   200	        //   잡이 있으면 그건 남의 요청이라 손대지 않는다). 이미 클레임됐으면 회수 실패 → 늦은 성공이 가능하다.
   201	        const recalled = await recallPendingJob(this.jobsPendingDir, job);
   202	        throw new Error(
   203	          recalled
   204	            ? `브리지 생성 대기 시간 초과(run=${run_id}, stage=${stage}) — 아무도 처리하지 않아 대기 중이던 요청을 거둬들였습니다.`
   205	            : // 회수 실패의 사정은 여럿이다(소비자가 집어 감 · 만료 처분됨 · 새 잡이 덮어씀) — 봇은 구분하지 못하므로
   206	              // 단정하지 않는다. 어느 쪽이든 사람이 확인할 길은 같다([상태 다시 확인]).
   207	              `브리지 생성 대기 시간 초과(run=${run_id}, stage=${stage}) — 대기 중이던 요청을 회수하지 못했습니다` +
   208	              `(소비자가 이미 집었거나 처분된 상태). 늦게 완료될 수 있습니다([상태 다시 확인]으로 화해).`,
