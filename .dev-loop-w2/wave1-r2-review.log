   222	  }
   223	
   224	  /** 생성 완료 판정 — 요청한 stage 가 더 이상 '현재 생성 대상'이 아니면 전이로 본다(판정 SSoT = job-protocol). */
   225	  private transitioned(na: NextAction, requestedStage: string): boolean {
   226	    return !isGenerateTurn(na, requestedStage);
   227	  }
   228	}
   229	
   230	// ── 3) Agent SDK 세션 워커(S-1 · 무인 · live-only 미검증) ─────────────────────────
   231	/** Agent SDK 로 insession 생성을 수행하는 실제 워커. 산출물 작성 + `run-stage.sh`(insession) 전이까지 책임진다. */
   232	export type SdkGenerate = (run_id: string, stage: string) => Promise<void>;
   233	
   234	export interface AgentSdkDeps {
   235	  /**
   236	   * 실제 Agent SDK 생성 호출. **미주입이면 S-1 미배선**으로 보고 실행 시 명확히 실패한다(fail-closed) —
   237	   *   selectGenExecutor 는 sdkGenerate 가 있을 때만 이 실행기를 고른다(없으면 브리지).
   238	   */
   239	  sdkGenerate?: SdkGenerate;
   240	  /** 전이 확인용 next-action 조회(기본 contract-client). */
   241	  readNext?: (rid: string) => Promise<NextAction>;
   242	}
   243	
   244	/**
   245	 * AgentSdkGenExecutor — 운영자 세션 없이 Agent SDK 세션 워커로 insession 생성을 돌리고(무인, S-1), 그 뒤
   246	 *   next-action 으로 전이를 확인한다(브리지와 동일 완료 계약). 세션 마커·SDK 배선은 이 레포에 없어 **오프라인
   247	 *   검증 불가**(live-only) — sdkGenerate 미주입 시 fail-closed. state.json 직접 쓰기 0(전이는 core scripts).
   248	 */
   249	export class AgentSdkGenExecutor implements GenExecutor {
   250	  private readonly sdkGenerate: SdkGenerate;
   251	  private readonly readNext: (rid: string) => Promise<NextAction>;
   252	  constructor(deps: AgentSdkDeps = {}) {
   253	    this.sdkGenerate =
   254	      deps.sdkGenerate ??
   255	      (() => {
   256	        throw new Error(
   257	          "AgentSdkGenExecutor: S-1(Agent SDK 세션 워커)가 배선되지 않았습니다 — sdkGenerate 를 주입하거나 C2 브리지를 쓰세요.",
   258	        );
   259	      });
   260	    this.readNext = deps.readNext ?? defaultReadNextAction;
   261	  }
   262	  async execute(run_id: string, stage: string): Promise<void> {
   263	    assertGenArgs(run_id, stage);
   264	    // 이미 전이돼 있으면(중복) 즉시 반환.
   265	    if (this.transitioned(await this.readNext(run_id), stage)) return;
   266	    await this.sdkGenerate(run_id, stage); // Agent SDK insession 워커: 산출물 작성 + run-stage(insession) 전이.
   267	    // 완료 계약(브리지와 동일): 세션 워커가 다 했으면 요청 stage 가 더 이상 현재 생성 대상이 아니어야 한다.
   268	    if (!this.transitioned(await this.readNext(run_id), stage)) {
   269	      throw new Error(`AgentSdk 생성 후 전이 미확인(run=${run_id}, stage=${stage}) — 세션 워커가 전이시키지 못했습니다.`);
   270	    }
   271	  }
   272	  /** 브리지와 동일 판정(SSoT = job-protocol.isGenerateTurn). */
   273	  private transitioned(na: NextAction, requestedStage: string): boolean {
   274	    return !isGenerateTurn(na, requestedStage);
   275	  }
   276	}
   277	
   278	// ── 선택기 ─────────────────────────────────────────────────────────────────────
   279	export interface SelectGenDeps {
   280	  /** 오프라인 판정(기본 config.isOffline). */
   281	  offline?: () => boolean;
