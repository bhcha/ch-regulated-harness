   294	export function selectGenExecutor(deps: SelectGenDeps = {}): GenExecutor {
   295	  const offline = deps.offline ?? isOffline;
   296	  if (offline()) return new StubDirectGenExecutor();
   297	  const unmanned = deps.unmannedS1 ?? genUnmannedS1;
