   418	/**
   419	 * run_id 가 '경로 세그먼트로 안전한가' — 파일경로에 넣기 전 검증(디렉터리 탈출·클로버 방지).
   420	 * 허용: 영숫자 · '.'·'_'·'-' (하네스 run_id 관례 = kebab/영숫자). 슬래시·역슬래시·널·`.`/`..` 단독은 불가.
   421	 * (chat 레이어가 rid 를 data/<rid> 등 경로에 쓰므로 `../other` 같은 값이 남의 run 입력을 덮어쓰는 것을 막는다.)
   422	 */
   423	export function isSafeRunId(rid: string): boolean {
   424	  if (typeof rid !== "string" || rid.length === 0 || rid.length > 128) return false;
   425	  if (rid === "." || rid === "..") return false;
   426	  return /^[A-Za-z0-9._-]+$/.test(rid);
   427	}
