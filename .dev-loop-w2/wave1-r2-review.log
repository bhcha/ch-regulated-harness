   182	    // 종단 마감 단일 원천(프로토콜 v2): 봇의 폴링 마감을 **잡 파일에 실린 그 값**에서 읽는다 — 따로 재면 봇이
   183	    //   포기한 뒤에도 소비자가 '아직 안 늦었다'고 보는 어긋남이 생긴다.
   184	    const deadline = parseDeadline(job);
   185	    if (deadline === null) {
   186	      // buildGenerateJob 이 만든 잡이라 도달 불가. 조용히 지어낸 마감으로 폴링하느니 드러낸다(마감은 보증의 뿌리다).
   187	      throw new Error(`적재한 잡에 마감이 없습니다(run=${run_id}, stage=${stage}) — 프로토콜 위반.`);
   188	    }
   189	    for (;;) {
   190	      const na = await this.readNext(run_id);
   191	      // ⚠ 순서 주의(의도): 마감 검사보다 **전이 검사가 먼저**다. 마감이 지난 뒤에 본 전이라도 그건 '실제로 된 것'이라
   192	      //   성공으로 보고한다 — 우리 타이머가 지났다는 이유로 끝난 일을 실패로 알리면 카드가 사실과 어긋난다.
   193	      //   (봇이 이미 포기해 실패 카드를 띄운 뒤의 늦은 전이는 이 루프 밖의 일이라 [상태 다시 확인]이 맡는다.)
