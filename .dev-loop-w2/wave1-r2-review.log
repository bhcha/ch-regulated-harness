   939	        moved
   940	          ? {
   941	              path,
   942	              consumer,
   943	              action: "failed",
   944	              reason: "expired",
   945	              detail: "마감이 지난 채 전이되지 않음 — 재큐하지 않는다(새 요청이 새 마감을 받는다)",
