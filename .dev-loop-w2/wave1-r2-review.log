   385	/**
   386	 * 무인 워커 시간 설정의 정합 검사 — `sdkGenTimeout() + 기동 여유 ≤ bridgeTimeout()` (계획 5절 기동 검증).
   387	 *   어기면 세션이 예산을 다 쓰기 전에 잡이 먼저 만료된다 = 완주한 산출물이 버려지고 운영자는 이유를 모른다.
   388	 *
   389	 * **관계 위반은 던지지 않고 결과로 돌려준다**(순수 검사기) — 기동 배선은 W4(소비자 데몬)의 몫이고, 여기서 throw 하면
   390	 *   이 값을 안 쓰는 다른 경로(봇 등)까지 config 를 읽다 죽는다. 부르는 쪽이 언제 멈출지 정한다.
   391	 *
   392	 * 단 **env 자체가 오설정이면 getter(sdkGenTimeout·bridgeTimeout)의 예외가 그대로 올라온다** — 일부러 그렇게 둔다.
   393	 *   이 검사기가 판정하는 건 '잘 읽힌 두 값 사이의 관계'지 '값을 읽을 수 있는가'가 아니다. 오설정을 {ok:false} 로
   394	 *   바꿔 담으면 관계 위반과 구별이 안 되고, 무엇보다 fail-fast 를 드러내야 할 자리에서 되레 삼키게 된다.
   395	 * @throws CHAT_SDK_GEN_TIMEOUT·CHAT_BRIDGE_TIMEOUT 이 명시됐는데 초 단위 양수가 아니면 Error(getter 전파).
   396	 */
   397	export interface WorkerTimeoutCheck {
   398	  ok: boolean;
   399	  /** ok=false 일 때만. 운영자가 무엇을 어떻게 고쳐야 하는지 알려주는 평이한 한국어 사유. */
   400	  reason?: string;
   401	}
   402	export function validateWorkerTimeouts(): WorkerTimeoutCheck {
   403	  const gen = sdkGenTimeout();
   404	  const bridge = bridgeTimeout();
   405	  const needed = gen + WORKER_STARTUP_MARGIN_MS;
   406	  if (needed <= bridge) return { ok: true };
   407	  const sec = (ms: number) => Math.round(ms / 1000);
   408	  return {
   409	    ok: false,
   410	    reason:
   411	      `무인 생성 시간(CHAT_SDK_GEN_TIMEOUT=${sec(gen)}초)에 기동 여유 ${sec(WORKER_STARTUP_MARGIN_MS)}초를 더하면 ` +
   412	      `${sec(needed)}초라, 봇의 대기 상한(CHAT_BRIDGE_TIMEOUT=${sec(bridge)}초)을 넘습니다 — 세션이 다 끝내기 전에 ` +
   413	      `요청이 먼저 만료돼 결과가 버려집니다. CHAT_SDK_GEN_TIMEOUT 을 ${sec(bridge - WORKER_STARTUP_MARGIN_MS)}초 이하로 줄이거나 ` +
   414	      `CHAT_BRIDGE_TIMEOUT 을 ${sec(needed)}초 이상으로 올리세요.`,
   415	  };
   416	}
