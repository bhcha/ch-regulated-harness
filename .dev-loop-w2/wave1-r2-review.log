    73	// ── 2) 브리지(C2 — 기본 운영 경로) ─────────────────────────────────────────
    74	
    75	/**
    76	 * 이미 누가 집어 **작업 중**이라 새 요청을 적재하지 않았다는 신호(이중 소비 차단 — enqueueJob 의 ok=false).
    77	 *
    78	 * 별도 타입인 이유: worker 는 제3자 예외를 "생성을 마치지 못했습니다"(FAIL_MESSAGES)로 치환하는데, 여기선 그게
    79	 *   **거짓말**이다 — 못 만든 게 아니라 지금 만들고 있다. 그래서 worker 가 이 오류만은 알아보고 message 를 그대로
    80	 *   카드에 싣는다(BadJobError 와 같은 계약: 우리가 쓴 평이 한국어라 노출 안전).
    81	 * 실패(ok=false)로 환원하는 것은 의도다: 성공으로 두면 onOutcome 의 자동 이어가기가 같은 단계 생성 잡을 **또**
    82	 *   넣어(next-action 이 그대로 생성 차례다) 우리가 막은 그 중복을 스스로 만든다.
    83	 */
    84	export class GenerationInProgressError extends Error {
    85	  constructor(message: string) {
    86	    super(message);
    87	    this.name = "GenerationInProgressError";
    88	  }
    89	}
    90	
    91	/**
    92	 * 적재 차단 시 현업에게 보이는 한 줄(operator-voice — 내부 용어 0: '클레임'·'잡'·'소비자'를 쓰지 않는다).
    93	 *   실패 카드에 실려 [상태 다시 확인] 버튼과 함께 뜬다(어댑터 renderFailure) — '다시 확인'의 실제 출구가 그 버튼이다.
    94	 */
    95	const MSG_ALREADY_IN_PROGRESS = "이미 만들고 있어요 — 잠시 후 다시 확인해 주세요.";
    96	/** 판단 불가(권한·IO)일 때의 한 줄 — 만들고 있다고 **단정하지 않는다**(모르는 것을 아는 척하지 않는다). */
    97	const MSG_CANNOT_TELL = "지금 상태를 확인하지 못했어요 — 잠시 후 다시 확인해 주세요.";
    98	
    99	export interface BridgeDeps {
   100	  /** 전이 감지용 next-action 조회(기본 contract-client.readNextAction). */
   101	  readNext?: (rid: string) => Promise<NextAction>;
   102	  /** pending 잡 디렉터리(기본 storagePaths().jobsPending). */
   103	  jobsPendingDir?: string;
   104	  /** claimed 잡 디렉터리(기본 storagePaths().jobsClaimed) — 이중 소비 차단 조회용(읽기 전용). */
   105	  jobsClaimedDir?: string;
   106	  /** 폴링 간격(ms, 기본 3000). */
   107	  pollIntervalMs?: number;
   108	  /** 최대 대기(ms, 기본 config.bridgeTimeout() = env CHAT_BRIDGE_TIMEOUT · 900초). 초과 시 Error(무한대기 금지). */
   109	  timeoutMs?: number;
   110	  /** 테스트 주입: sleep. */
   111	  sleep?: (ms: number) => Promise<void>;
   112	  /** 테스트 주입: 현재시각(ms). */
   113	  now?: () => number;
   114	}
   115	
   116	const defaultSleep = (ms: number): Promise<void> => new Promise((r) => setTimeout(r, ms));
   117	
   118	/** 생성 인자 검증 — 변조된 잡의 run_id/stage 가 파일경로를 탈출(`../`)하는 것 차단(세 실행기 공통). */
   119	function assertGenArgs(run_id: string, stage: string): void {
   120	  if (!isSafeRunId(run_id)) throw new Error(`gen-executor: run_id 형식이 안전하지 않습니다: ${run_id}`);
   121	  if (!isSafeStage(stage)) throw new Error(`gen-executor: stage 형식이 안전하지 않습니다: ${stage}`);
   122	}
   123	
   124	/**
   125	 * BridgeGenExecutor — 셸을 직접 띄우지 않고 pending 잡 파일을 적재한 뒤, 소비자(운영자 Claude Code 세션 ·
   126	 *   후속의 무인 데몬)가 세션 내(insession) 생성으로 전이시키기를 next-action 폴링으로 기다린다(전이 감지 시 resolve).
   127	 *   무한 대기 금지 — timeoutMs 초과 시 명확한 Error. 파일 기록만(state 직접쓰기 0).
   128	 *
   129	 * 프로토콜 v2 에서 봇 몫(chat-dual-surface-plan 3절 — 큐·커널 로직은 그대로, 봇 변경은 additive):
   130	 *   · 적재하는 잡에 `expires_at`(= 적재시각 + timeoutMs) 을 싣는다 — 봇의 폴링 마감과 **같은 값**이다(이중 시계 금지).
   131	 *   · 대기 상한 초과 시 아직 pending 인 **자기 잡을 회수**한다(나중 소비자가 봇 몰래 되살리는 창을 닫는다).
   132	 *   · 회수 실패(이미 클레임됨) = 늦은 성공이 가능하다는 뜻 → 그 화해는 실패 카드의 [상태 다시 확인] 버튼이 한다
   133	 *     (보증 3분법의 봇 몫 — 봇은 소비자를 죽일 수 없으므로 UX 로 닫는다).
   134	 *   · 회수 성공 = 요청이 사라졌다는 뜻(core 는 그대로 생성 차례) → [상태 다시 확인]이 그 사실을 확인하고 [다시 만들기]
   135	 *     카드를 낸다(flow.presentationForStatusCheck). 그 클릭은 옛 잡 부활이 아니라 이 실행기를 다시 타는 **새 요청**이다.
   136	 *   · **회수 실패 = 적재 금지**: 그 '새 요청'이 무조건 적재되면, 옛 잡을 집은 소비자와 새 잡을 집을 소비자가 같은
   137	 *     런을 동시에 쓴다(이중 소비 · 이중 과금). 그 차단은 **적재 그 자체**가 한다 — `enqueueJob`(원자 대체)이
