   308	  /** 기동 여유(ms) — 검사·클레임·세션 spawn 오버헤드 몫. */
   309	  startupMarginMs: number;
   310	  /** next-action 조회(읽기 전용). */
   311	  readNext: (rid: string) => Promise<NextAction>;
   312	}
   313	
   314	/**
   315	 * 2중 검사 — 시간(㉠) 먼저, 차례(㉡) 나중. 순서 주의: ㉠ 이 셸 없이 즉답이라 마감 지난 잡에 next-action spawn 비용을
   316	 *   쓰지 않는다. 둘 다 통과해야만 ok(하나라도 어긋나면 일하지 않는다 — fail-closed).
   317	 *
   318	 * ⚠ ㉠은 ㉡ **뒤에 한 번 더** 본다: ㉡의 next-action 조회는 셸 spawn 이라 수백 ms가 걸릴 수 있고, 그동안 기동 여유가
   319	 *   닳는다. 조회 전 시각으로만 판정하면 '검증할 땐 있던 예산'이 일을 시작할 땐 없다. 재검사는 순수 계산이라 공짜다.
   320	 */
   321	export async function doubleCheckJob(job: GenerateJobFile, deps: DoubleCheckDeps): Promise<JobCheck> {
   322	  const budget = checkBudget(job, deps.now(), deps.budgetMs, deps.startupMarginMs);
   323	  if (!budget.ok) return budget;
   324	  let na: NextAction;
   325	  try {
   326	    na = await deps.readNext(job.run_id);
   327	  } catch (e) {
   328	    const msg = e instanceof Error ? e.message : String(e);
   329	    return { ok: false, reason: "unreadable", detail: `next-action 조회 실패: ${msg}` };
   330	  }
   331	  if (!isGenerateTurn(na, job.stage)) {
   332	    return {
   333	      ok: false,
   334	      reason: "transitioned",
   335	      detail: `그 단계 생성 차례가 아님(현재 step=${String(na.step)} stage=${na.stage ?? "-"})`,
   336	    };
   337	  }
   338	  return checkBudget(job, deps.now(), deps.budgetMs, deps.startupMarginMs); // 조회에 걸린 시간만큼 예산 재확인
   339	}
