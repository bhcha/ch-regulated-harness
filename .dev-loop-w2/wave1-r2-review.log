   207	 */
   208	export function nlParser(): "auto" | "stub" | "cli" | "api" {
   209	  const raw = readEnv("CHAT_NL_PARSER");
   210	  if (raw === undefined) return "auto";
   211	  if (raw === "auto" || raw === "stub" || raw === "cli" || raw === "api") return raw;
   212	  throw new Error(
   213	    `CHAT_NL_PARSER 값이 올바르지 않습니다: "${raw}" — auto|stub|cli|api 중 하나여야 합니다.`,
   214	  );
   215	}
