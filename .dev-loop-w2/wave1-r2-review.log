   430	/**
   431	 * 봇 타임아웃 회수 — **자기 잡일 때만** pending 에서 거둬들인다(job_id 대조). 소비자가 이미 클레임했으면(파일 없음)
   432	 *   no-op 이고, 같은 단계로 **새 잡이 다시 적재**됐으면(job_id 다름) 건드리지 않는다 — 남의 요청을 지우면 그 요청이 증발한다.
   433	 *
   434	 * **이 회수는 2차 방어다(1차는 마감 그 자체).** 봇이 타임아웃하는 순간은 정의상 `now ≥ expires_at` 이라, 남아 있는
   435	 *   잡은 이미 만료다 — 어떤 소비자가 집으려 해도 2중 검사 ㉠에 걸려 failed/ 로 간다. 회수는 그 뻔한 결말을 앞당기는
   436	 *   **정리**일 뿐이라 실패해도 안전하다(그래서 읽기 오류도 '회수 못 함'으로 환원한다).
   437	 * ⚠ 읽기-후-삭제라 원자적이지 않다. 창이 좁게 유지되는 근거는 **적재자가 하나**라는 배치 전제다: pending/ 을 쓰는 것은
   438	 *   봇뿐이고(Socket Mode 봇은 워크스페이스당 1 프로세스), 그 잡큐는 run 별 FIFO 라 같은 run 의 다음 생성 잡은 이
   439	 *   execute 가 끝난 **뒤에** 적재된다. job_id 대조는 그 위의 2차 방어다. 봇을 다중화하려면(같은 jobs/ 를 공유하는
   440	 *   2 프로세스) 이 회수도 클레임처럼 rename 기반으로 바꿔야 한다 — 다만 그 배치는 카드·잡 중복부터 깨진다.
   441	 * @returns 실제로 회수했으면 true.
   442	 */
   443	export async function recallPendingJob(pendingDir: string, job: GenerateJobFile): Promise<boolean> {
   444	  const path = join(pendingDir, jobFileName(job.run_id, job.stage));
   445	  // 읽기 실패(권한·IO)는 '회수 못 함'으로 환원한다 — 봇의 타임아웃 보고를 fs 예외로 바꾸지 않는다(사람 문구가 사라진다).
   446	  const cur = await readJobFile(path).catch(() => null);
   447	  // job_id 는 v2 잡에만 있다 — 둘 다 '비지 않은 문자열'이고 같을 때만 자기 잡으로 인정(옛/변조 잡 오삭제 차단).
   448	  if (!cur || !job.job_id || cur.job_id !== job.job_id) return false;
   449	  try {
   450	    await unlink(path);
   451	    return true;
   452	  } catch (e) {
   453	    if (isEnoent(e)) return false; // 그 사이 누가 집었다 — 정상.
   454	    throw e;
   455	  }
   456	}
   457	
   458	/** 같은 run·stage 를 이미 집고 있는 클레임 1건(적재 차단 판정의 근거). */
   459	export interface ClaimedJobRef {
   460	  /** 클레임 경로(`claimed/<consumer>/<rid>-<stage>.json`). */
   460	  /** 클레임 경로(`claimed/<consumer>/<rid>-<stage>.json`). */
   461	  path: string;
   462	  /** 그 잡을 집은 소비자 id(= `claimed/` 밑 디렉터리명). */
   463	  consumer: string;
   464	  /** 집힌 잡 실물(이름이 아니라 이 내용이 그 소비자가 할 일이다). */
   465	  job: GenerateJobFile;
   466	  /** 절대 마감(ms). **null = 마감 미기재**(v1 레거시) — '만료'가 아니라 '알 수 없음'이다. */
   467	  deadlineMs: number | null;
   468	}
   469	
   470	/**
   471	 * **적재 차단 조회(봇 몫 · `enqueueJob` 2단계)** — 같은 run·stage 를 **마감이 아직 남은 소비자가 이미 집고 있는가**.
   472	 *   있으면 그 클레임을, 없으면 null 을 낸다. non-null 이면 새 잡을 적재하지 않는다(in_progress).
   473	 *
   474	 * 왜 필요한가(이중 소비 구멍): 회수(recallPendingJob)는 `pending/` 만 본다 — 소비자가 이미 집었으면 회수에 실패하고
   475	 *   봇은 실패 카드를 낸다. 그런데 core 는 그대로 그 단계 생성 차례라, [상태 다시 확인] → [다시 만들기] 가 **새 잡**을
   476	 *   적재한다(파일명이 같아도 옛 잡은 `claimed/` 에 있어 덮이지 않는다). 그러면 두 소비자가 같은 런의 산출물을 동시에
   477	 *   쓰고 돈도 두 번 든다. "[다시 만들기]는 클레임된 잡을 되살리지 않는다"는 v2 의 보증은 **같은 잡 파일**에만 참이라
   478	 *   이 결말을 막지 못한다 — 막을 자리는 되살리기가 아니라 **적재 그 자체**다(enqueueJob 이 1단계 unlink 로 옛 잡을
   479	 *   내린 **뒤** 이 조회를 부르므로, 여기서 보이는 클레임은 '이미 내구적으로 성립한 것' 전부다 — 그 근거는 enqueueJob 주석).
   480	 *
   481	 * 판정 규칙(마감이 기준 · 소비자 생사를 묻지 않는다 — 그건 reaper 의 지식이다):
   482	 *   · 마감이 남음(`expires_at > now`) → **막는다**. 규약상 그 소비자는 마감까지 일할 권리가 있다.
   483	 *   · 마감 지남 → 막지 않는다. 규약상 아무도 마감 뒤엔 일하지 않으므로(2중 검사 ㉠), 죽은 클레임 하나가 런을 영영
   484	 *     묶어선 안 된다. 그 잡의 뒷정리는 reaper 몫이고 새 요청은 새 마감을 받는다.
   485	 *   · **마감 미기재(v1 레거시) → 막는다(fail-closed)**. '죽었다'를 증명할 수 없어서다. 여기서 마감을 지어내면
   486	 *     (예 '적재시각+상한') 사람이 손으로 소비 중인 잡을 봇이 죽은 것으로 단정한다 — 모르는 것을 아는 척하는 쪽이
   487	 *     더 나쁘다. 그 잡이 끝나거나 사람이 치우면 곧 풀린다.
   488	 *
   489	 * ⚠ **이름으로만 찾는다**: claimJob 이 목적지 이름을 잡 내용에서 만들므로(`jobFileName(run_id, stage)`), 규약대로
   490	 *   집힌 클레임은 반드시 이 이름으로 있다. 내용이 이름과 어긋나는 파일은 그 이름의 일감이 아니라 건너뛴다
   491	 *   (listPendingJobs 와 같은 가드 — 하류가 canonical 이름을 쓴다).
   492	 * ⚠ 읽기 실패(권한·IO)는 **던진다** — '클레임 없음'으로 위장하면 이 함수의 존재 이유(중복 적재 차단)가 조용히
   493	 *   무력화된다. 막을지 말지는 호출부가 정한다(enqueueJob = unknown 으로 fail-closed). ENOENT(그 소비자는 이 잡을 안
   494	 *   갖고 있음)·형태 불일치만 readJobFile 규약대로 '일감 아님'이다.
   495	 *
   496	 * ⚠ **'우리 잡은 빼고 본다'(옛 excludeJobId)는 없다**: 그건 적재 **뒤** 재검사 전용이었는데(그때 보이는 우리 잡은
   497	 *   소비자가 제 일을 집어 간 정상이라 빼야 했다), 원자 대체(enqueueJob)는 적재 **전에** 한 번만 조회하므로 그 시점에
   498	 *   우리 잡은 존재하지도 않는다 — 뺄 것이 없다. 보이는 클레임은 전부 남의 것이고, 전부 막을 근거다.
   499	 */
   500	export async function findBlockingClaimedJob(
   501	  claimedDir: string,
   502	  run_id: string,
   503	  stage: string,
   504	  nowMs: number,
   505	): Promise<ClaimedJobRef | null> {
   506	  const name = jobFileName(run_id, stage); // assertJobArgs 포함 — 경로 탈출은 fs 접촉 전에 거부
   507	  let consumers: string[];
   508	  try {
   509	    consumers = (await readdir(claimedDir, { withFileTypes: true }))
   510	      .filter((d) => d.isDirectory())
   511	      .map((d) => d.name)
   512	      .sort(); // 이름순 = 결정적 순서(여럿이 막아도 같은 것을 보고한다)
   513	  } catch (e) {
   514	    if (isEnoent(e)) return null; // claimed/ 없음 = 아무도 집지 않았다.
   515	    throw e; // 권한·IO 오류를 '클레임 없음'으로 위장하지 않는다.
   516	  }
   517	  for (const consumer of consumers) {
   518	    const path = join(claimedDir, consumer, name);
   519	    const job = await readJobFile(path);
   520	    if (!job || jobFileName(job.run_id, job.stage) !== name) continue;
   521	    const deadlineMs = parseDeadline(job);
   522	    if (deadlineMs !== null && deadlineMs <= nowMs) continue; // 마감 지남 = 산 클레임이 아니다.
   523	    return { path, consumer, job, deadlineMs };
   524	  }
   525	  return null;
   526	}
   527	
   528	// ── 봇 진입점(적재 = 원자 대체) ────────────────────────────────────────────────
   529	
   530	/** 적재가 만지는 두 면. 실패 격리는 적재의 일이 아니라 `failed` 를 요구하지 않는다(JobDirs 도 그대로 들어맞는다). */
   531	export type EnqueueDirs = Pick<JobDirs, "pending" | "claimed">;
   532	
   533	export interface EnqueueInput {
   534	  run_id: string;
   535	  stage: string;
   536	  /** 봇 대기 상한(ms · config.bridgeTimeout). expires_at 의 원천. */
   537	  timeoutMs: number;
   538	}
   539	
   540	/**
   541	 * 적재 결과 — **적재자가 아는 결말은 이 셋뿐이다**:
   542	 *   ok=true      → 우리 잡이 대기줄에 정확히 1건 있다. 봇은 `job.expires_at` 을 제 폴링 마감으로 쓴다(마감 단일 원천).
   543	 *   in_progress  → 같은 run·stage 를 마감 남은 소비자가 이미 집고 있다 → **적재하지 않았다**.
   544	 *   unknown      → **남이 일하는 중임을 배제하지 못했다** → 적재하지 않았다(fail-closed).
   545	 *
   546	 * 두 실패를 가르는 기준은 '확신'이다: in_progress 는 산 클레임을 **봤다**, unknown 은 **못 봤을 뿐 없다고 말할 수
   547	 *   없다**. 사람에게 가는 문구가 달라지므로(모르는 것을 아는 척하지 않는다) 한 값으로 뭉개지 않는다.
   548	 */
   549	export type EnqueueResult =
   550	  | { ok: true; job: GenerateJobFile; path: string }
   551	  | { ok: false; reason: "in_progress" | "unknown" };
   552	
   553	export interface EnqueueDeps {
   554	  /** 현재시각(ms) — 주입(테스트 결정성). */
   555	  now: () => number;
   556	  /**
   557	   * 배타 생성(3단계) 주입 — 기본 = link 기반 no-clobber(`createPendingExclusive`). 테스트가 EEXIST 경합을
   558	   *   결정적으로 재현하는 **유일한 이음새**다: 진짜 EEXIST 는 이 프로세스 밖의 남이 그 찰나에 같은 이름을 만들어야
   559	   *   생기는데, 그 순간을 안에서 흉내낼 방법이 없다(now() 처럼 주입으로만 붙잡힌다).
   560	   */
   561	  createExclusive?: (pendingDir: string, dest: string, job: GenerateJobFile) => Promise<boolean>;
   562	}
   563	
   564	/**
   565	 * 배타 생성(no-clobber) — tmp 에 쓰고 `link` 로 목적지를 **잡는다**. rename 은 무조건 덮어써서 '있는지 보고 옮기기'의
   566	 *   경합 창이 생기지만, link 는 목적지가 이미 있으면 EEXIST 로 진다(releaseJob 과 같은 패턴 · 원자성 원천은 OS).
   567	 * @returns 우리가 목적지를 잡았으면 true, 이미 누가 있으면 false. tmp 는 이기든 지든 반드시 지운다(찌꺼기 금지).
   568	 */
   569	async function createPendingExclusive(pendingDir: string, dest: string, job: GenerateJobFile): Promise<boolean> {
   570	  // tmp 는 '.' 로 시작 — listPendingJobs 가 건너뛴다(반쯤 쓰인 파일이 잡으로 보이지 않게).
   571	  const tmp = join(pendingDir, `.${basename(dest)}.tmp-${randomUUID()}`);
   572	  await writeFile(tmp, `${JSON.stringify(job, null, 2)}\n`, "utf8");
   573	  try {
   574	    await link(tmp, dest);
   575	    return true;
   576	  } catch (e) {
   577	    if (!isEexist(e)) throw e;
   578	    return false;
   579	  } finally {
   580	    await unlink(tmp).catch(() => {}); // 이겼으면 링크 하나 줄이고(= 이동 완료), 졌으면 찌꺼기를 치운다.
   581	  }
   582	}
   583	
   584	/**
   585	 * **적재 1급 경로(봇 몫) = 원자 대체(supersede-then-create)**. 세 걸음으로만 잡을 낳는다:
   586	 *   1) `unlink(pending/X)` — 옛 잡을 **시장에서 내린다**(ENOENT = 애초에 없었음 = 정상).
   587	 *   2) `findBlockingClaimedJob` — 마감이 남은 클레임이 있으면 in_progress(적재 없음).
   588	 *   3) 배타 생성(tmp → `link` → tmp 제거) — EEXIST 면 1)로 **한 번만** 되돌아간다.
   589	 *
   590	 * ★ **왜 이것이 이중 소비를 닫는가**(창을 좁히는 게 아니라 전제를 없앤다): 클레임은 오직 `pending/X` 에서만 태어난다
   591	 *   (`rename(pending/X → claimed/C/X)` 말고 잡이 claimed 로 갈 길이 없다). 1) 이 그 파일을 원자적으로 없애므로 —
   592	 *   unlink 와 소비자의 rename 은 커널이 직렬화해 **정확히 한쪽만 파일을 갖는다** — 어떤 클레임 시도든 둘 중 하나다:
   593	 *     ㉮ unlink **전에 이미 성공했다** → 그 클레임은 2) 의 readdir 시점에 `claimed/` 에 **내구적으로 보인다** → 막는다.
   594	 *     ㉯ unlink **뒤에 시도한다** → 원본이 없어 ENOENT 로 진다(빈손).
   595	 *   즉 옛 결함 ㉠('검사 통과 → 그 직후 C1 이 옛 잡을 집음 → 봇이 새 잡을 씀 → C2 가 집음')의 **첫 걸음이 성립하지
   596	 *   않는다**: 검사할 무렵엔 집힐 물건이 이미 없다. 그래서 적재 후 재검사·보상(옛 assertNobodyElseTookOver/withdraw)이
   597	 *   필요 없다 — 그 보상은 제 자신도 실패할 수 있었고(C2 가 우리 잡을 먼저 집으면 회수 불가), 창이
   598	 *   readdir+readFile+unlink 만큼 길었다.
   599	 *
   600	 * **1)~3) 사이에 `pending/X` 를 만들 수 있는 자**: 적재자는 봇 하나뿐이고(recallPendingJob 주석의 배치 전제 — Socket
   601	 *   Mode 봇 = 워크스페이스당 1 프로세스 · 잡큐는 run 별 FIFO 라 같은 run 의 다음 적재는 이 execute 뒤다), 예외는
   602	 *   `takePendingJob` 이 **일을 시작하기도 전에** 되돌리는 자기 클레임(releaseJob)뿐이다. 그것과 3) 이 부딪히면
   603	 *   EEXIST → 1)로 한 번 되돌아가 그 잡까지 대체한다. 되돌려진 잡은 정의상 **아직 아무도 시작하지 않은 같은 일**이라
   604	 *   더 신선한 것으로 대체하는 게 옳다. 그래서 재시도는 **1회면 족하다** — 2회째 EEXIST 는 '적재자가 봇 하나'라는
   605	 *   전제가 깨졌다는 뜻이고(누군가 계속 같은 이름을 만든다), 그건 남이 일하는 중임을 배제하지 못한 것이라 unknown 이다.
   606	 *
   607	 * **정책(그대로 유지)**: 같은 이름의 옛 pending 잡은 **더 신선한 요청으로 대체**한다(같은 일의 옛 요청 · v1→v2 승격
   608	 *   경로 포함 — jobs/README 'v1 레거시 잡' 절). 바뀐 것은 **기전**뿐이다: 덮어쓰기(rename) → 원자 제거 + 배타 생성.
   609	 *   옛 잡을 **채택**(그대로 두고 기다리기)하지 않는 이유 = 그 잡의 마감은 남이 정한 것이라 봇의 폴링 마감이 정의되지
   610	 *   않는다(마감 단일 원천이 깨진다).
   611	 *
   612	 * **오류 처리 원칙**: `unknown` 은 '**남이 일하는 중인지 판정하지 못했다**'는 뜻이지 '기록이 실패했다'가 아니다.
   613	 *   1)·2) 의 IO 오류는 그 판정을 불가능하게 만들므로(옛 잡이 살아남아 언제든 집힐 수 있다 · 클레임을 못 본다)
   614	 *   unknown 으로 막고, 3) 의 IO 오류(EEXIST 아님)는 판정에 모호함이 없는 순수 기록 실패라 **그대로 던진다**
   615	 *   (아무것도 만들지 않았다). 두 실패를 뭉개면 호출부가 사람에게 할 말이 달라진다.
   616	 *
   617	 * ⚠ 전제(로컬 POSIX fs): rename·unlink·link 의 원자성과 **즉시 가시성**. `jobs/` 를 NFS/FUSE 에 두면 이 펜스는 깨진다.
   618	 */
   619	export async function enqueueJob(
   620	  dirs: EnqueueDirs,
   621	  input: EnqueueInput,
   622	  deps: EnqueueDeps,
   623	): Promise<EnqueueResult> {
   624	  assertJobArgs(input.run_id, input.stage);
   625	  const name = jobFileName(input.run_id, input.stage);
   626	  const dest = join(dirs.pending, name);
   627	  const create = deps.createExclusive ?? createPendingExclusive;
   628	  // 잡은 **한 번만** 만든다(재시도해도 같은 도장·같은 마감): 봇의 폴링 마감이 이 잡에서 나오므로 재시도마다 마감이
   629	  //   자라면 '적재 1건 = 마감 1개'가 흔들린다. 1~3단계에 드는 시간은 마감(기본 900초)에 견줘 무시할 수준이다.
   630	  const job = buildGenerateJob({
   631	    run_id: input.run_id,
   632	    stage: input.stage,
   633	    enqueuedAtMs: deps.now(),
   634	    timeoutMs: input.timeoutMs,
   635	  });
   636	  await mkdir(dirs.pending, { recursive: true });
   637	  for (let attempt = 1; attempt <= 2; attempt++) {
   638	    // 1) 원자 대체 1단계 — 옛 잡을 내린다. 이 뒤로 그 잡을 집을 수 있는 자는 없다(위 ㉯).
   639	    try {
   640	      await unlink(dest);
   641	    } catch (e) {
   642	      // ENOENT = 애초에 없었음(정상 · 대부분의 경우). 그 외(권한·IO)는 옛 잡이 **살아남았다**는 뜻이라 막는다:
   643	      //   그대로 적재하면 옛 잡과 새 잡이 동시에 집힐 수 있다(우리가 없애려는 바로 그 결말).
   644	      if (!isEnoent(e)) return { ok: false, reason: "unknown" };
   645	    }
   646	    // 2) 산 클레임 조회 — 여기서 보이는 것은 '1) 전에 이미 성립한 클레임' 전부다(위 ㉮).
   647	    let blocking: ClaimedJobRef | null;
   648	    try {
   649	      blocking = await findBlockingClaimedJob(dirs.claimed, input.run_id, input.stage, deps.now());
   650	    } catch {
   651	      return { ok: false, reason: "unknown" }; // 조회 실패 = 판정 불가 → fail-closed.
   652	    }
   653	    if (blocking) return { ok: false, reason: "in_progress" };
   654	    // 3) 배타 생성 — 이겼으면 대기줄의 그 이름은 우리 잡 하나뿐이다.
   655	    if (await create(dirs.pending, dest, job)) return { ok: true, job, path: dest };
   656	  }
   657	  // 2회째 EEXIST — 단일 적재자 전제가 깨졌다(누가 계속 같은 이름을 만든다). 배제하지 못했으니 막는다.
   658	  return { ok: false, reason: "unknown" };
   659	}
   660	
   740	// ── reaper(마감 지난 클레임 뒷정리) ────────────────────────────────────────────
   741	
   742	export interface ReapDeps {
   743	  dirs: JobDirs;
   744	  /** 현재시각(ms) — 주입(테스트 결정성). */
   745	  now: () => number;
   746	  /** next-action 조회(읽기 전용) — **마감이 지난** 클레임의 처분(뒷정리냐 만료 격리냐)만 가른다. */
   747	  readNext: (rid: string) => Promise<NextAction>;
   748	}
   749	
   750	export interface ReapResult {
   751	  path: string;
   752	  consumer: string;
   753	  /**
   754	   * leased    = 마감이 남았다 → **불가침**(손대지 않는다)
   755	   * completed = 마감 지남 + 이미 전이됨 → 잡 삭제(뒷정리)
   756	   * failed    = 마감 지남 + 아직 그 단계 생성 차례 → failed/ 격리(+.reason) · 깨진 잡 파일도 여기
   757	   * skipped   = v1(마감 미기재) · 판단 불가(next-action 조회 실패) · 목록에 잡힌 뒤 사라짐 → 손대지 않는다
   758	   */
   759	  action: "leased" | "completed" | "failed" | "skipped";
   760	  /**
   761	   * 판정 어휘(JobCheckReason) + reaper 고유 사유 둘:
   762	   *   leased   = 마감이 남아 판정 자체를 하지 않았다
   763	   *   vanished = **목록에 잡힌 뒤 사라졌다** — 멀쩡한 소비자가 그 사이 일을 마쳤거나(completeJob) 다른 pass 가
   764	   *              이미 처분했다. `unreadable`(깨진 잡 = 사람이 봐야 한다)과 **뜻이 정반대**라 그 값을 재활용하지
   765	   *              않는다: 하나는 정상 경합의 흔적이고 하나는 사람을 부르는 신호다.
   766	   */
   767	  reason: JobCheckReason | "leased" | "vanished";
   768	  detail?: string;
   769	}
   770	
   771	/**
   772	 * '목록에 잡힌 뒤 사라짐' 보고 1건(처분 없음 · 정상). readdir 로 이름을 본 **뒤의 모든 접촉**은 소비자의 정상 완료와
   773	 *   경합하므로, reaper 는 이 결말을 오류가 아니라 결과의 한 종류로 보고한다.
   774	 */
   775	function vanishedResult(path: string, consumer: string): ReapResult {
   776	  return {
   777	    path,
   778	    consumer,
   779	    action: "skipped",
   780	    reason: "vanished",
   781	    detail: "목록에 잡힌 뒤 사라짐(소비자가 그 사이 끝냈거나 다른 pass 가 처분함) — 처분할 것이 없다",
   782	  };
   783	}
   784	
   785	/**
   786	 * reaper 의 격리 = **경합에 져도 pass 를 깨지 않는 failJob**. `failJob` 자체는 ENOENT 를 던져야 옳다
   787	 *   (takePendingJob 은 자기가 소유한 잡을 옮기므로 원본이 사라지는 것이 진짜 이상 신호다). 반면 reaper 가 만지는 잡의
   788	 *   주인은 **남**이라, rename 이 ENOENT 로 지는 것은 '그 소비자가 방금 정상적으로 끝냈다'는 뜻이다 — 오류가 아니다.
   789	 *   ⚠ 삼키는 것은 ENOENT 하나뿐이다: EACCES·EIO 는 그대로 올린다. 진짜 오류를 조용한 skip 으로 바꾸는 것이 이
   790	 *     결함의 **거울상**이고(머리말이 경계하는 바로 그것), 그러면 격리돼야 할 잡이 아무 흔적 없이 큐에 남는다.
   791	 * @returns 실제로 격리했으면 true, 그 사이 사라졌으면 false.
   792	 */
   793	async function failJobUnlessGone(dirs: JobDirs, path: string, reason: string): Promise<boolean> {
   794	  try {
   795	    await failJob(dirs, path, reason);
   796	    return true;
   797	  } catch (e) {
   798	    if (isEnoent(e)) return false; // 옮길 원본이 없다 = 그 잡은 이미 끝났다(정상).
   799	    throw e;
   800	  }
   801	}
   802	
   803	/**
   804	 * 기동 reaper — `claimed/<소비자>/` 를 훑어 **마감이 지난** 클레임만 뒷정리한다. 처분은 마감(리스)이 정한다:
   805	 *
   806	 *   | 클레임 상태              | 처분                                                |
   807	 *   |--------------------------|-----------------------------------------------------|
   808	 *   | 마감이 남음              | **불가침**(leased) — 하트비트를 묻지도 않는다        |
   809	 *   | 마감 지남 + 전이 완료    | 삭제(completed) — 이미 끝난 일의 흔적만 치운다       |
   810	 *   | 마감 지남 + 아직 그 차례 | failed/ 격리(failed) — **재큐하지 않는다**           |
   811	 *   | 마감 미기재(v1)          | 보고만(skipped) — 생사를 알 수 없는 것에 손대지 않는다 |
   812	 *   | 그새 사라짐              | 보고만(skipped/vanished) — 처분할 것이 없다(아래 ★)  |
   813	 *
   814	 * ★ **한 잡의 정상 소멸이 pass 를 깨지 않는다.** 목록(readdir)은 스냅샷이라, 이름을 본 **뒤의 모든 접촉**(읽기·
   815	 *   failJob·completeJob)은 '멀쩡한 소비자가 그 사이 제 일을 끝냈다'와 경합한다 — 그 잡의 주인은 우리가 아니다.
   816	 *   그때의 ENOENT 는 오류가 아니라 **정상 결말**(vanished)이라 조용히 넘기고 그렇게 보고한다. 여기서 예외를 올리면
   817	 *   'reaper 를 먼저 돌린 뒤 폴링'(아래 호출 순서 규약) 때문에 **소비자 기동 자체가** 남의 정상 완료 하나로 실패한다.
   818	 *   ⚠ 그 반대도 금물이다: **삼키는 것은 ENOENT 뿐**이고 EACCES·EIO 는 그대로 올린다(진짜 오류를 조용한 skip 으로
   819	 *     바꾸면 격리돼야 할 잡이 흔적 없이 큐에 남는다 — readJobFile 머리말의 경고와 같은 축).
   820	 *
   821	 * ★ **생사 추정은 펜스가 아니다**(이 재작성의 이유). 옛 구현은 `isConsumerAlive()===false` 를 '죽음'으로 믿고 잡을
   822	 *   재큐했는데, **하트비트 정지 ≠ 죽음**이다(멈췄다 재개하는 소비자 · 느린 소비자 · 하트비트만 끊긴 소비자). 그
   823	 *   추정이 한 번 틀리면 원 소비자와 재큐된 잡을 집은 새 소비자가 **같은 런을 동시에 쓴다** — 이중 소비를 막아야 할
   824	 *   reaper 가 그 원천이 된다. 그래서 판정 근거를 '누가 살아 있나'(추정)에서 **'마감이 남았나'(파일에 박힌 사실)** 로
   825	 *   바꿨다. 적재 차단(findBlockingClaimedJob)이 쓰는 규칙과 **같은 규칙**이다 — 한 잡의 생사를 두 곳이 다르게
   826	 *   판정하면 한쪽이 반드시 틀린다. (하트비트는 폐기가 아니라 **강등**이다: W4 의 관측성·로그 몫이지 처분 근거가 아니다.)
   827	 *
   828	 * ★ **재큐를 버린 이유**: 되돌린 잡에는 새 마감이 필요한데 마감을 발행하는 자는 봇뿐이다(마감 단일 원천). reaper 가
   829	 *   마감을 지어내면 그 잡의 마감과 봇의 대기 마감이 갈라진다. 게다가 정규 복구 경로가 **이미 있다** — 만료된 클레임은
   830	 *   적재를 막지 않으므로(위와 같은 규칙) 봇의 자동 이어가기·[다시 만들기] 가 **새 마감을 단 새 잡**을 적재한다.
   831	 *   reaper 가 할 일은 큐가 거짓말하지 않게 흔적을 치우는 것뿐이다.
   832	 *
   833	 * ⚠ 예산(budgetMs·startupMarginMs)을 받지 않는다: 예산은 '지금 시작해서 끝낼 수 있나'를 묻는 값인데 reaper 는
   834	 *   **아무에게도 일을 주지 않는다**(재큐 없음). 물을 것이 없으므로 요구하지 않는다.
   835	 * ⚠ 호출 순서 규약: 소비자는 **기동 시 이 reaper 를 먼저 돌린 뒤 폴링을 시작한다**. 지난 생의 고아
   836	 *   (`claimed/<자기 id>/`)를 남겨 둔 채 새로 집으면 같은 이름의 클레임을 자기가 덮어써 그 기록을 잃는다.
   837	 */
   838	export async function reapClaimedJobs(deps: ReapDeps): Promise<ReapResult[]> {
   839	  // 시각은 pass 당 **한 번**만 읽는다: 스캔 도중 시계가 흐르면 같은 리스가 파일마다 다르게 판정된다(어중간한 상태).
   840	  //   스냅샷이 낡아 봐야 방금 만료된 리스를 'leased'(불가침)로 볼 뿐이라 늘 안전한 쪽으로 틀린다 — 다음 pass 가 치운다.
   841	  const nowMs = deps.now();
   842	  let consumers: string[];
   843	  try {
   844	    consumers = (await readdir(deps.dirs.claimed, { withFileTypes: true }))
   845	      .filter((d) => d.isDirectory())
   846	      .map((d) => d.name)
   847	      .sort();
   848	  } catch (e) {
   849	    if (isEnoent(e)) return []; // claimed/ 없음 = 고아 없음.
   850	    throw e; // 권한·IO 오류를 '고아 없음'으로 위장하지 않는다.
   851	  }
   852	  const out: ReapResult[] = [];
   853	  for (const consumer of consumers) {
   854	    const dir = join(deps.dirs.claimed, consumer);
   855	    // ENOENT = 그 사이 비워짐(정상). 그 외 오류는 '잡 없음'으로 위장하지 않고 올린다.
   856	    const names = (
   857	      await readdir(dir).catch((e: unknown) => {
   858	        if (isEnoent(e)) return [] as string[];
   859	        throw e;
   860	      })
   861	    ).sort();
   862	    for (const name of names) {
   863	      if (name.startsWith(".") || !name.endsWith(".json")) continue;
   864	      const path = join(dir, name);
   865	      const read = await readJobFileWithCause(path);
   866	      if (!read.job) {
   867	        if (read.cause === "gone") {
   868	          // ★ 목록(readdir) 이후 사라짐 = **정상 경합**이지 깨진 잡이 아니다: 멀쩡한 소비자가 그 사이 일을 마쳐
   869	          //   잡을 지웠거나(completeJob) 다른 pass 가 이미 처분했다. 이걸 '읽을 수 없음 = 깨짐'으로 뭉뚱그리면
   870	          //   failJob 의 rename 이 ENOENT 로 터져 **pass 전체가 거부**되고, 기동 시 reaper 를 먼저 돌리는 소비자는
   871	          //   (호출 순서 규약 — 아래) 남의 정상 완료 하나 때문에 뜨지 못한다. 그래서 조용히 넘기고 그렇게 보고한다.
   872	          out.push(vanishedResult(path, consumer));
   873	          continue;
   874	        }
   875	        // 파일은 있는데 잡이 아니다 = 깨진 잡 파일 → 마감을 읽을 수 없다 = 리스를 존중할 근거도 없다 → 사람이 보게
   876	        //   failed/ 로(큐에 남겨 되풀이 읽지 않는다). 리스 존중의 예외지만 안전하다: 읽을 수 없는 파일은 소비자도
   877	        //   일감으로 삼지 못한다. 격리 도중 사라지는 것 역시 정상이다(그 사이 사람이 치웠다).
   878	        const moved = await failJobUnlessGone(deps.dirs, path, "잡 파일을 읽을 수 없음(형식 오류)");
   879	        out.push(
   880	          moved
   881	            ? { path, consumer, action: "failed", reason: "unreadable", detail: "잡 파일 형식 오류" }
   882	            : vanishedResult(path, consumer),
   883	        );
   884	        continue;
   885	      }
   886	      const job = read.job;
   887	      const deadlineMs = parseDeadline(job);
   888	      if (deadlineMs === null) {
   889	        // v1 레거시 — 마감이 없으니 리스가 살았는지 죽었는지 **알 수 없다**. 모르는 것에 손대지 않는다(사람 몫).
   890	        //   옛 구현은 이걸 대기줄로 되돌렸는데, 사람이 손으로 소비 중인 파일을 매 pass 마다 흔드는 짓이었다.
   891	        out.push({
   892	          path,
   893	          consumer,
   894	          action: "skipped",
   895	          reason: "no_deadline",
   896	          detail: "expires_at 미기재(v1 레거시 잡) — 생사 판정 불가 · 사람 소비자 몫",
   897	        });
   898	        continue;
   899	      }
   900	      if (deadlineMs > nowMs) {
   901	        // 리스가 살아 있다 → **불가침**. 하트비트가 끊겼든 말든 그 소비자는 마감까지 일할 권리가 있다
   902	        //   (적재 차단과 같은 규칙 — findBlockingClaimedJob).
   903	        out.push({ path, consumer, action: "leased", reason: "leased" });
   904	        continue;
   905	      }
   906	      // 마감 지남 — 규약상 아무도 마감 뒤엔 일하지 않는다(2중 검사 ㉠). 남은 물음은 '뒷정리냐 만료 격리냐' 하나뿐이라
   907	      //   여기서만 next-action 을 부른다(산 리스에는 셸 비용을 쓰지 않는다).
   908	      let na: NextAction;
