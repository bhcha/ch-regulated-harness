   150	/** 단계 지원 판정 — keyvisual 은 별도 메시지로 먼저 가른다(원인이 다르다: 미측정이 아니라 구조적 부재). */
   151	function assertSupportedStage(stage: string): asserts stage is SupportedStage {
   152	  if (stage === "keyvisual") {
   153	    throw new Error(
   154	      "keyvisual 은 무인 세션으로 돌릴 수 없습니다(계획 W0 미해결 3번) — 이 단계가 쓰는 도구들의 " +
   155	        "타입드 도구 대응물이 존재하지 않아, 재설계 없이는 무인 편입이 불가능합니다. 사람 소비자로 남깁니다.",
   156	    );
   157	  }
   158	  if (!(SUPPORTED_STAGES as readonly string[]).includes(stage)) {
   159	    throw new Error(
   160	      `무인 지원 단계가 아닙니다: '${stage}'. 지원 = ${SUPPORTED_STAGES.join(" · ")} ` +
   161	        "(부록A-11 — 무인 완주 실측이 있는 단계만 편입합니다. 새 단계는 dry-run 1회로 먼저 측정하세요).",
   162	    );
   163	  }
   164	}
