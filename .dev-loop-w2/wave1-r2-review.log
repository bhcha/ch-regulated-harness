   217	/**
   218	 * '초 단위 env' → 밀리초 상한(공용 규약 — nlCliTimeout·bridgeTimeout·sdkGenTimeout 셋이 공유).
   219	 *
   220	 * **미설정은 기본값, 명시했는데 못 읽는 값은 즉시 예외**(계획 4절 '명시 스위치 + fail-fast'):
   221	 *   · 미설정/빈값 → 기본값. 아무 것도 안 정한 운영자에게 안전한 기본을 주는 건 오설정이 아니다.
   222	 *   · 명시했는데 숫자로 못 읽거나 0 이하(`30m`·`abc`·공백뿐·`-5`) → **예외**. 예전엔 조용히 기본값으로 폴백했지만,
   223	 *     그건 오타 하나가 **더 큰 예산**(예 `CHAT_SDK_GEN_TIMEOUT=30m` → 480초)을 말없이 승인해주는 짓이었다.
   224	 *     이 값들은 과금·무인 실행의 상한이라 '의도한 30분'과 '오타로 얻은 8분'을 운영자가 구별할 수 없으면 안 된다.
   225	 *     기동 시점에 끊는 편이, 잘못 읽은 상한으로 몇 분씩 태우는 것보다 안전하다.
   226	 *   · 유효한 양수인데 서브초 → **하한 1000ms 로 clamp**(예외 아님). 0.5초는 '읽을 수 없는 값'이 아니라
   227	 *     '너무 빡빡한 진짜 duration' 이라 시스템 바닥(1초)을 씌운다 — 서브초(0.0001초→0ms)로 반올림되면 상한이
   228	 *     사실상 0/즉시가 돼 '언제나 kill 할 수 있어야 한다'·'적재된 잡을 누군가는 집을 수 있어야 한다'는 전제가 깨진다.
   229	 *     clamp 는 위로 올려도 최대 1초라, 위 '오타가 큰 예산을 부른다' 실패 양상과는 자릿수가 다르다.
   230	 * @throws 명시했는데 초 단위 양수로 못 읽으면 Error(한국어 안내).
   231	 */
   232	function timeoutEnvMs(name: string, defaultMs: number): number {
   233	  const raw = readEnv(name);
   234	  if (raw === undefined) return defaultMs;
   235	  const sec = Number(raw);
   236	  if (!Number.isFinite(sec) || sec <= 0) {
   237	    throw new Error(
   238	      `${name} 값이 올바르지 않습니다: "${raw}" — 초 단위 양수여야 합니다(예: ${Math.round(defaultMs / 1000)}). ` +
   239	        `단위 접미사(30m·30s)나 빈칸은 쓸 수 없습니다.`,
   240	    );
   241	  }
   242	  return Math.max(1000, Math.round(sec * 1000));
   243	}
