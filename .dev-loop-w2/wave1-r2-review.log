   335	  const n = Number(raw);
   336	  if (!Number.isInteger(n) || n < 1) {
   337	    throw new Error(
   338	      `CHAT_SDK_MAX_TURNS 값이 올바르지 않습니다: "${raw}" — 1 이상의 정수여야 합니다(예: 50).`,
   339	    );
   340	  }
   341	  return n;
   342	}
