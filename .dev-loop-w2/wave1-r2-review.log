   148	  private readonly jobsClaimedDir: string;
   149	  private readonly pollIntervalMs: number;
   150	  private readonly timeoutMs: number;
   151	  private readonly sleep: (ms: number) => Promise<void>;
   152	  private readonly now: () => number;
   153	  constructor(deps: BridgeDeps = {}) {
   154	    this.readNext = deps.readNext ?? defaultReadNextAction;
   155	    this.jobsPendingDir = deps.jobsPendingDir ?? storagePaths().jobsPending;
   156	    this.jobsClaimedDir = deps.jobsClaimedDir ?? storagePaths().jobsClaimed;
   157	    this.pollIntervalMs = deps.pollIntervalMs ?? 3000;
   158	    this.timeoutMs = deps.timeoutMs ?? bridgeTimeout();
   159	    this.sleep = deps.sleep ?? defaultSleep;
   160	    // 주입 없으면 Date.now — 애플리케이션 런타임 코드라 사용 가능(Workflow 스크립트 아님).
   161	    this.now = deps.now ?? (() => Date.now());
   162	  }
   163	
   164	  async execute(run_id: string, stage: string): Promise<void> {
   165	    assertGenArgs(run_id, stage);
   166	    // ★ check-first: 요청한 stage 가 더 이상 현재 생성 대상이 아니면(중복 클릭·이미 다음 단계로 진행) pending
   167	    //   파일을 쓰지 않고 즉시 반환. 안 그러면 아무도 소비 안 하는 stale 잡 파일이 남아 엉뚱한 게이트에 처리될 수 있다.
   168	    if (this.transitioned(await this.readNext(run_id), stage)) return;
