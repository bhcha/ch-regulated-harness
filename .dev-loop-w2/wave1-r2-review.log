   440	 *   2 프로세스) 이 회수도 클레임처럼 rename 기반으로 바꿔야 한다 — 다만 그 배치는 카드·잡 중복부터 깨진다.
   441	 * @returns 실제로 회수했으면 true.
   442	 */
   443	export async function recallPendingJob(pendingDir: string, job: GenerateJobFile): Promise<boolean> {
   444	  const path = join(pendingDir, jobFileName(job.run_id, job.stage));
   445	  // 읽기 실패(권한·IO)는 '회수 못 함'으로 환원한다 — 봇의 타임아웃 보고를 fs 예외로 바꾸지 않는다(사람 문구가 사라진다).
   446	  const cur = await readJobFile(path).catch(() => null);
   447	  // job_id 는 v2 잡에만 있다 — 둘 다 '비지 않은 문자열'이고 같을 때만 자기 잡으로 인정(옛/변조 잡 오삭제 차단).
   448	  if (!cur || !job.job_id || cur.job_id !== job.job_id) return false;
   449	  try {
   450	    await unlink(path);
   451	    return true;
   452	  } catch (e) {
   453	    if (isEnoent(e)) return false; // 그 사이 누가 집었다 — 정상.
   454	    throw e;
   455	  }
   456	}
