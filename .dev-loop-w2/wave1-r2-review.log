    54	    this.runStage = deps.runStage ?? defaultRunStage;
    55	    this.offline = deps.offline ?? isOffline;
    56	  }
    57	  async execute(run_id: string, stage: string): Promise<void> {
    58	    assertGenArgs(run_id, stage);
    59	    if (!this.offline()) {
    60	      throw new Error(
    61	        "StubDirectGenExecutor: 온라인에서는 직접 생성 spawn 이 금지됩니다(헤드리스 실엔진 금지 — C3). " +
    62	          "온라인은 브리지(BridgeGenExecutor)로 세션 내 생성에 위임하세요.",
    63	      );
    64	    }
    65	    const res = await this.runStage(stage, run_id);
    66	    if (res.code !== 0) {
    67	      const tail = res.stderr.trim() || res.stdout.trim() || "(출력 없음)";
    68	      throw new Error(`stub 생성 실패(stage=${stage}, code=${res.code}): ${tail}`);
    69	    }
    70	  }
    71	}
