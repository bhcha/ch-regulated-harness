   157	/**
   158	 * pending 잡 파일 원자 기록(tmp+rename — 소비자가 반쯤 쓰인 파일을 읽는 일이 없게). @returns 기록 경로.
   159	 *
   160	 * ⚠ **봇의 적재 경로가 아니다 — 1급 적재는 `enqueueJob` 하나뿐이다.** 이 함수는 목적지를 **무조건 덮어쓰는**
   161	 *   저수준 기록 primitive 다(rename 의 성질). 봇 경로에서 이걸 직접 부르면 `enqueueJob` 의 원자 대체(unlink →
   162	 *   산 클레임 조회 → 배타 생성)를 통째로 우회해 **이중 소비 구멍이 되살아난다**: 덮어쓰기의 전제인 '옛 잡을
   163	 *   아무도 안 집었다' 는 검사 없이는 참이 아니다(그 전제가 깨지는 순간이 정확히 옛 결함 ㉠이었다).
   164	 *   남은 쓰임새는 잡 파일을 **있는 그대로** 놓아야 하는 자리뿐이다(테스트 픽스처 · 손으로 만든 v1 잡 재현 등).
   165	 */
   166	export async function writePendingJob(pendingDir: string, job: GenerateJobFile): Promise<string> {
   167	  const name = jobFileName(job.run_id, job.stage);
   168	  await mkdir(pendingDir, { recursive: true });
   169	  const dest = join(pendingDir, name);
   170	  // tmp 는 '.' 로 시작 — listPendingJobs 가 건너뛴다(반쯤 쓰인 파일이 잡으로 보이지 않게).
   171	  const tmp = join(pendingDir, `.${name}.tmp-${randomUUID()}`);
   172	  await writeFile(tmp, `${JSON.stringify(job, null, 2)}\n`, "utf8");
   173	  await rename(tmp, dest);
   174	  return dest;
   175	}
   176	
   177	/**
   178	 * 잡을 얻지 못한 **이유** — `readJobFile` 의 null 하나에 뭉쳐 있는 두 사실을 가른다:
   179	 *   gone    = 파일이 없다(ENOENT) — 목록에 잡힌 뒤 정상적으로 처분됐다(소비자의 완료·경합 패배·다른 pass)
   180	 *   corrupt = 파일은 있는데 잡이 아니다(JSON 깨짐 · kind 다름 · 경로탈출 rid) — 사람이 봐야 한다
   181	 * 대부분의 호출부에는 둘 다 '일감이 아니다' 하나로 족하다(그래서 readJobFile 의 null 계약이 그대로 옳다).
   182	 *   **처분이 정반대인 자리에서만** 이 구분이 필요하다 — reaper 는 gone 을 조용히 넘기고 corrupt 만 격리한다.
   183	 */
   184	type JobRead = { job: GenerateJobFile } | { job: null; cause: "gone" | "corrupt" };
   185	
   186	/**
   187	 * 잡 파일 읽기 + 최소 형태 검증(이유까지 딸린 원본). `readJobFile` 은 이 결과에서 job 만 떼어낸 얇은 투영이라
   188	 *   판정 규칙은 **여기 한 곳에만** 있다(두 벌로 갈라져 서로 다른 파일을 잡으로 보는 일이 없게).
   189	 *   ⚠ ENOENT·형태 불일치 밖의 fs 오류(EACCES·EIO·EMFILE…)는 **삼키지 않고 던진다**: '일시적으로 못 읽음'과
   190	 *     '내용이 깨졌음'은 다르다. 둘을 뭉뚱그리면 reaper 가 멀쩡한 잡을 디스크 딸꾹질 한 번에 failed/ 로 강등한다.
   191	 */
   192	async function readJobFileWithCause(path: string): Promise<JobRead> {
   193	  let text: string;
   194	  try {
   195	    text = await readFile(path, "utf8");
   196	  } catch (e) {
   197	    if (isEnoent(e)) return { job: null, cause: "gone" }; // 없음 = 잡 아님(경합 패배·이미 처분됨).
   198	    throw e; // 읽기 실패 ≠ 깨진 잡 — 호출부가 재시도하게 올린다.
   199	  }
   200	  let parsed: unknown;
   201	  try {
   202	    parsed = JSON.parse(text);
   203	  } catch {
   204	    return { job: null, cause: "corrupt" };
   205	  }
   206	  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) return { job: null, cause: "corrupt" };
   207	  const j = parsed as Record<string, unknown>;
   208	  if (j.kind !== "generate") return { job: null, cause: "corrupt" };
   209	  if (typeof j.run_id !== "string" || !isSafeRunId(j.run_id)) return { job: null, cause: "corrupt" };
   210	  if (typeof j.stage !== "string" || !isSafeStage(j.stage)) return { job: null, cause: "corrupt" };
   211	  // 미지 필드는 그대로 보존(forward-compat) — 재구성하지 않고 캐스팅만.
   212	  return { job: parsed as GenerateJobFile };
   213	}
   214	
   215	/**
   216	 * 잡 파일 읽기 + 최소 형태 검증. **없음(ENOENT)·깨짐·형태 불일치 = null**(모르는 파일은 일감이 아니다).
   217	 *   ⚠ 그 외 fs 오류(EACCES·EIO·EMFILE…)는 **삼키지 않고 던진다**: '일시적으로 못 읽음'과 '내용이 깨졌음'은 다르다.
   218	 *     둘을 뭉뚱그리면 reaper 가 멀쩡한 잡을 디스크 딸꾹질 한 번에 failed/ 로 강등한다(호출부는 재시도해야 한다).
   219	 *   ⚠ '없음'과 '깨짐'을 **일부러** 한 값으로 뭉갠다 — 목록·조회 호출부에는 둘의 처분이 같기 때문이다(건너뛴다).
   220	 *     둘을 갈라 봐야 하는 호출부(reaper)는 `readJobFileWithCause` 를 쓴다(이 함수의 계약은 건드리지 않는다).
   221	 */
   222	export async function readJobFile(path: string): Promise<GenerateJobFile | null> {
   223	  return (await readJobFileWithCause(path)).job;
   224	}
   225	
   226	/**
   227	 * pending/ 의 잡 목록(파일명 오름차순 = 결정적 순서). 숨김(tmp)·비-json·형태 불일치는 건너뛴다.
   228	 *   **파일명 규약(`<rid>-<stage>.json`)을 지키는 것만** 잡으로 본다: 하류(takePendingJob·claimJob)가 잡 내용에서
   229	 *   canonical 이름을 다시 만들어 쓰므로, 이름이 어긋난 파일을 잡으로 넘기면 매 회차 '찾을 수 없음'만 되풀이한다.
   230	 */
   231	export async function listPendingJobs(
   232	  pendingDir: string,
   233	): Promise<Array<{ path: string; job: GenerateJobFile }>> {
   234	  let names: string[];
   235	  try {
   236	    names = await readdir(pendingDir);
   237	  } catch (e) {
   238	    if (isEnoent(e)) return []; // 폴더가 아직 없음 = 잡 없음.
   239	    throw e; // 권한·IO 오류를 '빈 큐'로 위장하지 않는다(있는 일감이 조용히 사라진다).
   240	  }
   241	  const out: Array<{ path: string; job: GenerateJobFile }> = [];
   242	  for (const name of names.sort()) {
   243	    if (name.startsWith(".") || !name.endsWith(".json")) continue;
   244	    const path = join(pendingDir, name);
   245	    const job = await readJobFile(path);
   246	    if (!job || jobFileName(job.run_id, job.stage) !== name) continue;
   247	    out.push({ path, job });
   248	  }
   249	  return out;
   250	}
   251	
   252	// ── 2중 검사 ──────────────────────────────────────────────────────────────────
   253	
   254	/**
   255	 * 2중 검사 판정 사유. 소비자(데몬·사람)는 이 값으로 클레임/포기를 가른다:
   256	 *   ok           → 클레임하고 일한다
   257	 *   expired      → 마감까지 남은 시간이 잡 예산+기동 여유에 못 미친다 → failed/ 격리(늦은 성공 창 자체를 없앤다)
   258	 *   transitioned → 그 단계 생성 차례가 아니다(이미 됐거나 다음으로 감) → 잡 삭제(stale 재실행 차단)
   259	 *   no_deadline  → expires_at 미기재(v1 레거시 잡) → 자동 소비 대상 아님(마감을 못 걸어 구조적 보증이 성립 안 함) · 사람 소비자 몫
   260	 *   unreadable   → next-action 조회 실패 → 판단 불가라 손대지 않는다(다음 회차 재시도 — 조회 실패로 잡을 버리지 않는다)
   261	 */
   262	export type JobCheckReason = "ok" | "expired" | "transitioned" | "no_deadline" | "unreadable";
   263	
   264	export interface JobCheck {
   265	  ok: boolean;
   266	  reason: JobCheckReason;
   267	  /** 진단용 상세(로그·failed/ 사유 파일). 사람 카드 문구가 아니다. */
   268	  detail?: string;
   269	}
   270	
   271	/**
   272	 * 검사 ㉠(시간) — 순수. `지금 + 잡 예산 + 기동 여유 ≤ expires_at` 이어야 집는다.
   273	 *   '마감이 아직 안 지났나'가 아니라 '**끝낼 수 있나**'를 본다 — 마감 3초 전에 8분짜리 잡을 시작하면 실패 카드 뒤
   274	 *   늦은 성공이 되기 때문이다(그 창을 시작 전에 없앤다).
   275	 */
   276	export function checkBudget(
   277	  job: GenerateJobFile,
   278	  nowMs: number,
   279	  budgetMs: number,
   280	  startupMarginMs: number,
   281	): JobCheck {
   282	  const deadline = parseDeadline(job);
   283	  if (deadline === null) {
   284	    return { ok: false, reason: "no_deadline", detail: "expires_at 미기재(v1 레거시 잡) — 자동 소비 대상 아님" };
   285	  }
   286	  const need = budgetMs + startupMarginMs;
   287	  const remain = deadline - nowMs;
   288	  if (remain < need) {
   289	    return { ok: false, reason: "expired", detail: `남은 시간 ${remain}ms < 필요 ${need}ms(예산 ${budgetMs} + 기동여유 ${startupMarginMs})` };
   290	  }
   291	  return { ok: true, reason: "ok" };
   292	}
   293	
   294	/**
   295	 * 검사 ㉡(차례) — 지금 이 단계의 생성 차례인가. 봇(브리지)의 전이 감지와 **같은 판정**을 쓴다(이중 진실 금지).
   296	 *   step 은 페이즈 횡단 전역이라 `step==generate` 만 보면 stale 한 brief 잡을 다음 단계(concept)의 차례와 혼동한다
   297	 *   → stage 까지 같아야 '아직 그 잡의 차례'다.
   298	 */
   299	export function isGenerateTurn(na: NextAction, stage: string): boolean {
   300	  return na.step === "generate" && na.stage === stage;
   301	}
   302	
   303	export interface DoubleCheckDeps {
   304	  /** 현재시각(ms) — 주입(테스트 결정성). */
   305	  now: () => number;
   306	  /** 잡 wall-clock 예산(ms) — 소비자가 자기 값을 준다(데몬 = CHAT_SDK_GEN_TIMEOUT · 후속 단계 소유). */
   307	  budgetMs: number;
   308	  /** 기동 여유(ms) — 검사·클레임·세션 spawn 오버헤드 몫. */
   309	  startupMarginMs: number;
   310	  /** next-action 조회(읽기 전용). */
   311	  readNext: (rid: string) => Promise<NextAction>;
   312	}
   313	
   314	/**
   315	 * 2중 검사 — 시간(㉠) 먼저, 차례(㉡) 나중. 순서 주의: ㉠ 이 셸 없이 즉답이라 마감 지난 잡에 next-action spawn 비용을
   316	 *   쓰지 않는다. 둘 다 통과해야만 ok(하나라도 어긋나면 일하지 않는다 — fail-closed).
   317	 *
   318	 * ⚠ ㉠은 ㉡ **뒤에 한 번 더** 본다: ㉡의 next-action 조회는 셸 spawn 이라 수백 ms가 걸릴 수 있고, 그동안 기동 여유가
   319	 *   닳는다. 조회 전 시각으로만 판정하면 '검증할 땐 있던 예산'이 일을 시작할 땐 없다. 재검사는 순수 계산이라 공짜다.
   320	 */
   321	export async function doubleCheckJob(job: GenerateJobFile, deps: DoubleCheckDeps): Promise<JobCheck> {
   322	  const budget = checkBudget(job, deps.now(), deps.budgetMs, deps.startupMarginMs);
   323	  if (!budget.ok) return budget;
   324	  let na: NextAction;
   325	  try {
   326	    na = await deps.readNext(job.run_id);
   327	  } catch (e) {
   328	    const msg = e instanceof Error ? e.message : String(e);
   329	    return { ok: false, reason: "unreadable", detail: `next-action 조회 실패: ${msg}` };
   330	  }
   331	  if (!isGenerateTurn(na, job.stage)) {
   332	    return {
   333	      ok: false,
   334	      reason: "transitioned",
   335	      detail: `그 단계 생성 차례가 아님(현재 step=${String(na.step)} stage=${na.stage ?? "-"})`,
   336	    };
   337	  }
   338	  return checkBudget(job, deps.now(), deps.budgetMs, deps.startupMarginMs); // 조회에 걸린 시간만큼 예산 재확인
   339	}
   340	
   341	// ── 클레임·정리(rename 기반) ───────────────────────────────────────────────────
   342	
   343	/**
   344	 * 클레임 = `rename(pending/X → claimed/<consumer>/X)`. **경합의 승자는 OS 가 정한다**: 동시에 집으면 rename 이
   345	 *   하나만 성공하고 나머지는 원본이 사라져 ENOENT → null(깨끗한 패배). 승자만 그 잡을 만진다.
   346	 * @returns 승자면 claimed 경로, 패자·이미 없어짐이면 null.
   347	 */
   348	export async function claimJob(
   349	  dirs: JobDirs,
   350	  job: GenerateJobFile,
   351	  consumerId: string,
   352	): Promise<string | null> {
   353	  assertConsumerId(consumerId);
   354	  const name = jobFileName(job.run_id, job.stage);
   355	  const destDir = join(dirs.claimed, consumerId);
   356	  await mkdir(destDir, { recursive: true });
   357	  const to = join(destDir, name);
   358	  try {
   359	    await rename(join(dirs.pending, name), to);
   360	    return to;
   361	  } catch (e) {
   362	    if (isEnoent(e)) return null; // 누가 먼저 집었거나 봇이 회수함 — 정상 패배.
   363	    throw e;
   364	  }
   365	}
   366	
   367	/** 성공 = 잡 파일 삭제(수명주기 종료). 이미 없으면 no-op(멱등). */
   368	export async function completeJob(claimedPath: string): Promise<void> {
   369	  try {
   370	    await unlink(claimedPath);
   371	  } catch (e) {
   372	    if (!isEnoent(e)) throw e;
   373	  }
   374	}
   375	
   376	/**
   377	 * 실패 = `failed/X` + 사유 파일(`X.reason`). 부분 성공은 없다 — 실패한 잡은 큐에서 빠지고 사람이 본다.
   378	 *
   379	 * 순서: **잡을 먼저 옮기고 사유를 쓴다.** 반대로 하면(사유 먼저) 사유 파일 경로가 잡보다 먼저 존재해, 같은 잡을
   380	 *   처분하려던 다른 호출이 자기 실패를 정리하며 **승자의 사유 파일을 지운다**(사유 없는 실패 잡). 이 순서면 진 쪽은
   381	 *   아무것도 쓰지 않는다. 남는 위험은 '옮긴 직후 죽어 사유가 안 써지는' 창(µs)뿐이고, 그건 사유 없는 실패 잡 하나로
   382	 *   그친다(파일은 남아 사람이 본다).
   383	 *   ⚠ 검토 이력(㉢): 이 순서는 리뷰에서 **의도적으로 유지**하기로 했다 — 뒤집는 대안이 더 나쁘고(위), 나머지 대안은
   384	 *     값이 더 비싸다(사람 규약 복잡화). 재검토 불필요.
   385	 *   ⚠ 호출 전제: **그 잡을 소유한 상태**(클레임 승자)여야 한다 — takePendingJob 은 클레임 뒤에만 부른다.
   386	 *   ⚠ 알려진 한계: failed 경로도 `<rid>-<stage>` 라, 같은 단계의 잡 둘이 **동시에 살아 있다가 둘 다 실패**하면
   387	 *     나중 것이 앞의 기록을 덮는다(사유가 다른 실패를 가리킬 수 있다). 그 상황 자체가 이미 비정상이고(같은 단계를
   388	 *     두 소비자가 동시에 생성 — core 락·멱등 게이트가 상태는 지킨다), 실패 기록 한 줄의 정확도 문제라 파일명에
   389	 *     job_id 를 붙여 사람 규약(jobs/README 의 `mv … failed/`)을 복잡하게 만드는 대신 이 한계를 남긴다.
   390	 * @returns failed 경로.
   391	 */
   392	export async function failJob(dirs: JobDirs, fromPath: string, reason: string): Promise<string> {
   393	  const name = basename(fromPath);
   394	  await mkdir(dirs.failed, { recursive: true });
   395	  const dest = join(dirs.failed, name);
   396	  await rename(fromPath, dest);
   397	  await writeFile(`${dest}${REASON_SUFFIX}`, `${reason}\n`, "utf8");
   398	  return dest;
   399	}
   400	
   401	/**
   402	 * 클레임 해제 = pending 복귀. **쓰이는 자리는 하나뿐이다 — `takePendingJob` 이 일을 시작하기도 전에 물러설 때**
   403	 *   (레거시·판단 불가·처분 중 IO 오류). 그 시점엔 세션이 없으므로 되돌려도 아무도 두 번 일하지 않는다.
   404	 *
   405	 * ★ **W4 계약(못 박는다): 세션이 뜬 뒤엔 절대 해제하지 않는다 — 그 뒤의 결말은 complete(성공)·fail(실패) 둘뿐이다.**
   406	 *   일하는 중인 세션의 잡을 대기줄에 되돌리면 그 세션과 그 잡을 새로 집는 소비자가 **같은 런을 동시에 쓴다**
   407	 *   (reaper 가 재큐를 버린 이유와 같다 — 되살릴 근거는 늘 '저쪽은 죽었을 것'이라는 추정이고, 추정은 펜스가 아니다).
   408	 * ⚠ reaper 는 이 함수를 쓰지 않는다(마감 리스 — 재큐 개념 자체가 없다).
   409	 *
   410	 * **no-clobber**: 같은 이름의 새 잡이 이미 대기 중이면 그 새 잡(마감이 더 넉넉하다)을 옛 클레임으로 덮지 않고,
   411	 *   이쪽을 버린다(중복 잡 제거). link+unlink 를 쓰는 이유 = rename 은 무조건 덮어써서 '있는지 보고 옮기기'의
   412	 *   경합 창이 생기기 때문(`enqueueJob` 의 배타 생성도 같은 패턴이다).
   413	 * @returns 실제로 복귀시켰으면 true, 새 잡이 있어 버렸으면 false.
