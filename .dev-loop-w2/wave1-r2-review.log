   569	async function createPendingExclusive(pendingDir: string, dest: string, job: GenerateJobFile): Promise<boolean> {
   570	  // tmp 는 '.' 로 시작 — listPendingJobs 가 건너뛴다(반쯤 쓰인 파일이 잡으로 보이지 않게).
   571	  const tmp = join(pendingDir, `.${basename(dest)}.tmp-${randomUUID()}`);
   572	  await writeFile(tmp, `${JSON.stringify(job, null, 2)}\n`, "utf8");
   573	  try {
   574	    await link(tmp, dest);
   575	    return true;
   576	  } catch (e) {
   577	    if (!isEexist(e)) throw e;
   578	    return false;
   579	  } finally {
   580	    await unlink(tmp).catch(() => {}); // 이겼으면 링크 하나 줄이고(= 이동 완료), 졌으면 찌꺼기를 치운다.
