   131	 *   · data:        수신 첨부/산출물 스냅샷 등
   132	 *   · jobs:        잡큐 루트(run별 FIFO)
   133	 *   · jobsPending: 대기 중 생성 잡(소비자가 집기 전)
   134	 *   · jobsClaimed: 소비자가 집은 잡(`claimed/<소비자>/` — 클레임-by-rename 의 목적지)
   135	 *   · jobsFailed:  실패·만료 격리 잡(+ `.reason` 사유 파일)
   136	 * 잡 큐 3면의 규약 = kernel/job-protocol.ts(프로토콜 v2) · 사람용 문서 = jobs/README.md.
   137	 * env 오버라이드: CHAT_STATE_DIR · CHAT_DATA_DIR · CHAT_JOBS_DIR.
   138	 */
   139	export interface StoragePaths {
   140	  state: string;
   141	  data: string;
   142	  jobs: string;
   143	  jobsPending: string;
   144	  jobsClaimed: string;
   145	  jobsFailed: string;
   146	}
   147	export function storagePaths(): StoragePaths {
   148	  const state = readEnv("CHAT_STATE_DIR") ?? join(PACKAGE_ROOT, ".state");
   149	  const data = readEnv("CHAT_DATA_DIR") ?? join(PACKAGE_ROOT, "data");
   150	  const jobs = readEnv("CHAT_JOBS_DIR") ?? join(PACKAGE_ROOT, "jobs");
   151	  return {
   152	    state: resolve(state),
   153	    data: resolve(data),
   154	    jobs: resolve(jobs),
   155	    jobsPending: resolve(join(jobs, "pending")),
   156	    jobsClaimed: resolve(join(jobs, "claimed")),
   157	    jobsFailed: resolve(join(jobs, "failed")),
   158	  };
   159	}
