   500	export async function findBlockingClaimedJob(
   501	  claimedDir: string,
   502	  run_id: string,
   503	  stage: string,
   504	  nowMs: number,
   505	): Promise<ClaimedJobRef | null> {
   506	  const name = jobFileName(run_id, stage); // assertJobArgs 포함 — 경로 탈출은 fs 접촉 전에 거부
   507	  let consumers: string[];
   508	  try {
   509	    consumers = (await readdir(claimedDir, { withFileTypes: true }))
   510	      .filter((d) => d.isDirectory())
   511	      .map((d) => d.name)
   512	      .sort(); // 이름순 = 결정적 순서(여럿이 막아도 같은 것을 보고한다)
   513	  } catch (e) {
   514	    if (isEnoent(e)) return null; // claimed/ 없음 = 아무도 집지 않았다.
   515	    throw e; // 권한·IO 오류를 '클레임 없음'으로 위장하지 않는다.
   516	  }
   517	  for (const consumer of consumers) {
   518	    const path = join(claimedDir, consumer, name);
   519	    const job = await readJobFile(path);
   520	    if (!job || jobFileName(job.run_id, job.stage) !== name) continue;
   521	    const deadlineMs = parseDeadline(job);
   522	    if (deadlineMs !== null && deadlineMs <= nowMs) continue; // 마감 지남 = 산 클레임이 아니다.
