   458	/** 같은 run·stage 를 이미 집고 있는 클레임 1건(적재 차단 판정의 근거). */
   459	export interface ClaimedJobRef {
   460	  /** 클레임 경로(`claimed/<consumer>/<rid>-<stage>.json`). */
   461	  path: string;
   462	  /** 그 잡을 집은 소비자 id(= `claimed/` 밑 디렉터리명). */
   463	  consumer: string;
   464	  /** 집힌 잡 실물(이름이 아니라 이 내용이 그 소비자가 할 일이다). */
   465	  job: GenerateJobFile;
   466	  /** 절대 마감(ms). **null = 마감 미기재**(v1 레거시) — '만료'가 아니라 '알 수 없음'이다. */
