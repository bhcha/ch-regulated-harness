    27	 */
    28	export const INTENT_JSON_SCHEMA = {
    29	  type: "object",
    30	  additionalProperties: false,
    31	  properties: {
    32	    kind: { type: "string", enum: ["setup", "intake", "execute", "unknown"] },
    33	    domain: { type: "string", enum: ["화장품", "의약외품", "건기식", "의약품"], description: "명시 선언 시에만" },
