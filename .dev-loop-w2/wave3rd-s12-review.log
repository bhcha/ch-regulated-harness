   171	/**
   172	 * Worker — 잡 1건을 처리한다(순수 위임 · 상태 직접쓰기 없음).
   173	 * JobQueue 가 run별 FIFO 로 process(job) 를 호출한다. process 는 정상 흐름에서 예외를 던지지 않고
   174	 * 항상 WorkerOutcome 으로 환원한다(예외는 내부에서 흡수 → 큐 체인이 깨지지 않게).
   175	 */
   176	export class Worker {
   177	  private readonly gen: GenExecutor;
   178	  private readonly cli: HarnessCli;
   179	  private readonly readNext: ReadNextFn;
   180	  private readonly isApprover: (actor: string) => boolean;
   181	
   182	  constructor(deps: WorkerDeps) {
   183	    this.gen = deps.gen;
   184	    this.cli = deps.cli ?? DEFAULT_CLI;
   185	    this.readNext = deps.readNext ?? ((rid: string): Promise<NextAction> => readNextAction(rid));
   186	    this.isApprover = deps.isApprover ?? defaultIsApprover;
   187	  }
   188	
   189	  async process(job: Job): Promise<WorkerOutcome> {
   190	    const { kind, actor } = job;
   191	
   192	    // 상태변이 잡: 승인자 아니면 실행 전 거부(셸 미호출).
   193	    if (MUTATING.has(kind) && !this.isApprover(actor)) {
   194	      return this.finalize(job, false, MSG_NO_PERMISSION);
   195	    }
   196	
   197	    // stale ingest 방어: ingest-bundle.sh 는 기존 run 을 받아 상태를 인입으로 되돌려쓴다(하류 진행 폐기 위험).
   198	    //   현재 정말 인입 차례일 때만 실행한다 — 재생/지연된 업로드가 진행 중인 런을 리셋하지 못하게(read 실패 시엔
   199	    //   막지 않고 진행 = core 락/게이트에 위임). 다른 kind 는 core 멱등(락+status)이 stale 을 이미 거른다.
   200	    if (kind === "ingest") {
   201	      const na = await this.readNext(job.run_id).catch(() => null);
   202	      if (na && na.action !== "ingest") {
   203	        return this.finalize(job, false, "이미 지난 단계예요 — 지금은 자료 불러오기 차례가 아닙니다.");
   204	      }
   205	    }
   206	
   207	    try {
   208	      // generate 는 HarnessResult 가 아니라 GenExecutor(예외=실패)로 위임.
   209	      if (kind === "generate") {
   210	        const stage = requireStr(job.payload.stage, "생성할 단계");
   211	        // ⚠ default-deny: generate 경로는 '생성 단계'만 허용한다. run-stage 제어 verb(raise-limit 등)를
   212	        //   stage 로 넣어 승인 가드(MUTATING)를 우회하는 스머글링 차단(변조 잡 방어).
   213	        if (!GENERATION_STAGES.has(stage)) {
   214	          throw new BadJobError(`생성할 수 없는 단계입니다: ${stage}`);
   215	        }
   216	        await this.gen.execute(job.run_id, stage);
   217	        return await this.finalize(job, true, OK_MESSAGES.generate);
   218	      }
   219	
   220	      // 나머지: core scripts 쓰기 래퍼(비동기 spawn — 이벤트 루프 블로킹 금지).
   221	      const result = await this.runCli(job);
   222	      if (result.code !== 0) {
   223	        return await this.finalize(job, false, FAIL_MESSAGES[kind], tail(result.stderr));
   224	      }
   225	      return await this.finalize(job, true, OK_MESSAGES[kind]);
   226	    } catch (e) {
   227	      // 우리가 쓴 평이 문구(BadJobError·GenerationInProgressError)만 그대로 노출, 그 외 제3자 예외는 평이 문구로
   228	      //   치환(내부 비노출). GenerationInProgressError 를 FAIL_MESSAGES 로 덮으면 "생성을 마치지 못했습니다"가 되는데
   229	      //   그건 사실과 다르다 — 못 만든 게 아니라 다른 소비자가 지금 만들고 있어 중복 요청을 넣지 않은 것이다.
   230	      const safeMessage =
   231	        e instanceof BadJobError || e instanceof GenerationInProgressError ? e.message : FAIL_MESSAGES[kind];
   232	      const detail = e instanceof Error ? e.message : String(e);
   233	      return await this.finalize(job, false, safeMessage, detail);
   234	    }
   235	  }
   236	
   237	  /** kind → harness-cli 쓰기 래퍼 매핑(generate 는 호출부에서 별도 처리). 각 래퍼는 비동기 spawn. */
   238	  private runCli(job: Job): Promise<HarnessResult> {
   239	    const { kind, run_id, actor, payload } = job;
   240	    switch (kind) {
   241	      case "approve":
   242	        return this.cli.approve(run_id, {
   243	          comment: asStr(payload.comment),
   244	          // ⚠ 엄격 boolean — JSON 에서 온 truthy 비-boolean("false"·"0"·1 등)이 --ra-ok 로 새면 RA 게이트가
   245	          //   우회된다(규제 통제). 정확히 true 일 때만 RA 확인으로 인정, 그 외엔 미확인 → core 가 fail-closed.
   246	          raOk: payload.ra_ok === true,
   247	          by: actor,
   248	        });
   249	      case "select":
   250	        return this.cli.select(run_id, requireStr(payload.option, "선택한 옵션"), { by: actor });
   251	      case "revise":
   252	        return this.cli.revise(run_id, requireStr(payload.feedback, "보완 요청 내용"), { by: actor });
   253	      case "ingest":
   254	        return this.cli.ingestBundle(requireStr(payload.bundle_dir, "자료 폴더 경로"), run_id, {
   255	          wbPath: asStr(payload.wb_path),
   256	        });
   257	      case "intake":
   258	        // 00a-intake 정문(P3-2): 불변 스냅샷 폴더 + 사람 선언(제품명·도메인·포맷)으로 새 run 생성.
   259	        return this.cli.intake(requireStr(payload.folder, "첨부 폴더 경로"), run_id, {
   260	          product: requireStr(payload.product, "제품명"),
   261	          domain: requireStr(payload.domain, "규제도메인"),
   262	          format: requireStr(payload.format, "산출물 포맷"),
   263	        });
   264	      case "review":
   265	        return this.cli.kciaCheck(run_id);
   266	      case "raise-limit":
   267	        return this.cli.runStage("raise-limit", run_id);
   268	      default:
   269	        // generate 는 process 에서 걸러지므로 여기 오면 미지 kind.
   270	        throw new BadJobError(`처리할 수 없는 작업 종류입니다: ${String(kind)}`);
   271	    }
   272	  }
   273	
   274	  /** 결과 확정 — 완료 후 '다음 할 일'을 읽어 담는다(읽기 실패는 결과를 뒤엎지 않음 → next=null). */
   275	  private async finalize(
   276	    job: Job,
   277	    ok: boolean,
   278	    message: string,
   279	    detail?: string,
   280	  ): Promise<WorkerOutcome> {
   281	    let next: NextAction | null = null;
   282	    try {
   283	      next = await this.readNext(job.run_id);
   284	    } catch {
   285	      next = null; // 다음 할 일 조회 실패는 잡 결과와 무관하게 흡수(카드에 next 만 생략).
   286	    }
   287	    const outcome: WorkerOutcome = { ok, kind: job.kind, run_id: job.run_id, message, next };
   288	    if (detail) outcome.detail = detail;
   289	    return outcome;
   290	  }
   291	}
