    15	export const INTENT_TOOL_NAME = "declare_intent";
    16	
    17	/** 허용 도메인/포맷 CLI 토큰(LLM 이 벗어난 값을 주면 드롭). */
    18	export const DOMAINS = new Set(["화장품", "의약외품", "건기식", "의약품"]);
