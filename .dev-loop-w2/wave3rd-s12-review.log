exec
/bin/zsh -lc "sed -n '261,620p' /Users/chabh/.gstack/repos/gstack/.agents/skills/gstack-review/SKILL.md; sed -n '621,980p' /Users/chabh/.gstack/repos/gstack/.agents/skills/gstack-review/SKILL.md; sed -n '981,1340p' /Users/chabh/.gstack/repos/gstack/.agents/skills/gstack-review/SKILL.md; sed -n '1341,1500p' /Users/chabh/.gstack/repos/gstack/.agents/skills/gstack-review/SKILL.md" in /Users/chabh/workspace/ch-regulated-harness
