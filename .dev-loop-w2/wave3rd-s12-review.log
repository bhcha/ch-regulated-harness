    83	/**
    84	 * 알람 1홉 최대 지연 = 2^31-1 ms(≈24.8일) — `setTimeout` 이 클램프 없이 받는 상한(초과하면 즉시 발화로 뭉개진다).
    85	 *   armNext 는 다음 임계까지 남은 절대 지연이 이보다 크면 **이만큼만** 걸고, 그 알람이 깨면 다시 이어 건다(바운드 홉).
    86	 *   그래서 어떤 절대 시각도 클램프 조기발화로 새지 않는다(Finding 3). 잡 예산은 이보다 훨씬 짧아 실무에선 1홉이면
    87	 *   끝나지만, 잘못된 큰 예산·역행 시계·랩톱 슬립 같은 이상값에서 회수가 무한정 미뤄지지 않게 하는 안전 상한이다.
    88	 */
    89	export const ALARM_MAX_HOP_MS = 2_147_483_647;
    90	
    91	/**
    92	 * 세션 스폰 옵션 — **cli-parser.ts 의 검증된 헤드리스 spawn 패턴을 그대로 잇는다**(재발명 금지):
    93	 *   · `detached:true`  — 세션을 자기 프로세스그룹 리더로(위 토폴로지). `kill(-child.pid)` 로 세션+손자 일괄 회수.
    94	 *   · stdin `ignore`   — 입력 대기 행 차단(`</dev/null` 등가). 무인이라 답할 주체가 없다.
    95	 *   · 출력 상한 32MiB   — 폭주 출력 OOM 방지(초과 시 그룹 kill + 실패).
    96	 */
    97	export const SUPERVISOR_SPAWN_STDIO = ["ignore", "pipe", "pipe"] as const;
    98	export const SUPERVISOR_SPAWN_DETACHED = true;
    99	export const SUPERVISOR_MAX_OUTPUT_BYTES = 32 * 1024 * 1024;
   100	
   101	/** kill_at 스케줄 산출 입력. 전부 절대 ms(주입 — 테스트 결정성). */
   102	export interface KillScheduleInput {
   103	  /** 세션 기동(클레임) 시각 ms — 잡 wall-clock 예산이 흐르기 시작하는 기준. */
   104	  claimedAtMs: number;
   105	  /** 잡 wall-clock 예산 ms(config.sdkGenTimeout — 주/복구 세션 합산 상한). */
   106	  genTimeoutMs: number;
   107	  /** 잡 절대 마감 ms(잡 파일 `expires_at` → ms · 봇이 적재 순간 박은 값). */
   108	  deadlineMs: number;
   109	}
   110	
   111	/** kill_at 스케줄(전부 절대 ms). termAt < killSigAt < killAt 이 늘 성립한다. */
   112	export interface KillSchedule {
   113	  /** 강제 종료 완결 목표 시각 = min(claimedAt + genTimeout, deadline). 예산과 마감 중 **먼저 오는 쪽**. */
   114	  killAtMs: number;
   115	  /** SIGTERM 시각 = killAt - TERM_MARGIN. */
   116	  termAtMs: number;
   117	  /** SIGKILL 시각 = killAt - KILL_MARGIN. */
   118	  killSigAtMs: number;
   119	}
   120	
   121	function assertFiniteMs(label: string, v: number): void {
   122	  if (!Number.isFinite(v)) {
   123	    throw new Error(`supervisor: ${label} 가 유한한 ms 값이 아닙니다: ${v}`);
   124	  }
   125	}
   126	
   127	/**
   128	 * kill_at 스케줄 계산(순수).
   129	 *
   130	 * **핵심: kill_at = min(예산 마감, 잡 마감)**. 세션의 wall-clock 예산(기동 + genTimeout)과 잡의 절대 마감
   131	 *   (expires_at) 중 **먼저 오는 쪽**이 상한이다 — 예산이 남아도 잡이 만료면 거기서 끊고(늦은 성공 창 제거),
   132	 *   잡 마감이 멀어도 예산이 다하면 거기서 끊는다(폭주 세션 상한). TERM/KILL 은 그 kill_at **이전**에만 발화한다.
   133	 */
   134	export function computeKillSchedule(input: KillScheduleInput): KillSchedule {
   135	  assertFiniteMs("claimedAtMs", input.claimedAtMs);
   136	  assertFiniteMs("genTimeoutMs", input.genTimeoutMs);
   137	  assertFiniteMs("deadlineMs", input.deadlineMs);
   138	  const budgetKillMs = input.claimedAtMs + input.genTimeoutMs;
   139	  const killAtMs = Math.min(budgetKillMs, input.deadlineMs);
   140	  return {
   141	    killAtMs,
   142	    termAtMs: killAtMs - TERM_MARGIN_MS,
   143	    killSigAtMs: killAtMs - KILL_MARGIN_MS,
   144	  };
   145	}
   146	
   147	/** kill_at 까지 남은 시간(ms). 음수면 이미 지났다. */
   148	export function remainingBeforeKill(schedule: KillSchedule, nowMs: number): number {
   149	  return schedule.killAtMs - nowMs;
   150	}
   151	
   152	/**
   153	 * 지금 세션을 띄울 **여유**가 있는가 — 남은 시간이 SIGTERM 유예 미만이면 false.
   154	 *   즉시 죽여야 할 세션은 애초에 띄우지 않는다(계획: "don't start something you must instantly kill").
   155	 */
   156	export function hasSpawnRoom(schedule: KillSchedule, nowMs: number): boolean {
   157	  return remainingBeforeKill(schedule, nowMs) >= TERM_MARGIN_MS;
   158	}
   159	
   160	/** supervisor 가 세션을 띄웠을 때 돌려받는 핸들(주입 seam 이 만든다). */
   161	export interface SpawnedSession {
   162	  /** 그룹 회수 대상 id = detached 세션의 프로세스그룹 id(실제 = child.pid). 스폰 실패면 pid 부재 → pgid ≤ 1(HIGH#1). */
   163	  pgid: number;
   164	  /**
   165	   * (선택) cap-kill 이 **이미 일어났는지 동기 조회**(MEDIUM#1 — close 콜백보다 먼저 판정하기 위한 두 번째 채널).
   166	   *   아래 `exited` 의 `outputCapExceeded` 는 리더 close 가 **resolve 된 뒤에야** 감독에 닿는다. cap-kill 이 kill_at
   167	   *   **직전**에 일어나고 close 콜백이 지연되면, enforce 가 kill_at 에 그룹을 reap 할 때 `exited` 는 아직 pending →
   168	   *   감독은 cap 사실을 모른 채 `killed`(성공 후보)로 오판한다(폭주 출력 회수가 성공으로 둔갑). 그래서 spawn seam 이
   169	   *   cap-kill 하는 **바로 그 순간** 참이 되는 이 동기 ref 를 두어, **어떤 settle 경로**(enforce 의 kill_at reap 포함)든
   170	   *   cap 을 즉시 보고 output_cap(실패)으로 가르게 한다. 미주입(옛/가짜 seam)이면 undefined → `exited` 플래그
   171	   *   경로만 탄다(후방호환). */
   172	  capKilled?: () => boolean;
   173	  /** 세션이 **스스로** 종료하면 resolve(종료코드 · 신호 종료면 null). supervisor 가 죽이면 이건 안 풀려도 무방
   174	   *   (회수 알람이 kill_at 에 반드시 settle 하므로 행이 없다).
   175	   *   `outputCapExceeded` = 출력 상한(32MiB)을 넘겨 spawn seam 이 **cap-kill(SIGKILL)** 한 종료(MEDIUM#4). 감독이
   176	   *   보낸 신호가 아니므로 termSent/killSent 로는 구분되지 않는다 — 이 플래그로 실어 output_cap(실패)으로 가른다.
   177	   *   ⚠ 이 플래그는 close 경로라 **지연될 수 있다** — 즉시성이 필요한 판정은 위 `capKilled` 동기 ref 를 함께 본다. */
   178	  exited: Promise<{ code: number | null; outputCapExceeded?: boolean }>;
   179	}
   180	
   181	/** 감독 seam(전부 주입 — 실시계/실스폰/실신호는 프로덕션 기본 seam 에만 있고 테스트는 가짜를 넣는다). */
   182	export interface SuperviseDeps {
   183	  /** 현재 절대 시각 ms. */
   184	  now: () => number;
   185	  /** 절대 시각 `atMs` 에 fn 을 1회 발화하도록 예약하고, 취소 함수를 돌려준다. 이미 지난 시각이면 즉시(다음 틱) 발화. */
   186	  setAlarm: (atMs: number, fn: () => void) => () => void;
   187	  /** 세션 1건을 detached 로 spawn(플랜대로). supervisor 의 자식이 된다. */
   188	  spawnSession: (plan: SessionPlan) => SpawnedSession;
   189	  /** 세션 그룹에 신호 전송(`process.kill(-pgid, sig)` — 이미 없으면 무해). */
   190	  signalGroup: (pgid: number, sig: "SIGTERM" | "SIGKILL") => void;
   191	  /** 그룹이 살아 있는가(`kill(-pgid,0)` → 살아있음=true · ESRCH=false). */
   192	  groupAlive: (pgid: number) => boolean;
   193	  /** (선택) 세션 그룹이 살아나면 pgid 등록 — 프로세스 종료 전파·하트비트가 이 집합을 본다(Finding 1). 미주입=무시. */
   194	  registerSessionGroup?: (pgid: number) => void;
   195	  /** (선택) 세션이 settle(자가종료/강제종료/reap)하면 pgid 해제. register 와 짝. 미주입=무시. */
   196	  releaseSessionGroup?: (pgid: number) => void;
   197	}
   198	
   199	/** 감독 결과(세션 1건). */
   200	export type SessionOutcome =
   201	  | "exited" /** 세션이 신호 전에 스스로 종료(정상 완주 후보 — 전이 여부는 러너가 next-action 으로 확인) */
   202	  | "killed" /** 마감 강제(TERM/KILL 후 kill_at 시점 그룹 소멸 확인됨) */
   203	  | "reap_failed" /** kill_at 시점에도 그룹 생존 = 마감 강제 실패('결국 종료'가 아니다 · 계획 7절) */
   204	  | "output_cap" /** 출력 상한(32MiB) 초과로 spawn seam 이 cap-kill = 실패(exited 로 낙관 금지 · MEDIUM#4) */
   205	  | "heartbeat_unwritable" /** 하트비트가 **설정됐는데** register 발행(라이브 pgid 노출)이 내구적으로 안 써짐 =
   206	      백스톱 미확립 = 실패. 세션을 백스톱 없이 돌리지 않고 이미 뜬 그룹을 회수한다(HIGH — register 발행 실패는
   207	      첫이든 나중이든·주든 복구든 항상 fail-closed. release 발행 실패는 별개 — createHeartbeatWriter 계약 참조) */
   208	  | "spawn_failed" /** 스폰이 pid 를 못 냄(claude 부재·EACCES → pgid ≤ 1) = 실행된 그룹 없음. 신호·알람·등록 0(HIGH#1) */
   209	  | "refused"; /** 스폰 여유 부족(남은 시간 < TERM_MARGIN) → 애초에 안 띄웠다 */
   210	
   211	export interface SuperviseResult {
   212	  outcome: SessionOutcome;
   213	  /** 세션이 스스로 종료했을 때의 종료코드(신호 종료·미종료·refused 면 null). */
   214	  exitCode: number | null;
   215	  /** 진단 한 줄(로그·failed 사유). 사람 카드 문구가 아니다. */
   216	  detail: string;
   217	}
   218	
   219	/**
   220	 * 세션 1건을 감독한다 — detached 로 띄우고, kill_at 스케줄로 마감을 강제하고, 결과를 돌려준다.
   221	 *
   222	 * settle 은 **정확히 한 번**: (a) 세션 자가 종료 · (b) kill_at 회수 확인 중 먼저 오는 쪽. 회수 알람이 kill_at 에
   223	 *   반드시 판정하므로 세션이 영영 안 끝나도 promise 는 kill_at 에 풀린다(행 불가).
   224	 */
   225	export function superviseSession(
   226	  plan: SessionPlan,
   227	  schedule: KillSchedule,
   228	  deps: SuperviseDeps,
   229	): Promise<SuperviseResult> {
   230	  // 스폰 여유 사전 확인 — 즉시 죽여야 할 세션은 띄우지 않는다(신호 낭비·산출물 파손 회피).
   231	  if (!hasSpawnRoom(schedule, deps.now())) {
   232	    return Promise.resolve({
   233	      outcome: "refused",
   234	      exitCode: null,
   235	      detail: `스폰 여유 부족(남은 ${remainingBeforeKill(schedule, deps.now())}ms < TERM_MARGIN ${TERM_MARGIN_MS}ms)`,
   236	    });
   237	  }
   238	
   239	  const session = deps.spawnSession(plan);
   240	  const pgid = session.pgid;
   241	  /**
   242	   * HIGH#1 — **스폰 실패는 실행 중인 그룹이 아니다**. spawn 이 pid 를 못 내면(claude 부재·EACCES) pgid 가 ≤ 1 로
   243	   *   온다(defaultSpawnSession 의 `child.pid ?? -1`). 이걸 회수 대상 그룹으로 착각하면 재앙이다: `process.kill(-pgid)`
   244	   *   가 pgid=-1 일 때 `process.kill(-(-1))` = `process.kill(1)` = **init/launchd(PID 1) 를 신호**한다(pgid=0 이면
   245	   *   `kill(-0)`=`kill(0)`=호출자 그룹 전체). PID 1 은 늘 살아 있어 groupAlive(-1)=true → 리더 종료가 영영 settle 안
   246	   *   되고, TERM/KILL 이 init 을 겨냥(일반 계정=EPERM→kill_at 에 reap_failed · 특권 호스트=실제 시스템 프로세스 신호).
   247	   *   그래서 유효 pgid 가 아니면 **즉시 spawn_failed 로 short-circuit** 한다 — 알람 무장·pgid 등록·신호 전송을 전부
   248	   *   건너뛴다(어떤 경로도 나쁜 pgid 를 신호로 바꾸지 못하게). realSignalGroup/realGroupAlive 의 pgid ≤ 1 거부는 그
   249	   *   방어심층(2층)이다.
   250	   */
   251	  if (!Number.isInteger(pgid) || pgid <= 1) {
   252	    return Promise.resolve<SuperviseResult>({
   253	      outcome: "spawn_failed",
   254	      exitCode: null,
   255	      detail: `세션 스폰 실패(유효 pgid 없음: ${pgid}) — 신호·알람·등록 없이 즉시 실패(init/launchd 오신호 차단)`,
   256	    });
   257	  }
   258	  /**
   259	   * 이 세션 그룹을 레지스트리에 등록 — 종료 전파·하트비트가 살아있는 pgid 로 이걸 본다(Finding 1). settle 에서 해제.
   260	   *
   261	   * HIGH(정정 — 판정 축은 first-vs-later 가 아니라 **register-vs-release**) — register 발행이 던지면 **방금 뜬
   262	   *   라이브 pgid 가 디스크에서 누락됐다는 뜻**이고, 이는 하트비트가 지켜야 할 불변식(디스크 스냅샷은 늘 현재
   263	   *   살아있는 모든 세션 pgid 를 담는다) 위반이다. 등록은 `createSessionGroupRegistry` 의 publish("register")를
   264	   *   타고(=하트비트 파일 쓰기), 그 쓰기가 실패하면(EACCES/ENOENT/EIO) W4 데몬의 direct-pgid 회수 경로가 이
   265	   *   세션을 못 본다: supervisor 가 나중에 SIGKILL 당하면(트랩 불가) 종료 전파도 못 돌고, 데몬이 읽는 pgid 파일엔
   266	   *   이 세션이 없어 detached 세션이 마감을 넘겨 살아남는다 — 정확히 하트비트가 막으려던 구멍이다.
   267	   *   ⚠ **옛 처방의 결함(리뷰가 증명)**: 옛 코드는 '첫 발행'만 fatal 로 보고 이후 발행 실패는 감사 후 계속했다.
   268	   *     근거였던 "첫 성공 뒤엔 유효 파일이 디스크에 있다"는 **틀렸다** — 주 세션이 register/release 로 disk 를 `[]` 로
   269	   *     비운 뒤 복구 세션이 register(=나중 발행)하다 EIO 를 맞으면, 메모리엔 복구 세션이 있는데 disk 는 `[]` 에
   270	   *     머문다. supervisor 가 SIGKILL 당하면 W4 가 `[]` 를 읽어 복구 세션과 그 Bash 손자를 놓친다. 그래서 판정은
   271	   *     '첫이냐'가 아니라 '**register 냐**'다 — register 발행 실패는 주든 복구든, 첫이든 나중이든 **항상** fail-closed.
   272	   *   처방: 이미 뜬 그룹을 즉시 SIGKILL 로 회수하고(백스톱 없는 세션은 1초도 돌리지 않는다) `heartbeat_unwritable`
   273	   *   (실패)로 즉시 settle 한다. 알람 무장·자가종료 관측 전이라 부작용은 그룹 회수뿐이다. **주·복구 세션 모두 이
   274	   *   가드를 똑같이 통과**하므로(둘 다 superviseSession 을 탄다) 어느 쪽 register 발행이 실패해도 동일하게 끊긴다.
   275	   *   ⚠ release 발행 실패는 다른 위험이다 — 이미 죽은 pgid 가 디스크에 stale 하게 남을 뿐(라이브 누락 아님)이라
   276	   *     기록기가 던지지 않고 stderr 감사로만 남기고, W4 계약(supervisorPid 일치 + 그룹 생존 확인 후에만 kill)이
   277	   *     재사용 PID 오kill 을 막는다(아래 createHeartbeatWriter 계약 주석).
   278	   *   하트비트 미설정(경로 없음)이면 publish 자체가 no-op 이라 이 경로는 애초에 던지지 않는다(데몬이 백스톱을
   279	   *   요구할지는 데몬 몫 — 여기선 '설정됐는데 깨진' 경우만 fail-closed).
   280	   */
   281	  try {
   282	    deps.registerSessionGroup?.(pgid);
   283	  } catch (e) {
   284	    const msg = e instanceof Error ? e.message : String(e);
