   100	/** run_id 생성 — seed(threadId)를 경로-안전 토큰으로 축약(isSafeRunId 통과). */
   101	export function makeRunId(seed: string): string {
   102	  const safe = seed.replace(/[^A-Za-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 48);
   103	  return `chat-${safe || "run"}`;
   104	}
