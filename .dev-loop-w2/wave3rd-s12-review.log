    65	  "제품명은 따옴표로 감쌌거나 '제품명은 …'처럼 명시했을 때만 넣는다.",
    66	  "파일 경로(워킹백워드·시험성적서·참고자료)를 언급하면 files 에 role 과 함께 넣는다. 시험성적서는 role=test_report 로만 표시하고 자동 승격하지 마라.",
    67	  "승인/시작/선택/보완 같은 실행 요청이면 kind=execute, execute 에 해당 값을 넣는다.",
    68	].join("\n");
    69	
    70	/**
    71	 * tool_use.input(임의 JSON) → 정규화된 NlIntent. **순수 함수**(오프라인 단위 테스트 대상).
    72	 *   허용 밖 값은 드롭하고, uncertain(빠진 setup 필드)을 재계산한다(LLM 이 uncertain 을 틀리게 줘도 커널이 재산정).
    73	 */
    74	export function intentFromToolInput(input: unknown): NlIntent {
    75	  const o = (input && typeof input === "object" ? input : {}) as Record<string, unknown>;
    76	  const str = (v: unknown): string | undefined => (typeof v === "string" && v.trim() !== "" ? v.trim() : undefined);
    77	
    78	  const domain = str(o.domain);
    79	  const format = str(o.format);
    80	  const product = str(o.product);
    81	  const executeRaw = str(o.execute);
    82	  const kindRaw = str(o.kind);
    83	
    84	  const files: NlFileRef[] = Array.isArray(o.files)
    85	    ? o.files
    86	        .map((f): NlFileRef | null => {
    87	          const fo = (f && typeof f === "object" ? f : {}) as Record<string, unknown>;
    88	          const path = str(fo.path);
    89	          const roleRaw = str(fo.role);
    90	          const role = roleRaw && ROLES.has(roleRaw as NlFileRef["role"]) ? (roleRaw as NlFileRef["role"]) : "reference";
