   204	/** 미확신 필드(domain/format/product) → 사람용 되물음(평이 한국어). */
   205	function questionFor(field: string): string {
   206	  switch (field) {
   207	    case "domain":
   208	      return "어떤 제품인가요? (화장품 · 의약외품 · 건기식 · 의약품 중에서 알려 주세요)";
   209	    case "format":
