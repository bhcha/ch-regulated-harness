   244	/**
   245	 * P3-1 설정 제안: 뽑은 값을 pending=setup 에 병합(이후 Select/[시작] 경로가 그대로 작동)하고 NlProposal 을 낸다.
   246	 *   완결(도메인+포맷+제품명)이면 [시작](SETUP_ACTION_IDS.start) 버튼만; 미확신이면 질문 + 설정 카드로 사람이 채운다.
   247	 *   ⚠ 자동 시작 없음 — [시작] 은 startRun 이 pending 을 읽어 실행(잠긴 결정 6).
   248	 */
   249	async function handleNlSetup(threadId: string, gw: Gateway, intent: NlIntent): Promise<void> {
   250	  const patch = setupPatch(intent);
   251	  await gw.pending.set(threadId, { kind: "setup", ...patch });
   252	  await gw.chat.subscribe(threadId);
   253	  const complete = Boolean(intent.domain && intent.format && intent.product);
   254	  const proposal: NlProposalPresentation = {
   255	    type: "NlProposal",
   256	    kind: "setup",
   257	    summary: nlSetupSummary(intent),
   258	    questions: complete ? [] : questionsFor(intent),
   259	    ...(complete ? { confirm: { actionId: SETUP_ACTION_IDS.start, label: "시작" } } : {}),
   260	  };
   261	  await gw.chat.render(threadId, proposal);
   262	  // 미확신이면 설정 카드도 띄워 Select/답글로 마저 채우게(자동 시작 금지).
   263	  if (!complete) await gw.chat.render(threadId, setupP(patch));
   264	}
   265	
   266	/**
   267	 * P3-2 파일 인입 제안: 경로를 allowlist + realpath 봉쇄로 검증. 통과분이 없으면 거부 안내(잡·대기 없음).
   268	 *   설정 3필드가 다 있으면 pending=intake 로 두고 [이 자료로 시작] 버튼(확정 시 스테이징 + intake 잡). 미확신이면 질문만.
   269	 *   ⚠ 여기서 잡을 만들지 않는다 — 확정 버튼(confirmNlIntake)이 방아쇠다(잠긴 결정 6).
   270	 */
   271	async function handleNlIntake(threadId: string, gw: Gateway, intent: NlIntent): Promise<void> {
   272	  await gw.chat.subscribe(threadId);
   273	  // ⚠ 새 인입 제안은 이전 인입 제안을 즉시 무효화한다(Codex P3 HIGH): 선언이 바뀌었으므로 옛 제안 대기는 폐기.
   274	  //   아래에서 '전부 통과 + 3필드 완비'일 때만 새 대기(intake)를, 제품명만 미정이면 새 draft(intake_draft)를 심는다 —
   275	  //   거부/불완전이면 대기가 없어, 옛 카드 클릭·옛 draft 완성이 pending 부재로 no-op(거부된 재선언 뒤 옛 자료 확정 차단).
   276	  //   ⚠ intake 뿐 아니라 intake_draft 도 비운다: 거부된 재선언이 옛 draft 를 남기면 뒤이은 제품명 답글이 옛 파일로
   277	  //     완성돼 버린다(fail-closed 위반 · Codex intake_draft HIGH).
   278	  const prior = await gw.pending.get(threadId);
   279	  if (prior?.kind === "intake" || prior?.kind === "intake_draft") await gw.pending.clear(threadId);
   280	  const roots = gw.nlFileRoots();
   281	  const v = validateIntakeFiles(intent.files, roots);
   282	  // 파일 경로를 하나도 못 잡음(빈 목록/파싱 실패).
   283	  if (v.accepted.length === 0 && v.rejected.length === 0) {
   284	    await gw.chat.render(
   285	      threadId,
   286	      progressP(toViewModel(stubNext(makeRunId(threadId))), "받은 메시지에서 파일 경로를 찾지 못했어요 — 파일 위치를 알려 주세요."),
   287	    );
   288	    return;
   289	  }
   290	  // ⚠ 부분 반입 금지(fail-closed · Codex P3 HIGH): 하나라도 거부되면 전체를 보류한다. 규제 인입에서 '현업이 검토한
   291	  //   자료'와 '실제 반입된 자료'가 어긋나면 안 된다(거부분을 조용히 빼고 시작 금지). 거부 사유를 알려 고치게 한다.
   292	  if (v.rejected.length > 0) {
   293	    const lines = v.rejected.map((r) => `· ${r.ref.path}: ${r.reason}`).join("\n");
   294	    const head =
   295	      roots.length === 0
   296	        ? "파일을 불러올 폴더가 설정되어 있지 않아요 — 운영자에게 문의해 주세요."
   297	        : `일부 파일을 확인하지 못했어요 — 전부 확인돼야 시작할 수 있어요. 아래를 고쳐 다시 알려 주세요:\n${lines}`;
   298	    await gw.chat.render(threadId, progressP(toViewModel(stubNext(makeRunId(threadId))), head));
   299	    return; // pending·confirm 없음(fail-closed).
   300	  }
   301	  // 전부 통과. 설정 3필드가 있어야 확정 버튼을 낸다(없으면 질문만 — 자동 시작 금지).
   302	  const complete = Boolean(intent.domain && intent.format && intent.product);
   303	  let confirm: NlProposalPresentation["confirm"];
   304	  if (complete) {
   305	    // stale 가드용 도장(nonce): 이 제안을 대기에 심고, 확정 버튼에도 실어 옛 카드 클릭이 새 제안을 실행하는 것을 막는다.
   306	    const nonce = randomUUID();
   307	    await gw.pending.set(threadId, {
   308	      kind: "intake",
   309	      files: intent.files,
   310	      domain: intent.domain!,
   311	      format: intent.format!,
   312	      product: intent.product!,
   313	      nonce,
   314	    });
   315	    confirm = { actionId: NL_INTAKE_CONFIRM_ACTION_ID, label: "이 자료로 시작", payload: JSON.stringify({ nonce }) };
   316	  } else if (intent.domain && intent.format) {
   317	    // 제품명만 미정(파일·도메인·포맷은 있음): 제안 맥락을 draft 대기로 심어, 다음 답글(제품명)이 이 제안을
   318	    //   완성하게 한다(P3-2 보완). draft 는 확정 버튼이 없다 — 완성돼야 [이 자료로 시작] 이 붙는다.
