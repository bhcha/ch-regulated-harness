    62	/** 고정 nonce 시퀀스를 내는 생성기(테스트 결정성). 소진되면 던진다(예상보다 많은 intent 감지). */
    63	function makeNonceGen(seq: string[]): NonceGen {
    64	  let i = 0;
    65	  return () => {
    66	    const n = seq[i++];
    67	    if (n === undefined) throw new Error(`makeNonceGen: nonce 시퀀스 소진(요청 ${i})`);
    68	    return n;
    69	  };
    70	}
    71	
    72	/** 고정 시계(intentAtMs·spawnedAtMs 를 결정론적으로). */
    73	function makeClock(t = 500_000) {
    74	  let cur = t;
    75	  return { now: (): number => cur, set: (v: number): void => void (cur = v) };
    76	}
