   448	// ── 프로덕션 기본 seam (main() 과 W4 데몬이 쓴다 · W3 테스트에선 실행되지 않는다) ──────────────────
   449	
   450	/** 실시계 seam — setTimeout 은 arm 시점의 상대 지연이지만, 발화 콜백(enforce)이 `now()` 로 재판정하므로 슬립에 강건하다. */
   451	export const realClock: Pick<SuperviseDeps, "now" | "setAlarm"> = {
   452	  now: () => Date.now(),
   453	  setAlarm: (atMs, fn) => {
   454	    const handle = setTimeout(() => fn(), Math.max(0, atMs - Date.now()));
   455	    return () => clearTimeout(handle);
   456	  },
   457	};
   458	
   459	/**
   460	 * 세션 그룹 신호(cli-parser 의 killGroup 패턴) — 이미 없으면 조용히 무시.
   461	 *
   462	 * ⚠ **pgid ≤ 1 은 process.kill 을 호출하지도 않고 즉시 반환한다**(HIGH#1 방어심층). `process.kill(-pgid,…)` 는
   463	 *   pgid=1 이면 `kill(-1)` = **호출자가 신호할 수 있는 거의 모든 프로세스**, pgid=-1 이면 `kill(-(-1))` = `kill(1)`
   464	 *   = **init/launchd**, pgid=0 이면 `kill(0)` = **호출자 그룹 전체**로 퍼진다. 스폰 실패 -1 등 나쁜 pgid 가 어떤
   465	 *   경로로 새어들어도 여기서 광역·init 신호로 번지지 않게 막는다(superviseSession short-circuit 이 1차, 이건 2차).
   466	 */
   467	export function realSignalGroup(pgid: number, sig: "SIGTERM" | "SIGKILL"): void {
   468	  if (!Number.isInteger(pgid) || pgid <= 1) return; // 유효 pgid 아님 — kill(1)/kill(-1)/kill(0) 광역·init 신호 차단.
   469	  try {
   470	    process.kill(-pgid, sig); // 음수 pid = 프로세스그룹 전체(세션 + Bash 손자)
   471	  } catch {
   472	    // 이미 종료됨 — 무해.
   473	  }
   474	}
   475	
   476	/**
   477	 * 그룹 생존 확인 — ESRCH=소멸(false), EPERM=존재하나 권한없음(보수적으로 생존=true), 그 외=생존.
   478	 *
   479	 * ⚠ **pgid ≤ 1 은 process.kill 을 호출하지도 않고 false 를 반환한다**(HIGH#1 방어심층). 안 그러면 `kill(-(-1),0)`
   480	 *   = `kill(1,0)` 로 늘 살아있는 PID 1(init)을 찔러 **스폰 실패한 세션이 영원히 '생존 중'으로 오판**돼 리더 종료가
   481	 *   settle 되지 않고 회수가 새어나간다. 유효 그룹이 아니면 '생존 아님'이 옳다(회수할 게 없다).
   482	 */
   483	export function realGroupAlive(pgid: number): boolean {
   484	  if (!Number.isInteger(pgid) || pgid <= 1) return false; // 유효 pgid 아님 — kill(1,0) 로 init 을 생존으로 오판하지 않는다.
   485	  try {
   486	    process.kill(-pgid, 0);
   487	    return true;
   488	  } catch (e) {
   489	    return (e as NodeJS.ErrnoException).code === "EPERM";
   490	  }
   491	}
   492	
   493	// ── 세션 그룹 레지스트리 + 종료 전파(Finding 1 — 마감 구멍 봉합) ──────────────────────────────────
   494	
   495	/**
   496	 * 살아있는 세션 하위 그룹 레지스트리 — 이 supervisor 가 detached 로 띄운 세션 그룹의 pgid 집합.
   497	 *   두 소비자가 같은 집합을 본다: ① 종료 전파(installSupervisorTerminationHandlers)가 supervisor 가 죽기 전에 이들을
   498	 *   SIGKILL 한다 · ② `publish` 콜백(main 이 하트비트에 배선)이 W4 데몬에게 live pgid 를 노출한다 → 데몬이
   499	 *   `kill(-sessionPgid)` 로 세션 그룹을 **직접** 겨냥한다(supervisor 만 죽여선 세션 그룹에 못 닿는다 — 모듈 헤더 계약).
   500	 */
   501	export interface SessionGroupRegistry {
   502	  /** 세션 그룹이 살아나면 등록. pgid ≤ 1 은 무효(스폰 실패 -1 · 그룹 1 은 회수 대상 아님)라 무시한다. */
   503	  register: (pgid: number) => void;
   504	  /** 세션이 settle(자가종료/강제종료/reap)하면 해제. */
   505	  release: (pgid: number) => void;
   506	  /** 현재 살아있는 pgid 스냅샷(오름차순 — 결정론). 종료 전파·하트비트가 읽는다. */
   507	  live: () => number[];
   508	}
   509	
   510	/**
   511	 * 하트비트 발행 종류 — register(라이브 pgid **추가**) vs release(pgid **제거**). 발행 실패 처분이 갈린다(HIGH 정정):
   512	 *   · register 발행 실패 = **라이브 pgid 가 디스크에서 누락** → 불변식(디스크 스냅샷은 늘 현재 살아있는 모든 세션
   513	 *     pgid 를 담는다) 위반 → **항상 fail-closed(throw)**. 첫이든 나중이든·주든 복구든.
   514	 *   · release 발행 실패 = **이미 죽은 pgid 가 디스크에 stale 하게 잔존**(라이브 누락 아님) → fatal 아님(감사만).
   515	 *     재사용 PID 오kill 은 W4 데몬 계약이 닫는다(createHeartbeatWriter 계약 주석).
   516	 */
   517	export type HeartbeatPublishKind = "register" | "release";
   518	
   519	/**
   520	 * 세션 그룹 레지스트리 생성. `publish` 를 주면 집합이 바뀔 때마다 살아있는 pgid 스냅샷 + **발행 종류**를 넘긴다
