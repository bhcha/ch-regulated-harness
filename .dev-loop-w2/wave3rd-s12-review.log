    61	export const SYSTEM_PROMPT = [
    62	  "너는 규제 상세페이지 제작 챗봇의 자연어 이해기다.",
    63	  "사용자 텍스트에서 사용자가 '명시적으로 선언한' 것만 declare_intent 도구로 뽑아라.",
