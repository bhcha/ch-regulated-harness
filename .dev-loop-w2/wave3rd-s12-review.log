   104	  else if (execute) kind = "execute";
   105	  else if (kindRaw && KINDS.has(kindRaw as NlKind)) kind = kindRaw as NlKind;
   106	  else kind = "unknown";
   107	
   108	  const uncertain =
   109	    kind === "setup" || kind === "intake"
   110	      ? fieldsUncertain({ domain: cleanDomain, format: cleanFormat, product })
   111	      : [];
