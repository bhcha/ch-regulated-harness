   202	    entry.pgid = asFiniteNumber(`sessions[${i}].pgid`, o.pgid);
   203	  } else if (hasPgid) {
   204	    throw new LedgerParseError(`sessions[${i}] state=${state} 인데 pgid 가 있습니다(불변식 위반)`);
   205	  }
   206	  if (o.spawnedAtMs !== undefined) entry.spawnedAtMs = asFiniteNumber(`sessions[${i}].spawnedAtMs`, o.spawnedAtMs);
   207	  return entry;
   208	}
   209	
   210	/**
   211	 * 내구 문자열을 원장으로 파싱(round-trip). **거부하는 것**(전부 LedgerParseError throw): torn/invalid JSON · 알 수
   212	 *   없는 `v`(전방 비호환) · 구조 위반. 반환은 **정규화된** 원장(알 수 없는 잉여 필드는 버린다 — round-trip 결정론).
   213	 */
   214	export function parse(text: string): Ledger {
   215	  let raw: unknown;
   216	  try {
   217	    raw = JSON.parse(text);
   218	  } catch (e) {
   219	    const msg = e instanceof Error ? e.message : String(e);
   220	    throw new LedgerParseError(`원장 JSON 파싱 실패(torn/invalid): ${msg}`);
   221	  }
   222	  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
   223	    throw new LedgerParseError("원장 최상위가 객체가 아닙니다");
   224	  }
   225	  const o = raw as Record<string, unknown>;
   226	  // 알 수 없는 v 거부 — 데몬이 미지 포맷을 잘못 해석하지 않게(전방 비호환 fail-closed).
   227	  if (o.v !== LEDGER_VERSION) {
   228	    throw new LedgerParseError(`알 수 없는 원장 버전 v=${JSON.stringify(o.v)}(지원 v=${LEDGER_VERSION})`);
   229	  }
   230	  const sup = o.supervisor;
   231	  if (typeof sup !== "object" || sup === null || Array.isArray(sup)) {
   232	    throw new LedgerParseError("supervisor 블록이 객체가 아닙니다");
   233	  }
   234	  const s = sup as Record<string, unknown>;
   235	  const supervisor: SupervisorMeta = {
   236	    pid: asFiniteNumber("supervisor.pid", s.pid),
   237	    startedAtMs: asFiniteNumber("supervisor.startedAtMs", s.startedAtMs),
   238	    rid: asString("supervisor.rid", s.rid),
   239	    stage: asString("supervisor.stage", s.stage),
   240	  };
   241	  if (!Array.isArray(o.sessions)) throw new LedgerParseError("sessions 가 배열이 아닙니다");
   242	  const sessions = o.sessions.map((e, i) => parseEntry(e, i));
   243	  return { v: LEDGER_VERSION, supervisor, sessions };
   244	}
   245	
   246	// ── nonce 생성 seam ───────────────────────────────────────────────────────────────
   247	
   248	/** nonce 생성기 — 주입 seam(테스트 결정성). 기본은 crypto.randomUUID(재사용 불가·정상 앱 코드라 허용). */
   249	export type NonceGen = () => string;
   250	
   251	/** 프로덕션 기본 nonce 생성기. */
   252	export const defaultNonceGen: NonceGen = () => randomUUID();
   253	
   254	// ── 내구 기록기(createLedger) ─────────────────────────────────────────────────────
   255	
   256	/**
   257	 * io seam — supervisor.ts 의 `HeartbeatIo` 와 **같은 모양**(동기 + tmp→rename 원자 스왑)을 재사용한다. 동기라
   258	 *   호출 반환 시점엔 이미 디스크에 있어(대기 중 비동기 쓰기 없음) `process.exit()` 이 앞질러도 마지막 상태가 유실되지
   259	 *   않고, tmp→rename 이라 데몬이 반쯤 쓰인 파일을 절대 읽지 않는다(찢김 없음).
   260	 */
   261	export interface LedgerIo {
   262	  writeFileSync: (path: string, data: string) => void;
   263	  renameSync: (from: string, to: string) => void;
   264	}
   265	
   266	/** createLedger 의 추가 주입 seam(시계·nonce). io 는 필수 위치인자, 이건 선택(기본=실시계/실 nonce). */
   267	export interface LedgerSeams {
   268	  /** 현재 절대 시각 ms(intentAtMs·spawnedAtMs 기록용). 기본 Date.now — 테스트는 가짜 시계를 넣는다. */
   269	  now?: () => number;
   270	  nonceGen?: NonceGen;
   271	}
   272	
   273	/** createLedger 가 돌려주는 핸들. supervisor 가 이걸로 원장을 몬다. */
   274	export interface LedgerHandle {
   275	  /** nonce 생성 + `spawning` 엔트리 내구 기록 후 nonce 반환. **자식 spawn 직전**에 호출(register-lag 해소). */
   276	  intent: (role: SessionRole, killAtMs: number) => string;
   277	  /** 자식 확정 시 그 엔트리를 `live` + pgid 로 승격(내구 기록). */
   278	  register: (nonce: string, pgid: number) => void;
   279	  /** 회수 확인 시 처분 기록: reaped(소멸·pgid 버림) 또는 leaked(생존·pgid 유지·엔트리 존치). */
   280	  settle: (nonce: string, disposition: "reaped" | "leaked") => void;
   281	  /** 현재 원장 스냅샷(읽기 전용 복사 — 종료 전파가 live pgid 를 읽거나 테스트가 관측). */
   282	  snapshot: () => Ledger;
   283	}
   284	
   285	/**
   286	 * 내구 원장 기록기를 만든다. **모든 변이는 tmp→rename 원자 스왑으로 내구 기록되고, io 가 던지면 삼키지 않고
   287	 *   LedgerWriteError 로 surface** 한다(변이는 내구 성공 후에만 in-memory 에 커밋 → io 실패 시 in-memory 는
   288	 *   디스크와 어긋나지 않는다). 불법 전이는 LedgerTransitionError 로 거부한다.
   289	 *
   290	 * @param path 원장 파일 경로.
   291	 * @param supervisorMeta 이 supervisor 의 신원(데몬의 start-time 대조용).
   292	 * @param io 동기 원자 쓰기 seam(HeartbeatIo 와 동형).
   293	 * @param seams 선택 주입(now·nonceGen · 기본=실시계/실 nonce).
   294	 */
   295	export function createLedger(
   296	  path: string,
   297	  supervisorMeta: SupervisorMeta,
   298	  io: LedgerIo,
   299	  seams: LedgerSeams = {},
   300	): LedgerHandle {
   301	  const now = seams.now ?? (() => Date.now());
   302	  const nonceGen = seams.nonceGen ?? defaultNonceGen;
   303	  const tmp = `${path}.tmp`;
   304	  // in-memory 는 **내구화된 디스크 상태의 거울**이다. 변이는 persist 성공 후에만 여기에 반영한다.
   305	  let sessions: SessionEntry[] = [];
   306	
   307	  /**
   308	   * 다음 세션 배열을 내구 기록한다 — **성공한 뒤에만** in-memory 에 커밋한다. io 가 던지면 커밋 없이 LedgerWriteError
   309	   *   를 던진다 → in-memory(sessions)는 이전 내구 상태 그대로라, 실패한 변이가 핸들에 새지 않는다(롤백 불필요·자동).
   310	   */
   311	  const persist = (next: SessionEntry[]): void => {
   312	    const data = serialize({ v: LEDGER_VERSION, supervisor: supervisorMeta, sessions: next });
   313	    try {
   314	      io.writeFileSync(tmp, data);
   315	      io.renameSync(tmp, path); // 원자 교체 — 소비자(데몬)는 완결본만 본다.
   316	    } catch (e) {
   317	      const msg = e instanceof Error ? e.message : String(e);
   318	      throw new LedgerWriteError(`원장 내구 기록 실패(path=${path}): ${msg}`);
   319	    }
   320	    sessions = next; // 내구 성공 후에만 커밋.
   321	  };
   322	
   323	  const findIndex = (nonce: string): number => sessions.findIndex((e) => e.nonce === nonce);
   324	
   325	  return {
   326	    intent: (role: SessionRole, killAtMs: number): string => {
   327	      // role·killAt 정합성 fail-closed(잘못된 잡 스펙이 원장에 새지 않게).
   328	      if (role !== "main" && role !== "recovery") {
   329	        throw new LedgerTransitionError(`intent: 알 수 없는 role: ${JSON.stringify(role)}`);
   330	      }
   331	      if (!Number.isFinite(killAtMs)) {
   332	        throw new LedgerTransitionError(`intent: killAtMs 가 유한하지 않습니다: ${killAtMs}`);
   333	      }
   334	      const nonce = nonceGen();
   335	      // nonce 충돌 방어 — 실 crypto nonce 는 충돌하지 않지만, 주입 테스트 seam 이 같은 값을 두 번 낼 수 있다. 같은
   336	      //   nonce 두 엔트리는 register/settle 을 모호하게 만들므로 fail-closed(소유 토큰의 유일성이 계약의 근간).
   337	      if (findIndex(nonce) >= 0) {
   338	        throw new LedgerTransitionError(`intent: nonce 충돌(${nonce}) — 소유 토큰 유일성 위반`);
   339	      }
   340	      const entry: SessionEntry = { nonce, role, state: "spawning", intentAtMs: now(), killAtMs };
   341	      persist([...sessions, entry]);
   342	      return nonce;
   343	    },
   344	
   345	    register: (nonce: string, pgid: number): void => {
   346	      const idx = findIndex(nonce);
   347	      if (idx < 0) throw new LedgerTransitionError(`register: intent 되지 않은 nonce(${nonce}) — 소유권 없음`);
   348	      const cur = sessions[idx];
   349	      if (cur.state !== "spawning") {
   350	        throw new LedgerTransitionError(`register: state=${cur.state} 는 spawning 이 아닙니다(재register·settle 후 register 금지)`);
   351	      }
   352	      // pgid 정합성 — supervisor 의 pgid ≤ 1 가드와 같은 이유(방어심층). pgid ≤ 1 이 원장에 들어가면 데몬의 회수가
   353	      //   kill(1)=init/launchd·kill(-1)=광역·kill(0)=호출자그룹 으로 번질 위험이 있다. 유효 그룹만 live 로 승격한다.
   354	      if (!Number.isInteger(pgid) || pgid <= 1) {
   355	        throw new LedgerTransitionError(`register: 유효하지 않은 pgid(${pgid}) — init/launchd·광역 오신호 방지(1 초과 정수만)`);
   356	      }
   357	      const next = sessions.slice();
   358	      next[idx] = { ...cur, state: "live", pgid, spawnedAtMs: now() };
   359	      persist(next);
   360	    },
   361	
   362	    settle: (nonce: string, disposition: "reaped" | "leaked"): void => {
   363	      const idx = findIndex(nonce);
   364	      if (idx < 0) throw new LedgerTransitionError(`settle: 알 수 없는 nonce(${nonce})`);
   365	      const cur = sessions[idx];
   366	      if (cur.state === "reaped" || cur.state === "leaked") {
   367	        throw new LedgerTransitionError(`settle: 이미 settle 됨(state=${cur.state}) — double-settle 금지`);
   368	      }
   369	      const next = sessions.slice();
   370	      if (disposition === "reaped") {
   371	        // reaped = 그룹 소멸 확인. pgid 는 이제 무의미하고 재사용 위험이라 **버린다**(스키마: reaped 엔 pgid 부재).
   372	        //   live(있던 pgid) 든 spawning(원래 없음)이든 결과적으로 pgid 없는 reaped. spawn 실패로 register 못 한
   373	        //   spawning 을 '아무것도 안 남고 확인됨'으로 정리하는 경로이기도 하다.
   374	        const { pgid: _dropped, ...rest } = cur;
   375	        void _dropped;
   376	        next[idx] = { ...rest, state: "reaped" };
   377	      } else {
   378	        // leaked = 회수 실패, 그룹 생존. 데몬이 계속 겨냥해야 하므로 pgid 를 **유지**하고 엔트리를 **삭제하지 않는다**.
   379	        //   pgid 없는 spawning 은 leaked 로 갈 수 없다(유지할 pgid 가 없다 — settle 시그니처가 pgid 를 안 받는다).
   380	        if (cur.state !== "live") {
   381	          throw new LedgerTransitionError(`settle leaked: state=${cur.state} 에는 유지할 pgid 가 없습니다(live 만 leaked 가능)`);
   382	        }
   383	        next[idx] = { ...cur, state: "leaked" };
   384	      }
   385	      persist(next);
   386	    },
   387	
   388	    snapshot: (): Ledger => ({
   389	      v: LEDGER_VERSION,
   390	      supervisor: { ...supervisorMeta },
   391	      sessions: sessions.map((e) => ({ ...e })),
   392	    }),
   393	  };
   394	}
   395	
   396	// ── 순수 회수판정 함수(evaluateReap) — 계약의 심장 ────────────────────────────────
   397	
   398	/**
   399	 * 데몬이 프로세스 세계를 관측하는 seam(주입). **evaluateReap 은 이 안에서 실 ps/pgrep 를 부르지 않는다** — W3
   400	 *   테스트는 가짜, W4 가 실 `ps -E`/`pgrep` 를 배선한다.
   401	 */
   402	export interface ProcView {
   403	  /** pgid 그룹의 구성원 pid 목록. 그룹이 없으면(ESRCH) 빈 배열. */
   404	  groupMembers: (pgid: number) => number[];
   405	  /** pid 의 exec-env 에 name=value 가 있는가(예: `ps -E` 로 그 프로세스의 환경변수 조회). */
   406	  execEnvHas: (pid: number, name: string, value: string) => boolean;
   407	  /** exec-env 에 name=value 를 지닌 프로세스들의 pgid 목록(예: `pgrep`+env 필터). register-lag 창에서 pgid 발견용. */
   408	  scanByEnv: (name: string, value: string) => number[];
   409	}
   410	
   411	/** 데몬이 판정 시점에 보는 세계 상태(owner supervisor 신원 + 관측 + 현재 시각). */
   412	export interface SupervisorState {
   413	  /** 원장이 기록한 owner supervisor 신원(우리가 이 잡을 띄웠다고 주장하는 그 프로세스). */
   414	  ledger: { pid: number; startedAtMs: number };
   415	  /** 데몬이 지금 그 pid 를 관측한 결과 — alive(kill(pid,0)) + 실제 startedAtMs(없으면 null). */
   416	  observed: { alive: boolean; startedAtMs: number | null };
   417	  /** 데몬의 현재 절대 시각 ms(spawning GC 의 killAt+여유 판정용). */
   418	  nowMs: number;
   419	}
   420	
   421	/**
   422	 * 회수 판정(부작용 없음 — **결정만** 한다, 실행은 데몬 몫):
   423	 *   · kill          — pgid 그룹을 신호해도 된다(nonce 검증 통과). 데몬이 kill(-pgid) 실행.
   424	 *   · scan-then-kill — spawning(pgid 미확정)인데 nonce 스캔이 그룹(들)을 찾았다. 데몬이 그 pgids 를 nonce 검증하 회수.
   425	 *   · refuse        — 신호 거부. reason 이 근거(대표=nonce 불일치=PID 재사용 → 무관 그룹 오kill 방지 · 안전의 핵심).
   426	 *   · gc            — 회수할 그룹이 없다(이미 소멸·미발생·reaped). 원장 엔트리만 정리(신호 없음).
   427	 *   · wait          — 지금 손대지 않는다(owner 가 살아있어 자기 세션 관리 중 · 또는 register-lag 창 안).
   428	 */
   429	export type ReapDecision =
   430	  | { action: "kill"; pgid: number; reason: string }
   431	  | { action: "scan-then-kill"; nonce: string; pgids: number[]; reason: string }
   432	  | { action: "refuse"; reason: string }
   433	  | { action: "gc"; reason: string }
   434	  | { action: "wait"; reason: string };
   435	
   436	/**
   437	 * 세션 엔트리 1건에 대한 회수 판정. 순수 — procView/supervisorState 만 보고 ReapDecision 을 돌린다.
   438	 *
   439	 * **판정 순서**:
   440	 *   1. owner 신원 게이트 — owner 가 **살아있고 신원 일치**(alive && startedAtMs 일치)면 그 owner 가 자기 세션을
   441	 *      관리 중이니 데몬은 비켜선다(wait). `kill(pid,0)` 만으로 부족하고 **기동시각 일치**까지 봐야 PID 재사용된
   442	 *      supervisor 를 원 supervisor 로 오인하지 않는다. owner 가 죽었거나 신원 불일치(PID 재사용)면 세션은 고아 →
   443	 *      아래 nonce 검증하 회수로 내려간다(not-our-supervisor).
   444	 *   2. terminal 정리 — reaped 는 이미 끝났으니 gc(엔트리 정리).
   445	 *   3. live/leaked(pgid 있음) — 그룹이 없으면 gc(이미 소멸). 있으면 **nonce 일치할 때만 kill**, 불일치면 refuse
   446	 *      (PID 재사용 안전 케이스).
   447	 *   4. spawning(pgid 미확정) — nonce 로 스캔해 그룹을 찾으면 scan-then-kill, 못 찾고 killAt+여유를 넘겼으면 gc,
   448	 *      아직 창 안이면 wait.
   449	 */
   450	export function evaluateReap(
   451	  entry: SessionEntry,
   452	  supervisorState: SupervisorState,
   453	  procView: ProcView,
   454	): ReapDecision {
   455	  // 1. owner 신원 게이트 — 살아있고 기동시각까지 일치해야 '진짜 우리 owner, 아직 관리 중'이다.
   456	  const ownerGenuinelyAlive =
   457	    supervisorState.observed.alive === true &&
   458	    supervisorState.observed.startedAtMs !== null &&
   459	    supervisorState.observed.startedAtMs === supervisorState.ledger.startedAtMs;
   460	  if (ownerGenuinelyAlive) {
   461	    // 살아있는 owner 의 세션을 데몬이 밑에서 빼앗아 회수하지 않는다 — owner 가 자기 마감을 강제한다(데몬은 owner
   462	    //   사망 시의 백스톱). W4/W5 정책 카베아트: 'owner 살아있으나 마감+유예 초과' 에스컬레이션은 이 계약 밖(후속).
   463	    return { action: "wait", reason: "owner supervisor 살아있고 신원 일치 — 자기 세션 관리 중이니 회수 보류(defer)" };
   464	  }
   465	  // not-our-supervisor: owner 가 죽었거나(관측 dead) PID 재사용(살아있으나 기동시각 불일치)이다. 어느 쪽이든 원
   466	  //   supervisor 는 사라졌고 세션은 고아 → nonce 검증하 회수로 진행한다. 살아있는 그 pid 는 무관한 프로세스라 절대
   467	  //   그 pid 를 신호하지 않는다(evaluateReap 은 세션 pgid 만 다룬다 — supervisor pid 신호는 데몬의 별개 경로).
   468	  const ownerNote = !supervisorState.observed.alive
   469	    ? "owner dead"
   470	    : "owner PID 재사용(기동시각 불일치) — not-our-supervisor";
   471	
   472	  // 2. terminal 정리.
   473	  if (entry.state === "reaped") {
