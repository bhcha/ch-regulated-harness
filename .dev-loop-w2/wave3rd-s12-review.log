+  if (p.rid !== rid) {
+    throw new Error(`next-action.sh rid 불일치(요청 rid=${rid}, 응답 rid=${String(p.rid)}): ${snip}`);
+  }
+  // step·action: 비어있지 않은 문자열(분기 키 — 빠지면 전이/렌더 판정이 무의미).
+  if (typeof p.step !== "string" || p.step === "") {
