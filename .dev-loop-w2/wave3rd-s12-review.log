   213	    default:
   214	      return "";
   215	  }
   216	}
   217	/** 설정 제안 요약(평이) — 뽑힌 값 · 미정 표기. */
   218	function nlSetupSummary(i: NlIntent): string {
   219	  return `규제도메인: ${i.domain ?? "미정"} · 산출물: ${i.format ?? "미정"} · 제품명: ${i.product ?? "미정"}`;
   220	}
   221	/** 인입 제안 요약(평이) — 파일별 역할 + 설정 값. */
   222	function nlIntakeSummary(i: NlIntent, acceptedCount: number): string {
   223	  const roleLabel: Record<string, string> = {
   224	    working_backwards: "제품 자료",
   225	    test_report: "시험성적서",
   226	    reference: "참고 자료",
   227	  };
   228	  const lines = i.files.map((f) => `· ${roleLabel[f.role] ?? "자료"}: ${f.path}`);
   229	  const head = `첨부 자료 ${acceptedCount}건으로 시작할게요 — ${nlSetupSummary(i)}`;
   230	  return [head, ...lines].join("\n");
   231	}
   232	function questionsFor(intent: NlIntent): string[] {
   233	  return intent.uncertain.map(questionFor).filter((q) => q.length > 0);
   234	}
   235	/** 뽑힌 설정 필드만 patch 로(undefined 미포함). */
   236	function setupPatch(i: NlIntent): { product?: string; domain?: string; format?: string } {
   237	  const p: { product?: string; domain?: string; format?: string } = {};
   238	  if (i.domain !== undefined) p.domain = i.domain;
   239	  if (i.format !== undefined) p.format = i.format;
   240	  if (i.product !== undefined) p.product = i.product;
   241	  return p;
   242	}
