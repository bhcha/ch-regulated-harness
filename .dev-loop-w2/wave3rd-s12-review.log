   140	  }
   141	}
   142	
   143	/** 필수 문자열 payload 추출 — 없으면 노출안전한 BadJobError. */
   144	function requireStr(v: unknown, label: string): string {
   145	  if (typeof v === "string" && v.trim() !== "") return v;
   146	  throw new BadJobError(`${label} 정보가 없어 처리할 수 없습니다.`);
   147	}
   148	
   149	/** 선택 문자열 payload 추출(빈 문자열/비문자열 = 미지정). */
   150	function asStr(v: unknown): string | undefined {
   151	  return typeof v === "string" && v !== "" ? v : undefined;
   152	}
