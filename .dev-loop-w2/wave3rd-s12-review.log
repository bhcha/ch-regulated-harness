   106	/** 버튼 value(JSON) 파싱 — {run_id, action, ...}. 실패 시 null. */
   107	export function parseActionValue(
   108	  value: string | undefined,
   109	): {
   110	  run_id: string;
   111	  action: string;
   112	  stage?: string;
   113	  ra_required?: boolean;
   114	  option?: string;
   115	  phase?: string;
   116	  iteration?: number | null;
   117	} | null {
   118	  if (!value) return null;
   119	  try {
   120	    const v = JSON.parse(value) as Record<string, unknown>;
   121	    if (typeof v.run_id !== "string" || typeof v.action !== "string") return null;
   122	    return {
   123	      run_id: v.run_id,
   124	      action: v.action,
   125	      stage: typeof v.stage === "string" ? v.stage : undefined,
   126	      ra_required: v.ra_required === true,
   127	      option: typeof v.option === "string" ? v.option : undefined,
   128	      // 다안 stale 가드용 도장(stamp) — 옵션 버튼에만 실린다.
   129	      phase: typeof v.phase === "string" ? v.phase : undefined,
   130	      iteration: typeof v.iteration === "number" ? v.iteration : v.iteration === null ? null : undefined,
   131	    };
   132	  } catch {
   133	    return null;
   134	  }
   135	}
   136	
   137	/** action 문자열 → 잡 kind. 알 수 없으면 null(무시). */
   138	function actionToKind(action: string): JobKind | null {
   139	  switch (action) {
   140	    case "approve":
   141	    case "select":
   142	    case "revise":
   143	    case "ingest":
   144	    case "review":
   145	    case "raise-limit":
   146	      return action;
   147	    case "generate":
   148	      return "generate";
   149	    default:
   150	      return null;
   151	  }
   152	}
