    53	/** 구조화 추출 도구 — 단일 tool, tool_choice 로 강제해 확정적 JSON 을 받는다(API 래퍼). */
    54	export const DECLARE_INTENT_TOOL = {
    55	  name: INTENT_TOOL_NAME,
    56	  description:
    57	    "사용자가 챗에 남긴 자유 텍스트에서 '명시적으로 선언한' 것만 구조화한다. 내용으로 추론하지 말 것.",
    58	  input_schema: INTENT_JSON_SCHEMA,
    59	} as const;
