   147	/** 감독 결과(세션 1건). */
   148	export type SessionOutcome =
   149	  | "exited" /** 세션이 신호 전에 스스로 종료(정상 완주 후보 — 전이 여부는 러너가 next-action 으로 확인) */
   150	  | "killed" /** 마감 강제(TERM/KILL 후 kill_at 시점 그룹 소멸 확인됨) */
   151	  | "reap_failed" /** kill_at 시점에도 그룹 생존 = 마감 강제 실패('결국 종료'가 아니다 · 계획 7절) */
   152	  | "refused"; /** 스폰 여유 부족(남은 시간 < TERM_MARGIN) → 애초에 안 띄웠다 */
   153	
   154	export interface SuperviseResult {
   155	  outcome: SessionOutcome;
   156	  /** 세션이 스스로 종료했을 때의 종료코드(신호 종료·미종료·refused 면 null). */
   157	  exitCode: number | null;
   158	  /** 진단 한 줄(로그·failed 사유). 사람 카드 문구가 아니다. */
   159	  detail: string;
   160	}
