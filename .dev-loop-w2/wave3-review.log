    98	export function computeKillSchedule(input: KillScheduleInput): KillSchedule {
    99	  assertFiniteMs("claimedAtMs", input.claimedAtMs);
   100	  assertFiniteMs("genTimeoutMs", input.genTimeoutMs);
   101	  assertFiniteMs("deadlineMs", input.deadlineMs);
   102	  const budgetKillMs = input.claimedAtMs + input.genTimeoutMs;
   103	  const killAtMs = Math.min(budgetKillMs, input.deadlineMs);
   104	  return {
   105	    killAtMs,
   106	    termAtMs: killAtMs - TERM_MARGIN_MS,
   107	    killSigAtMs: killAtMs - KILL_MARGIN_MS,
   108	  };
   109	}
