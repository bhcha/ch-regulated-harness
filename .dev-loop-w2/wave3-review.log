   261	// ── 프로덕션 기본 seam (main() 과 W4 데몬이 쓴다 · W3 테스트에선 실행되지 않는다) ──────────────────
   262	
   263	/** 실시계 seam — setTimeout 은 arm 시점의 상대 지연이지만, 발화 콜백(enforce)이 `now()` 로 재판정하므로 슬립에 강건하다. */
   264	export const realClock: Pick<SuperviseDeps, "now" | "setAlarm"> = {
   265	  now: () => Date.now(),
   266	  setAlarm: (atMs, fn) => {
   267	    const handle = setTimeout(() => fn(), Math.max(0, atMs - Date.now()));
   268	    return () => clearTimeout(handle);
   269	  },
   270	};
   271	
   272	/** 세션 그룹 신호(cli-parser 의 killGroup 패턴) — 이미 없으면 조용히 무시. */
   273	export function realSignalGroup(pgid: number, sig: "SIGTERM" | "SIGKILL"): void {
   274	  try {
   275	    process.kill(-pgid, sig); // 음수 pid = 프로세스그룹 전체(세션 + Bash 손자)
   276	  } catch {
   277	    // 이미 종료됨 — 무해.
   278	  }
   279	}
   280	
   281	/** 그룹 생존 확인 — ESRCH=소멸(false), EPERM=존재하나 권한없음(보수적으로 생존=true), 그 외=생존. */
   282	export function realGroupAlive(pgid: number): boolean {
   283	  try {
   284	    process.kill(-pgid, 0);
   285	    return true;
   286	  } catch (e) {
   287	    return (e as NodeJS.ErrnoException).code === "EPERM";
   288	  }
   289	}
   290	
   291	/** cli-parser 와 동일 형태의 spawn 옵션(detached · stdin ignore). 스폰 없이 형태를 단위 테스트로 못 박기 위해 분리. */
   292	export function buildSupervisorSpawnOptions(cwd: string, env: Record<string, string>): SpawnOptions {
   293	  // stdio 는 새 mutable 배열로(SpawnOptions 는 readonly 튜플을 받지 않는다). 상수를 스프레드해 드리프트를 막는다.
   294	  return { cwd, env, stdio: [...SUPERVISOR_SPAWN_STDIO], detached: SUPERVISOR_SPAWN_DETACHED };
   295	}
   296	
   297	/**
   298	 * 프로덕션 세션 spawn seam(main()·W4 전용) — 실제 `claude` 를 detached 로 띄운다. **W3 테스트에선 호출되지 않는다**
   299	 *   (실세션 0 · 스폰은 주입 seam 뒤). cli-parser 의 러너 패턴(그룹 kill·stdin ignore·출력 상한)을 그대로 잇는다.
   300	 */
   301	export function defaultSpawnSession(plan: SessionPlan): SpawnedSession {
   302	  const child = spawn("claude", plan.argv, buildSupervisorSpawnOptions(plan.cwd, plan.env));
   303	  let total = 0;
   304	  const capKill = (): void => {
   305	    if (child.pid !== undefined) realSignalGroup(child.pid, "SIGKILL");
   306	  };
   307	  const onChunk = (chunk: Buffer): void => {
   308	    total += chunk.length;
   309	    if (total > SUPERVISOR_MAX_OUTPUT_BYTES) capKill(); // 폭주 출력 → 그룹 kill.
   310	  };
   311	  child.stdout?.on("data", onChunk);
   312	  child.stderr?.on("data", onChunk);
   313	  const exited = new Promise<{ code: number | null }>((resolve) => {
   314	    child.on("close", (code) => resolve({ code }));
   315	    child.on("error", () => resolve({ code: null })); // 스폰 실패도 '종료'로 환원(감독은 회수 알람이 백스톱).
   316	  });
   317	  // child.pid 미정(스폰 즉시 실패)이면 pgid 를 -1 로 — realGroupAlive(-1) 은 ESRCH 라 회수 확인이 즉시 통과한다.
   318	  return { pgid: child.pid ?? -1, exited };
   319	}
   320	
   321	/** 프로덕션 감독 seam 한 벌(main()·W4 가 주입). */
   322	export const defaultSuperviseDeps: SuperviseDeps = {
   323	  now: realClock.now,
   324	  setAlarm: realClock.setAlarm,
   325	  spawnSession: defaultSpawnSession,
   326	  signalGroup: realSignalGroup,
   327	  groupAlive: realGroupAlive,
   328	};
