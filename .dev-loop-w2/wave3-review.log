   204	// ── FakeClock (실타이머 0 · 결정적 발화) ─────────────────────────────────────────
   205	class FakeClock {
   206	  private t: number;
   207	  private alarms: Array<{ atMs: number; fn: () => void; cancelled: boolean }> = [];
   208	  constructor(start: number) {
   209	    this.t = start;
   210	  }
   211	  now = (): number => this.t;
   212	  setAlarm = (atMs: number, fn: () => void): (() => void) => {
   213	    const a = { atMs, fn, cancelled: false };
   214	    this.alarms.push(a);
   215	    return () => {
   216	      a.cancelled = true;
   217	    };
   218	  };
   219	  /** now 를 t 로 옮기고, atMs ≤ t 인 미취소 알람을 atMs 오름차순으로 발화(발화 중 취소되면 건너뛴다). */
   220	  advanceTo(t: number): void {
   221	    this.t = t;
   222	    const due = this.alarms.filter((a) => !a.cancelled && a.atMs <= t).sort((x, y) => x.atMs - y.atMs);
   223	    for (const a of due) {
   224	      if (a.cancelled) continue;
   225	      a.cancelled = true;
   226	      a.fn();
   227	    }
   228	  }
   229	}
