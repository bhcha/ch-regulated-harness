   139	 *
   140	 * ⚠ **이건 1차 경계가 아니다**(A-5). 이 명령들은 '승인 필요' 부류라 **allow 규칙이 없다는 사실만으로 이미
   141	 *   fail-closed**(헤드리스엔 승인을 답할 주체가 없다). 그러므로 여기 목록은 방어심층이지 경계의 본체가 아니고,
   142	 *   **동의어를 열거하려 들지 않는다**(A-5: 간접 스펠링 `sh -c`·`python3 -c` 는 승인 게이트가 잡는다 —
   143	 *   열거는 어차피 불완전한데 완전하다는 착각만 준다).
   144	 *   그럼에도 굳이 적는 이유: 결정은 사람의 몫이라(AGENTS 5번 절) **명시적으로 거부됐다는 기록**이 남는 편이,
   145	 *   '규칙이 없어서 우연히 막혔다'보다 감사에 유리하고 allow 규칙이 실수로 넓어진 날의 마지막 그물이 된다.
   146	 *
   147	 * 목록은 실제 `core/scripts/*.sh` 파일명이다(계획의 `apply-*` = 오늘 기준 `apply-learnings.sh` 하나 —
   148	 *   `apply-intake`·`apply-proposal` 은 독립 스크립트가 아니라 `gate.sh` 내부 훅이다). 정렬 = 결정론.
   149	 *   ⚠ core 가 이 파일들을 개명하면 규칙이 조용히 헛돈다 → 단위 테스트가 실재를 확인해 드리프트를 깨운다.
   150	 */
   151	export const DECISION_SCRIPTS = [
   152	  "advance-phase.sh",
   153	  "apply-learnings.sh",
   154	  "approve.sh",
   155	  "gate.sh",
   156	  "ingest-bundle.sh",
   157	  "ingest.sh",
   158	  "intake.sh",
   159	  "kcia-check.sh",
   160	  "new-run.sh",
   161	  "revise.sh",
   162	  "select.sh",
   163	] as const;
   164	
   165	/**
   166	 * 절대경로 → 권한 규칙의 **절대 글롭 표기**(`//abs/...`). 부록A-3 의 `Read(//**)`(유효한 전체 글롭)와 같은 표기다.
   167	 *
   168	 * 왜 상대 표기(`./state.json`)를 쓰지 않나: 규칙의 상대경로가 **무엇을 기준으로** 풀리는지가 부록A 에 없다
   169	 *   (settings 파일이 있는 디렉터리인가, cwd 인가 — A-3 의 프로브는 그 둘이 갈리는 배치가 아니었다).
   170	 *   우리 settings 는 cwd(런 디렉터리)가 아니라 **격리 CONFIG_DIR** 안에 있으므로 그 차이가 곧 규칙의 유효/무효를
   171	 *   가른다. 절대 표기는 그 질문 자체를 없앤다.
   172	 * ⚠ **미실측 — W5 카나리 확인 필요**: A-3 이 실측한 절대 글롭은 `Read(//**)` 이고, `Write`/`Edit` 규칙의 절대
   173	 *   표기·매칭은 기록이 없다. 틀렸다면 이 deny 는 조용히 무효다 → 그래서 이 층을 '경계의 본체'로 부르지 않는다.
   174	 */
   175	function absGlob(absPath: string): string {
   176	  return `/${absPath}`;
   177	}
   178	
   179	/** 경로 인자 검증(절대 + 규칙 문자열에 박을 수 있는 형태). 통과하면 그 경로를 그대로 돌려준다. */
   180	function assertRulePath(label: string, value: string): string {
   181	  if (typeof value !== "string" || value.trim() === "") {
   182	    throw new Error(`${label} 가 필요합니다 — 절대경로를 넘기세요.`);
   183	  }
   184	  if (!isAbsolute(value)) {
   185	    throw new Error(
   186	      `${label} 는 절대경로여야 합니다(받은 값: '${value}'). 상대경로는 cwd 에 따라 결과가 달라져 조립 결정론이 깨지고, ` +
   187	        "부록A-10 실측상 모델이 상대경로 깊이를 오산해 명령이 거부됩니다.",
   188	    );
   189	  }
   190	  if (PATH_UNSAFE.test(value)) {
   191	    throw new Error(
   192	      `${label} 에 공백·셸/글롭 메타문자를 쓸 수 없습니다(권한 규칙 문자열이 깨집니다): '${value}'`,
   193	    );
   194	  }
   195	  return value;
   196	}
