   137	  /** 절대 시각 `atMs` 에 fn 을 1회 발화하도록 예약하고, 취소 함수를 돌려준다. 이미 지난 시각이면 즉시(다음 틱) 발화. */
   138	  setAlarm: (atMs: number, fn: () => void) => () => void;
   139	  /** 세션 1건을 detached 로 spawn(플랜대로). supervisor 의 자식이 된다. */
   140	  spawnSession: (plan: SessionPlan) => SpawnedSession;
   141	  /** 세션 그룹에 신호 전송(`process.kill(-pgid, sig)` — 이미 없으면 무해). */
   142	  signalGroup: (pgid: number, sig: "SIGTERM" | "SIGKILL") => void;
