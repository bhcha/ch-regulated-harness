   358	// 직접 실행(= 데몬이 띄운 detached 프로세스)일 때만 main. import 로 로드되면(테스트·runner) 실행되지 않는다.
   359	if (process.argv[1] === fileURLToPath(import.meta.url)) {
   360	  const specPath = process.argv[2];
   361	  if (specPath === undefined || specPath === "") {
   362	    process.stderr.write("supervisor: 잡 스펙 JSON 경로가 필요합니다(argv[2]).\n");
   363	    process.exit(2);
   364	  } else {
   365	    void main(specPath);
   366	  }
   367	}
