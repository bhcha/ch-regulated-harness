   162	/**
   163	 * 세션 1건을 감독한다 — detached 로 띄우고, kill_at 스케줄로 마감을 강제하고, 결과를 돌려준다.
   164	 *
   165	 * settle 은 **정확히 한 번**: (a) 세션 자가 종료 · (b) kill_at 회수 확인 중 먼저 오는 쪽. 회수 알람이 kill_at 에
   166	 *   반드시 판정하므로 세션이 영영 안 끝나도 promise 는 kill_at 에 풀린다(행 불가).
   167	 */
   168	export function superviseSession(
   169	  plan: SessionPlan,
   170	  schedule: KillSchedule,
   171	  deps: SuperviseDeps,
   172	): Promise<SuperviseResult> {
   173	  // 스폰 여유 사전 확인 — 즉시 죽여야 할 세션은 띄우지 않는다(신호 낭비·산출물 파손 회피).
   174	  if (!hasSpawnRoom(schedule, deps.now())) {
   175	    return Promise.resolve({
   176	      outcome: "refused",
   177	      exitCode: null,
   178	      detail: `스폰 여유 부족(남은 ${remainingBeforeKill(schedule, deps.now())}ms < TERM_MARGIN ${TERM_MARGIN_MS}ms)`,
   179	    });
   180	  }
   181	
   182	  const session = deps.spawnSession(plan);
   183	  const pgid = session.pgid;
   184	
   185	  return new Promise<SuperviseResult>((resolve) => {
   186	    let settled = false;
   187	    let termSent = false;
   188	    let killSent = false;
   189	    const cancels: Array<() => void> = [];
   190	
   191	    const settle = (r: SuperviseResult): void => {
   192	      if (settled) return;
   193	      settled = true;
   194	      for (const cancel of cancels) cancel();
   195	      resolve(r);
   196	    };
   197	
   198	    // 세션이 스스로 종료 — 신호를 보낸 적 없으면 정상 종료, 보낸 뒤면 강제 종료로 기록한다.
   199	    const onSelfExit = (code: number | null): void =>
   200	      settle({
   201	        outcome: killSent || termSent ? "killed" : "exited",
   202	        exitCode: code,
   203	        detail: killSent || termSent ? "신호 후 세션 종료" : "세션 자가 종료",
   204	      });
   205	    session.exited.then(
   206	      (e) => onSelfExit(e.code),
   207	      () => onSelfExit(null), // 종료 관측 자체가 실패해도 감독은 계속(회수 알람이 백스톱).
   208	    );
   209	
   210	    /**
   211	     * 마감 강제 한 스텝 — **어느 알람이 깨우든 `now()` 로 due 페이즈를 재계산**해 밀린 단계를 즉시 따라잡는다.
   212	     *   (밀린 타이머 내성: TERM 알람이 kill_at 이후에 늦게 깨어나면 여기서 KILL+회수확인까지 한 번에 수행.)
   213	     */
   214	    const enforce = (): void => {
   215	      if (settled) return;
   216	      const now = deps.now();
   217	      if (now >= schedule.killAtMs) {
   218	        // 밀린 경우를 대비해 아직 안 보낸 신호를 지금 마저 보낸다(그 뒤 곧바로 소멸 확인).
   219	        if (!termSent) {
   220	          deps.signalGroup(pgid, "SIGTERM");
   221	          termSent = true;
   222	        }
   223	        if (!killSent) {
   224	          deps.signalGroup(pgid, "SIGKILL");
   225	          killSent = true;
   226	        }
   227	        // kill_at 시점 판정: **지금 소멸했는가**(결국이 아니라). 살아 있으면 회수 실패.
   228	        if (deps.groupAlive(pgid)) {
   229	          settle({ outcome: "reap_failed", exitCode: null, detail: `kill_at 시점 그룹(${pgid}) 생존 — 회수 실패` });
   230	        } else {
   231	          settle({ outcome: "killed", exitCode: null, detail: "마감 강제(회수 확인됨)" });
   232	        }
   233	        return;
   234	      }
   235	      if (now >= schedule.killSigAtMs) {
   236	        if (!termSent) {
   237	          deps.signalGroup(pgid, "SIGTERM");
   238	          termSent = true;
   239	        }
   240	        if (!killSent) {
   241	          deps.signalGroup(pgid, "SIGKILL");
   242	          killSent = true;
   243	        }
   244	        return;
   245	      }
   246	      if (now >= schedule.termAtMs) {
   247	        if (!termSent) {
   248	          deps.signalGroup(pgid, "SIGTERM");
   249	          termSent = true;
   250	        }
   251	      }
   252	    };
   253	
   254	    // 세 시점 모두 알람을 건다. 어느 것이 늦게 깨어나도 enforce 가 절대 시계로 따라잡으므로 순서·누락에 강건하다.
   255	    cancels.push(deps.setAlarm(schedule.termAtMs, enforce));
   256	    cancels.push(deps.setAlarm(schedule.killSigAtMs, enforce));
   257	    cancels.push(deps.setAlarm(schedule.killAtMs, enforce));
   258	  });
   259	}
