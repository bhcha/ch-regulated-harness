   351	export interface SessionArgsInput {
   352	  /** 세션에 넘길 프롬프트 = skill-rewrite 의 치환 산물(SKILL.md 전문). 프리앰블을 덧붙이지 않는다(부록A-10). */
   353	  prompt: string;
   354	  /** `--allowedTools` 규칙 — **skill-rewrite 도출 산물**(손으로 짜지 않는다 · 부록A-9 교훈). */
   355	  allowRules: string[];
   356	  /** `--disallowedTools` 규칙(buildDisallowedTools 산물). */
   357	  disallowRules: string[];
   358	  /** `--max-turns`(config 의 sdkMaxTurns). 이 모듈은 env 를 읽지 않는다 — 순수 유지. */
   359	  maxTurns: number;
   360	  /** `--add-dir`(buildAddDirs 산물 · 절대경로). */
   361	  addDirs: string[];
   362	}
   363	
   364	/**
   365	 * argv 조립(순수).
   366	 *
   367	 * **cwd 는 여기 없다** — CLI 에 cwd 플래그가 없기 때문이다(cwd 는 spawn 속성이라 러너가 넘긴다).
   368	 *   그래도 cwd 는 이 모듈이 정한다(buildRunCwd·buildSessionPlan): 경계를 정하는 자리는 한 곳이어야 한다.
   369	 *
   370	 * 순서 규약(두 가지 실측이 강제한다 — 로컬 파서 수준 프로브 · claude 2.1.212 · **API 콜 없음**):
   371	 *   ① **프롬프트는 `--` 뒤 피연산자**로 넘긴다. cli-parser 의 `-p <prompt>` 관례에서 벗어나는 유일한 지점이고,
   372	 *      이유가 있다: `-p` 는 값을 받지 않는 불리언이라 프롬프트는 위치인자인데, 우리 프롬프트는 SKILL.md 전문이라
   373	 *      **YAML frontmatter(`---`)로 시작**한다 → 대시로 시작하는 토큰이라 인자 파서가 **옵션으로 읽는다**.
   374	 *        `claude -p "---\nname: brief" --zzz-unknown --output-format json` → `error: unknown option '---\nname: brief…'`
   375	 *        `claude -p --zzz-unknown --output-format json -- "---\nname: brief"` → `error: unknown option '--zzz-unknown'`
   376	 *      (뒤쪽 = 프롬프트가 피연산자로 정상 수용됐다는 증거. 미지 옵션 오류는 옵션 파싱이 **끝난 뒤** 나므로 이 대조가
   377	 *       결정적이다 — 대조군 없이 앞쪽만 보면 오독을 놓친다.) `--` 없이 조립하면 **모든 SKILL.md 프롬프트가 첫 줄에서
   378	 *      죽는다**. 부록A 는 프롬프트 전달 형태를 기록하지 않아 이 지점은 A 가 답을 주지 않는 자리였다.
   379	 *   ② **variadic 플래그를 뒤에 모은다**. `--add-dir`·`--tools`·`--allowedTools`·`--disallowedTools` 는 전부
   380	 *      `<x...>` 수집기라 뒤 토큰을 삼킨다. 실측상 수집은 다음 `-` 접두 토큰(그리고 `--`)에서 멈추므로,
   381	 *      '값 있는 플래그들 → variadic 들 → `--` → 프롬프트' 순서면 서로를 먹지 않는다(cli-parser 가 `--tools ""` 를
   382	 *      맨 끝에 둔 것과 같은 조심의 일반화).
   383	 *
   384	 * @throws 프롬프트가 비었거나 · maxTurns 가 1 이상의 정수가 아니거나 · addDirs/allowRules 가 비었거나 ·
   385	 *         규칙/경로 토큰이 `-` 로 시작할 때.
   386	 */
   387	export function buildSessionArgs(input: SessionArgsInput): string[] {
   388	  const { prompt, allowRules, disallowRules, maxTurns, addDirs } = input;
   389	
   390	  if (typeof prompt !== "string" || prompt.trim() === "") {
   391	    throw new Error("프롬프트가 비어 있습니다 — skill-rewrite 의 치환 산물(SKILL.md 전문)을 넘기세요.");
   392	  }
   393	  // config.sdkMaxTurns 와 같은 규칙(지어내지 않는다): 읽을 수 없으면 clamp·반올림이 아니라 멈춘다.
   394	  if (!Number.isSafeInteger(maxTurns) || maxTurns < 1) {
   395	    throw new Error(`--max-turns 값이 올바르지 않습니다: '${maxTurns}' — 1 이상의 정수여야 합니다(예: 50).`);
   396	  }
   397	  if (!Array.isArray(addDirs) || addDirs.length === 0) {
   398	    throw new Error("addDirs 가 비어 있습니다 — buildAddDirs() 의 산물을 넘기세요(읽기 경계에 추가할 경로).");
   399	  }
   400	  if (!Array.isArray(allowRules) || allowRules.length === 0) {
   401	    // 규칙 0개면 세션은 산출물만 쓰고 전이하지 못한다 — 부록A-9 1차 시도의 실패 양상(산출물은 썼는데
   402	    //   전이 3회 거부 → next-action 정체) 그대로다. 조용히 그 상태를 만드는 대신 조립에서 끊는다.
   403	    throw new Error(
   404	      "allowRules 가 비어 있습니다 — 무인 세션은 전이 명령 한 줄을 통과시킬 규칙이 없으면 산출물만 쓰고 게이트에서 정체합니다. " +
   405	        "skill-rewrite 의 도출 산물을 넘기세요.",
   406	    );
   407	  }
   408	
   409	  // variadic 자리에 들어가는 caller 문자열은 **`-` 로 시작하면 안 된다**: 파서가 그 토큰을 옵션으로 읽어
   410	  //   ① 수집을 조기 종료(= 뒤 규칙들이 조용히 누락 = 경계가 의도와 달라짐) ② 최악의 경우 그 토큰 자체가
   411	  //   플래그로 해석된다(`--dangerously-skip-permissions` 를 규칙인 척 흘려보내는 길). 조립에서 끊는다.
   412	  for (const [label, values] of [
   413	    ["--add-dir", addDirs],
   414	    ["--allowedTools", allowRules],
   415	    ["--disallowedTools", disallowRules],
   416	  ] as const) {
   417	    for (const v of values) {
   418	      if (typeof v !== "string" || v === "") {
   419	        throw new Error(`${label} 항목이 비어 있습니다 — 빈 토큰은 인자 위치를 밀어 조립을 어긋나게 합니다.`);
   420	      }
   421	      if (v.startsWith("-")) {
   422	        throw new Error(
   423	          `${label} 항목은 '-' 로 시작할 수 없습니다: '${v}' — 인자 파서가 이 토큰을 옵션으로 읽어 뒤 항목을 누락시키거나 ` +
   424	            "플래그로 실행합니다(경계가 조용히 달라집니다).",
   425	        );
   426	      }
   427	    }
   428	  }
   429	
   430	  return [
   431	    "-p",
   432	    // 봉투(JSON)로 받아야 러너가 결과·비용·permission_denials 를 읽는다(도구 흔적 = 경계가 하중을 받은 증거).
   433	    "--output-format",
   434	    "json",
   435	    "--permission-mode",
   436	    SESSION_PERMISSION_MODE,
   437	    "--max-turns",
   438	    String(maxTurns),
   439	    /**
   440	     * 설정 소스 = `user` 하나(모듈 상단 '설정 소스' 절). 격리 CONFIG_DIR 는 **user 설정만** 옮기므로 이 핀이 없으면
   441	     *   레포의 `.claude/settings.local.json`(= 사람이 '허용'을 누를 때마다 자라는 파일)이 무인 세션 권한에 병합된다.
   442	     *   `<sources>` 는 variadic 이 아니라 **단일 콤마목록 값**이라 variadic 구간 앞에 두어도 뒤 토큰을 삼키지 않는다.
   443	     */
   444	    "--setting-sources",
   445	    SESSION_SETTING_SOURCES,
   446	    /**
   447	     * MCP 서버 0개 — `--mcp-config` 를 **주지 않은 채** 이 플래그를 켜면 '설정에서 온 MCP 전부 무시'가 된다.
   448	     *   `--tools` 는 빌트인만 제한하므로 이게 없으면 `core/.mcp.json` 이 도구 표면에 붙을 수 있다(불리언 = 값 없음).
   449	     */
   450	    "--strict-mcp-config",
   451	    // 여기부터 variadic — 각각 다음 `-` 접두 토큰에서 멈춘다(위 순서 규약 ②).
   452	    "--add-dir",
   453	    ...addDirs,
   454	    "--tools",
   455	    SESSION_TOOLS,
   456	    /**
   457	     * 규칙 **1건 = argv 토큰 1개**로 넘긴다.
   458	     *
   459	     * ⚠ **미실측 — W5 카나리 확인 필요**: 부록A 는 `--allowedTools` 에 **여러 규칙을 어떤 형태로 넘겼는지
   460	     *   기록하지 않았다**(한 토큰에 공백으로 이어붙였는지 · 규칙마다 토큰을 나눴는지 · 플래그를 반복했는지).
   461	     *   A-9 가 확인해 준 건 '두 규칙이 실제로 매칭됐다'는 결과뿐이다. 그러니 이 선택은 실측이 아니라 **판단**이다:
   462	     *     · 우리 규칙은 **내부에 공백이 있다**(`Bash(bash /abs/scripts/run-stage.sh brief rid)`). 한 토큰에
   463	     *       이어붙이면 규칙 내부 공백과 구분자 공백을 CLI 가 무엇으로 가르는지에 경계를 맡기게 된다.
   464	     *     · A-9 는 공백 포함 규칙 하나가 **온전히 매칭**됐음을 보였다(전이 성공) = 토큰 내부 공백으로 규칙을
   465	     *       쪼개지는 않는다. 그렇다면 토큰을 나누는 쪽이 '구분자 해석'을 CLI 에 넘기지 않는 유일한 형태다.
   466	     *   다만 **여러 토큰을 각각 독립 규칙으로 읽는지**는 라이브에서만 확인된다. 틀리면 전이가 거부되고
   467	     *   next-action 이 정체해 드러난다(= 조용한 통과가 아니라 fail-closed) — W5 무인 완주가 그 카나리다.
   468	     */
   469	    "--allowedTools",
   470	    ...allowRules,
   471	    ...(disallowRules.length > 0 ? ["--disallowedTools", ...disallowRules] : []),
   472	    // `--` 가 옵션 파싱을 끝낸다 → 뒤의 프롬프트는 frontmatter 로 시작해도 피연산자로 안전하게 수용된다(위 ①).
   473	    "--",
   474	    prompt,
   475	  ];
   476	}
   477	
   478	/** 세션 1건을 띄우는 데 필요한 전부(러너가 이걸 그대로 소비한다 — 축을 빠뜨릴 여지를 없앤다). */
   479	export interface SessionPlan {
   480	  /** `claude` 에 넘길 argv. */
   481	  argv: string[];
   482	  /** spawn cwd = 읽기 경계(`<coreRoot>/runs/<rid>`). */
   483	  cwd: string;
   484	  /** spawn env(위생 재구성 + 격리 CONFIG_DIR + OAuth). */
   485	  env: Record<string, string>;
   486	  /** 격리 CONFIG_DIR 에 쓸 settings 내용·경로(쓰기는 러너의 몫 — 이 모듈은 순수). */
   487	  settings: WorkerSettings;
   488	  settingsJson: string;
   489	  settingsPath: string;
   490	  /** 조립에 쓰인 add-dir(관측·로그용). */
   491	  addDirs: string[];
   492	}
   493	
   494	export interface SessionPlanInput {
   495	  /** core(하네스) 체크아웃 절대경로(config.harnessRoot()). */
   496	  coreRoot: string;
   497	  /** 이 잡의 run_id. */
   498	  rid: string;
   499	  /** state.json 에 사람이 선언한 규제도메인(팩 선택 키) — 이 세션이 볼 수 있는 팩은 이것 하나뿐이다. */
   500	  domain: string;
   501	  /** skill-rewrite 의 치환 산물. */
   502	  prompt: string;
   503	  /** skill-rewrite 의 도출 규칙. */
   504	  allowRules: string[];
   505	  /** config.sdkMaxTurns(). */
   506	  maxTurns: number;
   507	  /** 워커가 이 잡용으로 만든 전용 빈 디렉터리(절대경로). 생성·정리는 러너의 몫. */
   508	  configDir: string;
   509	  /** 구독 인증 토큰(chat/.env 의 CLAUDE_CODE_OAUTH_TOKEN). 없으면 세션은 인증 실패로 죽는다(A-8). */
   510	  oauthToken?: string;
   511	  /** 위생 재구성의 base(보통 process.env). 이 모듈은 process.env 를 직접 읽지 않는다 — 순수 유지. */
   512	  baseEnv: NodeJS.ProcessEnv;
   513	}
   514	
   515	/**
   516	 * 세션 1건 조립의 단일 진입점 — 부록A-9 의 축을 **한 번에** 묶는다.
   517	 *
   518	 * 왜 조립기를 따로 두나: 축이 하나라도 빠지면 경계가 조용히 약해진다(add-dir 를 빠뜨리면 세션이 못 읽어 시끄럽게
   519	 *   실패하지만, **settings 를 빠뜨리면 state 쓰기 금지가 사라지고 아무 소리도 안 난다**). 러너가 축을 손으로
   520	 *   재조립하지 않도록 여기서 한 덩이로 돌려준다 — '경계를 정하는 자리는 한 곳'이라는 이 모듈의 존재 이유 그대로다.
   521	 */
   522	export function buildSessionPlan(input: SessionPlanInput): SessionPlan {
   523	  const cwd = buildRunCwd({ coreRoot: input.coreRoot, rid: input.rid });
   524	  const addDirs = buildAddDirs({ coreRoot: input.coreRoot, domain: input.domain });
   525	  const settings = buildWorkerSettings({ runDir: cwd, addDirs });
   526	  const argv = buildSessionArgs({
   527	    prompt: input.prompt,
   528	    allowRules: input.allowRules,
   529	    disallowRules: buildDisallowedTools(input.coreRoot),
   530	    maxTurns: input.maxTurns,
   531	    addDirs,
   532	  });
   533	  const env = buildSessionEnv(input.baseEnv, {
   534	    configDir: input.configDir,
   535	    ...(input.oauthToken !== undefined ? { oauthToken: input.oauthToken } : {}),
   536	  });
   537	  return {
   538	    argv,
   539	    cwd,
   540	    env,
   541	    settings,
   542	    settingsJson: serializeWorkerSettings(settings),
   543	    settingsPath: join(input.configDir, WORKER_SETTINGS_FILENAME),
   544	    addDirs,
   545	  };
   546	}
     1	/**
     2	 * skill-rewrite.ts — SKILL.md 결정론 치환 + allow 규칙 도출(순수).
     3	 *
     4	 * 무인 `claude` 세션이 한 단계를 생성할 때, **프롬프트와 `--allowedTools` 경계는 한 출처에서 나와야 한다**.
