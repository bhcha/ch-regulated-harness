   255	  //   이 RangeError. 그건 이 함수가 방금 약속한 '명시 오설정은 기동 시 끊는다'의 정반대다(운영자는 봇이 뜬 걸 보고
   256	  //   설정이 맞다고 믿는다). 그래서 **환산 후**를 한 번 더 본다: 마감은 ISO 문자열로 잡 파일에 실려 소비자가 읽는
   257	  //   값이라, Date 로 표현 못 하는 상한은 상한이 아니다.
   258	  if (!Number.isSafeInteger(ms) || ms > MAX_TIMEOUT_MS) {
   259	    throw new Error(
   260	      `${name} 값이 너무 큽니다: "${raw}" — 초 단위로 ${Math.round(MAX_TIMEOUT_MS / 1000)} 이하여야 합니다. ` +
   261	        `밀리초를 초 자리에 쓰지 않았는지 확인해 주세요.`,
   262	    );
