   330	// ── detached 진입점 (데몬이 `node supervisor.js <잡스펙.json>` 을 detached 로 띄운다 · W3 테스트 밖) ──────
   331	
   332	/**
   333	 * detached 진입점 — 데몬(W4)이 이 파일을 **detached 로** spawn 해 프로세스그룹 리더로 만든 뒤, 잡 스펙 JSON 파일
   334	 *   경로를 argv[2] 로 넘긴다. 이 프로세스 안에서 `runJobSession` 이 돌며 주/복구 세션을 자식으로 띄우므로, 데몬의
   335	 *   backstop `kill(-이 프로세스 PID)` 이 트리 전체를 회수한다(잠긴 결정 4). 결과 JSON 을 stdout 한 줄로 내보내고
   336	 *   ok 면 0, 실패면 1 로 종료한다.
   337	 *
   338	 * ⚠ **W3 단위 테스트는 이 함수를 실행하지 않는다**(실 세션·실 파일 · 스폰 seam 뒤). 여기는 배선 glue 다 —
   339	 *   `runJobSession` 은 **동적 import** 로 불러 정적 순환(supervisor ↔ runner)을 피한다(런타임 init 순서 무관).
   340	 */
   341	async function main(specPath: string): Promise<void> {
   342	  const { readFile } = await import("node:fs/promises");
   343	  const { runJobSession } = await import("./cli-session-runner.js");
   344	  const spec = JSON.parse(await readFile(specPath, "utf8")) as Parameters<typeof runJobSession>[0];
   345	  const result = await runJobSession(
   346	    {
   347	      ...spec,
   348	      // 인증 토큰은 스펙에 안 실려도 데몬 env(chat/.env 로더)에서 가져온다(비밀을 잡 파일에 남기지 않는다).
   349	      oauthToken: spec.oauthToken ?? process.env.CLAUDE_CODE_OAUTH_TOKEN,
   350	      baseEnv: process.env,
   351	    },
   352	    {},
   353	  );
   354	  process.stdout.write(`${JSON.stringify(result)}\n`);
   355	  process.exit(result.ok ? 0 : 1);
   356	}
