   563	/**
   564	 * 프로덕션 세션 spawn seam(main()·W4 전용) — 실제 `claude` 를 detached 로 띄운다. **W3 테스트에선 호출되지 않는다**
   565	 *   (실세션 0 · 스폰은 주입 seam 뒤). cli-parser 의 러너 패턴(그룹 kill·stdin ignore·출력 상한)을 그대로 잇는다.
   566	 */
   567	export function defaultSpawnSession(plan: SessionPlan): SpawnedSession {
   568	  const child = spawn("claude", plan.argv, buildSupervisorSpawnOptions(plan.cwd, plan.env));
   569	  let total = 0;
   570	  let outputCapExceeded = false; // cap-kill 발생 표식 — exited 에 실어 output_cap(실패)으로 가른다(MEDIUM#4).
   571	  const capKill = (): void => {
   572	    if (child.pid !== undefined) realSignalGroup(child.pid, "SIGKILL");
   573	  };
   574	  const onChunk = (chunk: Buffer): void => {
   575	    total += chunk.length;
   576	    if (total > SUPERVISOR_MAX_OUTPUT_BYTES && !outputCapExceeded) {
   577	      outputCapExceeded = true; // 한 번만 표식·kill(중복 신호 방지).
   578	      capKill(); // 폭주 출력 → 그룹 kill.
   579	    }
   580	  };
