   193	
   194	export interface SuperviseResult {
   195	  outcome: SessionOutcome;
   196	  /** 세션이 스스로 종료했을 때의 종료코드(신호 종료·미종료·refused 면 null). */
   197	  exitCode: number | null;
   198	  /** 진단 한 줄(로그·failed 사유). 사람 카드 문구가 아니다. */
   199	  detail: string;
   200	}
   201	
   202	/**
   203	 * 세션 1건을 감독한다 — detached 로 띄우고, kill_at 스케줄로 마감을 강제하고, 결과를 돌려준다.
   204	 *
   205	 * settle 은 **정확히 한 번**: (a) 세션 자가 종료 · (b) kill_at 회수 확인 중 먼저 오는 쪽. 회수 알람이 kill_at 에
   206	 *   반드시 판정하므로 세션이 영영 안 끝나도 promise 는 kill_at 에 풀린다(행 불가).
   207	 */
   208	export function superviseSession(
   209	  plan: SessionPlan,
   210	  schedule: KillSchedule,
   211	  deps: SuperviseDeps,
   212	): Promise<SuperviseResult> {
   213	  // 스폰 여유 사전 확인 — 즉시 죽여야 할 세션은 띄우지 않는다(신호 낭비·산출물 파손 회피).
   214	  if (!hasSpawnRoom(schedule, deps.now())) {
   215	    return Promise.resolve({
   216	      outcome: "refused",
   217	      exitCode: null,
   218	      detail: `스폰 여유 부족(남은 ${remainingBeforeKill(schedule, deps.now())}ms < TERM_MARGIN ${TERM_MARGIN_MS}ms)`,
   219	    });
   220	  }
   221	
   222	  const session = deps.spawnSession(plan);
   223	  const pgid = session.pgid;
   224	  /**
   225	   * HIGH#1 — **스폰 실패는 실행 중인 그룹이 아니다**. spawn 이 pid 를 못 내면(claude 부재·EACCES) pgid 가 ≤ 1 로
   226	   *   온다(defaultSpawnSession 의 `child.pid ?? -1`). 이걸 회수 대상 그룹으로 착각하면 재앙이다: `process.kill(-pgid)`
   227	   *   가 pgid=-1 일 때 `process.kill(-(-1))` = `process.kill(1)` = **init/launchd(PID 1) 를 신호**한다(pgid=0 이면
   228	   *   `kill(-0)`=`kill(0)`=호출자 그룹 전체). PID 1 은 늘 살아 있어 groupAlive(-1)=true → 리더 종료가 영영 settle 안
   229	   *   되고, TERM/KILL 이 init 을 겨냥(일반 계정=EPERM→kill_at 에 reap_failed · 특권 호스트=실제 시스템 프로세스 신호).
   230	   *   그래서 유효 pgid 가 아니면 **즉시 spawn_failed 로 short-circuit** 한다 — 알람 무장·pgid 등록·신호 전송을 전부
   231	   *   건너뛴다(어떤 경로도 나쁜 pgid 를 신호로 바꾸지 못하게). realSignalGroup/realGroupAlive 의 pgid ≤ 1 거부는 그
   232	   *   방어심층(2층)이다.
   233	   */
   234	  if (!Number.isInteger(pgid) || pgid <= 1) {
   235	    return Promise.resolve<SuperviseResult>({
   236	      outcome: "spawn_failed",
   237	      exitCode: null,
   238	      detail: `세션 스폰 실패(유효 pgid 없음: ${pgid}) — 신호·알람·등록 없이 즉시 실패(init/launchd 오신호 차단)`,
   239	    });
   240	  }
   241	  // 이 세션 그룹을 레지스트리에 등록 — 종료 전파·하트비트가 살아있는 pgid 로 이걸 본다(Finding 1). settle 에서 해제.
   242	  deps.registerSessionGroup?.(pgid);
   243	
   244	  return new Promise<SuperviseResult>((resolve) => {
   245	    let settled = false;
   246	    let termSent = false;
   247	    let killSent = false;
   248	    const cancels: Array<() => void> = [];
   249	
   250	    const settle = (r: SuperviseResult): void => {
   251	      if (settled) return;
   252	      settled = true;
   253	      for (const cancel of cancels) cancel();
   254	      // 감독 종료 — 레지스트리에서 이 세션 그룹을 뗀다(더는 종료 전파·하트비트의 대상이 아니다).
   255	      deps.releaseSessionGroup?.(pgid);
   256	      resolve(r);
   257	    };
   258	
   259	    /**
   260	     * 세션 리더 자가 종료 — **그룹 소멸을 확인해야** settle 한다(Finding 2). 리더의 파이프가 닫히면 `exited` 가 뜨지만
   261	     *   `nohup … &` 류 손자는 그룹에 살아남을 수 있다: 리더 종료를 그룹 사멸로 낙관해 알람을 다 취소하면 그 손자가
   262	     *   kill_at 을 넘겨 살아남는다. 그래서 그룹이 **정말 비었을 때만** 성공(신호 전=exited · 신호 후=killed)으로 settle
   263	     *   하고, 아직 살아있으면 settle 하지 않고 회수 경로(TERM/KILL/kill_at reap)에 맡긴다(kill_at 알람은 armNext 로 늘
   264	     *   유지되므로 행 없음).
   265	     */
   266	    const onSelfExit = (code: number | null, outputCapExceeded: boolean): void => {
   267	      if (settled) return;
   268	      if (deps.groupAlive(pgid)) return; // 리더는 죽었으나 그룹 생존(손자 잔존) — 조기 성공 settle 금지, reap 경로가 처리.
   269	      /**
   270	       * MEDIUM#4 — 출력 상한(32MiB) 초과로 cap-kill 된 종료는 **깨끗한 종료가 아니라 폭주 출력 강제 회수(실패)**다.
   271	       *   감독이 보낸 신호가 아니라 spawn seam 이 보낸 cap-kill 이라 termSent/killSent 는 안 서 있다 — 그래서 그
   272	       *   플래그만 보고 exited 로 낙관하면 실패가 성공으로 둔갑한다(코드 주석은 실패라는데 결과는 성공). 별도 실패
   273	       *   outcome(output_cap)으로 settle 해 러너가 **전이 관측과 무관하게** 실패로 처분하게 한다.
   274	       *   (그룹이 아직 살아있으면 위 가드가 reap 경로에 넘기므로 여기 도달 = 그룹 소멸 확인됨.)
   275	       */
   276	      if (outputCapExceeded) {
   277	        settle({ outcome: "output_cap", exitCode: code, detail: "출력 상한(32MiB) 초과 → 그룹 cap-kill(실패 · exited 아님)" });
   278	        return;
   279	      }
   280	      settle({
   281	        outcome: killSent || termSent ? "killed" : "exited",
   282	        exitCode: code,
   283	        detail: killSent || termSent ? "신호 후 세션 종료(그룹 소멸 확인)" : "세션 자가 종료(그룹 소멸 확인)",
   284	      });
   285	    };
   286	    session.exited.then(
   287	      (e) => onSelfExit(e.code, e.outputCapExceeded === true),
   288	      () => onSelfExit(null, false), // 종료 관측 자체가 실패해도 감독은 계속(회수 알람이 백스톱).
   289	    );
   290	
   291	    /**
   292	     * 다음으로 도달해야 할 절대 임계로 알람을 (재)무장한다 — 조기 발화·클램프·밀린 타이머 내성의 축(Finding 3).
   293	     *   nextTarget = 아직 안 지난 가장 이른 임계(termAt → killSigAt → killAt). 남은 지연이 setTimeout 상한을 넘으면
   294	     *   **상한(ALARM_MAX_HOP_MS)만큼만** 걸고(클램프 시 즉시발화 회피), 그 알람이 깨면 enforce 가 다시 armNext 로 잇는다.
   295	     *   armAt 은 늘 미래(now < nextTarget)이므로 타이트 루프가 없다.
   296	     */
   297	    const armNext = (): void => {
   298	      if (settled) return;
   299	      const now = deps.now();
   300	      const nextTarget =
   301	        now < schedule.termAtMs
   302	          ? schedule.termAtMs
   303	          : now < schedule.killSigAtMs
   304	            ? schedule.killSigAtMs
   305	            : schedule.killAtMs;
   306	      const armAt = Math.min(nextTarget, now + ALARM_MAX_HOP_MS);
   307	      cancels.push(deps.setAlarm(armAt, enforce));
   308	    };
   309	
   310	    /**
   311	     * 마감 강제 한 스텝 — **어느 알람이 깨우든 `now()` 로 due 페이즈를 재계산**해 밀린 단계를 즉시 따라잡고, 아직
   312	     *   kill_at 전이면 `armNext()` 로 다음 임계 알람을 잇는다(조기 발화·클램프에도 회수가 새지 않는다).
   313	     */
   314	    const enforce = (): void => {
   315	      if (settled) return;
   316	      const now = deps.now();
   317	      if (now >= schedule.killAtMs) {
   318	        // 밀린 경우를 대비해 아직 안 보낸 신호를 지금 마저 보낸다(그 뒤 곧바로 소멸 확인).
   319	        if (!termSent) {
   320	          deps.signalGroup(pgid, "SIGTERM");
   321	          termSent = true;
   322	        }
   323	        if (!killSent) {
   324	          deps.signalGroup(pgid, "SIGKILL");
   325	          killSent = true;
   326	        }
   327	        // kill_at 시점 판정: **지금 소멸했는가**(결국이 아니라). 살아 있으면 회수 실패.
   328	        if (deps.groupAlive(pgid)) {
   329	          settle({ outcome: "reap_failed", exitCode: null, detail: `kill_at 시점 그룹(${pgid}) 생존 — 회수 실패` });
   330	        } else {
   331	          settle({ outcome: "killed", exitCode: null, detail: "마감 강제(회수 확인됨)" });
   332	        }
   333	        return;
   334	      }
   335	      if (now >= schedule.killSigAtMs) {
   336	        if (!termSent) {
   337	          deps.signalGroup(pgid, "SIGTERM");
   338	          termSent = true;
   339	        }
   340	        if (!killSent) {
   341	          deps.signalGroup(pgid, "SIGKILL");
   342	          killSent = true;
   343	        }
   344	        armNext(); // 아직 kill_at 전 — reap 확인 알람을 잇는다.
   345	        return;
   346	      }
   347	      if (now >= schedule.termAtMs) {
   348	        if (!termSent) {
   349	          deps.signalGroup(pgid, "SIGTERM");
   350	          termSent = true;
   351	        }
   352	        armNext(); // KILL·reap 알람을 잇는다.
   353	        return;
   354	      }
   355	      // 조기 발화(now < termAt) — 스펜트 원샷으로 버리지 않고 다음 임계로 재무장한다(Finding 3).
   356	      armNext();
   357	    };
   358	
   359	    // 첫 무장(다음 임계로). 조기 발화·클램프·밀린 타이머는 armNext 재무장 + enforce 절대시계 재판정이 흡수한다.
   360	    armNext();
   361	  });
   362	}
   363	
   364	// ── 프로덕션 기본 seam (main() 과 W4 데몬이 쓴다 · W3 테스트에선 실행되지 않는다) ──────────────────
   365	
   366	/** 실시계 seam — setTimeout 은 arm 시점의 상대 지연이지만, 발화 콜백(enforce)이 `now()` 로 재판정하므로 슬립에 강건하다. */
   367	export const realClock: Pick<SuperviseDeps, "now" | "setAlarm"> = {
   368	  now: () => Date.now(),
   369	  setAlarm: (atMs, fn) => {
   370	    const handle = setTimeout(() => fn(), Math.max(0, atMs - Date.now()));
   371	    return () => clearTimeout(handle);
   372	  },
   373	};
   374	
   375	/**
   376	 * 세션 그룹 신호(cli-parser 의 killGroup 패턴) — 이미 없으면 조용히 무시.
   377	 *
   378	 * ⚠ **pgid ≤ 1 은 process.kill 을 호출하지도 않고 즉시 반환한다**(HIGH#1 방어심층). `process.kill(-pgid,…)` 는
   379	 *   pgid=1 이면 `kill(-1)` = **호출자가 신호할 수 있는 거의 모든 프로세스**, pgid=-1 이면 `kill(-(-1))` = `kill(1)`
   380	 *   = **init/launchd**, pgid=0 이면 `kill(0)` = **호출자 그룹 전체**로 퍼진다. 스폰 실패 -1 등 나쁜 pgid 가 어떤
   381	 *   경로로 새어들어도 여기서 광역·init 신호로 번지지 않게 막는다(superviseSession short-circuit 이 1차, 이건 2차).
   382	 */
   383	export function realSignalGroup(pgid: number, sig: "SIGTERM" | "SIGKILL"): void {
   384	  if (!Number.isInteger(pgid) || pgid <= 1) return; // 유효 pgid 아님 — kill(1)/kill(-1)/kill(0) 광역·init 신호 차단.
   385	  try {
   386	    process.kill(-pgid, sig); // 음수 pid = 프로세스그룹 전체(세션 + Bash 손자)
   387	  } catch {
   388	    // 이미 종료됨 — 무해.
   389	  }
   390	}
   391	
   392	/**
   393	 * 그룹 생존 확인 — ESRCH=소멸(false), EPERM=존재하나 권한없음(보수적으로 생존=true), 그 외=생존.
   394	 *
   395	 * ⚠ **pgid ≤ 1 은 process.kill 을 호출하지도 않고 false 를 반환한다**(HIGH#1 방어심층). 안 그러면 `kill(-(-1),0)`
   396	 *   = `kill(1,0)` 로 늘 살아있는 PID 1(init)을 찔러 **스폰 실패한 세션이 영원히 '생존 중'으로 오판**돼 리더 종료가
   397	 *   settle 되지 않고 회수가 새어나간다. 유효 그룹이 아니면 '생존 아님'이 옳다(회수할 게 없다).
   398	 */
   399	export function realGroupAlive(pgid: number): boolean {
   400	  if (!Number.isInteger(pgid) || pgid <= 1) return false; // 유효 pgid 아님 — kill(1,0) 로 init 을 생존으로 오판하지 않는다.
   401	  try {
   402	    process.kill(-pgid, 0);
   403	    return true;
   404	  } catch (e) {
   405	    return (e as NodeJS.ErrnoException).code === "EPERM";
   406	  }
   407	}
   408	
   409	// ── 세션 그룹 레지스트리 + 종료 전파(Finding 1 — 마감 구멍 봉합) ──────────────────────────────────
   410	
   411	/**
   412	 * 살아있는 세션 하위 그룹 레지스트리 — 이 supervisor 가 detached 로 띄운 세션 그룹의 pgid 집합.
   413	 *   두 소비자가 같은 집합을 본다: ① 종료 전파(installSupervisorTerminationHandlers)가 supervisor 가 죽기 전에 이들을
   414	 *   SIGKILL 한다 · ② `publish` 콜백(main 이 하트비트에 배선)이 W4 데몬에게 live pgid 를 노출한다 → 데몬이
   415	 *   `kill(-sessionPgid)` 로 세션 그룹을 **직접** 겨냥한다(supervisor 만 죽여선 세션 그룹에 못 닿는다 — 모듈 헤더 계약).
   416	 */
   417	export interface SessionGroupRegistry {
   418	  /** 세션 그룹이 살아나면 등록. pgid ≤ 1 은 무효(스폰 실패 -1 · 그룹 1 은 회수 대상 아님)라 무시한다. */
   419	  register: (pgid: number) => void;
   420	  /** 세션이 settle(자가종료/강제종료/reap)하면 해제. */
   421	  release: (pgid: number) => void;
   422	  /** 현재 살아있는 pgid 스냅샷(오름차순 — 결정론). 종료 전파·하트비트가 읽는다. */
   423	  live: () => number[];
   424	}
   425	
   426	/**
   427	 * 세션 그룹 레지스트리 생성. `publish` 를 주면 집합이 바뀔 때마다 살아있는 pgid 스냅샷을 넘긴다(main 이 하트비트
   428	 *   파일 기록으로 배선 — W4 데몬이 세션 pgid 를 읽어 직접 kill).
   429	 *
   430	 * ⚠ **pgid > 1 가드는 안전 필수다**: 종료 전파는 `process.kill(-pgid, SIGKILL)` 을 쓰는데, pgid 가 1 이면
   431	 *   `kill(-1, …)` = **호출자가 신호할 수 있는 거의 모든 프로세스**로 퍼진다(재앙). 무효 pgid 는 등록 자체를 막는다.
   432	 */
   433	export function createSessionGroupRegistry(publish?: (livePgids: number[]) => void): SessionGroupRegistry {
   434	  const live = new Set<number>();
   435	  const snapshot = (): number[] => [...live].sort((a, b) => a - b);
   436	  const emit = (): void => publish?.(snapshot());
   437	  return {
   438	    register: (pgid: number): void => {
   439	      if (Number.isInteger(pgid) && pgid > 1) {
   440	        live.add(pgid);
   441	        emit();
   442	      }
   443	    },
   444	    release: (pgid: number): void => {
   445	      if (live.delete(pgid)) emit();
   446	    },
   447	    live: snapshot,
   448	  };
   449	}
   450	
   451	/** 하트비트 파일 IO seam(테스트는 in-memory 로 대체 — 실 디스크 없이 원자성·직렬성을 판정). */
   452	export interface HeartbeatIo {
   453	  writeFileSync: (path: string, data: string) => void;
   454	  renameSync: (from: string, to: string) => void;
   455	}
   456	
   457	/**
   458	 * 하트비트 기록기(HIGH#2) — 살아있는 세션 pgid 스냅샷을 W4 데몬이 읽을 파일에 **동기·원자**로 남긴다.
   459	 *   `createSessionGroupRegistry(publish)` 의 publish 로 배선한다(pgid 집합이 바뀔 때마다 호출).
   460	 *
   461	 * W3↔W4 계약의 **direct-pgid 경로**(supervisor 가 무응답일 때 데몬이 하트비트를 읽어 세션을 직접 kill)가 신뢰를
   462	 *   받으려면 파일이 ① 찢어지지 않고 ② **마지막 상태가 supervisor 종료 전에 디스크에 있어야** 한다. 옛 코드의
   463	 *   `void writeFile(path, …)`(비동기 fire-and-forget)은 둘 다 못 지켰다:
   464	 *     · **직렬화 없음** — 한 경로로 비대기 writeFile 을 겹쳐 부르면(동시 register `[C]` · release `[]`) 쓰기가
   465	 *       뒤엉키거나 찢긴다(Node 타입 정의도 이 겹침을 unsafe 로 경고한다). "원자 대체"라던 주석은 사실이 아니었다.
   466	 *     · **종료 전 유실** — 종료 핸들러의 process.exit 이 아직 안 끝난 비동기 쓰기보다 먼저 돌면 마지막 스냅샷이
   467	 *       디스크에 안 남는다.
   468	 *
   469	 * 처방 = **writeFileSync + renameSync 원자 스왑**:
   470	 *   · 동기라 호출이 반환된 시점엔 이미 디스크에 있다 → '대기 중 쓰기'가 없어 process.exit 이 앞질러도 유실 0.
   471	 *     종료 핸들러가 reap() 으로 세션을 해제하면 그 release 가 이 publish 를 **동기로** 불러 최종 `[]` 가 exit 전에
   472	 *     내구적으로 남는다(= 종료 핸들러의 동기 flush 경로).
   473	 *   · 동기라 본질적으로 직렬(다음 쓰기는 이전 쓰기가 끝난 뒤 시작) → 인터리브·찢김 불가.
   474	 *   · tmp 에 쓴 뒤 renameSync(원자 교체) → W4 가 반쯤 쓰인 파일을 절대 읽지 않는다.
   475	 *   pgid 변화는 잡당 몇 번뿐이라 동기 쓰기의 이벤트 루프 블로킹은 무시할 수준(정확성 > 미세 지연).
   476	 *
   477	 * 기록 실패는 조용히 삼킨다 — 회수 백스톱(종료 전파 ① · 데몬 SIGTERM b)이 있어 하트비트 부재가 치명적이지 않다.
   478	 * @returns publish(pgids) — 미설정 하트비트 경로에서는 이 함수를 아예 안 만들면 되므로(main 에서 조건부), 여기선 no-op 분기가 없다.
   479	 */
   480	export function createHeartbeatWriter(
   481	  path: string,
   482	  supervisorPid: number,
   483	  io: HeartbeatIo = { writeFileSync: (p, d) => writeFileSync(p, d, "utf8"), renameSync },
   484	): (pgids: number[]) => void {
   485	  const tmp = `${path}.tmp`;
   486	  return (pgids: number[]): void => {
   487	    try {
   488	      io.writeFileSync(tmp, `${JSON.stringify({ supervisorPid, sessionPgids: pgids })}\n`);
   489	      io.renameSync(tmp, path); // 원자 교체 — 소비자(W4)는 완결본만 본다.
   490	    } catch {
   491	      // 하트비트 기록 실패는 회수 백스톱이 있어 치명적이지 않다 — 조용히 무시.
   492	    }
   493	  };
   494	}
   495	
   496	/** 종료 전파 핸들러가 붙는 호스트(기본 = process). 테스트는 가짜를 주입해 실 신호·실 exit 없이 판정한다. */
   497	export interface SupervisorTerminationHost {
   498	  on: (event: "SIGTERM" | "SIGINT" | "exit", listener: () => void) => void;
   499	  removeListener: (event: "SIGTERM" | "SIGINT" | "exit", listener: () => void) => void;
   500	  exit: (code?: number) => void;
   501	}
   502	
   503	/**
   504	 * supervisor 종료 전파 핸들러 설치(Finding 1 — 마감 구멍 봉합) — 데몬(W4)이 supervisor 를 **SIGTERM/SIGINT 로
   505	 *   우아하게** 끝내거나 supervisor 가 정상 종료(exit)할 때, 아직 살아있는 세션 하위 그룹을 supervisor 가 빠져나가기
   506	 *   **전에** 전부 SIGKILL 해 고아를 남기지 않는다.
   507	 *
   508	 * 왜 필요한가: 세션은 supervisor 그룹을 **상속하지 않는다**(각자 detached 하위 그룹 — 회수 검증이 그룹 밖에서
