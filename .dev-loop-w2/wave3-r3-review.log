    93	  /** 이 잡의 run_id. */
    94	  rid: string;
    95	  /** run-stage 인자(intake·brief · SUPPORTED_STAGES). */
    96	  stage: string;
    97	  /** 세션 기동(클레임) 시각 ms — kill_at 예산의 기준. */
