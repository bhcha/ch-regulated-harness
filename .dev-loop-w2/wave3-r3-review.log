   121	  /** 격리 settings.json 쓰기(기본 mkdir -p + writeFile). 이 모듈의 유일한 파일 쓰기. */
   122	  writeSettings?: (path: string, content: string) => Promise<void>;
   123	  /** **스폰 seam** — supervisor 가 세션을 띄우고 kill_at 스케줄을 강제한다(기본 = superviseSession + 실 seam). */
   124	  supervise?: (plan: SessionPlan, schedule: KillSchedule) => Promise<SuperviseResult>;
