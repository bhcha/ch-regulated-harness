   187	/**
   188	 * 복구 플랜 argv 의 `--tools` 값을 복구 전용 최소 집합(RECOVERY_SESSION_TOOLS)으로 좁힌다(Finding 4).
   189	 *
   190	 * ⚠ **왜 조립부(cli-session.ts)가 아니라 여기서 하는가**: 이상적 seam 은 `buildSessionPlan` 의 `tools` 파라미터지만
   191	 *   cli-session.ts 는 이 작업의 소유 밖이라 고칠 수 없다(고쳐야만 가능하면 중단·보고가 규칙). buildSessionPlan 이
   192	 *   `--tools` 를 고정 리터럴로만 실으므로, 복구 경로에서 그 **한 토큰만** 결정론적으로 치환한다 — 프롬프트가 아니라
   193	 *   argv(조립 산물) 수준의 경계 조정이라 잠긴 결정 2 를 지킨다. `--tools` 가 없으면 조립 계약이 바뀐 것이니 fail-closed.
   194	 */
   195	function restrictRecoveryTools(argv: string[]): string[] {
   196	  const i = argv.indexOf("--tools");
   197	  if (i < 0 || i + 1 >= argv.length) {
   198	    throw new Error(
   199	      "복구 플랜 argv 에 --tools 가 없습니다 — cli-session 의 도구 표면 조립 계약이 바뀌었습니다(복구 최소화 불가).",
   200	    );
   201	  }
   202	  const out = argv.slice();
   203	  out[i + 1] = RECOVERY_SESSION_TOOLS; // 그 한 토큰만 최소 집합으로 치환(나머지 플래그·순서 불변).
   204	  return out;
   205	}
