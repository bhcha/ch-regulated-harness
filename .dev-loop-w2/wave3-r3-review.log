   113	/** 주입 seam — 프로덕션 기본은 실 파일/실 next-action/실 supervisor. 테스트는 전부 가짜(오프라인·결정적). */
   114	export interface RunJobSessionDeps {
   115	  /** 현재 절대 시각 ms(기본 Date.now). refuse·복구 예산 판정에 쓴다 — supervisor 시계와 같은 벽시계를 본다. */
