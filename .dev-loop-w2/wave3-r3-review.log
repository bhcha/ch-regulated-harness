    85	/** 잡 1건 처리 결과 — 성공(어느 세션이 전이시켰나) 또는 실패(분류 + 진단). 큐 처분은 데몬 몫. */
    86	export type RunJobResult =
    87	  | { ok: true; via: "main" | "recovery"; detail: string }
    88	  | { ok: false; reason: RunJobFailReason; detail: string };
