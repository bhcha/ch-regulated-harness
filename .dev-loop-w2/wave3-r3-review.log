   301	/** settings 직렬화(결정적) — 2칸 들여쓰기 + 끝 개행. 러너가 이 문자열을 그대로 쓴다. */
   302	export function serializeWorkerSettings(settings: WorkerSettings): string {
   303	  return `${JSON.stringify(settings, null, 2)}\n`;
   304	}
