    74	  | "refused_insufficient_time" /** 주 세션 스폰 여유 부족(남은 시간 < TERM_MARGIN) */
    75	  | "spawn_failed" /** 세션 스폰이 pid 를 못 냄(claude 부재·EACCES) — 실행된 그룹 없음(HIGH#1) */
    76	  | "output_cap" /** 세션 출력이 상한(32MiB) 초과 → cap-kill = 실패(전이 관측과 무관 · MEDIUM#4) */
    77	  | "reap_failed" /** 주 세션 마감 강제 실패(kill_at 시점 그룹 생존) — 마감 기계 자체가 실패 */
    78	  | "next_action_unreadable" /** next-action 조회 실패 — 전이 여부 판단 불가 */
    79	  | "not_transitioned_no_artifact" /** 전이 안 됨 + 산출물 없음 → 복구 무의미(주 세션이 아무것도 못 씀) */
    80	  | "recovery_budget_insufficient" /** 전이 안 됨 + 산출물 있음이나 복구할 시간 부족 */
    81	  | "recovery_compose_error" /** 복구 세션 조립·격리 settings 기록 실패(디스크 오류 등) — 복구가 뜨지도 못함(MEDIUM#3) */
    82	  | "recovery_reap_failed" /** 복구 세션 마감 강제 실패 */
    83	  | "still_not_transitioned"; /** 복구 세션까지 돌렸는데 여전히 전이 안 됨 */
