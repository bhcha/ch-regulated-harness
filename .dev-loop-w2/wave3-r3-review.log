   207	/**
   208	 * 잡 1건의 무인 세션 수명주기를 돈다. **큐를 만지지 않고** 결과만 보고한다(성공/실패 처분은 데몬 몫).
   209	 *
   210	 * @throws 던지지 않는다 — 조립 예외(도메인/스킬/치환)는 `compose_error` 결과로 환원해 **깨끗이 실패**한다
   211	 *   (keyvisual 같은 미지원 단계도 여기로 떨어진다). 데몬이 결과만 보고 큐를 처분할 수 있게 예외를 새로 흘리지 않는다.
   212	 */
   213	export async function runJobSession(
   214	  input: RunJobSessionInput,
   215	  deps: RunJobSessionDeps = {},
   216	): Promise<RunJobResult> {
   217	  const now = deps.now ?? Date.now;
   218	  const readDomain = deps.readDomain ?? readDeclaredDomain;
   219	  const readSkillMd = deps.readSkillMd ?? defaultReadSkillMd;
   220	  const writeSettings = deps.writeSettings ?? defaultWriteSettings;
   221	  const supervise = deps.supervise ?? defaultSupervise;
   222	  const readNext = deps.readNext ?? readNextAction;
   223	  const artifactPresent = deps.artifactPresent ?? defaultArtifactPresent;
   224	
   225	  const genTimeoutMs = input.genTimeoutMs ?? sdkGenTimeout();
   226	  const maxTurns = input.maxTurns ?? sdkMaxTurns();
   227	  const baseEnv = input.baseEnv ?? process.env;
   228	
   229	  // ── 조립(①~④) — 어느 단계든 던지면 compose_error 로 깨끗이 실패(스폰 전이므로 부작용 0) ──
   230	  let mainPlan: SessionPlan;
   231	  let transitionCommand: string;
