    97	/** kill_at 스케줄 산출 입력. 전부 절대 ms(주입 — 테스트 결정성). */
    98	export interface KillScheduleInput {
    99	  /** 세션 기동(클레임) 시각 ms — 잡 wall-clock 예산이 흐르기 시작하는 기준. */
   100	  claimedAtMs: number;
   101	  /** 잡 wall-clock 예산 ms(config.sdkGenTimeout — 주/복구 세션 합산 상한). */
   102	  genTimeoutMs: number;
   103	  /** 잡 절대 마감 ms(잡 파일 `expires_at` → ms · 봇이 적재 순간 박은 값). */
   104	  deadlineMs: number;
   105	}
   106	
   107	/** kill_at 스케줄(전부 절대 ms). termAt < killSigAt < killAt 이 늘 성립한다. */
   108	export interface KillSchedule {
   109	  /** 강제 종료 완결 목표 시각 = min(claimedAt + genTimeout, deadline). 예산과 마감 중 **먼저 오는 쪽**. */
   110	  killAtMs: number;
   111	  /** SIGTERM 시각 = killAt - TERM_MARGIN. */
   112	  termAtMs: number;
   113	  /** SIGKILL 시각 = killAt - KILL_MARGIN. */
   114	  killSigAtMs: number;
   115	}
   116	
   117	function assertFiniteMs(label: string, v: number): void {
   118	  if (!Number.isFinite(v)) {
   119	    throw new Error(`supervisor: ${label} 가 유한한 ms 값이 아닙니다: ${v}`);
   120	  }
   121	}
   122	
   123	/**
   124	 * kill_at 스케줄 계산(순수).
   125	 *
   126	 * **핵심: kill_at = min(예산 마감, 잡 마감)**. 세션의 wall-clock 예산(기동 + genTimeout)과 잡의 절대 마감
   127	 *   (expires_at) 중 **먼저 오는 쪽**이 상한이다 — 예산이 남아도 잡이 만료면 거기서 끊고(늦은 성공 창 제거),
   128	 *   잡 마감이 멀어도 예산이 다하면 거기서 끊는다(폭주 세션 상한). TERM/KILL 은 그 kill_at **이전**에만 발화한다.
   129	 */
   130	export function computeKillSchedule(input: KillScheduleInput): KillSchedule {
   131	  assertFiniteMs("claimedAtMs", input.claimedAtMs);
   132	  assertFiniteMs("genTimeoutMs", input.genTimeoutMs);
   133	  assertFiniteMs("deadlineMs", input.deadlineMs);
   134	  const budgetKillMs = input.claimedAtMs + input.genTimeoutMs;
   135	  const killAtMs = Math.min(budgetKillMs, input.deadlineMs);
   136	  return {
   137	    killAtMs,
   138	    termAtMs: killAtMs - TERM_MARGIN_MS,
   139	    killSigAtMs: killAtMs - KILL_MARGIN_MS,
   140	  };
   141	}
   142	
   143	/** kill_at 까지 남은 시간(ms). 음수면 이미 지났다. */
   144	export function remainingBeforeKill(schedule: KillSchedule, nowMs: number): number {
   145	  return schedule.killAtMs - nowMs;
   146	}
   147	
   148	/**
   149	 * 지금 세션을 띄울 **여유**가 있는가 — 남은 시간이 SIGTERM 유예 미만이면 false.
   150	 *   즉시 죽여야 할 세션은 애초에 띄우지 않는다(계획: "don't start something you must instantly kill").
   151	 */
   152	export function hasSpawnRoom(schedule: KillSchedule, nowMs: number): boolean {
   153	  return remainingBeforeKill(schedule, nowMs) >= TERM_MARGIN_MS;
   154	}
   155	
   156	/** supervisor 가 세션을 띄웠을 때 돌려받는 핸들(주입 seam 이 만든다). */
   157	export interface SpawnedSession {
   158	  /** 그룹 회수 대상 id = detached 세션의 프로세스그룹 id(실제 = child.pid). 스폰 실패면 pid 부재 → pgid ≤ 1(HIGH#1). */
