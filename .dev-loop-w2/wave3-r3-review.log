   147	const STAGE_ARTIFACT_DIR: Record<string, string> = {
   148	  intake: "00a-intake",
   149	  brief: "01-brief",
   150	};
   151	
   152	async function defaultArtifactPresent(coreRoot: string, rid: string, stage: string): Promise<boolean> {
   153	  const sub = STAGE_ARTIFACT_DIR[stage];
   154	  if (sub === undefined) return false;
   155	  const { readdir } = await import("node:fs/promises");
   156	  try {
   157	    const names = await readdir(join(coreRoot, "runs", rid, sub));
   158	    return names.some((n) => !n.startsWith(".")); // 숨김 아닌 파일이 하나라도 있으면 산출물 있음.
   159	  } catch {
   160	    return false; // 디렉터리 부재·읽기 실패 = 산출물 없음(conservative — 복구 안 함).
   161	  }
   162	}
