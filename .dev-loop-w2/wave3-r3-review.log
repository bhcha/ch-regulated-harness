     9	 * 불변식(dev-loop-grounding 3): state.json 은 core scripts 만 쓴다 — 이 모듈은 **읽기 전용**(state 직접 쓰기 0).
    10	 *   next-action.sh 자체가 읽기 전용이라 이 spawn 은 상태를 변이하지 않는다.
    11	 *
    12	 * forward-compat: NextAction 은 index signature 로 미지 키를 허용하므로 파싱 결과를 재구성하지 않고 캐스팅만 한다
    13	 *   → next-action.sh 가 새 top-level 필드를 추가해도 파싱이 깨지지 않고 알려진 필드는 보존된다.
    14	 */
    15	import { spawn } from "node:child_process";
    16	import { join } from "node:path";
    17	import { harnessEnv, harnessRoot, isSafeRunId } from "../config.js";
    18	import type { NextAction } from "../types/contract.js";
    19	
    20	/** spawn 1회 결과(종료코드·stdout·stderr). */
    21	export interface HarnessRunResult {
    22	  code: number;
    23	  stdout: string;
    24	  stderr: string;
    25	}
    26	
    27	/** 자식 출력 스트림 상한(스트림당) — OOM/폭주 방지. */
    28	const MAX_OUTPUT_BYTES = 32 * 1024 * 1024;
    29	
    30	/**
    31	 * next-action.sh 실행기. 기본은 실제 **비동기** spawn(defaultRunner). 테스트는 fake 를 주입해
    32	 * spawn 없이 파싱 로직(미지 필드 보존·오류 분기)을 검증한다.
    33	 */
    34	export type NextActionRunner = (rid: string) => Promise<HarnessRunResult>;
    35	
    36	/** 실제 비동기 spawn: `bash <harnessRoot>/scripts/next-action.sh <rid>` (이벤트 루프 블로킹 금지 — spawnSync 아님). */
    37	function defaultRunner(rid: string): Promise<HarnessRunResult> {
    38	  const root = harnessRoot();
    39	  const script = join(root, "scripts", "next-action.sh");
    40	  return new Promise<HarnessRunResult>((resolve, reject) => {
    41	    const child = spawn("bash", [script, rid], { cwd: root, env: { ...process.env, ...harnessEnv() } });
    42	    // 출력 상한(OOM/폭주 방지) — next-action JSON 은 한 줄이라 정상 출력은 상한 근처에도 안 가지만, 방어적으로 캡.
    43	    let stdout = "";
    44	    let stderr = "";
    45	    let over = false;
    46	    const cap = (cur: string, d: Buffer): string => {
    47	      if (over) return cur;
    48	      const room = MAX_OUTPUT_BYTES - cur.length;
    49	      const s = d.toString("utf8");
    50	      if (s.length <= room) return cur + s;
    51	      over = true;
    52	      child.kill();
    53	      return cur + s.slice(0, Math.max(0, room));
    54	    };
    55	    child.stdout.on("data", (d: Buffer) => (stdout = cap(stdout, d)));
    56	    child.stderr.on("data", (d: Buffer) => (stderr = cap(stderr, d)));
    57	    // spawn 자체 실패(bash 부재 등)는 종료코드가 없다 — 읽기 계약상 실패는 예외로 승격.
    58	    child.on("error", (err) => reject(new Error(`next-action.sh 실행 실패(rid=${rid}): ${err.message}`)));
