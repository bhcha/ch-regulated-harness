    60	  });
    61	}
    62	
    63	/**
    64	 * 하네스의 '지금 할 일' 구조화 계약을 읽는다(읽기 전용).
    65	 * @param rid    run_id.
    66	 * @param runner 실행기(기본 defaultRunner — 실제 next-action.sh spawn). 테스트가 fake 주입.
    67	 * @throws 비-0 종료 / 빈 출력 / JSON 파싱 실패 시 Error(종료코드·stderr 포함).
    68	 */
    69	export async function readNextAction(
    70	  rid: string,
    71	  runner: NextActionRunner = defaultRunner,
    72	): Promise<NextAction> {
    73	  if (!rid || rid.trim() === "") {
    74	    throw new Error("readNextAction: run_id 가 비었습니다.");
    75	  }
    76	  // 읽기 경로도 write 래퍼와 동일하게 경로-안전 rid 만 허용 — next-action.sh 가 $HARNESS_ROOT/runs/$rid 로
    77	  //   경로를 만들므로 `../runs/other` 같은 값이 다른 run 을 들여다보지 않도록 fail-closed.
    78	  if (!isSafeRunId(rid)) {
    79	    throw new Error(`readNextAction: run_id 형식이 안전하지 않습니다: ${rid}`);
    80	  }
    81	  const { code, stdout, stderr } = await runner(rid);
    82	  const errTail = stderr.trim() || "(stderr 없음)";
    83	  if (code !== 0) {
    84	    throw new Error(`next-action.sh 비정상 종료(rid=${rid}, code=${code}): ${errTail}`);
    85	  }
    86	  const text = stdout.trim();
    87	  if (text === "") {
    88	    throw new Error(`next-action.sh 빈 출력(rid=${rid}, code=${code}): ${errTail}`);
    89	  }
    90	  let parsed: unknown;
    91	  try {
    92	    parsed = JSON.parse(text);
    93	  } catch (e) {
    94	    const msg = e instanceof Error ? e.message : String(e);
    95	    throw new Error(
    96	      `next-action.sh JSON 파싱 실패(rid=${rid}): ${msg} — 원문(앞 200자): ${text.slice(0, 200)}`,
    97	    );
    98	  }
    99	  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
   100	    throw new Error(`next-action.sh JSON 이 객체가 아닙니다(rid=${rid}): ${text.slice(0, 200)}`);
   101	  }
   102	  // 미지 필드 무시=그대로 보존: 재구성 없이 캐스팅만(index signature 가 미지 키를 담는다).
   103	  return parsed as NextAction;
   104	}

