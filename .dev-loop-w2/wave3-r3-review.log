   160	  /** 세션이 **스스로** 종료하면 resolve(종료코드 · 신호 종료면 null). supervisor 가 죽이면 이건 안 풀려도 무방
   161	   *   (회수 알람이 kill_at 에 반드시 settle 하므로 행이 없다).
   162	   *   `outputCapExceeded` = 출력 상한(32MiB)을 넘겨 spawn seam 이 **cap-kill(SIGKILL)** 한 종료(MEDIUM#4). 감독이
   163	   *   보낸 신호가 아니므로 termSent/killSent 로는 구분되지 않는다 — 이 플래그로 실어 output_cap(실패)으로 가른다. */
   164	  exited: Promise<{ code: number | null; outputCapExceeded?: boolean }>;
   165	}
   166	
   167	/** 감독 seam(전부 주입 — 실시계/실스폰/실신호는 프로덕션 기본 seam 에만 있고 테스트는 가짜를 넣는다). */
   168	export interface SuperviseDeps {
   169	  /** 현재 절대 시각 ms. */
   170	  now: () => number;
   171	  /** 절대 시각 `atMs` 에 fn 을 1회 발화하도록 예약하고, 취소 함수를 돌려준다. 이미 지난 시각이면 즉시(다음 틱) 발화. */
   172	  setAlarm: (atMs: number, fn: () => void) => () => void;
   173	  /** 세션 1건을 detached 로 spawn(플랜대로). supervisor 의 자식이 된다. */
   174	  spawnSession: (plan: SessionPlan) => SpawnedSession;
   175	  /** 세션 그룹에 신호 전송(`process.kill(-pgid, sig)` — 이미 없으면 무해). */
   176	  signalGroup: (pgid: number, sig: "SIGTERM" | "SIGKILL") => void;
   177	  /** 그룹이 살아 있는가(`kill(-pgid,0)` → 살아있음=true · ESRCH=false). */
   178	  groupAlive: (pgid: number) => boolean;
   179	  /** (선택) 세션 그룹이 살아나면 pgid 등록 — 프로세스 종료 전파·하트비트가 이 집합을 본다(Finding 1). 미주입=무시. */
   180	  registerSessionGroup?: (pgid: number) => void;
   181	  /** (선택) 세션이 settle(자가종료/강제종료/reap)하면 pgid 해제. register 와 짝. 미주입=무시. */
