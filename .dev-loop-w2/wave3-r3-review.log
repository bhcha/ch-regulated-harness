   131	// ── 프로덕션 기본 seam ─────────────────────────────────────────────────────────
   132	
   133	async function defaultReadSkillMd(coreRoot: string, stage: string): Promise<string> {
   134	  return readFile(join(coreRoot, "skills", stage, "SKILL.md"), "utf8");
   135	}
   136	
   137	async function defaultWriteSettings(path: string, content: string): Promise<void> {
   138	  await mkdir(dirname(path), { recursive: true });
   139	  await writeFile(path, content, "utf8");
   140	}
