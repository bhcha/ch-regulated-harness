   608	// ── 세션 그룹 레지스트리 + 종료 전파(Finding 1 — 마감 구멍 봉합) ─────────────────
   609	/** on/removeListener/exit 를 기록하는 가짜 종료 호스트(실 process·실 신호 없이 판정). */
   610	function makeFakeTerminationHost() {
   611	  const listeners: Record<"SIGTERM" | "SIGINT" | "exit", Array<() => void>> = {
   612	    SIGTERM: [],
   613	    SIGINT: [],
   614	    exit: [],
   615	  };
   616	  const exitCodes: Array<number | undefined> = [];
   617	  return {
   618	    host: {
   619	      on: (e: "SIGTERM" | "SIGINT" | "exit", l: () => void): void => {
   620	        listeners[e].push(l);
   621	      },
   622	      removeListener: (e: "SIGTERM" | "SIGINT" | "exit", l: () => void): void => {
   623	        listeners[e] = listeners[e].filter((x) => x !== l);
   624	      },
   625	      exit: (code?: number): void => {
   626	        exitCodes.push(code);
   627	      },
   628	    },
   629	    fire: (e: "SIGTERM" | "SIGINT" | "exit"): void => {
   630	      for (const l of [...listeners[e]]) l();
   631	    },
   632	    exitCodes,
   633	  };
   634	}
