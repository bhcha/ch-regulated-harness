   152	  intake: "00a-intake",
   153	  brief: "01-brief",
   154	};
   155	
   156	async function defaultArtifactPresent(coreRoot: string, rid: string, stage: string): Promise<boolean> {
   157	  const sub = STAGE_ARTIFACT_DIR[stage];
   158	  if (sub === undefined) return false;
   159	  const { readdir } = await import("node:fs/promises");
   160	  try {
   161	    const names = await readdir(join(coreRoot, "runs", rid, sub));
   162	    return names.some((n) => !n.startsWith(".")); // 숨김 아닌 파일이 하나라도 있으면 산출물 있음.
   163	  } catch {
   164	    return false; // 디렉터리 부재·읽기 실패 = 산출물 없음(conservative — 복구 안 함).
   165	  }
   166	}
