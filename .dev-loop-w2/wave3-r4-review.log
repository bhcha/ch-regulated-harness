   743	  test("register 후 release 하면 디스크가 **최종 집합**을 반영한다(stale/torn 중간본 아님)", () => {
   744	    const fake = makeFakeHeartbeatIo();
   745	    const reg = createSessionGroupRegistry(createHeartbeatWriter("/hb", 4242, fake.io));
   746	    reg.register(101);
   747	    reg.register(202);
   748	    reg.release(101);
   749	    reg.release(202);
   750	    // 최종 상태 = 빈 집합(마지막 release 반영). 옛 비동기 fire-and-forget 이면 순서가 뒤엉킬 수 있었다.
   751	    expect(fake.read("/hb")).toEqual({ supervisorPid: 4242, sessionPgids: [] });
   752	    // 매 변화는 tmp → rename 원자 스왑으로만 목적지에 닿는다(path 직접 쓰기 0 = 반쯤 쓰인 파일 노출 불가).
   753	    expect(fake.directWrites("/hb")).toEqual([]);
