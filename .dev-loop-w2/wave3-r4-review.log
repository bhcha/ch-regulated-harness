   122	  readDomain?: (coreRoot: string, rid: string) => Promise<string>;
   123	  /** SKILL.md 원문 읽기(기본 core/skills/<stage>/SKILL.md). */
   124	  readSkillMd?: (coreRoot: string, stage: string) => Promise<string>;
   125	  /** 격리 settings.json 쓰기(기본 mkdir -p + writeFile). 이 모듈의 유일한 파일 쓰기. */
   126	  writeSettings?: (path: string, content: string) => Promise<void>;
   127	  /** **스폰 seam** — supervisor 가 세션을 띄우고 kill_at 스케줄을 강제한다(기본 = superviseSession + 실 seam). */
   128	  supervise?: (plan: SessionPlan, schedule: KillSchedule) => Promise<SuperviseResult>;
   129	  /** next-action 조회(기본 readNextAction · 읽기 전용). 전이 확인의 단일 채널. */
   130	  readNext?: (rid: string) => Promise<NextAction>;
   131	  /** 산출물 존재 확인(복구 백스톱 게이트 · 기본 = 단계 산출 디렉터리 비어있지 않음). */
   132	  artifactPresent?: (coreRoot: string, rid: string, stage: string) => Promise<boolean>;
   133	}
