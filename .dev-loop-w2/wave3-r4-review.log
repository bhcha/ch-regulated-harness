   103	  /** 잡 절대 마감 ms(잡 파일 expires_at → ms). kill_at = min(claimedAt+genTimeout, deadline). */
   104	  deadlineMs: number;
   105	  /** 워커가 이 잡용으로 만든 전용 빈 디렉터리(절대경로) = 격리 CLAUDE_CONFIG_DIR. 생성·정리는 데몬 몫. */
