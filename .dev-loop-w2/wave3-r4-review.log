   486	/**
   487	 * 세션 그룹 레지스트리 생성. `publish` 를 주면 집합이 바뀔 때마다 살아있는 pgid 스냅샷을 넘긴다(main 이 하트비트
   488	 *   파일 기록으로 배선 — W4 데몬이 세션 pgid 를 읽어 직접 kill).
   489	 *
   490	 * ⚠ **pgid > 1 가드는 안전 필수다**: 종료 전파는 `process.kill(-pgid, SIGKILL)` 을 쓰는데, pgid 가 1 이면
   491	 *   `kill(-1, …)` = **호출자가 신호할 수 있는 거의 모든 프로세스**로 퍼진다(재앙). 무효 pgid 는 등록 자체를 막는다.
   492	 */
   493	export function createSessionGroupRegistry(publish?: (livePgids: number[]) => void): SessionGroupRegistry {
   494	  const live = new Set<number>();
   495	  const snapshot = (): number[] => [...live].sort((a, b) => a - b);
   496	  const emit = (): void => publish?.(snapshot());
   497	  return {
   498	    register: (pgid: number): void => {
   499	      if (Number.isInteger(pgid) && pgid > 1) {
   500	        live.add(pgid);
   501	        emit();
   502	      }
   503	    },
   504	    release: (pgid: number): void => {
   505	      if (live.delete(pgid)) emit();
   506	    },
   507	    live: snapshot,
   508	  };
   509	}
