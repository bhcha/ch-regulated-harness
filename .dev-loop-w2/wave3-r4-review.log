   101	/** kill_at 스케줄 산출 입력. 전부 절대 ms(주입 — 테스트 결정성). */
   102	export interface KillScheduleInput {
   103	  /** 세션 기동(클레임) 시각 ms — 잡 wall-clock 예산이 흐르기 시작하는 기준. */
   104	  claimedAtMs: number;
   105	  /** 잡 wall-clock 예산 ms(config.sdkGenTimeout — 주/복구 세션 합산 상한). */
   106	  genTimeoutMs: number;
   107	  /** 잡 절대 마감 ms(잡 파일 `expires_at` → ms · 봇이 적재 순간 박은 값). */
