   202	    throw new Error(
   203	      "복구 플랜 argv 에 --tools 가 없습니다 — cli-session 의 도구 표면 조립 계약이 바뀌었습니다(복구 최소화 불가).",
   204	    );
   205	  }
   206	  const out = argv.slice();
   207	  out[i + 1] = RECOVERY_SESSION_TOOLS; // 그 한 토큰만 최소 집합으로 치환(나머지 플래그·순서 불변).
   208	  return out;
   209	}
