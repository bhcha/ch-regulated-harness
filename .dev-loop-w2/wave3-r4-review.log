    97	  /** 이 잡의 run_id. */
    98	  rid: string;
    99	  /** run-stage 인자(intake·brief · SUPPORTED_STAGES). */
   100	  stage: string;
   101	  /** 세션 기동(클레임) 시각 ms — kill_at 예산의 기준. */
