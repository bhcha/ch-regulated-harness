   137	async function defaultReadSkillMd(coreRoot: string, stage: string): Promise<string> {
   138	  return readFile(join(coreRoot, "skills", stage, "SKILL.md"), "utf8");
   139	}
   140	
   141	async function defaultWriteSettings(path: string, content: string): Promise<void> {
   142	  await mkdir(dirname(path), { recursive: true });
   143	  await writeFile(path, content, "utf8");
   144	}
