   718	// ── HIGH#2: createHeartbeatWriter — 동기·원자 하트비트(direct-pgid 경로 내구성) ───────────────────────
   719	/** in-memory 하트비트 IO(실 디스크 없이 원자성·직렬성 판정). `ops` 로 쓰기 순서·경로를 관측한다. */
   720	function makeFakeHeartbeatIo() {
   721	  const files: Record<string, string> = {};
   722	  const ops: string[] = [];
   723	  return {
   724	    io: {
   725	      writeFileSync: (p: string, d: string): void => {
   726	        files[p] = d;
   727	        ops.push(`write:${p}`);
   728	      },
   729	      renameSync: (from: string, to: string): void => {
   730	        files[to] = files[from];
   731	        delete files[from];
   732	        ops.push(`rename:${from}->${to}`);
   733	      },
   734	    },
   735	    ops,
   736	    read: (p: string): unknown => (files[p] !== undefined ? JSON.parse(files[p]) : undefined),
   737	    /** path 로 **직접** 쓴 적(원자 스왑 우회 = 찢김 가능)이 있으면 그 목록. */
   738	    directWrites: (p: string): string[] => ops.filter((o) => o === `write:${p}`),
   739	  };
   740	}
   741	
