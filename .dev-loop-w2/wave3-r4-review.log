   217	export async function runJobSession(
   218	  input: RunJobSessionInput,
   219	  deps: RunJobSessionDeps = {},
   220	): Promise<RunJobResult> {
   221	  const now = deps.now ?? Date.now;
   222	  const readDomain = deps.readDomain ?? readDeclaredDomain;
   223	  const readSkillMd = deps.readSkillMd ?? defaultReadSkillMd;
   224	  const writeSettings = deps.writeSettings ?? defaultWriteSettings;
   225	  const supervise = deps.supervise ?? defaultSupervise;
   226	  const readNext = deps.readNext ?? readNextAction;
   227	  const artifactPresent = deps.artifactPresent ?? defaultArtifactPresent;
   228	
   229	  // MEDIUM#2 — config 게터(sdkGenTimeout·sdkMaxTurns)는 **명시 오설정에 던진다**(예: CHAT_SDK_MAX_TURNS=0 ·
   230	  //   CHAT_SDK_GEN_TIMEOUT=30m). 이 읽기가 아래 첫 try 밖에 있으면 그 throw 가 runJobSession 을 **reject** 시키고,
   231	  //   supervisor 의 `void main()` 이 결과 없이 죽어 데몬이 실패를 분류 못 한다. '늘 구조적 RunJobResult 를 보고한다'는
   232	  //   계약을 지키려면 던질 수 있는 이 읽기도 가드 안으로 들여, config_error(실패)로 환원한다. input 으로 값이 오면
   233	  //   (테스트 경로) 게터를 아예 안 불러 던질 일이 없다.
   234	  let genTimeoutMs: number;
   235	  let maxTurns: number;
   236	  try {
   237	    genTimeoutMs = input.genTimeoutMs ?? sdkGenTimeout();
   238	    maxTurns = input.maxTurns ?? sdkMaxTurns();
   239	  } catch (e) {
   240	    const msg = e instanceof Error ? e.message : String(e);
   241	    return { ok: false, reason: "config_error", detail: `잡 설정(env) 조회 실패: ${msg}` };
   242	  }
   243	  const baseEnv = input.baseEnv ?? process.env;
   244	
   245	  // ── 조립(①~④) — 어느 단계든 던지면 compose_error 로 깨끗이 실패(스폰 전이므로 부작용 0) ──
   246	  let mainPlan: SessionPlan;
   247	  let transitionCommand: string;
   248	  let domain: string; // 복구 플랜에서 재사용(이미 검증된 값 — 재조회 불필요).
   249	  try {
   250	    domain = await readDomain(input.coreRoot, input.rid); // ① 스폰 전 fail-closed(잘못된 팩 방지)
   251	    const skillMd = await readSkillMd(input.coreRoot, input.stage);
   252	    const rewritten = rewriteSkill({ skillMd, stage: input.stage, rid: input.rid, coreRoot: input.coreRoot }); // ②
   253	    // 펜스에 예상 밖 명령이 있으면 **호출부가 거부한다**(부록A-11 3번 · 조용히 규칙으로 승격하지 않는다).
   254	    if (rewritten.unexpectedFencedCommands.length > 0) {
   255	      return {
   256	        ok: false,
   257	        reason: "unexpected_commands",
   258	        detail: `SKILL.md(stage=${input.stage}) 펜스에 예상 밖 명령: ${rewritten.unexpectedFencedCommands.join(" · ")}`,
   259	      };
   260	    }
   261	    transitionCommand = rewritten.transitionCommand;
   262	    mainPlan = buildSessionPlan({
   263	      // ③
   264	      coreRoot: input.coreRoot,
   265	      rid: input.rid,
   266	      domain,
   267	      prompt: rewritten.prompt,
   268	      allowRules: rewritten.allowRules,
   269	      maxTurns,
   270	      configDir: input.configDir,
   271	      ...(input.oauthToken !== undefined ? { oauthToken: input.oauthToken } : {}),
   272	      baseEnv,
   273	    });
   274	    await writeSettings(mainPlan.settingsPath, mainPlan.settingsJson); // ④ 격리 settings(쓰기 deny)
   275	  } catch (e) {
   276	    const msg = e instanceof Error ? e.message : String(e);
   277	    return { ok: false, reason: "compose_error", detail: msg };
   278	  }
   279	
   280	  const schedule = computeKillSchedule({
   281	    claimedAtMs: input.claimedAtMs,
   282	    genTimeoutMs,
   283	    deadlineMs: input.deadlineMs,
