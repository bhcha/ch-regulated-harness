    70	/** 실패 사유 — 데몬이 사람에게 할 말과 큐 처분(failed/·drop)을 가른다. 이 모듈은 처분하지 않고 **분류만** 한다. */
    71	export type RunJobFailReason =
    72	  | "config_error" /** 잡 설정(env) 조회 실패(예: CHAT_SDK_MAX_TURNS=0·sdkGenTimeout 오설정) 또는 supervisor 진입점
    73	      실패 — runJobSession 이 던지지 않고 늘 결과를 보고한다는 계약을 config 게터·진입점까지 넓힌다(MEDIUM#2) */
    74	  | "compose_error" /** 도메인/스킬/치환 조립 실패(keyvisual·미지원 단계 포함) — 스폰 전 fail-closed */
    75	  | "unexpected_commands" /** SKILL.md 펜스에 예상 밖 명령(스킬-게이트 드리프트) — 호출부 거부 계약(부록A-11 3번) */
    76	  | "refused_insufficient_time" /** 주 세션 스폰 여유 부족(남은 시간 < TERM_MARGIN) */
    77	  | "spawn_failed" /** 세션 스폰이 pid 를 못 냄(claude 부재·EACCES) — 실행된 그룹 없음(HIGH#1) */
    78	  | "output_cap" /** 세션 출력이 상한(32MiB) 초과 → cap-kill = 실패(전이 관측과 무관 · MEDIUM#4) */
    79	  | "heartbeat_unwritable" /** 설정된 하트비트 백스톱이 안 써짐(첫 발행 실패) → 세션을 백스톱 없이 돌리지 않고 회수
    80	      = 실패(HIGH — configured-but-broken safety net). supervisor 가 그룹을 SIGKILL 하고 이 outcome 을 돌려준다 */
    81	  | "reap_failed" /** 주 세션 마감 강제 실패(kill_at 시점 그룹 생존) — 마감 기계 자체가 실패 */
    82	  | "next_action_unreadable" /** next-action 조회 실패 — 전이 여부 판단 불가 */
    83	  | "not_transitioned_no_artifact" /** 전이 안 됨 + 산출물 없음 → 복구 무의미(주 세션이 아무것도 못 씀) */
    84	  | "recovery_budget_insufficient" /** 전이 안 됨 + 산출물 있음이나 복구할 시간 부족 */
    85	  | "recovery_compose_error" /** 복구 세션 조립·격리 settings 기록 실패(디스크 오류 등) — 복구가 뜨지도 못함(MEDIUM#3) */
    86	  | "recovery_reap_failed" /** 복구 세션 마감 강제 실패 */
    87	  | "still_not_transitioned"; /** 복구 세션까지 돌렸는데 여전히 전이 안 됨 */
    88	
    89	/** 잡 1건 처리 결과 — 성공(어느 세션이 전이시켰나) 또는 실패(분류 + 진단). 큐 처분은 데몬 몫. */
    90	export type RunJobResult =
    91	  | { ok: true; via: "main" | "recovery"; detail: string }
    92	  | { ok: false; reason: RunJobFailReason; detail: string };
