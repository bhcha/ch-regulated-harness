   111	/** kill_at 스케줄(전부 절대 ms). termAt < killSigAt < killAt 이 늘 성립한다. */
   112	export interface KillSchedule {
   113	  /** 강제 종료 완결 목표 시각 = min(claimedAt + genTimeout, deadline). 예산과 마감 중 **먼저 오는 쪽**. */
