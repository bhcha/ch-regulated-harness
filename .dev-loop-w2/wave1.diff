+  it("coreRoot 는 절대경로여야 한다(상대경로 = cwd 의존 = 비결정)", () => {
+    expect(() => rewriteSkill({ skillMd: ADVERSARIAL, stage: "brief", rid: FIXED_RID, coreRoot: "core" })).toThrow(
