+    expect(out.allowRules.some((r) => r.includes("HARNESS_OFFLINE"))).toBe(false);
+  });
+});
+
+describe("fail-closed — 지원하지 않는 단계", () => {
+  it("keyvisual 은 타입드 도구 대응물 부재로 거부(W0 미해결 3번)", () => {
