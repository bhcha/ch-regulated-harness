   485	    // 우리 잡(= 방금 적재한 그 도장)은 '남의 클레임'이 아니다 — 마감을 보기 전에 정체부터 가른다.
   486	    if (excludeJobId !== undefined && job.job_id === excludeJobId) continue;
   487	    const deadlineMs = parseDeadline(job);
   488	    if (deadlineMs !== null && deadlineMs <= nowMs) continue; // 마감 지남 = 산 클레임이 아니다.
   489	    return { path, consumer, job, deadlineMs };
   490	  }
   491	  return null;
   492	}
   493	
   494	// ── 소비자 진입점(집기) ────────────────────────────────────────────────────────
   495	
   496	/** 잡 1건을 집으려는 시도의 결과. */
   497	export type TakeAction =
   498	  | "claimed" /** 2중 검사 통과 + rename 승리 → 이 소비자가 일한다(path 는 claimed 경로) */
   499	  | "lost" /** 경합 패배·이미 사라짐 — 다른 소비자 몫(조용히 넘어간다) */
   500	  | "failed" /** 만료·형식 오류 → failed/ 격리(+ .reason) */
   501	  | "dropped" /** 전이 완료 → 잡 삭제(할 일이 이미 끝났다) */
   502	  | "skipped"; /** 레거시(미클레임) · 판단 불가(복귀) — 일감으로 삼지 않는다 */
   503	
   504	export interface TakeResult {
   505	  action: TakeAction;
   506	  reason: JobCheckReason;
   507	  /** action="claimed" 일 때의 claimed 경로. */
   508	  path?: string;
   509	  detail?: string;
   510	}
   511	
   512	export interface TakeDeps extends DoubleCheckDeps {
   513	  dirs: JobDirs;
   514	  /** 이 소비자의 id(= `claimed/<consumerId>/` 디렉터리명 · 안전 토큰). */
   515	  consumerId: string;
   516	}
   517	
   518	/**
   519	 * **소비자 1급 경로** — pending 잡 1건을 집어 2중 검사를 걸고 그 결과대로 처분한다(사람 소비자도 같은 규약을 손으로 따른다):
   520	 *   통과 → 그대로 보유(작업) · 만료 → failed/ · 전이완료 → 삭제 · 레거시/판단불가 → 대기줄 복귀.
   521	 *   검사 실패 잡을 그냥 두지 않고 **처분까지** 하는 이유: 남겨두면 다음 회차마다 같은 검사·spawn 을 되풀이하고
   522	 *   사람 눈에도 '대기 중'으로 보인다(큐가 거짓말을 한다).
   523	 *
   524	 * ★ 순서가 핵심 — **먼저 집고(claim), 집은 것을 검사한다.** 반대로 하면(검사 후 집기) 검사한 잡과 집은 잡이 다를 수
   525	 *   있다: rename 은 잡이 아니라 **경로**를 집는데, 그 사이 같은 이름으로 새 잡이 들어올 수 있기 때문이다. 그러면
   526	 *   ㉠ 검사 안 한 잡을 들고 일하거나 ㉡ 멀쩡한 새 잡을 남의 판정으로 failed/ 에 처박는다. 소유한 뒤 검사하면 검사
   527	 *   대상과 처분 대상이 같음이 보장되고(경합 패배자는 아무것도 만지지 않는다), 느린 next-action 조회 동안 예산이
   528	 *   닳는 문제도 같이 사라진다(검사 시각이 소유 이후다).
   529	 *   예외 하나 — **v1 레거시는 집지도 않는다**: 마감이 없다는 건 파일만 보고 알 수 있고(셸 0), 집었다 되돌리면 사람이
   530	 *   손으로 소비 중인 파일을 매 회차 흔들게 된다(contract: 레거시는 사람 몫).
   531	 */
   532	export async function takePendingJob(job: GenerateJobFile, deps: TakeDeps): Promise<TakeResult> {
   533	  assertJobArgs(job.run_id, job.stage);
   534	  // 0) 순수 사전 필터(파일만 보고 판단 · fs 접촉 0): 레거시 잡은 애초에 집지 않는다.
   535	  if (parseDeadline(job) === null) {
   536	    return { action: "skipped", reason: "no_deadline", detail: "expires_at 미기재(v1 레거시 잡) — 사람 소비자 몫" };
   537	  }
   538	  // 1) 집는다(경합의 승자는 OS 가 정한다).
   539	  const path = await claimJob(deps.dirs, job, deps.consumerId);
   540	  if (path === null) return { action: "lost", reason: "ok" };
   541	  try {
   542	    // 2) 집은 **실물**을 읽는다 — 검사도 처분도 이 실물에 대해서만 한다(목록의 잡은 '뭔가 있다'는 힌트일 뿐).
   543	    const mine = await readJobFile(path);
   544	    if (!mine) {
   545	      await failJob(deps.dirs, path, "잡 파일을 읽을 수 없음(형식 오류)");
   546	      return { action: "failed", reason: "unreadable", detail: "잡 파일 형식 오류" };
   547	    }
   548	    // 3) 2중 검사 → 처분. 판정 불가·레거시면 되돌린다(버리지 않는다 — 다음 회차·사람이 다시 본다).
   549	    const check = await doubleCheckJob(mine, deps);
   550	    const detail = check.detail ? { detail: check.detail } : {};
   551	    if (check.ok) return { action: "claimed", reason: "ok", path };
   552	    if (check.reason === "expired") {
   553	      await failJob(deps.dirs, path, check.detail ?? "만료(expires_at 초과)");
   554	      return { action: "failed", reason: check.reason, ...detail };
   555	    }
   556	    if (check.reason === "transitioned") {
   557	      await completeJob(path); // 이미 됐다 → 재실행 금지.
   558	      return { action: "dropped", reason: check.reason, ...detail };
   559	    }
   560	    await releaseJob(deps.dirs, path); // no_deadline(사전 필터 뒤 바뀐 경우) · unreadable
   561	    return { action: "skipped", reason: check.reason, ...detail };
   562	  } catch (e) {
   563	    // 소유한 채 판단·처분에 실패하면(IO 오류 등) 대기줄로 되돌리고 예외를 올린다. 안 그러면 그 잡은 살아 있는
   564	    //   소비자의 claimed/ 에 갇힌다 — reaper 는 산 소비자의 클레임을 건드리지 않으므로 재기동 전까지 아무도 못 집는다
   565	    //   (고아가 아니라 '실종'이라 더 나쁘다). 되돌리기 실패는 삼킨다 — 원래 원인을 가리면 안 된다.
   566	    await releaseJob(deps.dirs, path).catch(() => {});
   567	    throw e;
   568	  }
   569	}
   570	
   571	// ── reaper(고아 클레임 회수) ───────────────────────────────────────────────────
   572	
   573	export interface ReapDeps extends DoubleCheckDeps {
   574	  dirs: JobDirs;
   575	  /**
   576	   * 그 소비자가 아직 살아 있는가(하트비트 등) — **필수**. 기본값을 두지 않는 이유: '살아 있음' 판정은 소비자 구현의
   577	   *   지식이고(데몬=하트비트 파일 · 사람=알 수 없음), 여기서 아무 기본값이나 쓰면 **일하는 중인 소비자의 잡을
   578	   *   빼앗는다**. 판단은 호출부가 명시한다.
   579	   */
   580	  isConsumerAlive: (consumerId: string) => boolean | Promise<boolean>;
   581	}
   582	
   583	export interface ReapResult {
   584	  path: string;
   585	  consumer: string;
   586	  /** alive=살아 있어 건너뜀 · released=pending 복귀 · dropped=중복이라 버림 · failed=만료 격리 · completed=전이완료 삭제 · skipped=판단 불가 */
   587	  action: "alive" | "released" | "dropped" | "failed" | "completed" | "skipped";
   588	  reason: JobCheckReason | "alive";
   589	  detail?: string;
   590	}
   591	
   592	/**
   593	 * 기동 reaper — `claimed/<consumer>/` 의 **고아**(살아 있지 않은 소비자의 클레임)를 회수한다. 고아를 무조건
   594	 *   재큐하지 않고 **같은 2중 검사**를 다시 건다: 만료됐거나 이미 전이됐으면 복귀시키지 않는다(stale 재실행 차단).
   595	 *   살아 있는 소비자의 클레임과 판단 불가(next-action 조회 실패)는 손대지 않는다(fail-closed).
   596	 *
   597	 * ⚠ 호출 순서 규약: 소비자는 **기동 시 이 reaper 를 먼저 돌린 뒤 폴링을 시작한다**. 지난 생의 고아
   598	 *   (`claimed/<자기 id>/`)를 남겨 둔 채 새로 집으면 같은 이름의 클레임을 자기가 덮어써 그 기록을 잃는다.
   599	 */
   600	export async function reapClaimedJobs(deps: ReapDeps): Promise<ReapResult[]> {
   601	  let consumers: string[];
   602	  try {
   603	    consumers = (await readdir(deps.dirs.claimed, { withFileTypes: true }))
   604	      .filter((d) => d.isDirectory())
   605	      .map((d) => d.name)
   606	      .sort();
   607	  } catch (e) {
   608	    if (isEnoent(e)) return []; // claimed/ 없음 = 고아 없음.
   609	    throw e; // 권한·IO 오류를 '고아 없음'으로 위장하지 않는다.
   610	  }
   611	  const out: ReapResult[] = [];
   612	  for (const consumer of consumers) {
   613	    const dir = join(deps.dirs.claimed, consumer);
   614	    // ENOENT = 그 사이 비워짐(정상). 그 외 오류는 '잡 없음'으로 위장하지 않고 올린다.
   615	    const names = (
   616	      await readdir(dir).catch((e: unknown) => {
   617	        if (isEnoent(e)) return [] as string[];
   618	        throw e;
   619	      })
   620	    ).sort();
   621	    // 생사 판정은 소비자당 **한 번**만 — 한 pass 안에서 같은 소비자의 잡들이 서로 다른 판정을 받으면
   622	    //   (스캔 도중 죽었을 때) 일부만 빼앗기는 어중간한 상태가 된다. 판정이 바뀌면 다음 pass 가 처리한다.
   623	    const alive = await deps.isConsumerAlive(consumer);
   624	    for (const name of names) {
   625	      if (name.startsWith(".") || !name.endsWith(".json")) continue;
   626	      const path = join(dir, name);
   627	      if (alive) {
   628	        out.push({ path, consumer, action: "alive", reason: "alive" });
   629	        continue;
   630	      }
   631	      const job = await readJobFile(path);
   632	      if (!job) {
   633	        // 깨진 잡 파일 = 판단 불가 → 사람이 보게 failed/ 로(큐에 남겨 되풀이 읽지 않는다).
   634	        await failJob(deps.dirs, path, "잡 파일을 읽을 수 없음(형식 오류)");
   635	        out.push({ path, consumer, action: "failed", reason: "unreadable", detail: "잡 파일 형식 오류" });
   636	        continue;
   637	      }
   638	      const check = await doubleCheckJob(job, deps);
   639	      const detail = check.detail ? { detail: check.detail } : {};
   640	      if (check.ok || check.reason === "no_deadline") {
   641	        // ok = 아직 시간이 있다 → 대기줄 복귀. no_deadline = 레거시라 데몬이 못 집는다 → 사람이 찾을 대기줄로 되돌린다.
   642	        const released = await releaseJob(deps.dirs, path);
   643	        out.push({ path, consumer, action: released ? "released" : "dropped", reason: check.reason, ...detail });
   644	        continue;
   645	      }
   646	      if (check.reason === "expired") {
   647	        await failJob(deps.dirs, path, check.detail ?? "만료(expires_at 초과)");
   648	        out.push({ path, consumer, action: "failed", reason: check.reason, ...detail });
   649	        continue;
   650	      }
   651	      if (check.reason === "transitioned") {
   652	        await completeJob(path); // 이미 됐다 → 재큐 금지(늦은 중복 생성 차단).
   653	        out.push({ path, consumer, action: "completed", reason: check.reason, ...detail });
   654	        continue;
   655	      }
   656	      // unreadable — 조회 실패로 잡을 버리거나 되살리지 않는다(다음 회차 재시도).
   657	      out.push({ path, consumer, action: "skipped", reason: check.reason, ...detail });
   658	    }
   659	  }
   660	  return out;
   661	}

