   411	  }
   412	
   413	  /**
   414	   * 결함 재현용 봇 + 적재 감시. **주입된 시계가 이 경합의 이음새다**(프로덕션에 테스트 전용 구멍을 뚫지 않는다):
   415	   *   execute 안에서 now() 는 ① 검사 인자 → ② 적재 시각(= 검사가 **끝난 뒤**·적재 **전**) → ③ 재검사 인자 →
   416	   *   이후 폴링 마감 검사 순으로 불린다. 즉 now() 2회차는 정확히 '검사와 적재 사이'(이 결함의 창)이고, 3회차는
   417	   *   '적재와 재검사 사이'다 — onTick 으로 그 순간에 남의 rename 을 끼워 넣는다.
   418	   *   ⚠ 이 이음새는 execute 의 now() 호출 순서에 기댄다(검사→적재시각→재검사). 그 순서를 바꾸면 이 테스트도 같이 본다.
   419	   *
   420	   * ⚠ readNext 는 2회차부터 **전이**를 알린다(시계는 T0 고정) — 보상이 사라지면 이 테스트들은 '적재된 잡을 봤고
   421	   *   execute 가 그냥 끝났다'로 **밀리초 안에** 실패한다. 고정 시계로 폴링에 맡기면 마감이 영영 오지 않아 CI 가
   422	   *   멈춘다(행) — 회귀 가드는 멈추지 말고 실패해야 쓸모가 있다.
   423	   * @returns enqueued() = 폴링 중 대기줄에서 관측된 잡(= C2 가 집을 수 있었던 것 · 없으면 null).
   424	   */
   425	  function raceBridge(onTick: (call: number) => void): { gen: BridgeGenExecutor; enqueued: () => GenerateJobFile | null } {
   426	    let seen: GenerateJobFile | null = null;
   427	    let polls = 0;
   428	    let ticks = 0;
   429	    const gen = new BridgeGenExecutor({
   430	      jobsPendingDir: pendingDir,
   431	      jobsClaimedDir: claimedDir,
   432	      pollIntervalMs: 10,
   433	      timeoutMs: TIMEOUT,
   434	      now: () => {
   435	        onTick(++ticks);
   436	        return T0;
   437	      },
   438	      sleep: async () => {},
   439	      readNext: async () => {
   440	        if (++polls === 1) return na("generate", "brief"); // check-first: 아직 brief 생성 차례
   441	        seen = await readJobFile(join(pendingDir, NAME)); // 적재된 채 남았나(= C2 가 집을 것이 있나)
   442	        return na("human"); // 전이 → execute 종료(행 방지)
   443	      },
   444	    });
   445	    return { gen, enqueued: () => seen };
   446	  }
