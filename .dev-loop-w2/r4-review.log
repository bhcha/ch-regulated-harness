   199	 *   **파일명 규약(`<rid>-<stage>.json`)을 지키는 것만** 잡으로 본다: 하류(takePendingJob·claimJob)가 잡 내용에서
   200	 *   canonical 이름을 다시 만들어 쓰므로, 이름이 어긋난 파일을 잡으로 넘기면 매 회차 '찾을 수 없음'만 되풀이한다.
   201	 */
   202	export async function listPendingJobs(
   203	  pendingDir: string,
   204	): Promise<Array<{ path: string; job: GenerateJobFile }>> {
   205	  let names: string[];
   206	  try {
   207	    names = await readdir(pendingDir);
   208	  } catch (e) {
   209	    if (isEnoent(e)) return []; // 폴더가 아직 없음 = 잡 없음.
   210	    throw e; // 권한·IO 오류를 '빈 큐'로 위장하지 않는다(있는 일감이 조용히 사라진다).
   211	  }
   212	  const out: Array<{ path: string; job: GenerateJobFile }> = [];
   213	  for (const name of names.sort()) {
   214	    if (name.startsWith(".") || !name.endsWith(".json")) continue;
   215	    const path = join(pendingDir, name);
   216	    const job = await readJobFile(path);
   217	    if (!job || jobFileName(job.run_id, job.stage) !== name) continue;
   218	    out.push({ path, job });
   219	  }
   220	  return out;
   221	}
   222	
   223	// ── 2중 검사 ──────────────────────────────────────────────────────────────────
   224	
   225	/**
   226	 * 2중 검사 판정 사유. 소비자(데몬·사람)는 이 값으로 클레임/포기를 가른다:
   227	 *   ok           → 클레임하고 일한다
   228	 *   expired      → 마감까지 남은 시간이 잡 예산+기동 여유에 못 미친다 → failed/ 격리(늦은 성공 창 자체를 없앤다)
   229	 *   transitioned → 그 단계 생성 차례가 아니다(이미 됐거나 다음으로 감) → 잡 삭제(stale 재실행 차단)
   230	 *   no_deadline  → expires_at 미기재(v1 레거시 잡) → 자동 소비 대상 아님(마감을 못 걸어 구조적 보증이 성립 안 함) · 사람 소비자 몫

exec
/bin/zsh -lc "nl -ba chat/src/kernel/job-protocol.ts | sed -n '230,470p'" in /Users/chabh/workspace/ch-regulated-harness
 succeeded in 0ms:
   230	 *   no_deadline  → expires_at 미기재(v1 레거시 잡) → 자동 소비 대상 아님(마감을 못 걸어 구조적 보증이 성립 안 함) · 사람 소비자 몫
   231	 *   unreadable   → next-action 조회 실패 → 판단 불가라 손대지 않는다(다음 회차 재시도 — 조회 실패로 잡을 버리지 않는다)
   232	 */
   233	export type JobCheckReason = "ok" | "expired" | "transitioned" | "no_deadline" | "unreadable";
   234	
   235	export interface JobCheck {
   236	  ok: boolean;
   237	  reason: JobCheckReason;
   238	  /** 진단용 상세(로그·failed/ 사유 파일). 사람 카드 문구가 아니다. */
   239	  detail?: string;
   240	}
   241	
   242	/**
   243	 * 검사 ㉠(시간) — 순수. `지금 + 잡 예산 + 기동 여유 ≤ expires_at` 이어야 집는다.
   244	 *   '마감이 아직 안 지났나'가 아니라 '**끝낼 수 있나**'를 본다 — 마감 3초 전에 8분짜리 잡을 시작하면 실패 카드 뒤
   245	 *   늦은 성공이 되기 때문이다(그 창을 시작 전에 없앤다).
   246	 */
   247	export function checkBudget(
   248	  job: GenerateJobFile,
   249	  nowMs: number,
   250	  budgetMs: number,
   251	  startupMarginMs: number,
   252	): JobCheck {
   253	  const deadline = parseDeadline(job);
   254	  if (deadline === null) {
   255	    return { ok: false, reason: "no_deadline", detail: "expires_at 미기재(v1 레거시 잡) — 자동 소비 대상 아님" };
   256	  }
   257	  const need = budgetMs + startupMarginMs;
   258	  const remain = deadline - nowMs;
   259	  if (remain < need) {
   260	    return { ok: false, reason: "expired", detail: `남은 시간 ${remain}ms < 필요 ${need}ms(예산 ${budgetMs} + 기동여유 ${startupMarginMs})` };
   261	  }
   262	  return { ok: true, reason: "ok" };
   263	}
   264	
   265	/**
   266	 * 검사 ㉡(차례) — 지금 이 단계의 생성 차례인가. 봇(브리지)의 전이 감지와 **같은 판정**을 쓴다(이중 진실 금지).
   267	 *   step 은 페이즈 횡단 전역이라 `step==generate` 만 보면 stale 한 brief 잡을 다음 단계(concept)의 차례와 혼동한다
   268	 *   → stage 까지 같아야 '아직 그 잡의 차례'다.
   269	 */
   270	export function isGenerateTurn(na: NextAction, stage: string): boolean {
   271	  return na.step === "generate" && na.stage === stage;
   272	}
   273	
   274	export interface DoubleCheckDeps {
   275	  /** 현재시각(ms) — 주입(테스트 결정성). */
   276	  now: () => number;
   277	  /** 잡 wall-clock 예산(ms) — 소비자가 자기 값을 준다(데몬 = CHAT_SDK_GEN_TIMEOUT · 후속 단계 소유). */
   278	  budgetMs: number;
   279	  /** 기동 여유(ms) — 검사·클레임·세션 spawn 오버헤드 몫. */
   280	  startupMarginMs: number;
   281	  /** next-action 조회(읽기 전용). */
   282	  readNext: (rid: string) => Promise<NextAction>;
   283	}
   284	
   285	/**
   286	 * 2중 검사 — 시간(㉠) 먼저, 차례(㉡) 나중. 순서 주의: ㉠ 이 셸 없이 즉답이라 마감 지난 잡에 next-action spawn 비용을
   287	 *   쓰지 않는다. 둘 다 통과해야만 ok(하나라도 어긋나면 일하지 않는다 — fail-closed).
   288	 *
   289	 * ⚠ ㉠은 ㉡ **뒤에 한 번 더** 본다: ㉡의 next-action 조회는 셸 spawn 이라 수백 ms가 걸릴 수 있고, 그동안 기동 여유가
   290	 *   닳는다. 조회 전 시각으로만 판정하면 '검증할 땐 있던 예산'이 일을 시작할 땐 없다. 재검사는 순수 계산이라 공짜다.
   291	 */
   292	export async function doubleCheckJob(job: GenerateJobFile, deps: DoubleCheckDeps): Promise<JobCheck> {
   293	  const budget = checkBudget(job, deps.now(), deps.budgetMs, deps.startupMarginMs);
   294	  if (!budget.ok) return budget;
   295	  let na: NextAction;
   296	  try {
   297	    na = await deps.readNext(job.run_id);
   298	  } catch (e) {
   299	    const msg = e instanceof Error ? e.message : String(e);
   300	    return { ok: false, reason: "unreadable", detail: `next-action 조회 실패: ${msg}` };
   301	  }
   302	  if (!isGenerateTurn(na, job.stage)) {
   303	    return {
   304	      ok: false,
   305	      reason: "transitioned",
   306	      detail: `그 단계 생성 차례가 아님(현재 step=${String(na.step)} stage=${na.stage ?? "-"})`,
   307	    };
   308	  }
   309	  return checkBudget(job, deps.now(), deps.budgetMs, deps.startupMarginMs); // 조회에 걸린 시간만큼 예산 재확인
   310	}
   311	
   312	// ── 클레임·정리(rename 기반) ───────────────────────────────────────────────────
   313	
   314	/**
   315	 * 클레임 = `rename(pending/X → claimed/<consumer>/X)`. **경합의 승자는 OS 가 정한다**: 동시에 집으면 rename 이
   316	 *   하나만 성공하고 나머지는 원본이 사라져 ENOENT → null(깨끗한 패배). 승자만 그 잡을 만진다.
   317	 * @returns 승자면 claimed 경로, 패자·이미 없어짐이면 null.
   318	 */
   319	export async function claimJob(
   320	  dirs: JobDirs,
   321	  job: GenerateJobFile,
   322	  consumerId: string,
   323	): Promise<string | null> {
   324	  assertConsumerId(consumerId);
   325	  const name = jobFileName(job.run_id, job.stage);
   326	  const destDir = join(dirs.claimed, consumerId);
   327	  await mkdir(destDir, { recursive: true });
   328	  const to = join(destDir, name);
   329	  try {
   330	    await rename(join(dirs.pending, name), to);
   331	    return to;
   332	  } catch (e) {
   333	    if (isEnoent(e)) return null; // 누가 먼저 집었거나 봇이 회수함 — 정상 패배.
   334	    throw e;
   335	  }
   336	}
   337	
   338	/** 성공 = 잡 파일 삭제(수명주기 종료). 이미 없으면 no-op(멱등). */
   339	export async function completeJob(claimedPath: string): Promise<void> {
   340	  try {
   341	    await unlink(claimedPath);
   342	  } catch (e) {
   343	    if (!isEnoent(e)) throw e;
   344	  }
   345	}
   346	
   347	/**
   348	 * 실패 = `failed/X` + 사유 파일(`X.reason`). 부분 성공은 없다 — 실패한 잡은 큐에서 빠지고 사람이 본다.
   349	 *
   350	 * 순서: **잡을 먼저 옮기고 사유를 쓴다.** 반대로 하면(사유 먼저) 사유 파일 경로가 잡보다 먼저 존재해, 같은 잡을
   351	 *   처분하려던 다른 호출이 자기 실패를 정리하며 **승자의 사유 파일을 지운다**(사유 없는 실패 잡). 이 순서면 진 쪽은
   352	 *   아무것도 쓰지 않는다. 남는 위험은 '옮긴 직후 죽어 사유가 안 써지는' 창(µs)뿐이고, 그건 사유 없는 실패 잡 하나로
   353	 *   그친다(파일은 남아 사람이 본다).
   354	 *   ⚠ 호출 전제: **그 잡을 소유한 상태**(클레임 승자)여야 한다 — takePendingJob 은 클레임 뒤에만 부른다.
   355	 *   ⚠ 알려진 한계: failed 경로도 `<rid>-<stage>` 라, 같은 단계의 잡 둘이 **동시에 살아 있다가 둘 다 실패**하면
   356	 *     나중 것이 앞의 기록을 덮는다(사유가 다른 실패를 가리킬 수 있다). 그 상황 자체가 이미 비정상이고(같은 단계를
   357	 *     두 소비자가 동시에 생성 — core 락·멱등 게이트가 상태는 지킨다), 실패 기록 한 줄의 정확도 문제라 파일명에
   358	 *     job_id 를 붙여 사람 규약(jobs/README 의 `mv … failed/`)을 복잡하게 만드는 대신 이 한계를 남긴다.
   359	 * @returns failed 경로.
   360	 */
   361	export async function failJob(dirs: JobDirs, fromPath: string, reason: string): Promise<string> {
   362	  const name = basename(fromPath);
   363	  await mkdir(dirs.failed, { recursive: true });
   364	  const dest = join(dirs.failed, name);
   365	  await rename(fromPath, dest);
   366	  await writeFile(`${dest}${REASON_SUFFIX}`, `${reason}\n`, "utf8");
   367	  return dest;
   368	}
   369	
   370	/**
   371	 * 클레임 해제 = pending 복귀(reaper 가 고아 클레임을 되돌릴 때). **no-clobber**: 같은 이름의 새 잡이 이미
   372	 *   대기 중이면 그 새 잡(마감이 더 넉넉하다)을 옛 고아로 덮지 않고, 고아 쪽을 버린다(중복 잡 제거).
   373	 *   link+unlink 를 쓰는 이유 = rename 은 무조건 덮어써서 '있는지 보고 옮기기'의 경합 창이 생기기 때문.
   374	 * @returns 실제로 복귀시켰으면 true, 새 잡이 있어 버렸으면 false.
   375	 */
   376	export async function releaseJob(dirs: JobDirs, claimedPath: string): Promise<boolean> {
   377	  const name = basename(claimedPath);
   378	  await mkdir(dirs.pending, { recursive: true });
   379	  const dest = join(dirs.pending, name);
   380	  try {
   381	    await link(claimedPath, dest);
   382	  } catch (e) {
   383	    if (!isEexist(e)) throw e;
   384	    await completeJob(claimedPath); // 새 잡이 이미 대기 중 — 고아는 중복이라 버린다.
   385	    return false;
   386	  }
   387	  await completeJob(claimedPath); // 하드링크 성공 → 원본 링크 제거(= 이동 완료).
   388	  return true;
   389	}
   390	
   391	/**
   392	 * 봇 타임아웃 회수 — **자기 잡일 때만** pending 에서 거둬들인다(job_id 대조). 소비자가 이미 클레임했으면(파일 없음)
   393	 *   no-op 이고, 같은 단계로 **새 잡이 다시 적재**됐으면(job_id 다름) 건드리지 않는다 — 남의 요청을 지우면 그 요청이 증발한다.
   394	 *
   395	 * **이 회수는 2차 방어다(1차는 마감 그 자체).** 봇이 타임아웃하는 순간은 정의상 `now ≥ expires_at` 이라, 남아 있는
   396	 *   잡은 이미 만료다 — 어떤 소비자가 집으려 해도 2중 검사 ㉠에 걸려 failed/ 로 간다. 회수는 그 뻔한 결말을 앞당기는
   397	 *   **정리**일 뿐이라 실패해도 안전하다(그래서 읽기 오류도 '회수 못 함'으로 환원한다).
   398	 * ⚠ 읽기-후-삭제라 원자적이지 않다. 창이 좁게 유지되는 근거는 **적재자가 하나**라는 배치 전제다: pending/ 을 쓰는 것은
   399	 *   봇뿐이고(Socket Mode 봇은 워크스페이스당 1 프로세스), 그 잡큐는 run 별 FIFO 라 같은 run 의 다음 생성 잡은 이
   400	 *   execute 가 끝난 **뒤에** 적재된다. job_id 대조는 그 위의 2차 방어다. 봇을 다중화하려면(같은 jobs/ 를 공유하는
   401	 *   2 프로세스) 이 회수도 클레임처럼 rename 기반으로 바꿔야 한다 — 다만 그 배치는 카드·잡 중복부터 깨진다.
   402	 * @returns 실제로 회수했으면 true.
   403	 */
   404	export async function recallPendingJob(pendingDir: string, job: GenerateJobFile): Promise<boolean> {
   405	  const path = join(pendingDir, jobFileName(job.run_id, job.stage));
   406	  // 읽기 실패(권한·IO)는 '회수 못 함'으로 환원한다 — 봇의 타임아웃 보고를 fs 예외로 바꾸지 않는다(사람 문구가 사라진다).
   407	  const cur = await readJobFile(path).catch(() => null);
   408	  // job_id 는 v2 잡에만 있다 — 둘 다 '비지 않은 문자열'이고 같을 때만 자기 잡으로 인정(옛/변조 잡 오삭제 차단).
   409	  if (!cur || !job.job_id || cur.job_id !== job.job_id) return false;
   410	  try {
   411	    await unlink(path);
   412	    return true;
   413	  } catch (e) {
   414	    if (isEnoent(e)) return false; // 그 사이 누가 집었다 — 정상.
   415	    throw e;
   416	  }
   417	}
   418	
   419	/** 같은 run·stage 를 이미 집고 있는 클레임 1건(적재 차단 판정의 근거). */
   420	export interface ClaimedJobRef {
   421	  /** 클레임 경로(`claimed/<consumer>/<rid>-<stage>.json`). */
   422	  path: string;
   423	  /** 그 잡을 집은 소비자 id(= `claimed/` 밑 디렉터리명). */
   424	  consumer: string;
   425	  /** 집힌 잡 실물(이름이 아니라 이 내용이 그 소비자가 할 일이다). */
   426	  job: GenerateJobFile;
   427	  /** 절대 마감(ms). **null = 마감 미기재**(v1 레거시) — '만료'가 아니라 '알 수 없음'이다. */
   428	  deadlineMs: number | null;
   429	}
   430	
   431	/**
   432	 * **적재 차단 조회(봇 몫)** — 같은 run·stage 를 **마감이 아직 남은 소비자가 이미 집고 있는가**. 있으면 그 클레임을,
   433	 *   없으면 null 을 낸다. 봇은 non-null 이면 새 잡을 적재하지 않는다(BridgeGenExecutor).
   434	 *
   435	 * 왜 필요한가(이중 소비 구멍): 회수(recallPendingJob)는 `pending/` 만 본다 — 소비자가 이미 집었으면 회수에 실패하고
   436	 *   봇은 실패 카드를 낸다. 그런데 core 는 그대로 그 단계 생성 차례라, [상태 다시 확인] → [다시 만들기] 가 **새 잡**을
   437	 *   적재한다(파일명이 같아도 옛 잡은 `claimed/` 에 있어 덮이지 않는다). 그러면 두 소비자가 같은 런의 산출물을 동시에
   438	 *   쓰고 돈도 두 번 든다. "[다시 만들기]는 클레임된 잡을 되살리지 않는다"는 v2 의 보증은 **같은 잡 파일**에만 참이라
   439	 *   이 결말을 막지 못한다 — 막을 자리는 되살리기가 아니라 **적재 직전**이다.
   440	 *
