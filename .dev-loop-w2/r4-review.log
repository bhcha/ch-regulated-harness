   383	describe("BridgeGenExecutor — 이중 소비 차단(적재 후 재검사 → 보상)", () => {
   384	  const T0 = 1_700_000_000_000;
   385	  const TIMEOUT = 900_000;
   386	  const NAME = "run-1-brief.json";
   387	  let root: string;
   388	  let pendingDir: string;
   389	  let claimedDir: string;
   390	
   391	  beforeEach(async () => {
   392	    root = await mkdtemp(join(tmpdir(), "chat-bridge-race-"));
   393	    pendingDir = join(root, "pending");
   394	    claimedDir = join(root, "claimed");
   395	    await mkdir(pendingDir, { recursive: true });
   396	  });
   397	  afterEach(async () => {
   398	    await rm(root, { recursive: true, force: true });
   399	  });
   400	
   401	  /** ㉠의 옛 잡 — 봇의 이번 요청보다 먼저 적재됐고(T0-1000) 마감은 아직 남았다(T0 기준 산 잡). */
   402	  const oldJob = (): GenerateJobFile => ({
   403	    ...buildGenerateJob({ run_id: "run-1", stage: "brief", enqueuedAtMs: T0 - 1000, timeoutMs: TIMEOUT }),
   404	    job_id: "옛-잡",
   405	  });
   406	
   407	  /** 소비자가 지금 대기줄의 잡을 집는다(= 프로토콜의 클레임 = rename). **동기**여야 한다 — now() 안에서 부른다. */
   408	  function claimSync(consumer: string): void {
