+   *   execute 가 그냥 끝났다'로 **밀리초 안에** 실패한다. 고정 시계로 폴링에 맡기면 마감이 영영 오지 않아 CI 가
+   *   멈춘다(행) — 회귀 가드는 멈추지 말고 실패해야 쓸모가 있다.
+   * @returns enqueued() = 폴링 중 대기줄에서 관측된 잡(= C2 가 집을 수 있었던 것 · 없으면 null).
+   */
+  function raceBridge(onTick: (call: number) => void): { gen: BridgeGenExecutor; enqueued: () => GenerateJobFile | null } {
+    let seen: GenerateJobFile | null = null;
+    let polls = 0;
+    let ticks = 0;
+    const gen = new BridgeGenExecutor({
+      jobsPendingDir: pendingDir,
+      jobsClaimedDir: claimedDir,
+      pollIntervalMs: 10,
+      timeoutMs: TIMEOUT,
+      now: () => {
+        onTick(++ticks);
+        return T0;
+      },
+      sleep: async () => {},
+      readNext: async () => {
+        if (++polls === 1) return na("generate", "brief"); // check-first: 아직 brief 생성 차례
+        seen = await readJobFile(join(pendingDir, NAME)); // 적재된 채 남았나(= C2 가 집을 것이 있나)
+        return na("human"); // 전이 → execute 종료(행 방지)
+      },
+    });
+    return { gen, enqueued: () => seen };
+  }
+
+  it("★ 검사와 적재 사이에 남이 집어 갔으면 방금 쓴 우리 잡을 거두고 막는다(이중 소비의 원천 제거)", async () => {
+    await writePendingJob(pendingDir, oldJob()); // ㉠ 아무도 안 집은 옛 잡이 대기줄에 남아 있다
+    const { gen, enqueued } = raceBridge((call) => {
+      if (call === 2) claimSync("c1"); // ㉢ 검사 통과 직후·적재 직전에 C1 이 그 옛 잡을 집는다
+    });
+    const err = await gen.execute("run-1", "brief").catch((e: unknown) => e);
+    // ★ 핵심 단정: 우리 잡이 대기줄에 남으면 C2 가 집어 C1 과 같은 런을 동시에 쓴다 — 보상이 그것을 거둬들였다.
+    expect(enqueued()).toBeNull();
+    expect(await readdir(pendingDir)).toEqual([]);
+    expect(err).toBeInstanceOf(GenerationInProgressError);
+    expect((err as Error).message).toBe("이미 만들고 있어요 — 잠시 후 다시 확인해 주세요.");
+    // C1 의 잡은 그대로 — 보상은 job_id 대조라(recallPendingJob) 남의 요청을 지울 수 없다.
+    expect((await readJobFile(join(claimedDir, "c1", NAME)))?.job_id).toBe("옛-잡");
+  });
+
+  it("★ 그새 집힌 게 **우리 잡**이면 막지 않는다 — 소비자가 빠른 정상 경로다(과차단 금지)", async () => {
+    // 대기줄이 비어 있으니 끼어들 남의 잡도 없다. C2 는 우리 잡이 대기줄에 나타나는 첫 순간(재검사 직전)에 집는다.
+    const { gen } = raceBridge((call) => {
+      if (call === 3) claimSync("c2");
+    });
+    const err = await gen.execute("run-1", "brief").catch((e: unknown) => e);
+    // 이음새 sanity 먼저 — C2 가 실제로 우리 잡을 집었나(불발이면 아래 단정이 공허하게 통과한다).
+    expect((await readJobFile(join(claimedDir, "c2", NAME)))?.run_id).toBe("run-1");
+    // ★ 계약: 우리 잡이 집힌 것은 막을 근거가 아니다(재검사가 우리 job_id 를 빼고 본다) → 그대로 기다려 완료한다.
+    //   여기서 막으면 소비자가 빠를수록 봇이 스스로를 막는다 — 브리지가 정상 경로에서 못 쓰게 된다.
+    expect(err).toBeUndefined();
+  });
+
+  it("재검사가 판단 불가(권한·IO)면 우리 잡을 남기지 않고 막는다 — 막아 놓고 남기면 그게 곧 중복이다", async () => {
+    const { gen, enqueued } = raceBridge((call) => {
+      // 재검사 직전에 조회를 깨뜨린다: 잡 파일 자리에 디렉터리 → EISDIR('없음'도 '깨짐'도 아닌 fs 오류의 대역).
+      if (call === 3) mkdirSync(join(claimedDir, "c1", NAME), { recursive: true });
+    });
+    await expect(gen.execute("run-1", "brief")).rejects.toThrow("지금 상태를 확인하지 못했어요 — 잠시 후 다시 확인해 주세요.");
+    expect(enqueued()).toBeNull();
+    expect(await readdir(pendingDir)).toEqual([]); // 우리 잡은 거둬들였다(남겨두면 누가 집는다)
+  });
+
+  it("★ 보상(회수)이 실패해도 성공으로 보고하지 않는다 — 산 잡이 둘일 수 있으면 막는 쪽으로 넘어진다", async () => {
+    await writePendingJob(pendingDir, oldJob());
+    const { gen } = raceBridge((call) => {
+      if (call === 2) claimSync("c1"); // ㉢ C1 이 옛 잡을 집는다(창 안에서)
+      if (call === 3) claimSync("c2"); // ㉤ 회수보다 **먼저** C2 가 우리 잡까지 집어 간다 → 회수 불가
+    });
+    const err = await gen.execute("run-1", "brief").catch((e: unknown) => e);
+    expect(err).toBeInstanceOf(GenerationInProgressError); // 성공 보고 금지(fail-closed)
+    // ⚠ 남는 한계(정직하게 못 박는다): 이 순간 C1·C2 가 둘 다 그 단계를 만들 수 있다 — 봇은 남의 클레임을 되돌리지
+    //   못한다. 보상이 좁힌 것은 창의 크기지 결말 자체가 아니다(그래도 "만들고 있어요"는 사실이다).
+    expect((await readJobFile(join(claimedDir, "c1", NAME)))?.job_id).toBe("옛-잡");
+    expect((await readJobFile(join(claimedDir, "c2", NAME)))?.run_id).toBe("run-1");
+  });
+});
+
