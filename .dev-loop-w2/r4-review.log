   164	    //   파일을 쓰지 않고 즉시 반환. 안 그러면 아무도 소비 안 하는 stale 잡 파일이 남아 엉뚱한 게이트에 처리될 수 있다.
   165	    if (this.transitioned(await this.readNext(run_id), stage)) return;
   166	    // ★ 이중 소비 차단 ①(적재 전 검사): 같은 run·stage 를 아직 마감이 남은 소비자가 집고 있으면 **적재하지 않는다**.
   167	    await this.assertNobodyIsWorkingOn(run_id, stage);
   168	    // 종단 마감 단일 원천(프로토콜 v2): 잡의 expires_at 과 봇의 폴링 마감을 **한 시각**에서 계산한다 —
   169	    //   따로 재면 봇이 포기한 뒤에도 소비자가 '아직 안 늦었다'고 보는 어긋남이 생긴다.
   170	    const enqueuedAtMs = this.now();
   171	    const job = buildGenerateJob({ run_id, stage, enqueuedAtMs, timeoutMs: this.timeoutMs });
   172	    await writePendingJob(this.jobsPendingDir, job);
   173	    // ★ 이중 소비 차단 ②(적재 후 재검사 → 보상): ①과 적재 사이에 남이 집었으면 방금 쓴 우리 잡을 도로 거둔다(아래 상세).
   174	    await this.assertNobodyElseTookOver(job);
   175	    const deadline = enqueuedAtMs + this.timeoutMs; // = Date.parse(job.expires_at)
   176	    for (;;) {
   177	      const na = await this.readNext(run_id);
   178	      // ⚠ 순서 주의(의도): 마감 검사보다 **전이 검사가 먼저**다. 마감이 지난 뒤에 본 전이라도 그건 '실제로 된 것'이라
   179	      //   성공으로 보고한다 — 우리 타이머가 지났다는 이유로 끝난 일을 실패로 알리면 카드가 사실과 어긋난다.
   180	      //   (봇이 이미 포기해 실패 카드를 띄운 뒤의 늦은 전이는 이 루프 밖의 일이라 [상태 다시 확인]이 맡는다.)
   181	      if (this.transitioned(na, stage)) {
   182	        await this.cleanupPendingJob(run_id, stage); // 전이 완료 → 남은 pending 파일 정리(stale 방지)
   183	        return; // 생성 완료 → 게이트 도달
   184	      }
   185	      if (this.now() >= deadline) {
   186	        // 봇 타임아웃 = 회수: 아직 pending 인 **자기 잡**만 거둬들인다(job_id 대조 — 같은 단계로 새로 적재된
   187	        //   잡이 있으면 그건 남의 요청이라 손대지 않는다). 이미 클레임됐으면 회수 실패 → 늦은 성공이 가능하다.
   188	        const recalled = await recallPendingJob(this.jobsPendingDir, job);
   189	        throw new Error(
   190	          recalled
   191	            ? `브리지 생성 대기 시간 초과(run=${run_id}, stage=${stage}) — 아무도 처리하지 않아 대기 중이던 요청을 거둬들였습니다.`
   192	            : // 회수 실패의 사정은 여럿이다(소비자가 집어 감 · 만료 처분됨 · 새 잡이 덮어씀) — 봇은 구분하지 못하므로
   193	              // 단정하지 않는다. 어느 쪽이든 사람이 확인할 길은 같다([상태 다시 확인]).
   194	              `브리지 생성 대기 시간 초과(run=${run_id}, stage=${stage}) — 대기 중이던 요청을 회수하지 못했습니다` +
   195	              `(소비자가 이미 집었거나 처분된 상태). 늦게 완료될 수 있습니다([상태 다시 확인]으로 화해).`,
   196	        );
   197	      }
   198	      await this.sleep(this.pollIntervalMs);
   199	    }
   200	  }
   201	
   202	  /**
   203	   * 이중 소비 차단 — 적재 직전 `claimed/` 를 보고, 아직 마감이 남은 클레임이 있으면 **적재 없이** 중단한다.
   204	   *   판정 규칙(마감 남음/지남/미기재)의 근거는 job-protocol.findBlockingClaimedJob 주석이 SSoT 다.
   205	   *
   206	   * **왜 여기(실행기)인가**: 적재 경로는 [다시 만들기] 하나가 아니다 — 자동 이어가기(flow.onOutcome)도 같은 generate
   207	   *   잡을 넣는다. 잡을 만드는 자리마다 검사를 흩으면 언젠가 하나가 빠진다. 파일을 실제로 쓰는 **한 곳**에서 막으면
   208	   *   모든 경로가 덮인다(버튼·자동 이어가기·후속 소비자 무엇이든).
   209	   * **왜 전이 검사 뒤인가**: 이미 전이됐으면(소비자가 늦게 성공하고 클레임을 아직 안 지운 창) 조용한 no-op 이 옳다 —
   210	   *   다 끝난 일에 "만들고 있어요"라고 답하지 않는다.
   211	   * **왜 기다리지 않고 멈추나**: 봇이 남의 잡의 완료를 대신 기다리면 그 잡의 마감과 봇의 대기 마감이 둘이 된다
   212	   *   (v2 의 '마감 단일 원천'이 깨진다). 지금 상태를 묻는 길은 이미 있다 — 실패 카드의 [상태 다시 확인].
   213	   */
   214	  private async assertNobodyIsWorkingOn(run_id: string, stage: string): Promise<void> {
   215	    let blocking: Awaited<ReturnType<typeof findBlockingClaimedJob>>;
   216	    try {
   217	      blocking = await findBlockingClaimedJob(this.jobsClaimedDir, run_id, stage, this.now());
   218	    } catch {
   219	      // 판단 불가(권한·IO — ENOENT 는 여기 오지 않는다: 그건 '클레임 없음'이라 null 이다) → **막는다**(fail-closed).
   220	      //   잘못 막으면 사람이 잠시 후 다시 확인하면 그만이지만, 잘못 적재하면 두 소비자가 같은 런을 동시에 쓰고
   221	      //   돈도 두 번 든다(되돌릴 수 없다). 값싼 오류 쪽으로 넘어진다.
   222	      throw new GenerationInProgressError(MSG_CANNOT_TELL);
   223	    }
   224	    if (blocking) throw new GenerationInProgressError(MSG_ALREADY_IN_PROGRESS);
   225	  }
   226	
   227	  /**
   228	   * 이중 소비 차단 ②(적재 후 재검사 → 보상) — 적재 직후 `claimed/` 를 **한 번 더** 본다.
   229	   *
   230	   * ①은 원자적이지 않다: '검사'와 '적재'는 두 걸음인데 소비자의 클레임(`rename(pending/X → claimed/C/X)`)은 봇과
   231	   *   직렬화되지 않는다(원자성 원천은 OS 이고 봇은 그 rename 에 끼지 못한다). 그 사이로 새는 순서:
   232	   *     ㉠ 아직 아무도 안 집은 **옛 잡**이 `pending/X` 에 남아 있다(봇 재기동 · 회수 못 한 옛 요청).
   233	   *     ㉡ ①의 검사 → `claimed/` 가 비어 통과.   ㉢ C1 이 그 **옛 잡**을 집는다(rename).
   234	   *     ㉣ 우리가 `pending/X` 를 덮어써 **새 잡**을 넣는다(writePendingJob 의 덮어쓰기는 의도지만, 그 근거인
   235	   *        '아무도 안 집은 같은 일의 옛 요청 = 더 신선한 것으로 승격'은 **아무도 안 집었을 때만** 참이다 —
   236	   *        ㉢가 그 전제를 깬 순간이 정확히 여기다).
   237	   *     ㉤ C2 가 그 새 잡을 집는다 → C1·C2 가 같은 run·stage 를 동시에 만든다(①이 막으려던 바로 그 결말).
   238	   *
   239	   * 보상: 재검사에서 **남의** 산 클레임이 보이면(= ㉢가 ①과 적재 사이에 끼어들었다는 증거) 방금 쓴 **우리 잡을
   240	   *   회수**하고 ①과 같은 문구로 막는다 — 산 잡을 둘 남기느니 우리 것을 물린다(C1 이 이미 그 일을 하고 있으므로
   241	   *   현업에게 "이미 만들고 있어요"는 사실이다). 회수는 job_id 대조라(recallPendingJob) 남의 잡·더 새 잡은 지울 수
   242	   *   없다 — 보상이 남의 요청을 증발시키는 일은 구조적으로 없다.
   243	   *
   244	   * **왜 여기서 끝나나(보상이 되풀이되지 않는 근거)**: ㉣ 시점에 옛 잡은 이미 없다 — C1 이 rename 으로 가져갔고,
   245	   *   우리가 덮어쓴 `pending/X` 는 **우리 job_id** 를 단 새 파일이다. 그래서 C1 이 두 번 집을 길이 없고, 재검사
   246	   *   **뒤**에 생기는 클레임은 정의상 우리 잡을 집는 것뿐이다(= 산 잡 정확히 1건 · 정상). 보상이 필요한 끼어들기는
   247	   *   '①~재검사' 창 하나뿐이고 그 창은 재검사가 지나면 다시 열리지 않는다(적재자는 봇 하나 — recallPendingJob 주석의
   248	   *   배치 전제와 같다). 그래서 재검사는 **한 번**이면 족하다(루프 불필요).
   249	   *
   250	   * ⚠ 남는 창(정직하게): 우리 잡이 **회수보다 먼저** 집히면(㉤가 재검사를 앞지름) 회수는 실패한다 — 봇은 남의
   251	   *   클레임을 되돌릴 수 없다. 그때도 성공으로 보고하지 않고 막지만(fail-closed), C1·C2 가 둘 다 도는 결말 자체를
   252	   *   못 막는다. 완전히 없애려면 적재가 no-clobber(link 기반)여야 하는데 그러면 '같은 이름 덮어쓰기 = 더 신선한
   253	   *   요청'이라는 v2 규약과 마감 단일 원천이 함께 흔들린다 — 창을 µs 로 좁히는 쪽을 택했다.
   254	   */
   255	  private async assertNobodyElseTookOver(job: GenerateJobFile): Promise<void> {
   256	    let rival: Awaited<ReturnType<typeof findBlockingClaimedJob>>;
   257	    try {
   258	      // 우리 job_id 는 **뺀다**: 그새 집힌 게 우리 잡이면 소비자가 제 일을 가져간 정상 경로다(과차단 금지 — 그것까지
   259	      //   세면 소비자가 빠를수록 봇이 스스로를 막는다). 남의 잡만이 '이미 만들고 있다'의 근거다.
   260	      rival = await findBlockingClaimedJob(this.jobsClaimedDir, job.run_id, job.stage, this.now(), job.job_id);
   261	    } catch {
   262	      // 판단 불가(권한·IO) → ①과 같은 fail-closed. 단 우리 잡을 **남긴 채** 막지는 않는다: 남기면 우리가 막아 놓고
   263	      //   그 잡을 누가 집어 가 우리가 만든 중복이 된다(막는 시늉만 하는 꼴).
   264	      await this.withdraw(job);
   265	      throw new GenerationInProgressError(MSG_CANNOT_TELL);
   266	    }
   267	    if (!rival) return; // 아무도 끼어들지 않았다 → 우리 잡 그대로 두고 전이를 기다린다(정상 경로).
   268	    await this.withdraw(job);
   269	    throw new GenerationInProgressError(MSG_ALREADY_IN_PROGRESS);
   270	  }
   271	
   272	  /**
   273	   * 보상 = 방금 적재한 **우리 잡** 되거두기(job_id 대조 — recallPendingJob 이 남의 잡은 못 지운다).
   274	   *   회수 실패를 삼키는 이유: 실패의 뜻은 '이미 집혔다'(늦은 성공 가능) 또는 fs 오류인데 **어느 쪽이든 호출부의
   275	   *   결론은 같다 — 막는다**. 여기서 예외를 올리면 사람에게 갈 평이한 한 줄이 fs 예외로 바뀌어 worker 가 "생성을
   276	   *   마치지 못했습니다"로 뭉갠다(우리가 아는 사실이 아니다). 성공 보고로 새지 않는 한 회수 실패는 안전하다.
   277	   */
   278	  private async withdraw(job: GenerateJobFile): Promise<void> {
   279	    await recallPendingJob(this.jobsPendingDir, job).catch(() => {});
   280	  }
   281	
   282	  /**
   283	   * 전이 완료 후 남은 pending 잡 파일 정리(소비자가 이미 지웠으면 no-op).
   284	   *   ⚠ 회수(recall)와 달리 job_id 를 대조하지 않는다 — 전이가 확인된 시점엔 그 rid·stage 의 **어떤** 잡도
   285	   *     이미 stale 이다(그 단계 생성 차례가 지났다). 반대로 회수는 아직 그 차례라 남의 새 잡을 지우면 안 된다.
   286	   */
   287	  private async cleanupPendingJob(run_id: string, stage: string): Promise<void> {
   288	    await unlink(join(this.jobsPendingDir, jobFileName(run_id, stage))).catch(() => {});
   289	  }
   290	
   291	  /** 생성 완료 판정 — 요청한 stage 가 더 이상 '현재 생성 대상'이 아니면 전이로 본다(판정 SSoT = job-protocol). */
   292	  private transitioned(na: NextAction, requestedStage: string): boolean {
   293	    return !isGenerateTurn(na, requestedStage);
   294	  }
   295	}
   296	
   297	// ── 3) Agent SDK 세션 워커(S-1 · 무인 · live-only 미검증) ─────────────────────────
   298	/** Agent SDK 로 insession 생성을 수행하는 실제 워커. 산출물 작성 + `run-stage.sh`(insession) 전이까지 책임진다. */
   299	export type SdkGenerate = (run_id: string, stage: string) => Promise<void>;
   300	
   301	export interface AgentSdkDeps {
   302	  /**
   303	   * 실제 Agent SDK 생성 호출. **미주입이면 S-1 미배선**으로 보고 실행 시 명확히 실패한다(fail-closed) —
   304	   *   selectGenExecutor 는 sdkGenerate 가 있을 때만 이 실행기를 고른다(없으면 브리지).
   305	   */
   306	  sdkGenerate?: SdkGenerate;
   307	  /** 전이 확인용 next-action 조회(기본 contract-client). */
   308	  readNext?: (rid: string) => Promise<NextAction>;
   309	}
   310	
   311	/**
   312	 * AgentSdkGenExecutor — 운영자 세션 없이 Agent SDK 세션 워커로 insession 생성을 돌리고(무인, S-1), 그 뒤
   313	 *   next-action 으로 전이를 확인한다(브리지와 동일 완료 계약). 세션 마커·SDK 배선은 이 레포에 없어 **오프라인
   314	 *   검증 불가**(live-only) — sdkGenerate 미주입 시 fail-closed. state.json 직접 쓰기 0(전이는 core scripts).
   315	 */
   316	export class AgentSdkGenExecutor implements GenExecutor {
   317	  private readonly sdkGenerate: SdkGenerate;
   318	  private readonly readNext: (rid: string) => Promise<NextAction>;
   319	  constructor(deps: AgentSdkDeps = {}) {
   320	    this.sdkGenerate =
   321	      deps.sdkGenerate ??
   322	      (() => {
   323	        throw new Error(
   324	          "AgentSdkGenExecutor: S-1(Agent SDK 세션 워커)가 배선되지 않았습니다 — sdkGenerate 를 주입하거나 C2 브리지를 쓰세요.",
   325	        );
   326	      });
   327	    this.readNext = deps.readNext ?? defaultReadNextAction;
   328	  }
   329	  async execute(run_id: string, stage: string): Promise<void> {
   330	    assertGenArgs(run_id, stage);
   331	    // 이미 전이돼 있으면(중복) 즉시 반환.
   332	    if (this.transitioned(await this.readNext(run_id), stage)) return;
   333	    await this.sdkGenerate(run_id, stage); // Agent SDK insession 워커: 산출물 작성 + run-stage(insession) 전이.
   334	    // 완료 계약(브리지와 동일): 세션 워커가 다 했으면 요청 stage 가 더 이상 현재 생성 대상이 아니어야 한다.
   335	    if (!this.transitioned(await this.readNext(run_id), stage)) {
   336	      throw new Error(`AgentSdk 생성 후 전이 미확인(run=${run_id}, stage=${stage}) — 세션 워커가 전이시키지 못했습니다.`);
   337	    }
   338	  }
   339	  /** 브리지와 동일 판정(SSoT = job-protocol.isGenerateTurn). */
   340	  private transitioned(na: NextAction, requestedStage: string): boolean {
   341	    return !isGenerateTurn(na, requestedStage);
   342	  }
   343	}
   344	
   345	// ── 선택기 ─────────────────────────────────────────────────────────────────────
   346	export interface SelectGenDeps {
   347	  /** 오프라인 판정(기본 config.isOffline). */
   348	  offline?: () => boolean;
   349	  /** S-1 무인화 채택 플래그(기본 config.genUnmannedS1 = env CHAT_GEN_UNMANNED_S1). */
   350	  unmannedS1?: () => boolean;
   351	  /** Agent SDK 생성 호출(있고 S-1 채택 시에만 AgentSdk 를 고른다). 미주입=S-1 미배선. */
   352	  sdkGenerate?: SdkGenerate;
   353	}
   354	
   355	/**
