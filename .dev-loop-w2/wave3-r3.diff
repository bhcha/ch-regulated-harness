+
+  return new Promise<SuperviseResult>((resolve) => {
+    let settled = false;
+    let termSent = false;
+    let killSent = false;
+    const cancels: Array<() => void> = [];
+
+    const settle = (r: SuperviseResult): void => {
+      if (settled) return;
+      settled = true;
+      for (const cancel of cancels) cancel();
+      // 감독 종료 — 레지스트리에서 이 세션 그룹을 뗀다(더는 종료 전파·하트비트의 대상이 아니다).
