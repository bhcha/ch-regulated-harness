+/**
+ * cli-session-runner.ts — 무인 잡 1건의 **수명주기**를 도는 API(`runJobSession`). W4 데몬이 supervisor 안에서 부른다.
+ *
+ * 한 잡 = 한 단계를 무인 생성하는 실 `claude` 세션을 띄워 산출물을 쓰게 하고, 세션이 스스로 insession 전이까지
+ *   마치게 한다. 이 모듈은 그 조립·순서·백스톱만 소유한다 — **큐를 만지지 않고(성공/실패 처분은 데몬 몫)** core 를
+ *   직접 호출하지도 않는다(주/복구 세션은 **언제나 supervisor 가 spawn** 한다 · 잠긴 결정 4). 여기가 하는 일은:
+ *
+ *   조립 → 스폰(supervisor) → 전이 확인(next-action) → 복구 백스톱 → **결과 보고**(RunJobResult).
+ *
+ * 순서(계획 부록A-9/A-11 · W3):
+ *   ① readDeclaredDomain — state.json 에서 도메인 한 필드(팩 선택 키). **스폰 전** fail-closed(잘못된 팩 방지).
+ *   ② rewriteSkill      — SKILL.md 결정론 치환 → 프롬프트 + allow 규칙 + 전이 명령(손으로 짜지 않는다 · A-9 교훈).
+ *   ③ buildSessionPlan  — 부록A-9 '작동한 최소 구성'(argv·cwd·env·격리 settings) 한 덩이 조립.
+ *   ④ writeSettings     — 격리 CLAUDE_CONFIG_DIR/settings.json 기록(쓰기 deny — 이 모듈의 유일한 파일 쓰기).
+ *   ⑤ superviseSession  — supervisor 가 주 세션을 detached 로 띄우고 kill_at 스케줄로 마감을 강제. 세션 종료까지 대기.
+ *   ⑥ readNext          — 전이됐나? (isGenerateTurn == false = 전이 완료). 됐으면 성공(via=main).
+ *   ⑦ 복구 백스톱       — 전이 안 됐지만 **산출물이 있고** 복구 예산이 남으면, **전이 전용** 세션 1회(A-9 1차 실패
+ *      양상: 산출물은 썼는데 전이만 실패 → 그 한 줄만 다시 친다). 프롬프트·규칙은 **같은 전이 명령 문자열**에서 나온다
+ *      (결정론 · 프리앰블 교정이 아니다). 그래도 전이 안 되면 실패 보고(데몬이 failed/ 로 옮긴다 — 이 모듈은 보고만).
+ *
+ * ⚠ **이 모듈은 insession 마커를 스스로 지니지 않는다** — 마커는 실 CLI 가 자기 Bash 자식에 네이티브 주입한다(부록A-2).
+ * ⚠ **오프라인 유지(W3 DoD)**: 스폰·next-action·시계·파일쓰기·도메인읽기는 전부 주입 seam 뒤에 있다. W3 단위
+ *   테스트는 가짜 스폰/가짜 시계로 돈다 — **실 `claude` 세션은 여기서도 검증에서도 뜨지 않는다**(과금 게이트·라이브
+ *   스모크는 W5 몫). keyvisual 은 무인 대상이 아니므로(rewriteSkill 가 던진다) 여기서 **깨끗이 실패**한다(compose_error).
+ */
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import { dirname, join } from "node:path";
+
+import { sdkGenTimeout, sdkMaxTurns } from "../config.js";
+import { isGenerateTurn } from "../kernel/job-protocol.js";
+import { readNextAction } from "../kernel/contract-client.js";
+import type { NextAction } from "../types/contract.js";
+import { buildSessionPlan } from "./cli-session.js";
+import type { SessionPlan } from "./cli-session.js";
+import { readDeclaredDomain } from "./run-domain.js";
+import { rewriteSkill } from "./skill-rewrite.js";
+import {
+  type KillSchedule,
+  type SuperviseResult,
+  computeKillSchedule,
+  defaultSuperviseDeps,
+  hasSpawnRoom,
+  remainingBeforeKill,
+  superviseSession,
+} from "./supervisor.js";
+
+/**
+ * 복구 세션 예산 = 90초. 전이 안 됐지만 산출물이 있을 때, 전이 명령 한 줄만 다시 치는 짧은 세션에 남겨두는 최소 시간.
+ *   왜 90초: CLI 콜드스타트(수 초) + 전이 명령 ≤5턴(부록A-10 절대경로 전이 = 2턴·거부 0)에 넉넉한 상한이고, 잡
+ *   예산(기본 480초)에 견줘선 작다. TERM_MARGIN(30초)보다 커서 복구 세션도 우아한 종료 여유를 갖는다 — 남은 시간이
+ *   이보다 적으면 복구를 시작하지 않는다(시작하자마자 죽일 세션은 띄우지 않는다).
+ */
+export const RECOVERY_BUDGET_MS = 90_000;
+
+/** 복구 세션 턴 상한 = 5. 전이 명령 한 줄이면 끝나야 하므로 작게(폭주 방지). 주 세션(기본 50)과 다르다. */
+export const RECOVERY_MAX_TURNS = 5;
+
+/**
+ * 복구 세션 도구 표면 = **`Bash` 하나**(Finding 4). 복구는 '전이 명령 한 줄만 실행하는' 최소 세션이라 그 한 줄
+ *   (`Bash(<전이명령>)` allow 규칙)에 필요한 건 Bash 뿐이다 — Write/Edit/Read/Glob/Grep 은 불필요하다.
+ *
+ * ⚠ **왜 프롬프트가 아니라 도구 목록에서 빼는가**: 복구 플랜은 주 세션과 같은 `buildSessionPlan()` 으로 조립돼
+ *   `--permission-mode acceptEdits` 를 물려받는데, 그 아래선 cwd(= 런 디렉터리) 안 파일 작성이 **자동 승인**된다.
+ *   즉 `--tools` 에 Write/Edit 가 남아 있으면 복구 모델이 산출물을 덮어써도 게이트가 막지 못한다. 프롬프트의
+ *   "쓰지 마세요"는 경계가 아니다(잠긴 결정 2 — 프롬프트를 신뢰 경계로 쓰지 않는다). `--tools` 에서 아예 빼면
+ *   그 도구 자체가 실행 대상이 아니게 된다(cli-session 의 도구 표면 계약·NL 파서의 `--tools ""` 와 같은 1차 경계).
+ */
+export const RECOVERY_SESSION_TOOLS = "Bash";
+
+/** 실패 사유 — 데몬이 사람에게 할 말과 큐 처분(failed/·drop)을 가른다. 이 모듈은 처분하지 않고 **분류만** 한다. */
+export type RunJobFailReason =
+  | "compose_error" /** 도메인/스킬/치환 조립 실패(keyvisual·미지원 단계 포함) — 스폰 전 fail-closed */
+  | "unexpected_commands" /** SKILL.md 펜스에 예상 밖 명령(스킬-게이트 드리프트) — 호출부 거부 계약(부록A-11 3번) */
+  | "refused_insufficient_time" /** 주 세션 스폰 여유 부족(남은 시간 < TERM_MARGIN) */
+  | "spawn_failed" /** 세션 스폰이 pid 를 못 냄(claude 부재·EACCES) — 실행된 그룹 없음(HIGH#1) */
+  | "output_cap" /** 세션 출력이 상한(32MiB) 초과 → cap-kill = 실패(전이 관측과 무관 · MEDIUM#4) */
+  | "reap_failed" /** 주 세션 마감 강제 실패(kill_at 시점 그룹 생존) — 마감 기계 자체가 실패 */
+  | "next_action_unreadable" /** next-action 조회 실패 — 전이 여부 판단 불가 */
+  | "not_transitioned_no_artifact" /** 전이 안 됨 + 산출물 없음 → 복구 무의미(주 세션이 아무것도 못 씀) */
+  | "recovery_budget_insufficient" /** 전이 안 됨 + 산출물 있음이나 복구할 시간 부족 */
+  | "recovery_compose_error" /** 복구 세션 조립·격리 settings 기록 실패(디스크 오류 등) — 복구가 뜨지도 못함(MEDIUM#3) */
+  | "recovery_reap_failed" /** 복구 세션 마감 강제 실패 */
+  | "still_not_transitioned"; /** 복구 세션까지 돌렸는데 여전히 전이 안 됨 */
+
+/** 잡 1건 처리 결과 — 성공(어느 세션이 전이시켰나) 또는 실패(분류 + 진단). 큐 처분은 데몬 몫. */
+export type RunJobResult =
+  | { ok: true; via: "main" | "recovery"; detail: string }
+  | { ok: false; reason: RunJobFailReason; detail: string };
+
+export interface RunJobSessionInput {
+  /** core(하네스) 체크아웃 절대경로. */
+  coreRoot: string;
+  /** 이 잡의 run_id. */
+  rid: string;
+  /** run-stage 인자(intake·brief · SUPPORTED_STAGES). */
+  stage: string;
+  /** 세션 기동(클레임) 시각 ms — kill_at 예산의 기준. */
+  claimedAtMs: number;
+  /** 잡 절대 마감 ms(잡 파일 expires_at → ms). kill_at = min(claimedAt+genTimeout, deadline). */
+  deadlineMs: number;
+  /** 워커가 이 잡용으로 만든 전용 빈 디렉터리(절대경로) = 격리 CLAUDE_CONFIG_DIR. 생성·정리는 데몬 몫. */
+  configDir: string;
+  /** 구독 인증 토큰(chat/.env 의 CLAUDE_CODE_OAUTH_TOKEN). 없으면 세션은 인증 실패로 죽는다(부록A-8). */
+  oauthToken?: string;
+  /** 위생 재구성 base(기본 process.env). */
+  baseEnv?: NodeJS.ProcessEnv;
+  /** 잡 wall-clock 예산 ms(기본 config.sdkGenTimeout()). 테스트가 kill_at 스케줄을 고정하려 override. */
+  genTimeoutMs?: number;
+  /** 세션 턴 상한(기본 config.sdkMaxTurns()). */
+  maxTurns?: number;
+}
+
+/** 주입 seam — 프로덕션 기본은 실 파일/실 next-action/실 supervisor. 테스트는 전부 가짜(오프라인·결정적). */
+export interface RunJobSessionDeps {
+  /** 현재 절대 시각 ms(기본 Date.now). refuse·복구 예산 판정에 쓴다 — supervisor 시계와 같은 벽시계를 본다. */
+  now?: () => number;
+  /** 도메인 읽기(기본 readDeclaredDomain — state.json 한 필드). */
+  readDomain?: (coreRoot: string, rid: string) => Promise<string>;
+  /** SKILL.md 원문 읽기(기본 core/skills/<stage>/SKILL.md). */
+  readSkillMd?: (coreRoot: string, stage: string) => Promise<string>;
+  /** 격리 settings.json 쓰기(기본 mkdir -p + writeFile). 이 모듈의 유일한 파일 쓰기. */
+  writeSettings?: (path: string, content: string) => Promise<void>;
+  /** **스폰 seam** — supervisor 가 세션을 띄우고 kill_at 스케줄을 강제한다(기본 = superviseSession + 실 seam). */
+  supervise?: (plan: SessionPlan, schedule: KillSchedule) => Promise<SuperviseResult>;
+  /** next-action 조회(기본 readNextAction · 읽기 전용). 전이 확인의 단일 채널. */
+  readNext?: (rid: string) => Promise<NextAction>;
+  /** 산출물 존재 확인(복구 백스톱 게이트 · 기본 = 단계 산출 디렉터리 비어있지 않음). */
+  artifactPresent?: (coreRoot: string, rid: string, stage: string) => Promise<boolean>;
+}
+
+// ── 프로덕션 기본 seam ─────────────────────────────────────────────────────────
+
+async function defaultReadSkillMd(coreRoot: string, stage: string): Promise<string> {
+  return readFile(join(coreRoot, "skills", stage, "SKILL.md"), "utf8");
+}
+
+async function defaultWriteSettings(path: string, content: string): Promise<void> {
+  await mkdir(dirname(path), { recursive: true });
+  await writeFile(path, content, "utf8");
+}
+
+/**
+ * 무인 지원 단계 → core 페이즈 산출 디렉터리(AGENTS 3번 절 실측 배치). **core 레이아웃에 얕게 결합**하므로
+ *   지원 단계(intake·brief)만 담는다 — 다른 단계는 conservative 하게 '없음'(복구 안 함). ⚠ W4/W5 에서 실 배치로
+ *   확정(드리프트 시 복구가 조용히 안 도는 방향이라 안전). 테스트는 이 기본을 안 타고 artifactPresent 를 주입한다.
+ */
+const STAGE_ARTIFACT_DIR: Record<string, string> = {
+  intake: "00a-intake",
+  brief: "01-brief",
+};
+
+async function defaultArtifactPresent(coreRoot: string, rid: string, stage: string): Promise<boolean> {
+  const sub = STAGE_ARTIFACT_DIR[stage];
+  if (sub === undefined) return false;
+  const { readdir } = await import("node:fs/promises");
+  try {
+    const names = await readdir(join(coreRoot, "runs", rid, sub));
+    return names.some((n) => !n.startsWith(".")); // 숨김 아닌 파일이 하나라도 있으면 산출물 있음.
+  } catch {
+    return false; // 디렉터리 부재·읽기 실패 = 산출물 없음(conservative — 복구 안 함).
+  }
+}
+
+const defaultSupervise = (plan: SessionPlan, schedule: KillSchedule): Promise<SuperviseResult> =>
+  superviseSession(plan, schedule, defaultSuperviseDeps);
+
+/**
+ * 복구 세션 프롬프트(전이 전용) — **고정 최소 템플릿 + 전이 명령 verbatim**. 프리앰블로 생성 명령 형태를
+ *   교정하려는 게 아니다(부록A-10 이 금지한 것): 여기선 '정확히 이 한 줄만 쳐라'라고 말하고, 그 한 줄이 곧 **유일한
+ *   allow 규칙**이라 모델이 다른 걸 치면 fail-closed 된다. 프롬프트의 변수는 transitionCommand 하나뿐(결정론).
+ */
+function recoveryPrompt(transitionCommand: string): string {
+  return [
+    "# 복구 세션(전이 전용)",
+    "",
+    "이 단계의 산출물은 이미 작성됐고, 상태 전이 호출만 실패했습니다.",
+    "아래 명령을 **정확히 그대로** 한 번만 실행하세요. 경로·인자·환경변수 접두를 바꾸거나 다른 명령을 덧붙이지 마세요:",
+    "",
+    "```bash",
+    transitionCommand,
+    "```",
+    "",
+    "이 명령 외에는 파일을 읽거나 쓰지 말고, 아무 것도 하지 마세요. 전이가 끝나면 종료하세요.",
+  ].join("\n");
+}
+
+/**
+ * 복구 플랜 argv 의 `--tools` 값을 복구 전용 최소 집합(RECOVERY_SESSION_TOOLS)으로 좁힌다(Finding 4).
+ *
+ * ⚠ **왜 조립부(cli-session.ts)가 아니라 여기서 하는가**: 이상적 seam 은 `buildSessionPlan` 의 `tools` 파라미터지만
+ *   cli-session.ts 는 이 작업의 소유 밖이라 고칠 수 없다(고쳐야만 가능하면 중단·보고가 규칙). buildSessionPlan 이
+ *   `--tools` 를 고정 리터럴로만 실으므로, 복구 경로에서 그 **한 토큰만** 결정론적으로 치환한다 — 프롬프트가 아니라
+ *   argv(조립 산물) 수준의 경계 조정이라 잠긴 결정 2 를 지킨다. `--tools` 가 없으면 조립 계약이 바뀐 것이니 fail-closed.
+ */
+function restrictRecoveryTools(argv: string[]): string[] {
+  const i = argv.indexOf("--tools");
+  if (i < 0 || i + 1 >= argv.length) {
+    throw new Error(
+      "복구 플랜 argv 에 --tools 가 없습니다 — cli-session 의 도구 표면 조립 계약이 바뀌었습니다(복구 최소화 불가).",
+    );
+  }
+  const out = argv.slice();
+  out[i + 1] = RECOVERY_SESSION_TOOLS; // 그 한 토큰만 최소 집합으로 치환(나머지 플래그·순서 불변).
+  return out;
+}
+
+/**
+ * 잡 1건의 무인 세션 수명주기를 돈다. **큐를 만지지 않고** 결과만 보고한다(성공/실패 처분은 데몬 몫).
+ *
+ * @throws 던지지 않는다 — 조립 예외(도메인/스킬/치환)는 `compose_error` 결과로 환원해 **깨끗이 실패**한다
+ *   (keyvisual 같은 미지원 단계도 여기로 떨어진다). 데몬이 결과만 보고 큐를 처분할 수 있게 예외를 새로 흘리지 않는다.
+ */
+export async function runJobSession(
+  input: RunJobSessionInput,
+  deps: RunJobSessionDeps = {},
+): Promise<RunJobResult> {
+  const now = deps.now ?? Date.now;
+  const readDomain = deps.readDomain ?? readDeclaredDomain;
+  const readSkillMd = deps.readSkillMd ?? defaultReadSkillMd;
+  const writeSettings = deps.writeSettings ?? defaultWriteSettings;
+  const supervise = deps.supervise ?? defaultSupervise;
+  const readNext = deps.readNext ?? readNextAction;
+  const artifactPresent = deps.artifactPresent ?? defaultArtifactPresent;
+
+  const genTimeoutMs = input.genTimeoutMs ?? sdkGenTimeout();
+  const maxTurns = input.maxTurns ?? sdkMaxTurns();
+  const baseEnv = input.baseEnv ?? process.env;
+
+  // ── 조립(①~④) — 어느 단계든 던지면 compose_error 로 깨끗이 실패(스폰 전이므로 부작용 0) ──
+  let mainPlan: SessionPlan;
+  let transitionCommand: string;
+  let domain: string; // 복구 플랜에서 재사용(이미 검증된 값 — 재조회 불필요).
+  try {
+    domain = await readDomain(input.coreRoot, input.rid); // ① 스폰 전 fail-closed(잘못된 팩 방지)
+    const skillMd = await readSkillMd(input.coreRoot, input.stage);
+    const rewritten = rewriteSkill({ skillMd, stage: input.stage, rid: input.rid, coreRoot: input.coreRoot }); // ②
+    // 펜스에 예상 밖 명령이 있으면 **호출부가 거부한다**(부록A-11 3번 · 조용히 규칙으로 승격하지 않는다).
+    if (rewritten.unexpectedFencedCommands.length > 0) {
+      return {
+        ok: false,
+        reason: "unexpected_commands",
+        detail: `SKILL.md(stage=${input.stage}) 펜스에 예상 밖 명령: ${rewritten.unexpectedFencedCommands.join(" · ")}`,
+      };
+    }
+    transitionCommand = rewritten.transitionCommand;
+    mainPlan = buildSessionPlan({
+      // ③
+      coreRoot: input.coreRoot,
+      rid: input.rid,
+      domain,
+      prompt: rewritten.prompt,
+      allowRules: rewritten.allowRules,
+      maxTurns,
+      configDir: input.configDir,
+      ...(input.oauthToken !== undefined ? { oauthToken: input.oauthToken } : {}),
+      baseEnv,
+    });
+    await writeSettings(mainPlan.settingsPath, mainPlan.settingsJson); // ④ 격리 settings(쓰기 deny)
+  } catch (e) {
+    const msg = e instanceof Error ? e.message : String(e);
+    return { ok: false, reason: "compose_error", detail: msg };
+  }
+
+  const schedule = computeKillSchedule({
+    claimedAtMs: input.claimedAtMs,
+    genTimeoutMs,
+    deadlineMs: input.deadlineMs,
+  });
+
+  // 즉시 죽여야 할 세션은 애초에 띄우지 않는다(스폰 결정 시점 여유 부족).
+  if (!hasSpawnRoom(schedule, now())) {
+    return {
+      ok: false,
+      reason: "refused_insufficient_time",
+      detail: `주 세션 스폰 여유 부족(남은 ${remainingBeforeKill(schedule, now())}ms)`,
+    };
+  }
+
+  // ⑤ 주 세션 — supervisor 가 spawn·마감강제. 세션 종료(자가/강제)까지 대기.
+  const mainResult = await supervise(mainPlan, schedule);
+  if (mainResult.outcome === "reap_failed") {
+    // 마감 기계 자체가 실패했다(그룹 생존). '결국 종료'가 아니라 지금 실패다 — 복구를 시도하지 않는다.
+    return { ok: false, reason: "reap_failed", detail: mainResult.detail };
+  }
+  if (mainResult.outcome === "refused") {
+    return { ok: false, reason: "refused_insufficient_time", detail: mainResult.detail };
+  }
+  if (mainResult.outcome === "spawn_failed") {
+    // 세션이 뜨지도 못했다(pid 없음) — 전이·산출물 확인은 무의미하므로 곧장 실패로 처분(HIGH#1).
+    return { ok: false, reason: "spawn_failed", detail: mainResult.detail };
+  }
+  if (mainResult.outcome === "output_cap") {
+    // 출력 상한 초과 cap-kill = 실패다. **전이 관측 전에** 끊는다 — 폭주 출력으로 죽은 세션은 전이가 보여도
+    //   성공이 아니다(전이 확인으로 내려가면 우연한 전이를 ok:true 로 오판한다 · MEDIUM#4).
+    return { ok: false, reason: "output_cap", detail: mainResult.detail };
+  }
+
+  // ⑥ 전이됐나 — next-action 이 단일 채널. isGenerateTurn == false = 그 단계 생성 차례가 아니다 = 전이 완료.
+  let na: NextAction;
+  try {
+    na = await readNext(input.rid);
+  } catch (e) {
+    const msg = e instanceof Error ? e.message : String(e);
+    return { ok: false, reason: "next_action_unreadable", detail: `주 세션 후 next-action 조회 실패: ${msg}` };
+  }
+  if (!isGenerateTurn(na, input.stage)) {
+    return { ok: true, via: "main", detail: "주 세션이 전이까지 완료" };
+  }
+
+  // ⑦ 복구 백스톱 — 전이 안 됨. 산출물이 있고 예산이 남을 때만 전이 전용 세션 1회.
+  const artifact = await artifactPresent(input.coreRoot, input.rid, input.stage);
+  if (!artifact) {
+    return {
+      ok: false,
+      reason: "not_transitioned_no_artifact",
+      detail: "주 세션이 전이도 산출물 작성도 못 함 — 복구 무의미",
+    };
+  }
+  if (remainingBeforeKill(schedule, now()) < RECOVERY_BUDGET_MS) {
+    return {
+      ok: false,
+      reason: "recovery_budget_insufficient",
+      detail: `산출물은 있으나 복구 예산 부족(남은 ${remainingBeforeKill(schedule, now())}ms < ${RECOVERY_BUDGET_MS}ms)`,
+    };
+  }
+
+  // 복구 플랜 조립 + 격리 settings 기록 — **초기 조립(①~④)과 같은 구조적-결과 보증 아래** 둔다(MEDIUM#3).
+  //   이 세 단계(buildSessionPlan·restrictRecoveryTools·writeSettings)는 던질 수 있다(플랜 검증 실패 · 디스크
+  //   오류 ENOSPC/EACCES). try/catch 밖에 두면 그 rejection 이 `void main()` 까지 새어 supervisor 가 **구조적
+  //   RunJobResult 없이** 죽고, W4 데몬이 실패를 분류하지 못한다. runJobSession 의 계약은 '던지지 않고 늘 결과를
+  //   보고한다'이므로, 복구가 뜨지도 못하면 recovery_compose_error(실패)로 환원한다.
+  let recoveryPlan: SessionPlan;
+  try {
+    // 프롬프트·규칙 모두 **같은 전이 명령 문자열**에서. allow 규칙은 그 전이 한 줄뿐(최소).
+    const recoveryPlanBase = buildSessionPlan({
+      coreRoot: input.coreRoot,
+      rid: input.rid,
+      domain, // 조립 단계에서 검증된 도메인 재사용(재조회 불필요)
+      prompt: recoveryPrompt(transitionCommand),
+      allowRules: [`Bash(${transitionCommand})`],
+      maxTurns: RECOVERY_MAX_TURNS,
+      configDir: input.configDir,
+      ...(input.oauthToken !== undefined ? { oauthToken: input.oauthToken } : {}),
+      baseEnv,
+    });
+    // 도구 표면을 복구 최소 집합(Bash 하나)으로 좁힌다 — acceptEdits 자동승인 하에서도 산출물 Write/Edit 불가(Finding 4).
+    recoveryPlan = {
+      ...recoveryPlanBase,
+      argv: restrictRecoveryTools(recoveryPlanBase.argv),
+    };
+    await writeSettings(recoveryPlan.settingsPath, recoveryPlan.settingsJson); // 같은 내용(멱등) — 격리 settings 보증.
+  } catch (e) {
+    const msg = e instanceof Error ? e.message : String(e);
+    return { ok: false, reason: "recovery_compose_error", detail: `복구 세션 조립·격리 settings 기록 실패: ${msg}` };
+  }
+
+  // 복구도 **같은 kill_at**(잡 스코프) 아래 — 주+복구를 합쳐 잡 하나의 예산을 넘지 않는다.
+  const recResult = await supervise(recoveryPlan, schedule);
+  if (recResult.outcome === "reap_failed") {
+    return { ok: false, reason: "recovery_reap_failed", detail: recResult.detail };
+  }
+  if (recResult.outcome === "spawn_failed") {
+    return { ok: false, reason: "spawn_failed", detail: recResult.detail };
+  }
+  if (recResult.outcome === "output_cap") {
+    return { ok: false, reason: "output_cap", detail: recResult.detail };
+  }
+
+  let na2: NextAction;
+  try {
+    na2 = await readNext(input.rid);
+  } catch (e) {
+    const msg = e instanceof Error ? e.message : String(e);
+    return { ok: false, reason: "next_action_unreadable", detail: `복구 세션 후 next-action 조회 실패: ${msg}` };
+  }
+  if (!isGenerateTurn(na2, input.stage)) {
+    return { ok: true, via: "recovery", detail: "복구 세션이 전이 완료" };
+  }
+  return { ok: false, reason: "still_not_transitioned", detail: "복구 세션까지 돌렸으나 여전히 전이 안 됨" };
+}
diff --git a/chat/src/worker/run-domain.ts b/chat/src/worker/run-domain.ts
new file mode 100644
index 0000000..29c35cb
--- /dev/null
+++ b/chat/src/worker/run-domain.ts
@@ -0,0 +1,90 @@
+/**
+ * run-domain.ts — 런의 선언 규제도메인을 state.json 에서 **읽기만** 하는 게이트웨이의 유일한 직접 state 읽기.
+ *
+ * 무인 세션 조립(`cli-session.buildAddDirs`)은 `packs/<도메인>` 을 열려면 그 런에 **사람이 선언한 규제도메인**을
+ *   알아야 한다. 그 값의 단일 출처는 core 의 `runs/<rid>/state.json`(사람이 `new-run.sh` 로 선언 → normalize_domain
+ *   이 레지스트리로 강제 · state 의 유일한 쓰기 주체). next-action 계약에는 그 필드가 노출되지 않으므로, 도메인만은
+ *   state.json 을 **직접** 읽는다.
+ *
+ * ⚠ **AGENTS 1번 규칙과 충돌하지 않는다** — 규칙은 "state.json 은 오직 `scripts/*.sh` 만 **쓴다**"이고, 여기서 하는
+ *   일은 **읽기뿐**이다(파일을 열어 한 필드만 뽑고 닫는다 · 쓰기·잠금·이동 없음). 그럼에도 이건 게이트웨이가
+ *   state.json 을 직접 만지는 **처음이자 유일한** 자리라, 다음 두 규율을 못 박는다:
+ *     ① **정확히 한 필드만 소비한다**(`product.regulatory_domain`). 여기서 state 의 다른 필드(phase·gate·status…)를
+ *        읽기 시작하면 next-action(그 모든 것의 단일 채널)과 갈라진 두 번째 진실이 생긴다 — 도메인 하나만 예외다.
+ *     ② **읽기 실패·부재·불안전값은 전부 throw**(fail-closed). 이 값은 곧 `packs/<도메인>` **경로**와 add-dir 권한
+ *        규칙 문자열에 박히므로, 검증 안 된 값이 새면 세션이 엉뚱한 팩을 열거나(경로 주입) 규칙이 조용히 깨진다.
+ *        조용히 cosmetic 으로 폴백하지 않는 것은 core 자신의 자세이기도 하다(AGENTS 8번 절: "미선언·미등록 도메인은
+ *        cosmetic 으로 조용히 폴백하지 않고 fail-closed"). 스폰 **전에** 실패해야 잘못된 팩으로 세션이 뜨지 않는다.
+ *
+ * 순수하진 않지만(파일을 읽는다) **읽기 전용**이라 상태를 변이하지 않는다 — contract-client(next-action 읽기)와 동급이다.
+ */
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { isSafeRunId } from "../config.js";
+
+/**
+ * 규제도메인 형식 — `core/harness/state.schema.json` 의 `regulatory_domain` 패턴과 **같은 규칙**의 의도적 미러다
+ *   (`cli-session.ts` 의 `DOMAIN_PATTERN` 과도 같다 — worker 는 형제 모듈을 서로 import 하지 않으므로 규칙 리터럴을
+ *   공유하는 대신 복제하고, 어긋나면 회귀 테스트가 깨운다). 여기서 검사하는 건 '형식'이지 '등록 여부'가 아니다
+ *   (등록 강제는 core 의 new-run 이 팩 레지스트리로 한다). 검사하는 이유는 하나 — 검증 안 된 문자열이 팩 경로와
+ *   권한 규칙에 그대로 박히는 것을 스폰 전에 끊기 위해서다.
+ */
+export const DECLARED_DOMAIN_PATTERN = /^[a-z][a-z0-9_]*$/;
+
+/** state.json 의 상대 위치(런 디렉터리 기준) 및 도메인이 사는 자리. 경로·필드 이름을 한 곳에 못 박는다. */
+const STATE_FILENAME = "state.json";
+
+/**
+ * `<coreRoot>/runs/<rid>/state.json` 에서 사람이 선언한 규제도메인 한 필드만 읽어 돌려준다(읽기 전용).
+ *
+ * @param coreRoot core(하네스) 체크아웃 절대경로(config.harnessRoot()).
+ * @param rid      런 id. 경로 세그먼트가 되므로 안전 토큰만 허용(그 외 = throw).
+ * @returns `product.regulatory_domain`(형식 검증 통과분).
+ * @throws rid 불안전 · 파일 없음/읽기 실패 · JSON 손상 · 도메인 부재/비문자열/형식 위반 — 전부 fail-closed(스폰 전에 멈춘다).
+ */
+export async function readDeclaredDomain(coreRoot: string, rid: string): Promise<string> {
+  if (!isSafeRunId(rid)) {
+    throw new Error(
+      `run-domain: run_id 가 안전한 토큰이 아닙니다: '${rid}' — 이 값은 state.json 경로 세그먼트가 되므로, ` +
+        "검증 전에 파일을 열지 않습니다(경로 탈출 차단).",
+    );
+  }
+  const statePath = join(coreRoot, "runs", rid, STATE_FILENAME);
+
+  // 읽기 실패(부재·권한·IO)는 삼키지 않고 그대로 올린다 — '도메인을 못 읽었다'를 조용한 기본값으로 덮으면
+  //   세션이 엉뚱한 팩(또는 아무 팩도)으로 뜬다. 스폰 전에 시끄럽게 실패하는 편이 안전하다.
+  let text: string;
+  try {
+    text = await readFile(statePath, "utf8");
+  } catch (e) {
+    const msg = e instanceof Error ? e.message : String(e);
+    throw new Error(`run-domain: state.json 을 읽을 수 없습니다(rid=${rid}, 경로=${statePath}): ${msg}`);
+  }
+
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(text);
+  } catch (e) {
+    const msg = e instanceof Error ? e.message : String(e);
+    throw new Error(`run-domain: state.json JSON 파싱 실패(rid=${rid}): ${msg}`);
+  }
+  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
+    throw new Error(`run-domain: state.json 이 객체가 아닙니다(rid=${rid}).`);
+  }
+
+  // 도메인은 `product.regulatory_domain` 에 있다(state.schema.json 실측). product 부재·비객체도 fail-closed.
+  const product = (parsed as Record<string, unknown>).product;
+  if (product === null || typeof product !== "object" || Array.isArray(product)) {
+    throw new Error(`run-domain: state.json 에 product 객체가 없습니다(rid=${rid}) — 규제도메인을 읽을 수 없습니다.`);
+  }
+  const domain = (product as Record<string, unknown>).regulatory_domain;
+
+  // 부재·비문자열·형식 위반은 전부 throw — 조용한 cosmetic 폴백 금지(AGENTS 8번 절 · 위 모듈 주석 ②).
+  if (typeof domain !== "string" || !DECLARED_DOMAIN_PATTERN.test(domain)) {
+    throw new Error(
+      `run-domain: 규제도메인이 선언되지 않았거나 형식이 올바르지 않습니다(rid=${rid}, 값=${JSON.stringify(domain)}). ` +
+        "무인 세션은 사람이 선언한 도메인으로만 팩을 엽니다 — 미선언은 조용히 cosmetic 으로 폴백하지 않고 멈춥니다.",
+    );
+  }
+  return domain;
+}
diff --git a/chat/src/worker/supervisor.ts b/chat/src/worker/supervisor.ts
new file mode 100644
index 0000000..acce400
--- /dev/null
+++ b/chat/src/worker/supervisor.ts
@@ -0,0 +1,674 @@
+/**
+ * supervisor.ts — 무인 세션 1건이 **마감을 넘겨 살아남지 못하도록** 강제하는 프로세스그룹 감독(잠긴 결정 4).
+ *
+ * 토폴로지(계획 잠긴 결정 4 · 부록A-7 4번): 데몬(W4)이 이 파일을 **detached 로** 띄운다 → supervisor 는 자기
+ *   프로세스그룹의 리더가 된다(Node 엔 '기존 PGID 에 합류'하는 API 가 없어 스스로 리더가 되는 길뿐이다). 그리고
+ *   이 supervisor 가 **주 세션과 복구 세션을 직접 spawn** 한다. 각 세션은 다시 **detached**(자기 하위 그룹의 리더)로
+ *   띄운다 — 그래야 supervisor 가 `kill(-세션PGID)` 로 세션 + 그 Bash 손자들을 통째로 회수하면서도 **자기 자신은
+ *   살아남아** kill_at 시점의 소멸을 확인·보고할 수 있다(같은 그룹이면 자기까지 죽여 확인 주체가 사라진다).
+ *
+ *   ⚠ **정직한 정정 + W3↔W4 회수 계약(잠긴 결정 4 의 kill 메커니즘 변경 — 사람 승인 대상)**: 계획 산문은 "세션이
+ *     supervisor 의 그룹을 **상속**한다(→ `kill(-supervisorPGID)` 한 방에 트리 전체 회수)"고 적었지만 **틀렸다**.
+ *     회수 검증 문구가 `kill(-pgid, 0) → ESRCH` 인 이상 검증 주체(supervisor)는 세션 그룹 **밖**에 있어야 하고
+ *     (그룹 안이면 자기 때문에 영영 ESRCH 가 안 난다), 곧 **세션은 각자 detached 하위 그룹**이다(그래야 Bash 손자까지
+ *     닿는 그룹 kill·회수 검증이 성립한다). 그 귀결: 음수-PID 신호인 `kill(-supervisorPID)` 는 supervisor 의 PGID
+ *     **하나만** 겨냥하므로 **세션 그룹(과 그 Bash 손자)엔 닿지 않는다** — 데몬이 supervisor 만 죽이면 세션은 마감
+ *     타이머 주인을 잃고 **살아남는다**(진짜 마감 구멍). "`kill(-supervisorPID)` 가 트리 전체를 회수한다"는 서술은
+ *     거짓이므로 쓰지 않는다. 구멍은 두 층으로 닫는다:
+ *       ① **종료 전파**: supervisor 가 SIGTERM/SIGINT/정상 exit 를 받으면, 살아있는 세션 하위 그룹을 빠져나가기
+ *          **전에** 전부 `kill(-sessionPgid, SIGKILL)` 한다(installSupervisorTerminationHandlers). 데몬이 supervisor 를
+ *          **우아하게(SIGTERM)** 끝낼 때 이게 돈다.
+ *       ② **live pgid 노출**: 살아있는 세션 pgid 를 레지스트리(SessionGroupRegistry)로 모으고 main 이 하트비트에 실어,
+ *          W4 데몬이 `kill(-sessionPgid)` 로 세션 그룹을 **직접** 겨냥할 수 있게 한다.
+ *     **W3↔W4 계약(명시)**: detached 세션은 유지된다. 데몬은 잡을 회수할 때 **(a) supervisor 에 SIGTERM 을 먼저
+ *       보내 종료 전파(①)가 돌게 하거나, (b) 노출된 세션 pgid 를 직접 `kill(-sessionPgid)`** 해야 한다. **맨몸
+ *       `kill(-supervisorPID, SIGKILL)` 하나로는 부족하다** — SIGKILL 은 트랩 불가라 ①이 안 돌고, 세션 그룹은 그
+ *       신호가 닿지 않는 별개 PGID 다. 이는 잠긴 결정 4 의 "kill_at 도달 시 데몬이 `kill(-supervisorPid)`"(계획
+ *       116·280행)의 **kill 메커니즘을 바꾸는 재합의**이며 사람 승인 대상이다(Wave 1 리스 변경과 같은 격 — 코드가
+ *       계약을 명시하되 확정은 사람이 한다).
+ *     ⚠ 남는 W5 카나리: 전파 SIGKILL 이 실제 detached 하위 그룹을 소멸시키는지·Bash 손자까지 닿는지는 실세션에서만
+ *       확증된다(단위 테스트는 '무엇을 겨냥해 신호를 보냈는가'를 고정할 뿐 '그 신호가 무엇을 죽였는가'는 아니다).
+ *
+ * 마감 강제 = **3단 에스컬레이션**(전부 kill_at **이전**에 끝난다 — 마감을 넘겨 신호를 보내지 않는다):
+ *   ① `kill_at - TERM_MARGIN` 에 SIGTERM(우아한 종료 · 산출물 flush·전이 마무리 여유)
+ *   ② `kill_at - KILL_MARGIN` 에 SIGKILL(강제 종료)
+ *   ③ `kill_at` 에 **소멸 확인**(`kill(-pgid, 0)` → ESRCH). 살아 있으면 `reap_failed` — 요구는 '결국 종료'가 아니라
+ *      **kill_at 시점 소멸 확인**이다(계획 7절 "결국 종료가 아님"). 결국 죽더라도 kill_at 에 살아 있으면 실패다.
+ *
+ * ⚠ **밀린/앞당겨진 타이머 내성**: 알람은 상대 지연이 아니라 **절대 시계**로 판정하고 **자기 재무장**한다.
+ *   · 늦게 깨어남(랩톱 슬립·SIGSTOP): `enforce()` 가 `now()` 로 due 페이즈를 다시 계산해 **밀린 단계를 즉시
+ *     따라잡는다**(TERM 알람이 이미 kill_at 이후에 깨어나면 그 자리에서 KILL+회수확인까지 수행).
+ *   · 일찍 깨어남(역행 시계·`setTimeout` 최대지연 클램프): 알람이 목표 **전에** 깨어나면 스펜트로 버리지 않고
+ *     `armNext()` 가 남은 절대 지연으로 **다시 건다**(Finding 3). 남은 지연이 setTimeout 상한을 넘으면 바운드
+ *     홉(ALARM_MAX_HOP_MS)으로 나눠 재무장한다 → 어떤 절대 시각도 클램프 즉시발화로 새지 않는다.
+ *   상대 지연에만 기대면 슬립엔 마감이 새고, 스펜트 원샷에만 기대면 조기발화에 회수기가 통째로 소실된다.
+ *
+ * ⚠ **리더 종료 ≠ 그룹 사멸**(Finding 2): 세션 리더의 파이프가 닫혀 `exited` 가 떠도, `nohup … &` 류 손자가 그룹에
+ *   남아있을 수 있다. 리더 종료를 그룹 사멸로 낙관해 알람을 다 취소하면 그 손자가 kill_at 을 넘겨 살아남는다. 그래서
+ *   자가 종료는 **그룹 소멸을 확인해야** 성공(exited/killed)으로 settle 하고, 그룹이 살아있으면 settle 하지 않고
+ *   회수 경로(TERM/KILL/kill_at reap)에 넘긴다 — kill_at 알람은 armNext 로 늘 유지되므로 행은 없다.
+ *
+ * 테스트 결정성: 시계·스폰·신호·생존확인은 전부 **주입 seam**이다(SuperviseDeps). 단위 테스트는 가짜 시계(setAlarm
+ *   을 기록만 하고 테스트가 수동으로 발화)와 가짜 세션(exited 를 테스트가 직접 resolve)으로 **실타이머·실슬립 없이**
+ *   스케줄을 못 박는다 — 회귀는 ms 안에 실패해야지 매달리면 안 된다(선행 라운드 교훈). 회수 알람이 kill_at 에 항상
+ *   settle 하므로, 세션이 영영 안 끝나는 가짜에서도 promise 는 kill_at 에 반드시 풀린다(행 없음).
+ */
+import { spawn, type SpawnOptions } from "node:child_process";
+import { renameSync, writeFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import type { SessionPlan } from "./cli-session.js";
+
+/**
+ * SIGTERM 유예 = 30초. kill_at 으로부터 이만큼 앞에서 우아한 종료를 시작한다.
+ *   왜 30초인가: SIGTERM 을 받은 세션(claude CLI + 그 Bash 손자들 + 진행 중이던 run-stage 전이)이 산출물을 flush 하고
+ *   깨끗이 빠져나올 시간이다. 실측(부록A-9)상 전이는 몇 턴 규모라 30초면 넉넉하고, 잡 기본 예산(480초)에 견줘선
+ *   충분히 작다. 더 짧으면 세션이 파일을 쓰는 중에 SIGKILL 이 떨어져 산출물이 깨지고(반쯤 쓰인 파일), 더 길면
+ *   아래 회수 확인 여유(KILL_MARGIN)를 갉아먹는다.
+ */
+export const TERM_MARGIN_MS = 30_000;
+
+/**
+ * SIGKILL 유예 = 10초. kill_at 으로부터 이만큼 앞에서 강제 종료한다 → kill_at 까지 남는 10초가 **회수 정착 창**이다.
+ *   왜 10초인가: SIGKILL 도 프로세스 **트리**엔 즉발이 아니다(좀비 수확·FS flush·커널의 그룹 해체). 10초를 두면
+ *   커널이 실제로 그룹을 헐어낸 **뒤에** `kill(-pgid,0)` 회수 확인을 하게 되어, kill_at 에 그룹이 살아 있으면 그건
+ *   '아직 죽는 중'인 레이스가 아니라 **진짜 회수 실패**다(reap_failed 를 신뢰할 수 있게 만든다).
+ *   TERM_MARGIN > KILL_MARGIN 이라 순서는 termAt < killSigAt < killAt 로 늘 마감 이전에 완결된다.
+ */
+export const KILL_MARGIN_MS = 10_000;
+
+/**
+ * 알람 1홉 최대 지연 = 2^31-1 ms(≈24.8일) — `setTimeout` 이 클램프 없이 받는 상한(초과하면 즉시 발화로 뭉개진다).
+ *   armNext 는 다음 임계까지 남은 절대 지연이 이보다 크면 **이만큼만** 걸고, 그 알람이 깨면 다시 이어 건다(바운드 홉).
+ *   그래서 어떤 절대 시각도 클램프 조기발화로 새지 않는다(Finding 3). 잡 예산은 이보다 훨씬 짧아 실무에선 1홉이면
+ *   끝나지만, 잘못된 큰 예산·역행 시계·랩톱 슬립 같은 이상값에서 회수가 무한정 미뤄지지 않게 하는 안전 상한이다.
+ */
+export const ALARM_MAX_HOP_MS = 2_147_483_647;
+
+/**
+ * 세션 스폰 옵션 — **cli-parser.ts 의 검증된 헤드리스 spawn 패턴을 그대로 잇는다**(재발명 금지):
+ *   · `detached:true`  — 세션을 자기 프로세스그룹 리더로(위 토폴로지). `kill(-child.pid)` 로 세션+손자 일괄 회수.
+ *   · stdin `ignore`   — 입력 대기 행 차단(`</dev/null` 등가). 무인이라 답할 주체가 없다.
+ *   · 출력 상한 32MiB   — 폭주 출력 OOM 방지(초과 시 그룹 kill + 실패).
+ */
+export const SUPERVISOR_SPAWN_STDIO = ["ignore", "pipe", "pipe"] as const;
+export const SUPERVISOR_SPAWN_DETACHED = true;
+export const SUPERVISOR_MAX_OUTPUT_BYTES = 32 * 1024 * 1024;
+
+/** kill_at 스케줄 산출 입력. 전부 절대 ms(주입 — 테스트 결정성). */
+export interface KillScheduleInput {
+  /** 세션 기동(클레임) 시각 ms — 잡 wall-clock 예산이 흐르기 시작하는 기준. */
+  claimedAtMs: number;
+  /** 잡 wall-clock 예산 ms(config.sdkGenTimeout — 주/복구 세션 합산 상한). */
+  genTimeoutMs: number;
+  /** 잡 절대 마감 ms(잡 파일 `expires_at` → ms · 봇이 적재 순간 박은 값). */
+  deadlineMs: number;
+}
+
+/** kill_at 스케줄(전부 절대 ms). termAt < killSigAt < killAt 이 늘 성립한다. */
+export interface KillSchedule {
+  /** 강제 종료 완결 목표 시각 = min(claimedAt + genTimeout, deadline). 예산과 마감 중 **먼저 오는 쪽**. */
+  killAtMs: number;
+  /** SIGTERM 시각 = killAt - TERM_MARGIN. */
+  termAtMs: number;
+  /** SIGKILL 시각 = killAt - KILL_MARGIN. */
+  killSigAtMs: number;
+}
+
+function assertFiniteMs(label: string, v: number): void {
+  if (!Number.isFinite(v)) {
+    throw new Error(`supervisor: ${label} 가 유한한 ms 값이 아닙니다: ${v}`);
+  }
+}
+
+/**
+ * kill_at 스케줄 계산(순수).
+ *
+ * **핵심: kill_at = min(예산 마감, 잡 마감)**. 세션의 wall-clock 예산(기동 + genTimeout)과 잡의 절대 마감
+ *   (expires_at) 중 **먼저 오는 쪽**이 상한이다 — 예산이 남아도 잡이 만료면 거기서 끊고(늦은 성공 창 제거),
+ *   잡 마감이 멀어도 예산이 다하면 거기서 끊는다(폭주 세션 상한). TERM/KILL 은 그 kill_at **이전**에만 발화한다.
+ */
+export function computeKillSchedule(input: KillScheduleInput): KillSchedule {
+  assertFiniteMs("claimedAtMs", input.claimedAtMs);
+  assertFiniteMs("genTimeoutMs", input.genTimeoutMs);
+  assertFiniteMs("deadlineMs", input.deadlineMs);
+  const budgetKillMs = input.claimedAtMs + input.genTimeoutMs;
+  const killAtMs = Math.min(budgetKillMs, input.deadlineMs);
+  return {
+    killAtMs,
+    termAtMs: killAtMs - TERM_MARGIN_MS,
+    killSigAtMs: killAtMs - KILL_MARGIN_MS,
+  };
+}
+
+/** kill_at 까지 남은 시간(ms). 음수면 이미 지났다. */
+export function remainingBeforeKill(schedule: KillSchedule, nowMs: number): number {
+  return schedule.killAtMs - nowMs;
+}
+
+/**
+ * 지금 세션을 띄울 **여유**가 있는가 — 남은 시간이 SIGTERM 유예 미만이면 false.
+ *   즉시 죽여야 할 세션은 애초에 띄우지 않는다(계획: "don't start something you must instantly kill").
+ */
+export function hasSpawnRoom(schedule: KillSchedule, nowMs: number): boolean {
+  return remainingBeforeKill(schedule, nowMs) >= TERM_MARGIN_MS;
+}
+
+/** supervisor 가 세션을 띄웠을 때 돌려받는 핸들(주입 seam 이 만든다). */
+export interface SpawnedSession {
+  /** 그룹 회수 대상 id = detached 세션의 프로세스그룹 id(실제 = child.pid). 스폰 실패면 pid 부재 → pgid ≤ 1(HIGH#1). */
+  pgid: number;
+  /** 세션이 **스스로** 종료하면 resolve(종료코드 · 신호 종료면 null). supervisor 가 죽이면 이건 안 풀려도 무방
+   *   (회수 알람이 kill_at 에 반드시 settle 하므로 행이 없다).
+   *   `outputCapExceeded` = 출력 상한(32MiB)을 넘겨 spawn seam 이 **cap-kill(SIGKILL)** 한 종료(MEDIUM#4). 감독이
+   *   보낸 신호가 아니므로 termSent/killSent 로는 구분되지 않는다 — 이 플래그로 실어 output_cap(실패)으로 가른다. */
+  exited: Promise<{ code: number | null; outputCapExceeded?: boolean }>;
+}
+
+/** 감독 seam(전부 주입 — 실시계/실스폰/실신호는 프로덕션 기본 seam 에만 있고 테스트는 가짜를 넣는다). */
+export interface SuperviseDeps {
+  /** 현재 절대 시각 ms. */
+  now: () => number;
+  /** 절대 시각 `atMs` 에 fn 을 1회 발화하도록 예약하고, 취소 함수를 돌려준다. 이미 지난 시각이면 즉시(다음 틱) 발화. */
+  setAlarm: (atMs: number, fn: () => void) => () => void;
+  /** 세션 1건을 detached 로 spawn(플랜대로). supervisor 의 자식이 된다. */
+  spawnSession: (plan: SessionPlan) => SpawnedSession;
+  /** 세션 그룹에 신호 전송(`process.kill(-pgid, sig)` — 이미 없으면 무해). */
+  signalGroup: (pgid: number, sig: "SIGTERM" | "SIGKILL") => void;
+  /** 그룹이 살아 있는가(`kill(-pgid,0)` → 살아있음=true · ESRCH=false). */
+  groupAlive: (pgid: number) => boolean;
+  /** (선택) 세션 그룹이 살아나면 pgid 등록 — 프로세스 종료 전파·하트비트가 이 집합을 본다(Finding 1). 미주입=무시. */
+  registerSessionGroup?: (pgid: number) => void;
+  /** (선택) 세션이 settle(자가종료/강제종료/reap)하면 pgid 해제. register 와 짝. 미주입=무시. */
+  releaseSessionGroup?: (pgid: number) => void;
+}
+
+/** 감독 결과(세션 1건). */
+export type SessionOutcome =
+  | "exited" /** 세션이 신호 전에 스스로 종료(정상 완주 후보 — 전이 여부는 러너가 next-action 으로 확인) */
+  | "killed" /** 마감 강제(TERM/KILL 후 kill_at 시점 그룹 소멸 확인됨) */
+  | "reap_failed" /** kill_at 시점에도 그룹 생존 = 마감 강제 실패('결국 종료'가 아니다 · 계획 7절) */
+  | "output_cap" /** 출력 상한(32MiB) 초과로 spawn seam 이 cap-kill = 실패(exited 로 낙관 금지 · MEDIUM#4) */
+  | "spawn_failed" /** 스폰이 pid 를 못 냄(claude 부재·EACCES → pgid ≤ 1) = 실행된 그룹 없음. 신호·알람·등록 0(HIGH#1) */
+  | "refused"; /** 스폰 여유 부족(남은 시간 < TERM_MARGIN) → 애초에 안 띄웠다 */
+
+export interface SuperviseResult {
+  outcome: SessionOutcome;
+  /** 세션이 스스로 종료했을 때의 종료코드(신호 종료·미종료·refused 면 null). */
+  exitCode: number | null;
+  /** 진단 한 줄(로그·failed 사유). 사람 카드 문구가 아니다. */
+  detail: string;
+}
+
+/**
+ * 세션 1건을 감독한다 — detached 로 띄우고, kill_at 스케줄로 마감을 강제하고, 결과를 돌려준다.
+ *
+ * settle 은 **정확히 한 번**: (a) 세션 자가 종료 · (b) kill_at 회수 확인 중 먼저 오는 쪽. 회수 알람이 kill_at 에
+ *   반드시 판정하므로 세션이 영영 안 끝나도 promise 는 kill_at 에 풀린다(행 불가).
+ */
+export function superviseSession(
+  plan: SessionPlan,
+  schedule: KillSchedule,
+  deps: SuperviseDeps,
+): Promise<SuperviseResult> {
+  // 스폰 여유 사전 확인 — 즉시 죽여야 할 세션은 띄우지 않는다(신호 낭비·산출물 파손 회피).
+  if (!hasSpawnRoom(schedule, deps.now())) {
+    return Promise.resolve({
+      outcome: "refused",
+      exitCode: null,
+      detail: `스폰 여유 부족(남은 ${remainingBeforeKill(schedule, deps.now())}ms < TERM_MARGIN ${TERM_MARGIN_MS}ms)`,
+    });
+  }
+
+  const session = deps.spawnSession(plan);
+  const pgid = session.pgid;
+  /**
+   * HIGH#1 — **스폰 실패는 실행 중인 그룹이 아니다**. spawn 이 pid 를 못 내면(claude 부재·EACCES) pgid 가 ≤ 1 로
+   *   온다(defaultSpawnSession 의 `child.pid ?? -1`). 이걸 회수 대상 그룹으로 착각하면 재앙이다: `process.kill(-pgid)`
+   *   가 pgid=-1 일 때 `process.kill(-(-1))` = `process.kill(1)` = **init/launchd(PID 1) 를 신호**한다(pgid=0 이면
+   *   `kill(-0)`=`kill(0)`=호출자 그룹 전체). PID 1 은 늘 살아 있어 groupAlive(-1)=true → 리더 종료가 영영 settle 안
+   *   되고, TERM/KILL 이 init 을 겨냥(일반 계정=EPERM→kill_at 에 reap_failed · 특권 호스트=실제 시스템 프로세스 신호).
