+  const ops: string[] = [];
+  return {
+    io: {
+      writeFileSync: (p: string, d: string): void => {
+        files[p] = d;
+        ops.push(`write:${p}`);
+      },
+      renameSync: (from: string, to: string): void => {
+        files[to] = files[from];
+        delete files[from];
+        ops.push(`rename:${from}->${to}`);
+      },
+    },
+    ops,
+    read: (p: string): unknown => (files[p] !== undefined ? JSON.parse(files[p]) : undefined),
