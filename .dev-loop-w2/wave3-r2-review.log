   455	// ── 세션 그룹 레지스트리 + 종료 전파(Finding 1 — 마감 구멍 봉합) ─────────────────
   456	/** on/removeListener/exit 를 기록하는 가짜 종료 호스트(실 process·실 신호 없이 판정). */
   457	function makeFakeTerminationHost() {
   458	  const listeners: Record<"SIGTERM" | "SIGINT" | "exit", Array<() => void>> = {
   459	    SIGTERM: [],
   460	    SIGINT: [],
   461	    exit: [],
   462	  };
   463	  const exitCodes: Array<number | undefined> = [];
   464	  return {
   465	    host: {
   466	      on: (e: "SIGTERM" | "SIGINT" | "exit", l: () => void): void => {
   467	        listeners[e].push(l);
   468	      },
   469	      removeListener: (e: "SIGTERM" | "SIGINT" | "exit", l: () => void): void => {
   470	        listeners[e] = listeners[e].filter((x) => x !== l);
   471	      },
   472	      exit: (code?: number): void => {
   473	        exitCodes.push(code);
   474	      },
   475	    },
   476	    fire: (e: "SIGTERM" | "SIGINT" | "exit"): void => {
   477	      for (const l of [...listeners[e]]) l();
   478	    },
   479	    exitCodes,
   480	  };
   481	}
