   191	/**
   192	 * ```bash 펜스 안의 명령만 순서대로 수집한다(치환된 텍스트 기준).
   193	 *   · 인용문 안 펜스(`> ```)는 trim 후에도 `>` 로 시작해 오프너에 걸리지 않는다 — 자연히 제외된다.
   194	 *   · 백슬래시 연속행은 한 논리 명령으로 결합하되 physicalLines 로 흔적을 남긴다(분류에서 fail-closed).
   195	 */
   196	function collectFencedBashCommands(text: string): FencedCommand[] {
   197	  const out: FencedCommand[] = [];
   198	  let inFence = false;
   199	  let isBashFence = false;
   200	  let pending: string[] = [];
   201	
   202	  const flushPending = (): void => {
   203	    if (pending.length === 0) return;
   204	    out.push({ command: pending.join(" "), physicalLines: pending.length });
   205	    pending = [];
   206	  };
   207	
   208	  for (const raw of text.split("\n")) {
   209	    const line = raw.trim();
   210	
   211	    if (!inFence) {
   212	      const open = FENCE_OPEN.exec(line);
   213	      if (open) {
   214	        inFence = true;
   215	        isBashFence = open[1] === "bash";
   216	      }
   217	      continue;
   218	    }
   219	
   220	    if (FENCE_CLOSE.test(line)) {
