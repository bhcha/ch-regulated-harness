   427	): () => void {
   428	  const host: SupervisorTerminationHost = deps.host ?? {
   429	    on: (event, listener) => {
   430	      process.on(event, listener);
   431	    },
   432	    removeListener: (event, listener) => {
   433	      process.removeListener(event, listener);
   434	    },
   435	    exit: (code) => process.exit(code),
   436	  };
