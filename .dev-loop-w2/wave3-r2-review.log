   172	  /** 세션 그룹에 신호 전송(`process.kill(-pgid, sig)` — 이미 없으면 무해). */
   173	  signalGroup: (pgid: number, sig: "SIGTERM" | "SIGKILL") => void;
   174	  /** 그룹이 살아 있는가(`kill(-pgid,0)` → 살아있음=true · ESRCH=false). */
   175	  groupAlive: (pgid: number) => boolean;
   176	  /** (선택) 세션 그룹이 살아나면 pgid 등록 — 프로세스 종료 전파·하트비트가 이 집합을 본다(Finding 1). 미주입=무시. */
   177	  registerSessionGroup?: (pgid: number) => void;
   178	  /** (선택) 세션이 settle(자가종료/강제종료/reap)하면 pgid 해제. register 와 짝. 미주입=무시. */
   179	  releaseSessionGroup?: (pgid: number) => void;
   180	}
   181	
   182	/** 감독 결과(세션 1건). */
   183	export type SessionOutcome =
   184	  | "exited" /** 세션이 신호 전에 스스로 종료(정상 완주 후보 — 전이 여부는 러너가 next-action 으로 확인) */
   185	  | "killed" /** 마감 강제(TERM/KILL 후 kill_at 시점 그룹 소멸 확인됨) */
   186	  | "reap_failed" /** kill_at 시점에도 그룹 생존 = 마감 강제 실패('결국 종료'가 아니다 · 계획 7절) */
   187	  | "refused"; /** 스폰 여유 부족(남은 시간 < TERM_MARGIN) → 애초에 안 띄웠다 */
   188	
   189	export interface SuperviseResult {
   190	  outcome: SessionOutcome;
   191	  /** 세션이 스스로 종료했을 때의 종료코드(신호 종료·미종료·refused 면 null). */
   192	  exitCode: number | null;
   193	  /** 진단 한 줄(로그·failed 사유). 사람 카드 문구가 아니다. */
   194	  detail: string;
   195	}
   196	
   197	/**
   198	 * 세션 1건을 감독한다 — detached 로 띄우고, kill_at 스케줄로 마감을 강제하고, 결과를 돌려준다.
   199	 *
   200	 * settle 은 **정확히 한 번**: (a) 세션 자가 종료 · (b) kill_at 회수 확인 중 먼저 오는 쪽. 회수 알람이 kill_at 에
   201	 *   반드시 판정하므로 세션이 영영 안 끝나도 promise 는 kill_at 에 풀린다(행 불가).
   202	 */
   203	export function superviseSession(
   204	  plan: SessionPlan,
   205	  schedule: KillSchedule,
   206	  deps: SuperviseDeps,
   207	): Promise<SuperviseResult> {
   208	  // 스폰 여유 사전 확인 — 즉시 죽여야 할 세션은 띄우지 않는다(신호 낭비·산출물 파손 회피).
   209	  if (!hasSpawnRoom(schedule, deps.now())) {
   210	    return Promise.resolve({
   211	      outcome: "refused",
   212	      exitCode: null,
   213	      detail: `스폰 여유 부족(남은 ${remainingBeforeKill(schedule, deps.now())}ms < TERM_MARGIN ${TERM_MARGIN_MS}ms)`,
   214	    });
   215	  }
   216	
   217	  const session = deps.spawnSession(plan);
   218	  const pgid = session.pgid;
   219	  // 이 세션 그룹을 레지스트리에 등록 — 종료 전파·하트비트가 살아있는 pgid 로 이걸 본다(Finding 1). settle 에서 해제.
   220	  deps.registerSessionGroup?.(pgid);
   221	
   222	  return new Promise<SuperviseResult>((resolve) => {
   223	    let settled = false;
   224	    let termSent = false;
   225	    let killSent = false;
   226	    const cancels: Array<() => void> = [];
   227	
   228	    const settle = (r: SuperviseResult): void => {
   229	      if (settled) return;
   230	      settled = true;
   231	      for (const cancel of cancels) cancel();
   232	      // 감독 종료 — 레지스트리에서 이 세션 그룹을 뗀다(더는 종료 전파·하트비트의 대상이 아니다).
   233	      deps.releaseSessionGroup?.(pgid);
   234	      resolve(r);
   235	    };
   236	
   237	    /**
   238	     * 세션 리더 자가 종료 — **그룹 소멸을 확인해야** settle 한다(Finding 2). 리더의 파이프가 닫히면 `exited` 가 뜨지만
   239	     *   `nohup … &` 류 손자는 그룹에 살아남을 수 있다: 리더 종료를 그룹 사멸로 낙관해 알람을 다 취소하면 그 손자가
   240	     *   kill_at 을 넘겨 살아남는다. 그래서 그룹이 **정말 비었을 때만** 성공(신호 전=exited · 신호 후=killed)으로 settle
   241	     *   하고, 아직 살아있으면 settle 하지 않고 회수 경로(TERM/KILL/kill_at reap)에 맡긴다(kill_at 알람은 armNext 로 늘
   242	     *   유지되므로 행 없음).
   243	     */
   244	    const onSelfExit = (code: number | null): void => {
   245	      if (settled) return;
   246	      if (deps.groupAlive(pgid)) return; // 리더는 죽었으나 그룹 생존(손자 잔존) — 조기 성공 settle 금지, reap 경로가 처리.
   247	      settle({
   248	        outcome: killSent || termSent ? "killed" : "exited",
   249	        exitCode: code,
   250	        detail: killSent || termSent ? "신호 후 세션 종료(그룹 소멸 확인)" : "세션 자가 종료(그룹 소멸 확인)",
   251	      });
   252	    };
   253	    session.exited.then(
   254	      (e) => onSelfExit(e.code),
   255	      () => onSelfExit(null), // 종료 관측 자체가 실패해도 감독은 계속(회수 알람이 백스톱).
   256	    );
   257	
   258	    /**
   259	     * 다음으로 도달해야 할 절대 임계로 알람을 (재)무장한다 — 조기 발화·클램프·밀린 타이머 내성의 축(Finding 3).
   260	     *   nextTarget = 아직 안 지난 가장 이른 임계(termAt → killSigAt → killAt). 남은 지연이 setTimeout 상한을 넘으면
   261	     *   **상한(ALARM_MAX_HOP_MS)만큼만** 걸고(클램프 시 즉시발화 회피), 그 알람이 깨면 enforce 가 다시 armNext 로 잇는다.
   262	     *   armAt 은 늘 미래(now < nextTarget)이므로 타이트 루프가 없다.
   263	     */
   264	    const armNext = (): void => {
   265	      if (settled) return;
   266	      const now = deps.now();
   267	      const nextTarget =
   268	        now < schedule.termAtMs
   269	          ? schedule.termAtMs
   270	          : now < schedule.killSigAtMs
   271	            ? schedule.killSigAtMs
   272	            : schedule.killAtMs;
   273	      const armAt = Math.min(nextTarget, now + ALARM_MAX_HOP_MS);
   274	      cancels.push(deps.setAlarm(armAt, enforce));
   275	    };
   276	
   277	    /**
   278	     * 마감 강제 한 스텝 — **어느 알람이 깨우든 `now()` 로 due 페이즈를 재계산**해 밀린 단계를 즉시 따라잡고, 아직
   279	     *   kill_at 전이면 `armNext()` 로 다음 임계 알람을 잇는다(조기 발화·클램프에도 회수가 새지 않는다).
   280	     */
   281	    const enforce = (): void => {
   282	      if (settled) return;
   283	      const now = deps.now();
   284	      if (now >= schedule.killAtMs) {
   285	        // 밀린 경우를 대비해 아직 안 보낸 신호를 지금 마저 보낸다(그 뒤 곧바로 소멸 확인).
   286	        if (!termSent) {
   287	          deps.signalGroup(pgid, "SIGTERM");
   288	          termSent = true;
   289	        }
   290	        if (!killSent) {
   291	          deps.signalGroup(pgid, "SIGKILL");
   292	          killSent = true;
   293	        }
   294	        // kill_at 시점 판정: **지금 소멸했는가**(결국이 아니라). 살아 있으면 회수 실패.
   295	        if (deps.groupAlive(pgid)) {
   296	          settle({ outcome: "reap_failed", exitCode: null, detail: `kill_at 시점 그룹(${pgid}) 생존 — 회수 실패` });
   297	        } else {
   298	          settle({ outcome: "killed", exitCode: null, detail: "마감 강제(회수 확인됨)" });
   299	        }
   300	        return;
   301	      }
   302	      if (now >= schedule.killSigAtMs) {
   303	        if (!termSent) {
   304	          deps.signalGroup(pgid, "SIGTERM");
   305	          termSent = true;
   306	        }
   307	        if (!killSent) {
   308	          deps.signalGroup(pgid, "SIGKILL");
   309	          killSent = true;
   310	        }
   311	        armNext(); // 아직 kill_at 전 — reap 확인 알람을 잇는다.
   312	        return;
   313	      }
   314	      if (now >= schedule.termAtMs) {
   315	        if (!termSent) {
   316	          deps.signalGroup(pgid, "SIGTERM");
   317	          termSent = true;
   318	        }
   319	        armNext(); // KILL·reap 알람을 잇는다.
   320	        return;
   321	      }
   322	      // 조기 발화(now < termAt) — 스펜트 원샷으로 버리지 않고 다음 임계로 재무장한다(Finding 3).
   323	      armNext();
   324	    };
   325	
   326	    // 첫 무장(다음 임계로). 조기 발화·클램프·밀린 타이머는 armNext 재무장 + enforce 절대시계 재판정이 흡수한다.
   327	    armNext();
   328	  });
   329	}
   330	
   331	// ── 프로덕션 기본 seam (main() 과 W4 데몬이 쓴다 · W3 테스트에선 실행되지 않는다) ──────────────────
   332	
   333	/** 실시계 seam — setTimeout 은 arm 시점의 상대 지연이지만, 발화 콜백(enforce)이 `now()` 로 재판정하므로 슬립에 강건하다. */
   334	export const realClock: Pick<SuperviseDeps, "now" | "setAlarm"> = {
   335	  now: () => Date.now(),
   336	  setAlarm: (atMs, fn) => {
   337	    const handle = setTimeout(() => fn(), Math.max(0, atMs - Date.now()));
   338	    return () => clearTimeout(handle);
   339	  },
   340	};
   341	
   342	/** 세션 그룹 신호(cli-parser 의 killGroup 패턴) — 이미 없으면 조용히 무시. */
   343	export function realSignalGroup(pgid: number, sig: "SIGTERM" | "SIGKILL"): void {
   344	  try {
   345	    process.kill(-pgid, sig); // 음수 pid = 프로세스그룹 전체(세션 + Bash 손자)
   346	  } catch {
   347	    // 이미 종료됨 — 무해.
   348	  }
   349	}
   350	
   351	/** 그룹 생존 확인 — ESRCH=소멸(false), EPERM=존재하나 권한없음(보수적으로 생존=true), 그 외=생존. */
   352	export function realGroupAlive(pgid: number): boolean {
   353	  try {
   354	    process.kill(-pgid, 0);
   355	    return true;
   356	  } catch (e) {
   357	    return (e as NodeJS.ErrnoException).code === "EPERM";
   358	  }
   359	}
   360	
   361	// ── 세션 그룹 레지스트리 + 종료 전파(Finding 1 — 마감 구멍 봉합) ──────────────────────────────────
   362	
   363	/**
   364	 * 살아있는 세션 하위 그룹 레지스트리 — 이 supervisor 가 detached 로 띄운 세션 그룹의 pgid 집합.
   365	 *   두 소비자가 같은 집합을 본다: ① 종료 전파(installSupervisorTerminationHandlers)가 supervisor 가 죽기 전에 이들을
   366	 *   SIGKILL 한다 · ② `publish` 콜백(main 이 하트비트에 배선)이 W4 데몬에게 live pgid 를 노출한다 → 데몬이
   367	 *   `kill(-sessionPgid)` 로 세션 그룹을 **직접** 겨냥한다(supervisor 만 죽여선 세션 그룹에 못 닿는다 — 모듈 헤더 계약).
   368	 */
   369	export interface SessionGroupRegistry {
   370	  /** 세션 그룹이 살아나면 등록. pgid ≤ 1 은 무효(스폰 실패 -1 · 그룹 1 은 회수 대상 아님)라 무시한다. */
   371	  register: (pgid: number) => void;
   372	  /** 세션이 settle(자가종료/강제종료/reap)하면 해제. */
   373	  release: (pgid: number) => void;
   374	  /** 현재 살아있는 pgid 스냅샷(오름차순 — 결정론). 종료 전파·하트비트가 읽는다. */
   375	  live: () => number[];
   376	}
   377	
   378	/**
   379	 * 세션 그룹 레지스트리 생성. `publish` 를 주면 집합이 바뀔 때마다 살아있는 pgid 스냅샷을 넘긴다(main 이 하트비트
   380	 *   파일 기록으로 배선 — W4 데몬이 세션 pgid 를 읽어 직접 kill).
   381	 *
   382	 * ⚠ **pgid > 1 가드는 안전 필수다**: 종료 전파는 `process.kill(-pgid, SIGKILL)` 을 쓰는데, pgid 가 1 이면
   383	 *   `kill(-1, …)` = **호출자가 신호할 수 있는 거의 모든 프로세스**로 퍼진다(재앙). 무효 pgid 는 등록 자체를 막는다.
   384	 */
   385	export function createSessionGroupRegistry(publish?: (livePgids: number[]) => void): SessionGroupRegistry {
   386	  const live = new Set<number>();
   387	  const snapshot = (): number[] => [...live].sort((a, b) => a - b);
   388	  const emit = (): void => publish?.(snapshot());
   389	  return {
   390	    register: (pgid: number): void => {
   391	      if (Number.isInteger(pgid) && pgid > 1) {
   392	        live.add(pgid);
   393	        emit();
   394	      }
   395	    },
   396	    release: (pgid: number): void => {
   397	      if (live.delete(pgid)) emit();
   398	    },
   399	    live: snapshot,
   400	  };
   401	}
   402	
   403	/** 종료 전파 핸들러가 붙는 호스트(기본 = process). 테스트는 가짜를 주입해 실 신호·실 exit 없이 판정한다. */
   404	export interface SupervisorTerminationHost {
   405	  on: (event: "SIGTERM" | "SIGINT" | "exit", listener: () => void) => void;
   406	  removeListener: (event: "SIGTERM" | "SIGINT" | "exit", listener: () => void) => void;
   407	  exit: (code?: number) => void;
   408	}
   409	
   410	/**
   411	 * supervisor 종료 전파 핸들러 설치(Finding 1 — 마감 구멍 봉합) — 데몬(W4)이 supervisor 를 **SIGTERM/SIGINT 로
   412	 *   우아하게** 끝내거나 supervisor 가 정상 종료(exit)할 때, 아직 살아있는 세션 하위 그룹을 supervisor 가 빠져나가기
   413	 *   **전에** 전부 SIGKILL 해 고아를 남기지 않는다.
   414	 *
   415	 * 왜 필요한가: 세션은 supervisor 그룹을 **상속하지 않는다**(각자 detached 하위 그룹 — 회수 검증이 그룹 밖에서
   416	 *   성립해야 하므로). 그래서 음수-PID 신호 `kill(-supervisorPID)` 는 supervisor PGID **하나만** 겨냥하고 세션 그룹엔
   417	 *   닿지 않는다 — supervisor 가 죽으면 세션과 Bash 손자는 마감 타이머 주인을 잃고 살아남는다. 그 구멍을 여기서 닫는다.
   418	 *
   419	 * ⚠ **SIGKILL 로 supervisor 자신이 죽는 경우는 트랩 불가**(SIGKILL 은 핸들러를 못 건다). 그 잔여는 모듈 헤더의
   420	 *   W3↔W4 계약이 메운다: 데몬은 SIGTERM 을 먼저 보내(이 전파를 돌려) 또는 노출된 세션 pgid 를 직접 kill 해야 한다.
   421	 *
   422	 * @returns 설치 해제 함수(핸들러 제거 — 테스트 정리용).
   423	 */
   424	export function installSupervisorTerminationHandlers(
   425	  registry: SessionGroupRegistry,
   426	  deps: { signalGroup: (pgid: number, sig: "SIGKILL") => void; host?: SupervisorTerminationHost },
   427	): () => void {
   428	  const host: SupervisorTerminationHost = deps.host ?? {
   429	    on: (event, listener) => {
   430	      process.on(event, listener);
   431	    },
   432	    removeListener: (event, listener) => {
   433	      process.removeListener(event, listener);
   434	    },
   435	    exit: (code) => process.exit(code),
   436	  };
   437	  // 살아있는 세션 그룹을 전부 SIGKILL(멱등 — release 로 비면 no-op). 그룹 kill 이라 detached 손자까지 회수된다.
   438	  const reap = (): void => {
   439	    for (const pgid of registry.live()) {
   440	      deps.signalGroup(pgid, "SIGKILL");
   441	      registry.release(pgid);
   442	    }
   443	  };
   444	  const onSignal =
   445	    (code: number) =>
   446	    (): void => {
   447	      reap();
   448	      // SIGTERM/SIGINT 리스너를 달면 Node 의 기본 종료가 무효화되므로 **명시 종료**한다(안 그러면 데몬의 우아한 종료가 먹통).
   449	      host.exit(code);
   450	    };
   451	  const onTerm = onSignal(143); // 128 + SIGTERM(15)
   452	  const onInt = onSignal(130); // 128 + SIGINT(2)
   453	  const onExit = (): void => reap(); // 정상 종료 백스톱(exit 이벤트 — 동기만 가능, reap 은 동기).
   454	  host.on("SIGTERM", onTerm);
   455	  host.on("SIGINT", onInt);
   456	  host.on("exit", onExit);
   457	  return () => {
   458	    host.removeListener("SIGTERM", onTerm);
   459	    host.removeListener("SIGINT", onInt);
   460	    host.removeListener("exit", onExit);
   461	  };
   462	}
   463	
   464	/** cli-parser 와 동일 형태의 spawn 옵션(detached · stdin ignore). 스폰 없이 형태를 단위 테스트로 못 박기 위해 분리. */
   465	export function buildSupervisorSpawnOptions(cwd: string, env: Record<string, string>): SpawnOptions {
