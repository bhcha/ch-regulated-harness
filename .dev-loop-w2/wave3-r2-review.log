   222	      flushPending();
   223	      inFence = false;
   224	      isBashFence = false;
   225	      continue;
   226	    }
   227	    if (!isBashFence) continue;
   228	
   229	    // 빈 줄·주석은 명령이 아니다(다만 연속행 중간이라면 그 연속은 끊긴 것으로 본다).
   230	    if (line === "" || line.startsWith("#")) {
   231	      flushPending();
   232	      continue;
   233	    }
   234	    if (line.endsWith("\\")) {
   235	      pending.push(line.slice(0, -1).trim());
   236	      continue;
   237	    }
   238	    pending.push(line);
   239	    flushPending();
   240	  }
