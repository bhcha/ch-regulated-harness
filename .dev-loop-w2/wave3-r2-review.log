   144	 *   그럼에도 굳이 적는 이유: 결정은 사람의 몫이라(AGENTS 5번 절) **명시적으로 거부됐다는 기록**이 남는 편이,
   145	 *   '규칙이 없어서 우연히 막혔다'보다 감사에 유리하고 allow 규칙이 실수로 넓어진 날의 마지막 그물이 된다.
   146	 *
   147	 * 목록은 실제 `core/scripts/*.sh` 파일명이다(계획의 `apply-*` = 오늘 기준 `apply-learnings.sh` 하나 —
   148	 *   `apply-intake`·`apply-proposal` 은 독립 스크립트가 아니라 `gate.sh` 내부 훅이다). 정렬 = 결정론.
   149	 *   ⚠ core 가 이 파일들을 개명하면 규칙이 조용히 헛돈다 → 단위 테스트가 실재를 확인해 드리프트를 깨운다.
   150	 */
   151	export const DECISION_SCRIPTS = [
   152	  "advance-phase.sh",
   153	  "apply-learnings.sh",
   154	  "approve.sh",
   155	  "gate.sh",
   156	  "ingest-bundle.sh",
   157	  "ingest.sh",
   158	  "intake.sh",
   159	  "kcia-check.sh",
   160	  "new-run.sh",
   161	  "revise.sh",
   162	  "select.sh",
   163	] as const;
   164	
   165	/**
   166	 * 절대경로 → 권한 규칙의 **절대 글롭 표기**(`//abs/...`). 부록A-3 의 `Read(//**)`(유효한 전체 글롭)와 같은 표기다.
   167	 *
   168	 * 왜 상대 표기(`./state.json`)를 쓰지 않나: 규칙의 상대경로가 **무엇을 기준으로** 풀리는지가 부록A 에 없다
   169	 *   (settings 파일이 있는 디렉터리인가, cwd 인가 — A-3 의 프로브는 그 둘이 갈리는 배치가 아니었다).
   170	 *   우리 settings 는 cwd(런 디렉터리)가 아니라 **격리 CONFIG_DIR** 안에 있으므로 그 차이가 곧 규칙의 유효/무효를
   171	 *   가른다. 절대 표기는 그 질문 자체를 없앤다.
   172	 * ⚠ **미실측 — W5 카나리 확인 필요**: A-3 이 실측한 절대 글롭은 `Read(//**)` 이고, `Write`/`Edit` 규칙의 절대
   173	 *   표기·매칭은 기록이 없다. 틀렸다면 이 deny 는 조용히 무효다 → 그래서 이 층을 '경계의 본체'로 부르지 않는다.
   174	 */
   175	function absGlob(absPath: string): string {
   176	  return `/${absPath}`;
   177	}
   178	
   179	/** 경로 인자 검증(절대 + 규칙 문자열에 박을 수 있는 형태). 통과하면 그 경로를 그대로 돌려준다. */
   180	function assertRulePath(label: string, value: string): string {
   181	  if (typeof value !== "string" || value.trim() === "") {
   182	    throw new Error(`${label} 가 필요합니다 — 절대경로를 넘기세요.`);
   183	  }
   184	  if (!isAbsolute(value)) {
   185	    throw new Error(
   186	      `${label} 는 절대경로여야 합니다(받은 값: '${value}'). 상대경로는 cwd 에 따라 결과가 달라져 조립 결정론이 깨지고, ` +
   187	        "부록A-10 실측상 모델이 상대경로 깊이를 오산해 명령이 거부됩니다.",
   188	    );
   189	  }
   190	  if (PATH_UNSAFE.test(value)) {
   191	    throw new Error(
   192	      `${label} 에 공백·셸/글롭 메타문자를 쓸 수 없습니다(권한 규칙 문자열이 깨집니다): '${value}'`,
   193	    );
   194	  }
   195	  return value;
   196	}
   197	
   198	/**
   199	 * 이 세션의 cwd = `<coreRoot>/runs/<rid>` — **이게 곧 읽기 경계다**(부록A-4).
   200	 *
   201	 * ⚠ 계획 W3 초안의 `cwd=core` 는 여기서 채택하지 않는다(A-7 3번이 재검토를 요구했고, A-4 가 답을 줬다):
   202	 *   core 를 cwd 로 잡으면 `core/runs/*` **전체가 경계 안**이라 타 런 읽기가 열린다. 런 디렉터리를 cwd 로 잡고
   203	 *   필요한 경로만 `--add-dir` 로 여는 것이 r8 의 realpath 허용목록(기본 거부 + 현재 런 + 고정 지침 경로 +
   204	 *   선언 도메인 packs)의 **CLI 네이티브 대응물**이다.
   205	 */
   206	export function buildRunCwd(input: { coreRoot: string; rid: string }): string {
   207	  const core = assertRulePath("coreRoot", input.coreRoot);
   208	  if (!isSafeRunId(input.rid)) {
   209	    throw new Error(
   210	      `run_id 가 안전한 토큰이 아닙니다: '${input.rid}'. 영숫자·'.'·'_'·'-' 만 허용합니다 ` +
   211	        "(이 값은 cwd 경로와 권한 규칙 문자열에 그대로 박히므로, 경로 탈출·규칙 훼손을 조립 전에 끊습니다).",
   212	    );
   213	  }
   214	  return join(core, RUNS_DIRNAME, input.rid);
   215	}
   216	
   217	/**
   218	 * `--add-dir` 4종(절대경로 · 부록A-9 표 순서) — cwd 경계에 **정확히 이 경로들만** 추가한다.
   219	 *
   220	 * 왜 이 4개인가(A-9 실측 = 무인 완주에 실제로 필요했던 최소):
   221	 *   prompts(단계 계약) · harness(스키마) · scripts(전이·emit-context) · packs/<선언 도메인>(룰셋).
   222	 *   ⚠ 도메인은 **선언된 그 하나만** 연다. `packs` 루트를 통째로 열면 남의 도메인 룰셋까지 경계 안이 된다.
   223	 *
   224	 * packs 는 core 의 **형제**다(모노레포 배치). core 는 `PACKS_DIR="${PACKS_DIR:-$HARNESS_ROOT/../packs}"` 로 같은
   225	 *   경로를 유도하고, 우리 env 위생(화이트리스트 재구성)은 `PACKS_DIR` 를 싣지 않으므로 **세션 안 core 스크립트도
   226	 *   반드시 이 형제 경로를 본다** — 두 계산이 갈라질 여지가 구조적으로 없다(env 를 넓히면 그 보증이 깨진다).
   227	 *
   228	 * @throws 도메인 형식 위반 · coreRoot 가 절대경로가 아니거나 규칙에 박을 수 없는 형태일 때.
   229	 */
   230	export function buildAddDirs(input: { coreRoot: string; domain: string }): string[] {
   231	  const core = assertRulePath("coreRoot", input.coreRoot);
   232	  if (typeof input.domain !== "string" || !DOMAIN_PATTERN.test(input.domain)) {
   233	    throw new Error(
   234	      `규제도메인 형식이 올바르지 않습니다: '${input.domain}' — 영소문자로 시작하는 영소문자·숫자·'_' 조합이어야 ` +
   235	        "합니다(예: cosmetic·quasi_drug·health_food·drug). 검증되지 않은 도메인은 팩 경로와 권한 규칙 문자열에 " +
   236	        "그대로 박히므로 조립 전에 끊습니다(등록 여부는 core 의 new-run 이 레지스트리로 강제합니다).",
   237	    );
   238	  }
   239	  const packsRoot = resolve(core, "..", PACKS_DIRNAME);
   240	  return [...ADD_DIR_CORE_SUBDIRS.map((sub) => join(core, sub)), join(packsRoot, input.domain)];
   241	}
   242	
   243	/**
   244	 * `--disallowedTools` 규칙(2차 방어 · 결정·상태변이 스크립트). 접두 매칭(`:*`)이라 인자와 무관하게 걸린다.
   245	 *   1차 경계는 **allow 규칙의 부재**라는 점을 잊지 말 것(A-5 · 위 DECISION_SCRIPTS 주석).
   246	 */
   247	export function buildDisallowedTools(coreRoot: string): string[] {
   248	  const core = assertRulePath("coreRoot", coreRoot);
   249	  return DECISION_SCRIPTS.map((name) => `Bash(bash ${join(core, "scripts", name)}:*)`);
   250	}
   251	
   252	/** 격리 CONFIG_DIR 에 쓸 settings 내용(러너가 직렬화해 쓴다 — 이 모듈은 파일을 만들지 않는다). */
   253	export interface WorkerSettings {
   254	  permissions: { deny: string[] };
   255	}
   256	
   257	/**
   258	 * 격리 `CLAUDE_CONFIG_DIR/settings.json` 내용 — **경계 안쪽에서 파내는 예외**만 담는다(부록A-7 2번).
   259	 *
   260	 * ⚠ **이 deny 는 '보조 방어'가 아니라 하중을 받는다**(Codex W2-R2 정정): `--permission-mode acceptEdits` 라
   261	 *   **cwd 안 쓰기는 자동 승인**되는데 cwd(`runs/<rid>`) 안에 `state.json` 이 있다. 즉 아래 ①을 빼면 세션이
   262	 *   state 를 직접 쓰는 걸 막는 게 **아무것도 없다**. 읽기 경계(cwd)·실행 경계(allow 규칙 부재)와 달리 이건
   263	 *   구조가 아니라 **규칙 문자열이 실제로 매칭돼야** 성립한다 → 아래 ⚠(글롭 철자 미실측)가 그래서 중요하다.
   264	 *
   265	 * 담는 것:
   266	 *   ① 런의 `state.json`·`run.md`·`.lock` 쓰기 금지 — **상태는 오직 `run-stage.sh` 가 쓴다**(AGENTS 1번 절).
   267	 *      세션이 state 를 직접 쓸 수 있으면 게이트를 건너뛴 '전이'가 가능해져 승인·심의 전제가 통째로 무너진다.
   268	 *      `.lock` 은 파일이 아니라 **디렉터리**(core 의 mkdir 원자성 락)라 실질 표적은 `.lock/pid`(보유 PID 위조)다 →
   269	 *      루트와 하위를 함께 막는다.
   270	 *   ② `--add-dir` 루트 4종 쓰기 금지 — 그것들은 **입력이지 산출물이 아니다**. `acceptEdits` 아래선 파일 작성이
   271	 *      자동승인이므로, 막지 않으면 세션이 `scripts/run-stage.sh` 를 고쳐놓고 **허용된 그 한 줄로 실행**할 수 있다
   272	 *      (= allow 규칙 정밀도를 우회하는 지름길). `packs/<도메인>/ruleset.json` 쓰기 금지는 같은 이유의 심의판
   273	 *      — 자기 심의 기준을 고쳐 쓰는 세션은 self-grading 이다(AGENTS 1번 절 4).
   274	 *
   275	 * 담지 않는 것: **읽기 허용목록도, 읽기 deny 열거도 없다.** cwd 가 이미 기본-거부 읽기 경계라 `.env`·타 런·
   276	 *   `chat/jobs`·`~/.claude` 는 전부 구조적으로 밖이고(A-4), A-3 상 `deny` 가 `allow` 를 이기므로 '전부 deny +
   277	 *   내 것만 allow' 는 만들 수도 없다. `ask` 는 Bash 읽기에 적용되지 않아 수단이 아니다.
   278	 *
   279	 * 결정론: 규칙 순서는 선언 순서 고정(같은 입력 → 바이트 동일 산출). 설정 파일이 실행마다 달라지면 그 경계는 무효다.
   280	 */
   281	export function buildWorkerSettings(input: { runDir: string; addDirs: string[] }): WorkerSettings {
   282	  const runDir = assertRulePath("runDir", input.runDir);
   283	  if (!Array.isArray(input.addDirs) || input.addDirs.length === 0) {
   284	    throw new Error("addDirs 가 비어 있습니다 — buildAddDirs() 의 산물을 그대로 넘기세요(입력 경로 쓰기 금지 대상).");
   285	  }
   286	
   287	  const deny: string[] = [];
   288	  // ① 런 안에서 스크립트만 만질 수 있어야 하는 것들.
   289	  for (const rel of ["state.json", "run.md", ".lock", join(".lock", "**")]) {
   290	    const target = absGlob(join(runDir, rel));
   291	    deny.push(`Write(${target})`, `Edit(${target})`);
   292	  }
   293	  // ② 입력 경로(add-dir 루트)는 읽기 전용이다.
   294	  for (const dir of input.addDirs) {
   295	    const target = absGlob(join(assertRulePath("addDirs 항목", dir), "**"));
   296	    deny.push(`Write(${target})`, `Edit(${target})`);
   297	  }
   298	  return { permissions: { deny } };
   299	}
   300	
   301	/** settings 직렬화(결정적) — 2칸 들여쓰기 + 끝 개행. 러너가 이 문자열을 그대로 쓴다. */
   302	export function serializeWorkerSettings(settings: WorkerSettings): string {
   303	  return `${JSON.stringify(settings, null, 2)}\n`;
   304	}
   305	
   306	/**
   307	 * 무인 세션 env — 위생 재구성(hygienicSpawnEnv) + 격리 CONFIG_DIR + OAuth 주입.
   308	 *
   309	 * hygienicSpawnEnv 가 이미 하는 일은 **다시 하지 않는다**: 화이트리스트 재구성(base 통째 복사 아님) ·
   310	 *   `ANTHROPIC_API_KEY`/`ANTHROPIC_AUTH_TOKEN`·`CODEX_*`·Bedrock/Vertex·마커·플랫폼 비밀 스크럽 ·
   311	 *   `HARNESS_ACK_GAPS="0"` 핀(core 의 .env 로더가 set-if-unset 이라 생략만으론 되채워진다).
   312	 *
   313	 * 여기서 더하는 두 가지:
   314	 *   · **격리 CONFIG_DIR 필수** — 사용자 훅/플러그인/MCP/`apiKeyHelper` 를 애초에 없애는 층이라(과금·행동 우회 차단)
   315	 *     선택지가 아니다. 절대경로만 받는다: 상대경로면 CLI 가 **cwd(=런 디렉터리) 기준**으로 풀어 워커 설정이
   316	 *     남의 산출물 폴더 안에 생긴다(= 격리 실패 + 런 오염).
   317	 *   · **OAuth 토큰 주입** — 격리 CONFIG_DIR 는 로컬 로그인 자격증명까지 가려서 그대로 두면 `Not logged in` 이다
   318	 *     (부록A-1 부수 관측). 토큰 주입으로 인증·격리·경계가 한 구성에서 성립함이 A-8 에서 실측됐다.
   319	 *     ⚠ 토큰은 **API 키가 아니라 구독 토큰**이라 과금이 구독으로 잡힌다(잠긴 결정 6). 빈 문자열은 '미설정'으로
   320	 *     취급한다(config 의 readEnv 관례) — 빈 값을 실어보내면 인증이 '설정됐는데 실패'로 흐려진다.
   321	 *   · **claude.ai 커넥터 끄기**(`ENABLE_CLAUDEAI_MCP_SERVERS=false`) — 커넥터는 **OAuth 계정**을 타고 도구를 노출하므로
   322	 *     바로 위 토큰 주입이 여는 경로다(= 격리 CONFIG_DIR 도 `--strict-mcp-config` 도 못 닫는다). 인증을 주는 대가로
