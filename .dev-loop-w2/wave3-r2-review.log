   209	class FakeClock {
   210	  private t: number;
   211	  private alarms: Array<{ atMs: number; fn: () => void; cancelled: boolean }> = [];
   212	  constructor(start: number) {
   213	    this.t = start;
   214	  }
   215	  now = (): number => this.t;
   216	  setAlarm = (atMs: number, fn: () => void): (() => void) => {
   217	    const a = { atMs, fn, cancelled: false };
   218	    this.alarms.push(a);
   219	    return () => {
   220	      a.cancelled = true;
   221	    };
   222	  };
   223	  /** now 를 t 로 옮기고, atMs ≤ t 인 미취소 알람을 atMs 오름차순으로 발화(발화 중 취소되면 건너뛴다). */
   224	  advanceTo(t: number): void {
   225	    this.t = t;
   226	    const due = this.alarms.filter((a) => !a.cancelled && a.atMs <= t).sort((x, y) => x.atMs - y.atMs);
   227	    for (const a of due) {
   228	      if (a.cancelled) continue;
   229	      a.cancelled = true;
   230	      a.fn();
   231	    }
   232	  }
   233	  /** now 를 nowMs 로 옮기고, **atMs 조건 없이** 미취소 알람을 전부 강제 발화(역행 시계·클램프 조기발화 시뮬레이션). */
   234	  fireAllPendingAt(nowMs: number): void {
   235	    this.t = nowMs;
   236	    const pending = this.alarms.filter((a) => !a.cancelled);
   237	    for (const a of pending) {
   238	      if (a.cancelled) continue;
   239	      a.cancelled = true;
   240	      a.fn();
   241	    }
   242	  }
   243	}
