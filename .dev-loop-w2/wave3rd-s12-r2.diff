+    hint: "",
+    files: [],
+    ...over,
+  };
+}
+/** 아직 그 단계 생성 차례(= 전이 안 됨). */
+const NA_STILL_GENERATE = makeNa({ step: "generate", stage: "brief" });
+/** 전이 완료(사람 승인 게이트로 넘어감). */
+const NA_TRANSITIONED = makeNa({ step: "human", stage: "brief", gate: "user" });
+
+// ── 러너 seam 헬퍼 ──────────────────────────────────────────────────────────────
+function makeInput(over: Partial<RunJobSessionInput> = {}): RunJobSessionInput {
+  return {
+    coreRoot: CORE,
+    rid: RID,
+    stage: "brief",
+    claimedAtMs: CLAIMED,
+    deadlineMs: DEADLINE,
+    configDir: CONFIG_DIR,
+    baseEnv: { PATH: "/usr/bin" },
+    genTimeoutMs: GEN_TIMEOUT,
+    maxTurns: 50,
+    ...over,
+  };
+}
+
+/** supervise seam 을 결과 큐로 흉내내고 호출(플랜·스케줄)을 기록한다. */
+function makeSupervise(results: SuperviseResult[]) {
+  const calls: Array<{ plan: SessionPlan; schedule: KillSchedule }> = [];
+  const supervise = async (plan: SessionPlan, schedule: KillSchedule): Promise<SuperviseResult> => {
+    calls.push({ plan, schedule });
+    const r = results[calls.length - 1];
+    if (!r) throw new Error(`makeSupervise: 예상보다 많은 supervise 호출(${calls.length})`);
+    return r;
+  };
+  return { supervise, calls };
+}
+
+/** 기본 seam 한 벌(성공 경로) — 개별 테스트가 필요한 것만 덮는다. */
+function makeDeps(over: Partial<RunJobSessionDeps>): RunJobSessionDeps {
+  return {
+    now: () => CLAIMED + 1_000, // 넉넉한 여유
+    readDomain: async () => "cosmetic",
+    readSkillMd: async () => SKILL_BRIEF,
+    writeSettings: async () => {},
+    readNext: async () => NA_TRANSITIONED,
+    artifactPresent: async () => true,
+    ...over,
+  };
+}
+
+/** allowedTools 규칙 슬라이스(그 다음 플래그 전까지)를 뽑는다. */
+function allowRulesOf(argv: string[]): string[] {
+  const at = argv.indexOf("--allowedTools");
+  if (at < 0) return [];
+  let end = at + 1;
+  while (end < argv.length && !argv[end].startsWith("--")) end++;
+  return argv.slice(at + 1, end);
+}
+
+// ── 테스트 1: kill_at/TERM/KILL 절대시각 계산 ────────────────────────────────────
+describe("computeKillSchedule — kill_at = min(예산 마감, 잡 마감)", () => {
+  test("예산이 먼저 오면 kill_at = claimedAt + genTimeout", () => {
+    const s = computeKillSchedule({ claimedAtMs: CLAIMED, genTimeoutMs: GEN_TIMEOUT, deadlineMs: DEADLINE });
+    expect(s.killAtMs).toBe(CLAIMED + GEN_TIMEOUT);
+    expect(s.termAtMs).toBe(s.killAtMs - TERM_MARGIN_MS);
+    expect(s.killSigAtMs).toBe(s.killAtMs - KILL_MARGIN_MS);
+    // 순서 불변: term < killSig < killAt (전부 마감 이전).
+    expect(s.termAtMs).toBeLessThan(s.killSigAtMs);
+    expect(s.killSigAtMs).toBeLessThan(s.killAtMs);
+  });
+
+  test("잡 마감(expires_at)이 먼저 오면 kill_at = deadline(= 마감이 min)", () => {
+    const nearDeadline = CLAIMED + 100_000; // 예산(480k)보다 훨씬 앞
+    const s = computeKillSchedule({ claimedAtMs: CLAIMED, genTimeoutMs: GEN_TIMEOUT, deadlineMs: nearDeadline });
+    expect(s.killAtMs).toBe(nearDeadline); // expires_at 결박
+    expect(s.termAtMs).toBe(nearDeadline - TERM_MARGIN_MS);
+    expect(s.killSigAtMs).toBe(nearDeadline - KILL_MARGIN_MS);
+  });
+
+  test("유예 상수: TERM_MARGIN(30초) > KILL_MARGIN(10초) — 늘 마감 이전에 완결된다", () => {
+    expect(TERM_MARGIN_MS).toBe(30_000);
+    expect(KILL_MARGIN_MS).toBe(10_000);
+    expect(TERM_MARGIN_MS).toBeGreaterThan(KILL_MARGIN_MS);
+  });
+
+  test("비유한 입력은 던진다(fail-fast)", () => {
+    expect(() =>
+      computeKillSchedule({ claimedAtMs: Number.NaN, genTimeoutMs: GEN_TIMEOUT, deadlineMs: DEADLINE }),
+    ).toThrow(/유한한 ms/);
+  });
