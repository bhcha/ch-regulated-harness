+    // settle reaped — 소멸 확인 · pgid **버림**(스키마: reaped 엔 pgid 부재).
+    led.settle("N1", "reaped");
+    const e = fake.read()?.sessions[0];
+    expect(e?.state).toBe("reaped");
+    expect(e && "pgid" in e).toBe(false); // pgid 키가 실제로 제거됨.
