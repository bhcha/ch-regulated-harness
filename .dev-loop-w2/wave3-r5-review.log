   630	// ── 세션 그룹 레지스트리 + 종료 전파(Finding 1 — 마감 구멍 봉합) ─────────────────
   631	/** on/removeListener/exit 를 기록하는 가짜 종료 호스트(실 process·실 신호 없이 판정). */
   632	function makeFakeTerminationHost() {
   633	  const listeners: Record<"SIGTERM" | "SIGINT" | "exit", Array<() => void>> = {
   634	    SIGTERM: [],
   635	    SIGINT: [],
   636	    exit: [],
   637	  };
   638	  const exitCodes: Array<number | undefined> = [];
   639	  return {
   640	    host: {
   641	      on: (e: "SIGTERM" | "SIGINT" | "exit", l: () => void): void => {
   642	        listeners[e].push(l);
   643	      },
   644	      removeListener: (e: "SIGTERM" | "SIGINT" | "exit", l: () => void): void => {
   645	        listeners[e] = listeners[e].filter((x) => x !== l);
   646	      },
   647	      exit: (code?: number): void => {
   648	        exitCodes.push(code);
   649	      },
   650	    },
   651	    fire: (e: "SIGTERM" | "SIGINT" | "exit"): void => {
   652	      for (const l of [...listeners[e]]) l();
   653	    },
   654	    exitCodes,
   655	  };
   656	}
