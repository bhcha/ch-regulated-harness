   740	// ── HIGH#2: createHeartbeatWriter — 동기·원자 하트비트(direct-pgid 경로 내구성) ───────────────────────
   741	/** in-memory 하트비트 IO(실 디스크 없이 원자성·직렬성 판정). `ops` 로 쓰기 순서·경로를 관측한다. */
   742	function makeFakeHeartbeatIo() {
   743	  const files: Record<string, string> = {};
   744	  const ops: string[] = [];
   745	  return {
   746	    io: {
   747	      writeFileSync: (p: string, d: string): void => {
   748	        files[p] = d;
   749	        ops.push(`write:${p}`);
   750	      },
   751	      renameSync: (from: string, to: string): void => {
   752	        files[to] = files[from];
   753	        delete files[from];
   754	        ops.push(`rename:${from}->${to}`);
   755	      },
   756	    },
   757	    ops,
   758	    read: (p: string): unknown => (files[p] !== undefined ? JSON.parse(files[p]) : undefined),
   759	    /** path 로 **직접** 쓴 적(원자 스왑 우회 = 찢김 가능)이 있으면 그 목록. */
   760	    directWrites: (p: string): string[] => ops.filter((o) => o === `write:${p}`),
   761	  };
   762	}
