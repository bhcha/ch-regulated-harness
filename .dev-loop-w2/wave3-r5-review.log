    15	/** 이 chat 패키지 루트(= chat/). 저장 루트의 기준. 파일 위치 chat/src/config.ts → 두 단계 상위. */
    16	export const PACKAGE_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
    17	
    18	/** Slack 토큰 env '이름'만 선언(값 아님). 단일 워크스페이스 Socket Mode 기준. */
    19	export const SLACK_ENV = {
    20	  botToken: "SLACK_BOT_TOKEN",
    21	  appToken: "SLACK_APP_TOKEN",
    22	  signingSecret: "SLACK_SIGNING_SECRET",
    23	} as const;
    24	
    25	/** 빈 문자열은 미설정으로 취급(값이 있을 때만 반환). */
    26	function readEnv(name: string): string | undefined {
    27	  const v = process.env[name];
    28	  return v !== undefined && v !== "" ? v : undefined;
    29	}
    30	
    31	/**
    32	 * core(하네스) 절대경로 — env HARNESS_ROOT 로 **주입 필수**. 항상 절대경로로 정규화.
    33	 *
    34	 * 헥사고날 관점: 이 챗은 '구동 어댑터'이고 하네스(core)는 그 포트다. 포트 주소(=core 체크아웃 경로)는
    35	 *   어댑터가 스스로 추측(형제 경로 유도)하지 않고 **주입받는다** — 리포지토리 분리(chat·core 별도 레포) 대비.
    36	 *   미주입(미설정/빈값)이면 조용히 엉뚱한 core 를 붙드는 대신 **즉시 실패**한다(fail-fast): 명확한 안내로 멈추는 편이,
    37	 *   잘못된 하네스를 말없이 spawn 하는 것보다 안전하다.
    38	 * @throws HARNESS_ROOT 미설정/빈값이면 Error(한국어 주입 안내).
    39	 */
    40	export function harnessRoot(): string {
    41	  const root = readEnv("HARNESS_ROOT");
    42	  if (root === undefined) {
    43	    throw new Error(
    44	      "HARNESS_ROOT 환경변수가 필요합니다 — 이 챗 어댑터는 하네스(core) 체크아웃 경로를 주입받아야 합니다. 예: HARNESS_ROOT=/path/to/core",
    45	    );
    46	  }
    47	  return isAbsolute(root) ? root : resolve(root);
    48	}
