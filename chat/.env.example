# .env.example — 챗 게이트웨이(Slack 어댑터) 환경설정 예시.
#   실제 값은 `.env`(gitignore)로 두거나 프로세스 env 로 주입한다. config.ts 가 유일 SSoT —
#   다른 모듈은 process.env 를 직접 읽지 않는다.
#
# 이 어댑터는 하네스(core)를 spawn 으로 구동하는 driving adapter 다(헥사고날). core 는 무수정.

# ── 필수 ───────────────────────────────────────────────────────────────────────
# HARNESS_ROOT — 하네스(ch-regulated-harness) core 체크아웃의 절대/상대 경로.
#   포트 주소는 '주입'받는다(형제경로 추측 없음). 미설정이면 기동·통합테스트가 즉시 중단된다(fail-fast).
HARNESS_ROOT=/absolute/path/to/ch-regulated-harness/core

# ── Slack(Socket Mode · 단일 워크스페이스) ──────────────────────────────────────
#   봇 기동엔 BOT·APP 토큰이 필요하다(SIGNING_SECRET 은 선택). 상주 프로세스가 WebSocket 으로 연결.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=

# ── 승인자 allowlist ────────────────────────────────────────────────────────────
# CHAT_APPROVERS — 콤마분리 승인자 id. 형식 관대(U123 · slack:U123 · chat:slack:U123 모두 매칭).
#   비우면 아무도 승인 불가(fail-closed 기본).
CHAT_APPROVERS=slack:U0000000

# ── 인입(운영자 사전 스테이징) ──────────────────────────────────────────────────
# CHAT_BUNDLE_DIR — 크롤 번들 폴더(product.json + reviews.csv + images) 절대경로. 챗 업로드가 아니라 운영자가 미리 스테이징.
CHAT_BUNDLE_DIR=
# CHAT_STAGED_WB — 운영자 스테이징 워킹백워드 .md 절대경로.
#   없으면 [붙여넣기 없이 진행]이 막힌다(core 샘플 WB 오인입 방지 — fail-closed).
CHAT_STAGED_WB=

# ── 저장 루트(선택 — 기본은 패키지 디렉터리 하위) ───────────────────────────────
#   미설정 시: .state/ · data/ · jobs/(gitignore). 아래로 오버라이드 가능.
# CHAT_STATE_DIR=
# CHAT_DATA_DIR=
# CHAT_JOBS_DIR=

# ── 결정적 오프라인(CI/테스트) ──────────────────────────────────────────────────
# HARNESS_OFFLINE=1 이면 core 가 결정적 stub 로 동작(골든 바이트 불변). 운영에서는 설정하지 않는다.
# HARNESS_OFFLINE=
