{
  "_comment": "산출물 파일 경로 패턴 → JSON Schema 매핑. validate-stage.sh / lib 가 사용. 위에서부터 첫 매칭.",
  "rules": [
    { "match": "state.json",                       "schema": "state.schema.json" },
    { "match": "00a-intake/intake-proposal.json",  "schema": "intake-proposal.schema.json" },
    { "match": "00-ingest/voc.json",               "schema": "voc.schema.json" },
    { "match": "00-ingest/claim-basis.json",       "schema": "claim-basis.schema.json" },
    { "match": "00-ingest/assets-manifest.json",   "schema": "assets-manifest.schema.json" },
    { "match": "00-ingest/best-practices.json",    "schema": "best-practices.schema.json" },
    { "match": "00-ingest/evidence-documents.json", "schema": "evidence-documents.schema.json" },
    { "match": "inputs/evidence/index.json",        "schema": "evidence-index.schema.json" },
    { "match": "00g-guideline/examples/*/example-analysis.json", "schema": "example-analysis.schema.json" },
    { "match": "00e-evidence/reflection-proposal.json", "schema": "reflection-proposal.schema.json" },
    { "match": "00g-guideline/reference-notes.json", "schema": "reference-notes.schema.json" },
    { "match": "01-brief/brief.json",              "schema": "brief.schema.json" },
    { "match": "02-concept/concept-axes.json",     "schema": "concept-axes.schema.json" },
    { "match": "*/rtb.json",                        "schema": "rtb.schema.json" },
    { "match": "*/key-message.json",                "schema": "key-message.schema.json" },
    { "match": "*/recommendation.json",             "schema": "recommendation.schema.json" },
    { "match": "*/decision.json",                   "schema": "decision.schema.json" },
    { "match": "*/feedback.json",                   "schema": "feedback.schema.json" },
    { "match": "*-verdict.json",                    "schema": "verdict.schema.json" },
    { "match": "*/concept-verdict.json",            "schema": "verdict.schema.json" },
    { "match": "*/storyline.json",                  "schema": "storyline.schema.json" },
    { "match": "03-storyboard/tone/tone-directions.json", "schema": "tone-directions.schema.json" },
    { "match": "03-storyboard/tone/options/*/tone.json", "schema": "tone-direction.schema.json" },
    { "match": "03-storyboard/art-direction.json",  "schema": "art-direction.schema.json" },
    { "match": "03-storyboard/plan/*.json",         "schema": "plan-block.schema.json" },
    { "match": "*/sources/results.json",            "schema": "results.schema.json" },
    { "match": "04-keyvisual/design-manifest.json", "schema": "design-manifest.schema.json" },
    { "match": "04-keyvisual/image-manifest.json",  "schema": "image-asset.schema.json" },
    { "match": "packs/*/ruleset.json",              "schema": "ruleset.schema.json" },
    { "match": "*/canon-coverage.json",             "schema": "canon-coverage.schema.json" },
    { "match": "*/golden-set.json",                 "schema": "golden-set.schema.json" },
    { "match": "tests/golden/*golden-set*.json",    "schema": "golden-set.schema.json" }
  ]
}
