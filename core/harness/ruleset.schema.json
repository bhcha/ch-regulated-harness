{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "harness/ruleset.schema.json",
  "title": "ruleset.json — 규제도메인별 심의 카탈로그 (설계 §8.3 / multi-domain-build-plan §3)",
  "description": "도메인-중립: 화장품 4축은 properties 로 엄격 검증, 타 도메인(의약외품/건기식/의약품)의 축은 additionalProperties 로 허용. 축 id 는 데이터 주도.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "axes", "general_principle"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sources", "pdf_edition"],
      "properties": {
        "sources": { "type": "array", "items": { "type": "string" } },
        "pdf_edition": { "type": "string", "description": "사용한 PDF 판본(2023/2025) 기록" },
        "domain": { "type": "string", "description": "규제도메인 id(cosmetic|quasi_drug|health_food|drug). 미기재 시 cosmetic(레거시)" },
        "note": { "type": "string" }
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "drug_misperception": {
          "type": "object",
          "additionalProperties": false,
          "required": ["banned", "ref"],
          "properties": {
            "banned": { "type": "array", "items": { "type": "string" } },
            "ref": { "type": "string" }
          }
        },
        "functional_misperception": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conditional", "general_allowed", "ref"],
          "properties": {
            "conditional": { "type": "object", "additionalProperties": { "type": "string" } },
            "general_allowed": { "type": "array", "items": { "type": "string" } },
            "ref": { "type": "string" }
          }
        },
        "consumer_deception": {
          "type": "object",
          "additionalProperties": false,
          "required": ["banned", "rule_extra", "ref"],
          "properties": {
            "banned": { "type": "array", "items": { "type": "string" } },
            "rule_extra": { "type": "array", "items": { "type": "string" } },
            "ref": { "type": "string" }
          }
        },
        "substantiation_required": {
          "type": "object",
          "additionalProperties": false,
          "required": ["triggers", "evidence_grade", "rejected_grade", "ref"],
          "properties": {
            "triggers": { "type": "array", "items": { "type": "string" } },
            "evidence_grade": { "type": "array", "items": { "type": "string" } },
            "rejected_grade": { "type": "array", "items": { "type": "string" } },
            "ref": { "type": "string" },
            "satisfied_when": {
              "type": "array",
              "description": "실증 충족 판정 조건 목록 (이 조건을 모두 갖추면 substantiation_required 위반이 아님)",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "general_principle": { "type": "string" }
  }
}
