{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "harness/storyline.schema.json",
  "title": "storyline.json — 12블록 아웃라인 (설계 §7.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["channel_profile", "blocks"],
  "properties": {
    "channel_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width_px", "max_height_px", "gif_allowed"],
      "properties": {
        "name": { "type": "string" },
        "width_px": { "type": "integer" },
        "max_height_px": { "type": "integer" },
        "gif_allowed": { "type": "boolean" }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "type", "intent", "risk_tier"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "type": {
            "comment": "블록 유효 카탈로그(23종)는 포맷 캐논 정본 packs/_format/<fmt>/canon.json 의 types 가 소유(4단계, C 메커니즘: 닫힌 enum → 구조적 패턴 완화). 스키마는 구조 검증만 — 카탈로그 대조는 validate_storyboard._canon 이 canon.json 으로 강제(미등록 type=캐논 외 fail).",
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          },
          "intent": { "type": "string" },
          "risk_tier": { "enum": ["low", "medium", "high", "critical"] },
          "evidence_required": { "type": "boolean" },
          "enabled_if": { "type": ["string", "null"] }
        }
      }
    }
  }
}
