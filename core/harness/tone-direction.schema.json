{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "harness/tone-direction.schema.json",
  "title": "tone.json — 톤&매너 방향 1안 (03-storyboard tone substage)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "palette", "typography", "mood", "slot_concepts"],
  "properties": {
    "id":         { "type": "string", "minLength": 1 },
    "label":      { "type": "string" },
    "palette":    { "type": "array", "items": { "type": "string" } },
    "typography": { "type": "string" },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color_temp": { "type": "string" },
        "lighting":   { "type": "string" },
        "texture":    { "type": "string" }
      }
    },
    "reference_strategy": { "type": "string" },
    "slot_concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_type", "reference"],
        "properties": {
          "block_type":   { "type": "string" },
          "composition":  { "type": "string" },
          "handoff_note": { "type": "string" },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["own_asset_path"],
            "properties": {
              "own_asset_path":          { "type": "string", "pattern": "^inputs/assets/" },
              "direction":               { "type": "string" },
              "crawl_pattern_ref":       { "type": ["string", "null"] },
              "reference_image_id":      { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._-]+#[0-9]{2,}$", "description": "M2(G3): 00g example-analysis.reference_images[].id(<example_id>#NN) 로 조인. 메타 SSoT=00g(중복 임베드 아님)." },
              "pixel_reference_allowed": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
