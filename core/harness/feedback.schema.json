{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "harness/feedback.schema.json",
  "title": "feedback.json — 보완 요청 (설계 §3.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_text", "issue"],
        "properties": {
          "target_text": { "type": "string" },
          "issue": { "type": "string" },
          "regulation_ref": { "type": ["string", "null"] },
          "suggested_alternative": { "type": ["string", "null"] }
        }
      }
    },
    "stop_reason": {
      "type": "object",
      "additionalProperties": false,
      "description": "선택(WS-GATES). 구조화 멈춤 사유(왜 멈췄나 + 사람이 채울 필드). revise --reason 가 기록.",
      "properties": {
        "code": { "type": "string", "description": "기계 판독 코드(예: human_revise, missing_evidence)" },
        "summary": { "type": "string", "description": "사람이 읽는 한 줄 사유" },
        "required_fields": { "type": "array", "items": { "type": "string" }, "description": "사람/재생성이 채워야 할 필드/대상" }
      }
    }
  }
}
