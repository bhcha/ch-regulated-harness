{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "harness/key-message.schema.json",
  "title": "key-message.json — 키메시지 (설계 §7.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["concept_axis", "key_messages"],
  "properties": {
    "concept_axis": { "type": "string" },
    "key_messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slot", "headline", "claim_strength", "evidence_ref", "review_status"],
        "properties": {
          "id": { "type": "string" },
          "slot": { "enum": ["emotional", "legal"] },
          "headline": { "type": "string" },
          "voc_phrase": { "type": ["string", "null"], "description": "emotional 슬롯은 reviews 근거 인용 강제" },
          "claim_strength": { "enum": ["factual", "emotional", "superlative", "efficacy", "speed"] },
          "evidence_ref": { "type": ["string", "null"] },
          "functional_basis": { "type": ["string", "null"] },
          "review_status": { "enum": ["pending", "passed", "revise"] }
        }
      }
    }
  }
}
