{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "harness/recommendation.schema.json",
  "title": "recommendation.json — pairwise 추천 (설계 §6.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["ranked", "rationale"],
  "properties": {
    "ranked": {
      "type": "array",
      "minItems": 1,
      "description": "pairwise 비교 결과 순위. ranked[0]=top-1.",
      "items": { "type": "string" }
    },
    "rationale": { "type": "string" }
  }
}
